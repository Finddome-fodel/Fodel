# Copy to .env and fill in. Never commit .env.

# Supabase (https://supabase.com) — the database behind properties, the
# admin system and the seller portal. Project Settings → API in your
# Supabase dashboard has all three values.
#
# SUPABASE_URL and SUPABASE_ANON_KEY are what the public website uses to read
# published listings. The anon key is low-privilege by design — every query
# it makes is still filtered by the database's own security rules (Row-Level
# Security), so this key is safe even though it lives in server code that
# talks to a public database.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# The service-role key BYPASSES every security rule — it can read and write
# anything. Not required to run the public website (Stage 1). Collected now
# because Stage 2 onward (the admin system and seller portal) need it for
# privileged server-side actions. Never put this key in any file that ships
# to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Transactional email (https://resend.com) — powers the public forms and every
# portal lifecycle email (registration, invite, approval, receipt, password
# reset). Without it the endpoints still validate, still change state, and log
# what they would have sent instead of sending it, so the whole flow stays
# testable offline.
#
# The sender domain must be verified in Resend or nothing is delivered. This
# is the single most common reason a working build appears to "lose" emails.
RESEND_API_KEY=

# Where form submissions are delivered.
FODEL_INBOX=info@fodel.com

# Verified sender domain in Resend. Must be a domain FODEL controls.
FODEL_FROM="FODEL <info@fodel.com>"

# Where a customer's reply lands ("just reply to this email"). Optional —
# defaults to FODEL_INBOX. All three addresses are read in exactly one place,
# src/lib/email/routing.ts.
FODEL_REPLY_TO=info@fodel.com

# Self-hosted map basemap (Stage 7). Public URL of the .pmtiles file built by
# `npm run build:pmtiles` and uploaded to Cloudflare R2 (or any public host).
# Optional: until this is set, every <Map> uses OpenFreeMap's free hosted
# style (tiles.openfreemap.org, no key, OSM/OpenMapTiles credit shown).
PMTILES_URL=

# Stripe — card payment for an approved listing.
#
# FODEL 1.1's model: an admin approves a listing, the owner is emailed what it
# costs, and paying publishes it. Bank transfer remains the primary, published
# method and works whether or not this is on — with STRIPE_ENABLED=false the
# approval email simply carries the bank details and no card button, and an
# admin publishes from the review screen once the transfer lands. Nothing
# breaks in either state.
#
# Turn this on only once FODEL's Stripe account is live. You also need to
# register the webhook endpoint in the Stripe dashboard, pointing at
# https://<your-domain>/api/stripe/webhook and subscribed to
# `checkout.session.completed` and `checkout.session.expired` — without it a
# card payment is taken and the listing never publishes.
STRIPE_ENABLED=false
PAYMENT_GATES_PUBLISHING=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# OpenAI — the valuation adjustment/rationale and the description-rewrite
# suggestion, both behind an admin approval gate (see src/lib/ai/client.ts).
# Same degradation posture as Stripe/Resend: with AI_ENABLED anything but
# "true", every page still renders and every form still submits — the
# valuation degrades to comps + median/IQR with no AI adjustment, and the
# "Szövegjavaslat" button simply doesn't appear.
#
# Only ever read from a `prerender = false` route — never from a page that
# could be statically built with the key inlined.
AI_ENABLED=false
OPENAI_API_KEY=

# CRM hand-off (optional). Every new enquiry is POSTed here as JSON, right
# after it is saved. Leave empty until the CRM is chosen; the portal then shows
# "CRM nincs bekötve" and nothing is lost. The token, if the CRM wants one, is
# sent as `Authorization: Bearer …`.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_TOKEN=

# Daily job (vercel.json → "crons" → /api/cron/daily): listing expiry, expiry
# reminders, and the monthly "still for sale?" email to owners. Vercel sends
# `Authorization: Bearer <CRON_SECRET>` with every cron call; the endpoint
# refuses anything else, and with this unset it never runs. Use a long random
# string (e.g. `openssl rand -hex 32`) and set it in Vercel → Settings →
# Environment Variables (Production).
CRON_SECRET=

# Newsletter (optional). If set, every confirmed newsletter subscriber is also
# added to this Resend Audience (Resend → Audiences → the audience's id), and
# an unsubscribe is mirrored there. Leave empty to keep the list only in the
# database (admin → Hírlevél → Excel export).
RESEND_AUDIENCE_ID=

# End-to-end tests only — never set in production. `capture` makes every email
# (portal lifecycle mail and the public forms' notifications alike) land as a
# JSON file in .e2e/outbox/ instead of being sent; the Playwright suite reads
# invite and password-reset links from there. Leave empty to send through
# Resend as normal. See .env.test.example for the whole test setup.
EMAIL_TRANSPORT=
