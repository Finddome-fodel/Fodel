# End-to-end tests (Playwright) — copy to .env.test (gitignored) and fill in.
#
# The suite NEVER reads .env (the live database). Run it from a copy of the
# repo without .env, e.g.
#   rsync -a --exclude node_modules --exclude .env ./ ../fodel-e2e/ && cd ../fodel-e2e && npm ci
#   npx playwright install chromium firefox webkit
#   npx playwright test
#
# Without the values below only the public, read-only tests run (navigation,
# language switching, layout, form validation — nothing is ever submitted).

# Turn on the seller/admin lifecycle tests. They write to the database, so the
# suite refuses to start unless SUPABASE_URL is localhost (supabase start) or
# the project whose ref is E2E_SUPABASE_REF.
E2E_ALLOW_WRITES=
E2E_SUPABASE_REF=

# A local Supabase (supabase start) or the separate "fodel-test" project, with
# migrations 0001–0020 applied. Never production.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# An admin account in that test database (the lifecycle tests sign in as it).
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# Stripe in test mode (sk_test_…), or leave empty to test only the signed
# webhook path. The webhook secret signs the test events the suite posts.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=whsec_e2e_dummy

# The daily job's secret, for the cron test.
CRON_SECRET=e2e-cron-secret

# Optional: test a server that is already running instead of starting one.
# E2E_BASE_URL=http://localhost:4400
