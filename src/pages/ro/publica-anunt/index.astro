---
// Needs to read ?ref= and re-evaluate FormShell's renderedAt anti-spam value
// per request — a prerendered page freezes both at build time.
export const prerender = false;
Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=120');

import SubmitAdPage from "~/components/pages/SubmitAdPage.astro";
---

<SubmitAdPage locale="ro" />
