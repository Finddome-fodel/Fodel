---
export const prerender = false;
import ArticlePage from '~/components/pages/ArticlePage.astro';
import { localizedPostBySlug } from '~/lib/blog';

const { slug } = Astro.params;
// Drafts, future-dated posts and unknown slugs come back null. The Dutch (or,
// failing that, Hungarian) text stands in for a post with no version in this language.
const found = slug ? await localizedPostBySlug('ro', slug) : null;
if (!found) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}
Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=120');
---

<ArticlePage locale="ro" post={found.post} from={found.from} />
