---
export const prerender = false;
import ArticlePage from '~/components/pages/ArticlePage.astro';
import { postBySlug } from '~/lib/blog';

const { slug } = Astro.params;
// Drafts, future-dated posts and other languages' slugs all come back null.
const post = slug ? await postBySlug('nl', slug) : null;
if (!post) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}
// No stale-while-revalidate here: an unpublished post must stop being served within the minute.
Astro.response.headers.set('Cache-Control', 's-maxage=60');
---

<ArticlePage locale="nl" post={post} />
