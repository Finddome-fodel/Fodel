---
// Reads property data from Supabase (via SoldPage.astro), so this renders on
// request rather than once at build time. Cached at the CDN for 5 minutes.
export const prerender = false;
Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=120');

import SoldPage from "~/components/pages/SoldPage.astro";
---

<SoldPage locale="sv" />
