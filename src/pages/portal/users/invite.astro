---
export const prerender = false;

import Portal from '~/layouts/Portal.astro';
import { inviteAvailability } from '~/lib/portal/invites';
import { LOCALE_LABEL } from '~/lib/portal/labels';

const sent = Astro.url.searchParams.get('sent');
const err = Astro.url.searchParams.get('error');
const languages = await inviteAvailability(Astro.locals.supabase);
const SOURCE_NOTE = {
  approved: 'jóváhagyott sablon',
  'built-in': 'alapértelmezett szöveg',
  missing: 'nincs jóváhagyott szöveg',
} as const;
---

<Portal title="Meghívás">
  <header class="ph">
    <div>
      <p class="eyebrow"><a href="/portal/users">← Felhasználók</a></p>
      <h1>Új felhasználó <em>meghívása</em></h1>
      <p class="lede">A meghívott e-mailben kapja a belépési linket, és maga állítja be a jelszavát.</p>
    </div>
  </header>

  {sent && <p class="notice ok">Meghívó elküldve: {decodeURIComponent(sent)}</p>}
  {err && <p class="notice error">{decodeURIComponent(err)}</p>}

  <form method="POST" action="/api/portal/users/invite" class="invite-card">
    <div class="field">
      <label for="email">E-mail cím</label>
      <input id="email" name="email" type="email" required />
    </div>
    <div class="field">
      <label for="role">Szerep</label>
      <select id="role" name="role">
        <option value="owner">Hirdető</option>
        <option value="admin">Admin</option>
      </select>
    </div>
    <div class="field">
      <label for="locale">A meghívó nyelve</label>
      <select id="locale" name="locale" required>
        <option value="" selected disabled>Válasszon nyelvet…</option>
        {languages.map((language) => (
          <option
            value={language.locale}
            disabled={language.owner === 'missing'}
            data-owner={language.owner}
            data-admin={language.admin}
            data-name={LOCALE_LABEL[language.locale]}
          >
            {LOCALE_LABEL[language.locale]} — {SOURCE_NOTE[language.owner]}
          </option>
        ))}
      </select>
      <p class="hint">
        A nyelvet Ön választja ki — az e-mail címből nem következtetünk rá. Hirdetői meghívó
        angolul és németül csak jóváhagyott szöveggel küldhető; a szövegek a
        <a href="/portal/settings/templates">Meghívólevelek</a> oldalon szerkeszthetők. Admin
        meghívó mindig a beépített admin szöveggel megy ki, magyarul vagy hollandul.
      </p>
    </div>
    <div class="field" id="free-field">
      <label class="check">
        <input type="checkbox" name="free_listing" value="yes" />
        Ingyenes hirdetésfeladás
      </label>
      <p class="hint">
        A meghívott első hirdetése díjbekérő nélkül kerül elbírálásra. A jogosultságot a rendszer
        tárolja, a linkben nem szerepel. A közzététel ekkor is munkatársi jóváhagyáshoz kötött.
      </p>
    </div>
    <button type="submit" class="btn">Meghívó küldése e-mailben</button>
    <button type="button" class="btn btn-ghost" id="copy-link-btn">Link létrehozása és másolása (e-mail nélkül)</button>
    <div id="link-result" class="link-result" hidden>
      <label for="link-url">Meghívó link</label>
      <div class="link-row">
        <input id="link-url" type="text" readonly />
        <button type="button" class="btn" id="copy-again-btn">Másolás</button>
      </div>
      <p class="hint" id="link-note"></p>
    </div>
    <p class="notice error" id="link-error" hidden></p>
  </form>

  
</Portal>

<script>
  // A free listing only means something for a seller account, and the
  // wording (so which languages can be sent) depends on the role.
  const NOTE: Record<string, string> = {
    approved: 'jóváhagyott sablon',
    'built-in': 'alapértelmezett szöveg',
    missing: 'nincs jóváhagyott szöveg',
  };
  const role = document.getElementById('role') as HTMLSelectElement | null;
  const locale = document.getElementById('locale') as HTMLSelectElement | null;
  const free = document.getElementById('free-field');
  const sync = () => {
    if (!role || !free) return;
    const owner = role.value === 'owner';
    free.hidden = !owner;
    const box = free.querySelector('input');
    if (box && !owner) box.checked = false;
    for (const option of locale?.querySelectorAll<HTMLOptionElement>('option[data-owner]') ?? []) {
      const source = (owner ? option.dataset.owner : option.dataset.admin) ?? 'missing';
      option.disabled = source === 'missing';
      option.textContent = `${option.dataset.name} — ${owner ? NOTE[source] : source === 'missing' ? 'admin meghívó nem érhető el' : 'admin szöveg'}`;
      if (option.disabled && option.selected && locale) locale.value = '';
    }
  };
  role?.addEventListener('change', sync);
  sync();

  // Copy link: the invite is created without an e-mail and the link is shown once (only its hash is stored).
  const card = document.querySelector<HTMLFormElement>('.invite-card');
  const copyBtn = document.getElementById('copy-link-btn') as HTMLButtonElement | null;
  const copyAgain = document.getElementById('copy-again-btn') as HTMLButtonElement | null;
  const result = document.getElementById('link-result');
  const urlBox = document.getElementById('link-url') as HTMLInputElement | null;
  const note = document.getElementById('link-note');
  const error = document.getElementById('link-error');
  const copy = async () => {
    if (!urlBox) return false;
    try { await navigator.clipboard.writeText(urlBox.value); return true; }
    catch { urlBox.select(); return document.execCommand('copy'); }
  };
  copyBtn?.addEventListener('click', async () => {
    if (!card || !result || !urlBox || !note || !error) return;
    error.hidden = true;
    if (!card.reportValidity()) return;
    copyBtn.disabled = true;
    try {
      const data = new FormData(card);
      data.set('delivery', 'link');
      const res = await fetch('/api/portal/users/invite', { method: 'POST', body: data });
      const json = await res.json().catch(() => ({}));
      if (!res.ok || !json.ok) { error.textContent = json.error || 'Nem sikerült létrehozni a linket.'; error.hidden = false; return; }
      urlBox.value = json.url;
      const copied = await copy();
      note.textContent = `${copied ? 'A link a vágólapra került. ' : 'Másolja ki a linket. '}${json.email} számára készült, ${json.expiresDays} napig érvényes, egyszer használható. Biztonsági okból csak most látható — később nem kérhető le újra.`;
      result.hidden = false;
    } finally { copyBtn.disabled = false; }
  });
  copyAgain?.addEventListener('click', async () => {
    if (await copy() && copyAgain) { const t = copyAgain.textContent; copyAgain.textContent = 'Másolva ✓'; setTimeout(() => { copyAgain.textContent = t; }, 1500); }
  });
</script>

<style>
  .invite-card { max-width: 560px; padding: clamp(24px, 3vw, 36px); border-radius: var(--r-xl); background: var(--white); box-shadow: var(--shadow-md), 0 0 0 1px var(--pt-hair); }
  .field { display: grid; gap: 8px; margin-bottom: 22px; }
  label { font-size: var(--fs-small); font-weight: var(--fw-medium); color: var(--ink); }
  input:not([type='checkbox']), select { width: 100%; min-height: 52px; padding: 12px 16px; font-size: var(--fs-body); color: var(--ink); font-family: inherit; }
  .hint { font-size: 14px; line-height: 1.65; color: var(--ink-quiet); }
  .hint a { text-decoration: underline; text-underline-offset: 3px; }
  label.check { display: flex; gap: 12px; align-items: center; padding: 14px 16px; border-radius: var(--r-md); background: var(--paper); font-weight: var(--fw-regular); cursor: pointer; }
  #free-field[hidden] { display: none; }
  .invite-card > .btn { width: 100%; padding: 14px 24px; }
  .invite-card > .btn + .btn { margin-top: 12px; }
  .btn-ghost { background: transparent; color: var(--ink); box-shadow: 0 0 0 1px var(--pt-hair); }
  .link-result { margin-top: 22px; display: grid; gap: 8px; }
  .link-result[hidden], #link-error[hidden] { display: none; }
  .link-row { display: flex; gap: 8px; }
  .link-row input { flex: 1; min-width: 0; }
  .link-row .btn { padding: 12px 20px; }
</style>
