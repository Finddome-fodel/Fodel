---
/**
 * Guided listing setup — step 4 of the seller flow (launch round).
 *
 * After registering on the public site and setting a password, a seller lands
 * here, in their own language (profiles.locale: Hungarian, Dutch or English), and builds the
 * listing one calm step at a time: package → the property → description and
 * contact → photos → billing → review and submit. One page; each step is a
 * section revealed on its own, the URL hash says which (#package, #property…)
 * so a reload, a deep link and the browser's Back button all land where they
 * should, and the person can leave and come back at any time.
 *
 * Saving: every step saves on "Continue" and, quietly, whenever a field is
 * left (autosave on blur) — through the existing update endpoint with a
 * `step` field (src/lib/portal/setup.ts), so only that step's fields change.
 * Photos and billing use their own endpoints; submitting is the existing
 * status action. Row-Level Security still decides that an owner can only
 * touch their own draft.
 *
 * What does not change: nothing publishes without FODEL approving it, and
 * payment comes after approval. The full editor (/portal/properties/[id])
 * stays for admins and for edits after the first submission.
 */
export const prerender = false;

import Portal from '~/layouts/Portal.astro';
import Logo from '~/components/Logo.astro';
import ArrowChip from '~/components/ArrowChip.astro';
import PackageCard from '~/components/PackageCard.astro';
import OnsiteServiceChoice from '~/components/OnsiteServiceChoice.astro';
import ListingFields from '~/components/portal/ListingFields.astro';
import {languageName} from '~/lib/listing-catalogue';
import { HEARD_FROM } from '~/lib/listing-details';
import ContactLanguages from '~/components/portal/ContactLanguages.astro';
import Field from '~/components/forms/Field.astro';
import PhotoUploader from '~/components/portal/PhotoUploader.astro';
import BillingForm from '~/components/BillingForm.astro';
import { getProperty, OWNER_EDITABLE } from '~/lib/portal/properties';
import { getCompany, getTaxonomy, termLabel } from '~/lib/runtime-config';
import { listingCatalog, packageCard, packageOf } from '~/lib/listing-packages';
import { readRequestedExtras } from '~/lib/portal/requested-extras';
import { TRANSLATION_LANGUAGES, ONSITE_SERVICES } from '~/config/company';
import { LOCALE_META } from '~/i18n/ui';
import { DESCRIPTION_MAX } from '~/lib/portal/setup';
import { SETUP_COPY } from '~/lib/portal/setup-copy';
import { portalLang } from '~/lib/portal/auth-copy';

const { supabase, profile, user } = Astro.locals;
const { id } = Astro.params;
const isAdmin = profile?.role === 'admin';

const property = await getProperty(supabase, id!);
if (!property) return new Response('Not found', { status: 404 });
if (!isAdmin && property.owner_id !== user?.id) return new Response('Forbidden', { status: 403 });
// Submitted, approved or live: the guided setup is over; the editor shows its state.
if (!OWNER_EDITABLE.includes(property.status)) return Astro.redirect(`/portal/properties/${property.id}`);

const lang = portalLang(profile?.locale);
const hu = lang === 'hu';
const numberTag = { hu: 'hu-HU', nl: 'nl-NL', en: 'en-GB' }[lang];

const [company, taxonomy, { data: billingRow }, serviceResult] = await Promise.all([
  getCompany(),
  getTaxonomy(),
  supabase.from('profiles').select('billing, full_name, phone').eq('id', user!.id).maybeSingle(),
  supabase
    .from('service_requests')
    .select('service_id, status')
    .eq('property_id', property.id)
    .in('status', ['requested', 'scheduled'])
    .maybeSingle(),
]);

const catalog = listingCatalog(company.services);
const requested = readRequestedExtras(property.requested_extras);
// The package the seller chose here before; on a fresh draft, the recommended one.
const chosenId = requested.source === 'listing_editor' ? property.package : (catalog.packages.find((p) => p.recommended) ?? catalog.packages[0]).id;
const chosen = packageOf(catalog, chosenId);
const cards = catalog.packages.map((pkg) => ({ pkg, card: packageCard(pkg, catalog, lang) }));
const extra = (key: string) => catalog.extras.find((e) => e.id === key)!;
const service = serviceResult.data?.service_id ?? requested.service ?? '';

const tr = property.translations.find((t) => t.locale === lang) ?? property.translations.find((t) => t.locale === 'hu');
const description = tr?.description || '';
const x=(hu:string,nl:string,en:string)=>lang==='hu'?hu:lang==='nl'?nl:en;

// An admin-granted free listing has no package to choose and no invoice to address, so those two steps are left out.
const free = Boolean(property.free_listing);
const ALL_STEPS = ['package', 'property', 'description', 'photos', 'billing', 'review'] as const;
const STEPS = ALL_STEPS.filter((step) => !free || (step !== 'package' && step !== 'billing'));
const at = (step: (typeof ALL_STEPS)[number]) => ALL_STEPS.indexOf(step);

const t = SETUP_COPY[lang];


const billing = (billingRow as any)?.billing ?? null;

/** Everything the script needs to price and summarise, without a second request. */
const pricing = {
  packages: Object.fromEntries(
    catalog.packages.map((p) => [
      p.id,
      { name: p.names[lang], cents: p.priceEur * 100, aboveCents: p.priceEurAbove !== null ? p.priceEurAbove * 100 : null, threshold: p.thresholdHuf, video: p.video, phone: p.phone },
    ])
  ),
  translationCents: extra('translation').priceEur * 100,
  categoryCents: extra('category-highlight').priceEur * 100 * (extra('category-highlight').minMonths ?? 1),
  homepageCents: extra('homepage-highlight').priceEur * 100 * (extra('homepage-highlight').minMonths ?? 1),
  videoCents: extra('video').priceEur * 100,
  services: Object.fromEntries(ONSITE_SERVICES.map((s) => [s.id, { name: s.names[lang], cents: s.priceEur * 100 }])),
};
const strings = {
  saving: t.saving, saved: t.saved, saveFailed: t.saveFailed, required: t.required, none: t.none,
  submitting: t.submitting, submitFailed: t.submitFailed, noPhotos: t.noPhotos,
  missing: t.missing, missingHead: t.missingHead, photosCount: t.photosCount(0).replace('0', '{n}'),
  translation: t.translation, categoryHighlight: t.categoryHighlight, homepageHighlight: t.homepageHighlight, video: t.video,
};
---

<Portal title={t.title} bare wide lang={lang}>
  <div
    class="su"
    data-setup
    data-property-id={property.id}
    data-lang={lang}
    data-steps={STEPS.join(',')}
    data-free={free ? 'yes' : undefined}
    data-strings={JSON.stringify(strings)}
    data-pricing={JSON.stringify(pricing)}
  >
    <script is:inline>
      // Before first paint: show one step, chosen by the hash, so the page
      // never flashes all six at once.
      (function () {
        var root = document.currentScript.parentElement;
        var steps = root.dataset.steps.split(',');
        var at = steps.indexOf(location.hash.slice(1));
        root.dataset.active = steps[at < 0 ? 0 : at];
        root.classList.add('js');
      })();
    </script>

    <header class="su-top">
      <Logo locale={lang} href="/portal/dashboard" />
      <a class="su-exit" href="/portal/dashboard">{t.saveExit}</a>
    </header>

    <div class="su-head">
      <p class="su-eyebrow">{t.eyebrow} · #{property.ref}</p>
      <div class="su-progress">
        <div class="su-bar" aria-hidden="true"><span data-progress-bar></span></div>
        <p class="su-count" aria-live="polite"><b data-step-n>1</b> / {STEPS.length} <span class="sr-only">{t.of}</span></p>
      </div>
      <ol class="su-steps">
        {STEPS.map((step, i) => (
          <li><a href={`#${step}`} data-step-link={step}><span class="n">{i + 1}</span><span class="l">{t.steps[at(step)]}</span></a></li>
        ))}
      </ol>
    </div>

    {/* ── 1. Package ── */}
    {!free && (
    <section class="su-step" id="package" data-step="package" aria-labelledby="h-package" tabindex="-1">
      <h1 id="h-package">{t.steps[0]}</h1>
      <p class="su-intro">{t.intros[0]}</p>
      <form data-step-form="package" id="su-package" novalidate>
        <div class="su-packages">
          {cards.map(({ pkg, card }) => (
            <PackageCard
              pkg={card}
              mode="select"
              radioName="package"
              checked={pkg.id === chosen.id}
              priceCents={card.priceCents}
              recommendedLabel={t.recommended}
            />
          ))}
        </div>

        <fieldset class="su-extras">
          <legend>{t.extrasHead}</legend>
          <p class="su-note">{t.extrasNote}</p>
          <div class="chips">
            {TRANSLATION_LANGUAGES.map((code) => (
              <label class="chip">
                <input type="checkbox" name="translations" value={code} checked={requested.translations?.includes(code)} />
                <span class="box" aria-hidden="true"></span>
                <span class="chip-name">{t.translation}: {languageName(code,lang)}</span>
                <span class="chip-price">€ {extra('translation').priceEur} {t.perLanguage}</span>
              </label>
            ))}
            <label class="chip">
              <input type="checkbox" name="categoryHighlight" value="yes" checked={requested.categoryHighlight} />
              <span class="box" aria-hidden="true"></span>
              <span class="chip-name">{t.categoryHighlight}</span>
              <span class="chip-price">€ {extra('category-highlight').priceEur} {t.perMonth} · {t.minMonths(extra('category-highlight').minMonths ?? 1)}</span>
            </label>
            <label class="chip">
              <input type="checkbox" name="homepageHighlight" value="yes" checked={requested.homepageHighlight} />
              <span class="box" aria-hidden="true"></span>
              <span class="chip-name">{t.homepageHighlight}</span>
              <span class="chip-price">€ {extra('homepage-highlight').priceEur} {t.perMonth} · {t.minMonths(extra('homepage-highlight').minMonths ?? 1)}</span>
            </label>
            <label class="chip"><input type="checkbox" name="topicHighlight" value="yes" checked={property.topic_highlight_requested||requested.topicHighlight}/><span class="box" aria-hidden="true"></span><span class="chip-name">{x('Témakörön belüli kiemelés','Uitlichting binnen het subtype','Highlight within the subtype')}</span><span class="chip-price">{x('Egyedi áregyeztetés','Prijs in overleg','Price by arrangement')}</span></label>
            <label class="chip" data-video-chip>
              <input type="checkbox" name="video" value="yes" checked={requested.video} />
              <span class="box" aria-hidden="true"></span>
              <span class="chip-name">{t.video}</span>
              <span class="chip-price">€ {extra('video').priceEur} {t.once}</span>
            </label>
          </div>
        </fieldset>

        <div class="su-onsite">
          <OnsiteServiceChoice locale={lang} selected={service} />
        </div>

        <div class="su-total" aria-live="polite">
          <p><span class="su-total-label">{t.total}</span><span class="su-total-note">{t.totalNote}</span></p>
          <strong class="num" data-total>—</strong>
        </div>
      </form>
    </section>
    )}

    {/* ── 2. The property ── */}
    <section class="su-step" id="property" data-step="property" aria-labelledby="h-property" tabindex="-1">
      <h1 id="h-property">{t.steps[1]}</h1>
      <p class="su-intro">{t.intros[1]}</p>
      <form data-step-form="property" novalidate data-price-huf={property.price_huf}>
        <ListingFields property={property} taxonomy={taxonomy} locale={lang}/>
      </form>
    </section>

    {/* ── 3. Description and contact ── */}
    <section class="su-step" id="description" data-step="description" aria-labelledby="h-description" tabindex="-1">
      <h1 id="h-description">{t.steps[2]}</h1>
      <p class="su-intro">{t.intros[2]}</p>
      <form data-step-form="description" novalidate>
        <aside class="su-good">
          <p class="su-good-head">{t.goodHead}</p>
          <ul>{t.good.map((line) => <li>{line}</li>)}</ul>
        </aside>
        <Field locale={lang} name="title" label={x('Hirdetés címe','Advertentietitel','Listing title')} required value={tr?.title==='Új hirdetés'?'':tr?.title||''} maxlength={160}/>
        <Field locale={lang} name="description" label={t.description} type="textarea" rows={4} required hint={t.descriptionHint} value={description} maxlength={DESCRIPTION_MAX} />
        <p class="su-counter num" aria-live="polite"><span data-counter>{description.length.toLocaleString(numberTag)}</span> / {DESCRIPTION_MAX.toLocaleString(numberTag)} {t.chars}</p>

        <Field locale={lang} name="body" label={x('Részletes leírás','Uitgebreide beschrijving','Detailed description')} type="textarea" rows={8} value={tr?.body||''} maxlength={30000}/>
        <Field locale={lang} name="internal_note" label={x('Megjegyzés (belső használatra)','Opmerking (intern)','Note (private)')} type="textarea" rows={3} value={property.internal_note||''} maxlength={10000} hint={x('Csak Ön és a FINDDOME munkatársai láthatják. Soha nem jelenik meg a hirdetésben.','Alleen zichtbaar voor u en FINDDOME. Wordt nooit openbaar getoond.','Visible only to you and FINDDOME. Never displayed in the public listing.')}/>
        <Field locale={lang} name="heard_from" label={x('Honnan értesült a FINDDOME-ről?','Hoe hoorde u van FINDDOME?','Where did you hear about FINDDOME?')} type="select" value={property.heard_from||''} options={[{value:'',label:x('Válasszon, ha szeretne','Kies, als u wilt','Choose if you like')},...HEARD_FROM.map(o=>({value:o.key,label:o.labels[lang]}))]} hint={x('Csak a FINDDOME munkatársai látják.','Alleen zichtbaar voor FINDDOME.','Only FINDDOME staff see this.')}/>
        <fieldset class="su-fieldset">
          <legend>{t.speaks}</legend>
          <p class="su-note">{t.speaksHint}</p>
          <ContactLanguages selected={property.seller_speaks} locale={lang}/>
        </fieldset>

        <fieldset class="su-fieldset" data-contact-choice>
          <legend>{t.contact}</legend>
          <p class="su-note">{t.contactHint}</p>
          <label class="su-radio"><input type="radio" name="contact" value="yes" checked={property.seller_contact_visible} /> {t.contactYes}</label>
          <label class="su-radio"><input type="radio" name="contact" value="no" checked={!property.seller_contact_visible} /> {t.contactNo}</label>
        </fieldset>
        <p class="su-note su-contact-off" data-contact-off>{t.contactNotInPackage}</p>
      </form>
    </section>

    {/* ── 4. Photos ── */}
    <section class="su-step" id="photos" data-step="photos" aria-labelledby="h-photos" tabindex="-1">
      <h1 id="h-photos">{t.steps[3]}</h1>
      <p class="su-intro">{t.intros[3]}</p>
      <div class="su-card">
        <PhotoUploader
          propertyId={property.id}
          media={property.media}
          photoLimit={packageOf(catalog, property.package).maxImages}
          packageName={packageOf(catalog, property.package).names[lang]}
          editable={true}
          isAdmin={isAdmin}
          locale={lang}
          withHeading={false}
        />
      </div>
    </section>

    {/* ── 5. Billing ── */}
    {!free && (
    <section class="su-step" id="billing" data-step="billing" aria-labelledby="h-billing" tabindex="-1">
      <h1 id="h-billing">{t.steps[4]}</h1>
      <p class="su-intro">{t.intros[4]}</p>
      <div class="su-card">
        <BillingForm billing={billing} fallbackName={(billingRow as any)?.full_name ?? ''} fallbackPhone={(billingRow as any)?.phone ?? ''} locale={lang} embedded />
      </div>
    </section>
    )}

    {/* ── 6. Review ── */}
    <section class="su-step" id="review" data-step="review" aria-labelledby="h-review" tabindex="-1">
      <h1 id="h-review">{t.steps[5]}</h1>
      <p class="su-intro">{t.intros[5]}</p>
      <div class="su-review" data-review>
        <dl>
          {[
            ['package', t.reviewPackage],
            ['property', t.reviewProperty],
            ['description', t.reviewDescription],
            ['photos', t.reviewPhotos],
            ['billing', t.reviewBilling],
          ].filter(([key]) => !free || (key !== 'package' && key !== 'billing')).map(([key, label]) => (
            <div class="su-row">
              <dt>{label}</dt>
              <dd data-summary={key}></dd>
              <a class="su-edit" href={`#${key}`}>{t.edit}<span class="sr-only">: {label}</span></a>
            </div>
          ))}
        </dl>
        {free ? (
          <div class="su-total">
            <p><span class="su-total-label">{t.total}</span><span class="su-total-note">{x('Ingyenes hirdetés: a közzététel előtt munkatársunk jóváhagyja.','Gratis advertentie: een medewerker keurt hem goed vóór publicatie.','Free listing: our team approves it before it goes live.')}</span></p>
            <strong class="num">{x('Ingyenes','Gratis','Free')}</strong>
          </div>
        ) : (
        <div class="su-total">
          <p><span class="su-total-label">{t.total}</span><span class="su-total-note">{t.totalNote}</span></p>
          <strong class="num" data-total>—</strong>
        </div>
        )}
        <div class="su-missing" data-missing hidden></div>
        <p class="su-submit-status" role="status" data-submit-status></p>
      </div>
      <div class="su-done" data-thanks hidden tabindex="-1">
        <span class="su-done-mark" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 22 22" fill="none"><path d="M5 11.5l4 4 8-9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </span>
        <h2>{t.doneTitle}</h2>
        <p>{t.doneBody}</p>
        <a class="su-btn" href="/portal/dashboard">{t.doneCta} <ArrowChip size={32} /></a>
      </div>
    </section>

    <nav class="su-nav" aria-label={t.title}>
      <button type="button" class="su-back" data-back>{t.back}</button>
      <p class="su-saved" role="status" data-save-status></p>
      <button type="button" class="su-btn" data-next>
        <span data-next-label>{t.next}</span>
        <ArrowChip size={32} />
      </button>
      <button type="button" class="su-btn" data-submit hidden>
        <span>{t.submit}</span>
        <ArrowChip size={32} />
      </button>
    </nav>
  </div>
</Portal>

<script>
  import { hasLivingArea, isLandOnly } from '~/lib/listing-catalogue';

  type Pricing = {
    packages: Record<string, { name: string; cents: number; aboveCents: number | null; threshold: number | null; video: string; phone: boolean }>;
    translationCents: number;
    categoryCents: number;
    homepageCents: number;
    videoCents: number;
    services: Record<string, { name: string; cents: number }>;
  };

  const root = document.querySelector<HTMLElement>('[data-setup]')!;
  const id = root.dataset.propertyId!;
  const lang = (root.dataset.lang === 'nl' || root.dataset.lang === 'en' ? root.dataset.lang : 'hu') as 'hu' | 'nl' | 'en';
  const steps = root.dataset.steps!.split(',');
  const free = root.dataset.free === 'yes';
  const s = JSON.parse(root.dataset.strings!);
  const pricing = JSON.parse(root.dataset.pricing!) as Pricing;
  const saveStatus = root.querySelector<HTMLElement>('[data-save-status]')!;
  const nextBtn = root.querySelector<HTMLButtonElement>('[data-next]')!;
  const backBtn = root.querySelector<HTMLButtonElement>('[data-back]')!;
  const submitBtn = root.querySelector<HTMLButtonElement>('[data-submit]')!;
  const form = (step: string) => root.querySelector<HTMLFormElement>(`[data-step-form="${step}"]`);
  const nf = new Intl.NumberFormat({ hu: 'hu-HU', nl: 'nl-NL', en: 'en-GB' }[lang]);
  const money = (cents: number) => `€ ${(cents / 100).toLocaleString('de-DE')}`;

  let lib: typeof import('~/lib/validation') | null = null;
  const loadLib = async () => (lib ??= await import('~/lib/validation'));
  /** The wording for this page's language: one small file, fetched on first use. */
  const wording = async () => {
    const [{ loadValidationCopy }, { errorMessageIn }] = await Promise.all([import('~/lib/validation-client'), import('~/lib/validation-messages')]);
    const copy = await loadValidationCopy(lang);
    return (error: never) => errorMessageIn(copy, error);
  };

  /* ── Steps ─────────────────────────────────────────────────────────── */

  const show = (step: string, focus = true) => {
    const at = Math.max(0, steps.indexOf(step));
    const name = steps[at];
    root.dataset.active = name;
    root.querySelector<HTMLElement>('[data-step-n]')!.textContent = String(at + 1);
    root.querySelector<HTMLElement>('[data-progress-bar]')!.style.transform = `scaleX(${(at + 1) / steps.length})`;
    root.querySelectorAll<HTMLElement>('[data-step-link]').forEach((a, i) => {
      a.toggleAttribute('aria-current', i === at);
      a.dataset.done = String(i < at);
    });
    backBtn.hidden = at === 0;
    nextBtn.hidden = name === 'review';
    submitBtn.hidden = name !== 'review';
    saveStatus.textContent = '';
    if (name === 'review') renderReview();
    if (focus) {
      const section = root.querySelector<HTMLElement>(`[data-step="${name}"]`)!;
      section.focus({ preventScroll: true });
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  };
  window.addEventListener('hashchange', () => show(location.hash.slice(1)));

  /* ── Validation (the same rules as every public form) ──────────────── */

  const fieldError = (control: HTMLElement) =>
    control.closest('.field, .fld')?.querySelector<HTMLElement>(':scope > .error');

  const checkable = (scope: HTMLElement) =>
    [...scope.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('input[name], textarea[name], select[name]')].filter(
      (control) => !control.disabled && !control.closest('[hidden]') && !['radio', 'checkbox', 'hidden'].includes(control.type)
    );

  /** Shows or clears one field's message from its current value; true when the value is acceptable. */
  const checkControl = (
    control: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement,
    validateField: typeof import('~/lib/validation').validateField,
    errorMessage: (error: never) => string
  ) => {
    const error = validateField(
      {
        rule: (control.dataset.rule as never) ?? 'text',
        required: control.required,
        min: control.dataset.min ? Number(control.dataset.min) : undefined,
        max: control.dataset.max ? Number(control.dataset.max) : undefined,
        maxLength: 'maxLength' in control && control.maxLength > 0 ? control.maxLength : undefined,
      },
      control.value
    );
    const el = fieldError(control);
    if (error) {
      control.setAttribute('aria-invalid', 'true');
      if (el) {
        el.textContent = errorMessage(error as never);
        el.hidden = false;
      }
    } else {
      control.removeAttribute('aria-invalid');
      if (el) el.hidden = true;
    }
    return !error;
  };

  async function validate(scope: HTMLElement): Promise<HTMLElement | null> {
    const [{ validateField }, errorMessage] = await Promise.all([loadLib(), wording()]);
    let first: HTMLElement | null = null;
    for (const control of checkable(scope)) if (!checkControl(control, validateField, errorMessage)) first ??= control;
    return first;
  }

  /**
   * Once a field shows a message it follows its value, like the other forms do (FormShell.astro).
   * The map, the geocoder and the pin set latitude and longitude from code and announce it with
   * one `change` on longitude, so every field in the step that is showing a message is looked at
   * again, not only the one the event came from.
   */
  async function revalidateShown(scope: HTMLElement) {
    const shown = checkable(scope).filter((control) => control.getAttribute('aria-invalid') === 'true');
    if (!shown.length) return;
    const [{ validateField }, errorMessage] = await Promise.all([loadLib(), wording()]);
    for (const control of shown) checkControl(control, validateField, errorMessage);
  }

  /** The server's own refusals, shown on the fields they belong to. */
  async function showServerErrors(scope: HTMLElement, errors: Record<string, { code: string }>) {
    const errorMessage = await wording();
    let first: HTMLElement | null = null;
    for (const [name, error] of Object.entries(errors)) {
      const control = scope.querySelector<HTMLElement>(`[name="${name}"]`);
      if (!control) continue;
      control.setAttribute('aria-invalid', 'true');
      const el = fieldError(control);
      if (el) {
        el.textContent = errorMessage(error as never);
        el.hidden = false;
      }
      first ??= control;
    }
    first?.focus();
  }

  /* ── Saving ────────────────────────────────────────────────────────── */

  async function saveNow(step: string, quiet = false): Promise<boolean> {
    const f = form(step);
    if (!f) return true;
    const body = new FormData(f);
    body.set('step', step);
    if(quiet)body.set('partial','yes');
    if (!quiet) saveStatus.textContent = s.saving;
    try {
      const res = await fetch(`/api/portal/properties/${id}/update`, { method: 'POST', headers: { Accept: 'application/json' }, body });
      const json = await res.json().catch(() => ({}));
      if (!res.ok || !json.ok) {
        if (!quiet && json.errors) await showServerErrors(f, json.errors);
        saveStatus.textContent = s.saveFailed;
        return false;
      }
      saveStatus.textContent = s.saved;
      return true;
    } catch {
      saveStatus.textContent = s.saveFailed;
      return false;
    }
  }

  const queuedSaves=new Map<string,Promise<boolean>>();
  const save=(step:string,quiet=false)=>{const previous=queuedSaves.get(step)||Promise.resolve(true);const next=previous.then(()=>saveNow(step,quiet),()=>saveNow(step,quiet));queuedSaves.set(step,next);return next;};

  // Autosave when a field is left — quietly, and only once something changed.
  let pending: number | undefined;
  root.querySelectorAll<HTMLFormElement>('[data-step-form]').forEach((f) => {
    f.addEventListener('input', () => void revalidateShown(f));
    f.addEventListener('change', () => {
      void revalidateShown(f);
      window.clearTimeout(pending);
      pending = window.setTimeout(() => void save(f.dataset.stepForm!, true), 400);
    });
    f.addEventListener('submit', (e) => e.preventDefault());
  });

  /** The billing step saves through its own form (BillingForm.astro). */
  const saveBilling = async () => {
    const billing = root.querySelector<HTMLFormElement>('form[data-billing]');
    if (!billing) return true;
    const invalid = (await (window as any).fodelValidateBilling?.(billing)) as HTMLElement | null;
    if (invalid) {
      invalid.focus();
      return false;
    }
    return new Promise<boolean>((resolve) => {
      const done = (ok: boolean) => () => resolve(ok);
      billing.addEventListener('billing:saved', done(true), { once: true });
      billing.addEventListener('billing:failed', done(false), { once: true });
      // requestSubmit (Safari 16+) runs the form's own submit handler; older
      // engines get the same event dispatched by hand.
      if (typeof billing.requestSubmit === 'function') billing.requestSubmit();
      else billing.dispatchEvent(new Event('submit', { cancelable: true }));
    });
  };

  nextBtn.addEventListener('click', async () => {
    const current = root.dataset.active!;
    const scope = root.querySelector<HTMLElement>(`[data-step="${current}"]`)!;
    window.clearTimeout(pending);
    nextBtn.disabled = true;
    try {
      const invalid = await validate(scope);
      if (invalid) {
        invalid.focus();
        return;
      }
      const ok = current === 'billing' ? await saveBilling() : await save(current);
      if (!ok) return;
      location.hash = steps[steps.indexOf(current) + 1];
    } finally {
      nextBtn.disabled = false;
    }
  });
  backBtn.addEventListener('click', () => {
    const at = steps.indexOf(root.dataset.active!);
    if (at > 0) location.hash = steps[at - 1];
  });

  /* ── Step 1: price estimate, video and phone follow the package ────── */

  const priceHuf = () => Number(form('property')?.dataset.priceHuf||0);
  const selectedPackage = () => (form('package')?.querySelector<HTMLInputElement>('input[name="package"]:checked')?.value ?? '');

  function estimate(): { cents: number; lines: string[] } {
    const f = form('package');
    const pkg = pricing.packages[selectedPackage()];
    if (!f || !pkg) return { cents: 0, lines: [] };
    const above = pkg.aboveCents !== null && pkg.threshold !== null && priceHuf() > pkg.threshold;
    let cents = above ? pkg.aboveCents! : pkg.cents;
    const lines = [pkg.name];
    const translations = f.querySelectorAll<HTMLInputElement>('input[name="translations"]:checked');
    if (translations.length) {
      cents += translations.length * pricing.translationCents;
      lines.push(`${s.translation} × ${translations.length}`);
    }
    const flag = (name: string) => Boolean(f.querySelector<HTMLInputElement>(`input[name="${name}"]`)?.checked);
    const add = (when: boolean, amount: number, label: string) => {
      if (!when) return;
      cents += amount;
      lines.push(label);
    };
    add(flag('categoryHighlight'), pricing.categoryCents, s.categoryHighlight);
    add(flag('homepageHighlight'), pricing.homepageCents, s.homepageHighlight);
    add(pkg.video === 'extra' && flag('video'), pricing.videoCents, s.video);
    const service = f.querySelector<HTMLInputElement>('input[name="service"]:checked')?.value ?? '';
    add(Boolean(pricing.services[service]), pricing.services[service]?.cents ?? 0, pricing.services[service]?.name ?? '');
    return { cents, lines };
  }

  function syncPackage() {
    const pkg = pricing.packages[selectedPackage()];
    const videoChip = root.querySelector<HTMLElement>('[data-video-chip]');
    if (videoChip) videoChip.hidden = pkg?.video !== 'extra';
    const contact = root.querySelector<HTMLElement>('[data-contact-choice]');
    const off = root.querySelector<HTMLElement>('[data-contact-off]');
    // A free listing has no package; the seller's phone choice is always offered.
    const phone = free || Boolean(pkg?.phone);
    if (contact) contact.hidden = !phone;
    if (off) off.hidden = phone;
    const total = money(estimate().cents);
    root.querySelectorAll<HTMLElement>('[data-total]').forEach((el) => (el.textContent = total));
  }
  form('package')?.addEventListener('change', syncPackage);
  form('property')?.addEventListener('change', syncPackage);
  form('property')?.addEventListener('listing:price',syncPackage);
  syncPackage();

  /* ── Step 3: character counter ─────────────────────────────────────── */

  const text = form('description')?.elements.namedItem('description') as HTMLTextAreaElement | null;
  const counter = root.querySelector<HTMLElement>('[data-counter]');
  text?.addEventListener('input', () => {
    if (counter) counter.textContent = nf.format(text.value.length);
  });

  /* ── Step 6: review and submit ─────────────────────────────────────── */

  const value = (step: string, name: string) => {
    const el = form(step)?.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | null;
    if (!el) return '';
    if (el instanceof HTMLSelectElement) return el.value ? el.selectedOptions[0]?.textContent?.trim() ?? '' : '';
    return el.value.trim();
  };
  const photoCount = () => Number(root.querySelector<HTMLElement>('[data-photo-count]')?.dataset.photoCount ?? 0);
  const billingName = () => (root.querySelector<HTMLFormElement>('form[data-billing]')?.elements.namedItem('name') as HTMLInputElement | null)?.value.trim() ?? '';

  /** [step, wording, the field to land on]. */
  function missing(): [string, string, string?][] {
    const list: [string, string, string?][] = [];
    if (!value('property','property_subtype') || !value('property','country') || !value('property','lat') || !value('property','lng') || !value('property','location_confirmed')) list.push(['property',s.missing.settlement]);
    if (!value('description','title')) list.push(['description',s.missing.description,'title']);
    if (!priceHuf()) list.push(['property', s.missing.price, 'original_price']);
    // The old upload form made these compulsory for a home; the editor marks them as required.
    const field = (name: string) => (form('property')?.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | null)?.value.trim() ?? '';
    const gaps = [
      ...(hasLivingArea(field('property_group'), field('property_subtype')) ? (['street', 'setting', 'floor_m2', 'floors', 'rooms', 'kitchens', 'toilets', 'bedrooms', 'bathrooms'] as const).filter((name) => !field(name)) : []),
      // Every property with a building says how it is heated ("no heating" is an answer).
      ...(!isLandOnly(field('property_group'), field('property_subtype')) && !field('heating_key') ? (['heating'] as const) : []),
    ];
    if (gaps.length) list.push(['property', `${s.missing.details}: ${gaps.map((name) => s.missing.fields[name]).join(', ')}`, gaps[0] === 'heating' ? 'heating_key' : gaps[0]]);
    if (!value('description', 'description')) list.push(['description', s.missing.description, 'description']);
    if (photoCount() < 1) list.push(['photos', s.missing.photos]);
    if (!free && !billingName()) list.push(['billing', s.missing.billing]);
    return list;
  }

  /** Open a step and land on one field, with a quiet ring so the eye finds it. */
  function goTo(step: string, name: string) {
    if (location.hash.slice(1) === step) show(step, false);
    else location.hash = step;
    window.setTimeout(() => {
      const control = form(step)?.elements.namedItem(name) as HTMLElement | null;
      if (!control || (control as HTMLInputElement).type === 'hidden') return;
      control.scrollIntoView({ block: 'center', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      control.focus({ preventScroll: true });
      control.classList.add('su-flash');
      window.setTimeout(() => control.classList.remove('su-flash'), 2400);
    }, 60);
  }

  function renderReview() {
    const put = (key: string, lines: string[]) => {
      const dd = root.querySelector<HTMLElement>(`[data-summary="${key}"]`)!;
      dd.textContent = '';
      const shown = lines.filter(Boolean);
      (shown.length ? shown : [s.none]).forEach((line) => {
        const span = document.createElement('span');
        span.textContent = line;
        dd.append(span);
      });
    };
    const est = estimate();
    if (!free) put('package', est.lines);
    put('property', [
      [value('property','property_subtype'),value('property','country'), value('property', 'settlement'), value('property', 'county')].filter(Boolean).join(', '),
      value('property','original_price') ? `${value('property','original_price')} ${value('property','original_currency')}` : '',
      [value('property', 'floor_m2') && `${value('property', 'floor_m2')} ${value('property','floor_m2_unit')}`, value('property', 'plot_m2') && `${value('property', 'plot_m2')} ${value('property','plot_m2_unit')}`].filter(Boolean).join(' · '),
    ]);
    const desc = value('description', 'description');
    put('description', [desc.length > 220 ? `${desc.slice(0, 220)}…` : desc]);
    put('photos', [photoCount() ? s.photosCount.replace('{n}', String(photoCount())) : '']);
    const b = root.querySelector<HTMLFormElement>('form[data-billing]');
    const bv = (n: string) => (b?.elements.namedItem(n) as HTMLInputElement | null)?.value.trim() ?? '';
    if (!free) put('billing', [bv('name'), [bv('postalCode'), bv('city'), bv('street')].filter(Boolean).join(' ')]);
    root.querySelectorAll<HTMLElement>('[data-total]').forEach((el) => (el.textContent = money(est.cents)));

    const gaps = missing();
    const box = root.querySelector<HTMLElement>('[data-missing]')!;
    box.hidden = gaps.length === 0;
    box.innerHTML = '';
    if (gaps.length) {
      const head = document.createElement('p');
      head.textContent = s.missingHead;
      const ul = document.createElement('ul');
      gaps.forEach(([step, label, name]) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `#${step}`;
        a.textContent = label;
        if (name) a.addEventListener('click', (e) => { e.preventDefault(); goTo(step, name); });
        li.append(a);
        ul.append(li);
      });
      box.append(head, ul);
    }
    submitBtn.disabled = gaps.length > 0;
  }

  submitBtn.addEventListener('click', async () => {
    const status = root.querySelector<HTMLElement>('[data-submit-status]')!;
    submitBtn.disabled = true;
    status.textContent = s.submitting;
    try {
      const res = await fetch(`/api/portal/properties/${id}/status`, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ action: 'submit' }),
      });
      const json = await res.json().catch(() => ({}));
      // 409 not-editable: the listing is already past draft, i.e. an earlier click (or a request whose
      // reply was lost) did submit it. Show the thank-you rather than an error for something that worked.
      const alreadySubmitted = res.status === 409 && json.error === 'not-editable';
      if (!alreadySubmitted && (!res.ok || !json.ok)) throw Object.assign(new Error(json.error ?? 'failed'), { fields: json.fields, detail: json.message, httpStatus: res.status });
      status.textContent = '';
      // Remove, rather than hide, everything but the thank-you panel: the review block, the step list
      // and the navigation each carry their own display rules, which beat the hidden attribute.
      // (Not [data-done]: the step links carry that, and the first of them matched here.)
      const done = root.querySelector<HTMLElement>('[data-thanks]')!;
      done.closest('.su-step')!.replaceChildren(done);
      root.querySelector('.su-nav')!.remove();
      root.querySelector('.su-steps')!.remove();
      done.hidden = false;
      done.focus();
      done.scrollIntoView({ block: 'start' });
    } catch (error) {
      const failure = error as Error & { fields?: (keyof typeof s.missing.fields)[]; detail?: string; httpStatus?: number };
      console.warn('[setup] submit failed', failure.httpStatus ?? '(no response)', error);
      status.textContent = failure.message === 'no-photos' ? s.noPhotos
        : failure.message === 'incomplete-details' && failure.fields?.length ? `${s.missing.details}: ${failure.fields.map((name) => s.missing.fields[name]).join(', ')}`
        : failure.message === 'placeholder' && failure.detail ? failure.detail
        : s.submitFailed;
      submitBtn.disabled = false;
    }
  });
  show(root.dataset.active ?? steps[0], false);
</script>

<style>
  .su { display: flex; flex-direction: column; gap: 0; width: 100%; }
