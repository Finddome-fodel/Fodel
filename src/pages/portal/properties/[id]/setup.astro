      required: 'Vul dit veld in.',
    };

const speakOptions = ['hu', 'nl', 'de', 'en', 'fr'] as const;
const billing = (billingRow as any)?.billing ?? null;

/** Everything the script needs to price and summarise, without a second request. */
const pricing = {
  packages: Object.fromEntries(
    catalog.packages.map((p) => [
      p.id,
      { name: p.names[lang], cents: p.priceEur * 100, aboveCents: p.priceEurAbove !== null ? p.priceEurAbove * 100 : null, threshold: p.thresholdHuf, video: p.video, phone: p.phone },
    ])
  ),
  translationCents: extra('translation').priceEur * 100,
  categoryCents: extra('category-highlight').priceEur * 100 * (extra('category-highlight').minMonths ?? 1),
  homepageCents: extra('homepage-highlight').priceEur * 100 * (extra('homepage-highlight').minMonths ?? 1),
  videoCents: extra('video').priceEur * 100,
  services: Object.fromEntries(ONSITE_SERVICES.map((s) => [s.id, { name: s.names[lang], cents: s.priceEur * 100 }])),
};
const strings = {
  saving: t.saving, saved: t.saved, saveFailed: t.saveFailed, required: t.required, none: t.none,
  submitting: t.submitting, submitFailed: t.submitFailed, noPhotos: t.noPhotos,
  missing: t.missing, missingHead: t.missingHead, photosCount: t.photosCount(0).replace('0', '{n}'),
  translation: t.translation, categoryHighlight: t.categoryHighlight, homepageHighlight: t.homepageHighlight, video: t.video,
};
---

<Portal title={t.title} bare wide lang={lang}>
  <div
    class="su"
    data-setup
    data-property-id={property.id}
    data-lang={lang}
    data-steps={STEPS.join(',')}
    data-strings={JSON.stringify(strings)}
    data-pricing={JSON.stringify(pricing)}
  >
    <script is:inline>
      // Before first paint: show one step, chosen by the hash, so the page
      // never flashes all six at once.
      (function () {
        var root = document.currentScript.parentElement;
        var steps = root.dataset.steps.split(',');
        var at = steps.indexOf(location.hash.slice(1));
        root.dataset.active = steps[at < 0 ? 0 : at];
        root.classList.add('js');
      })();
    </script>

    <header class="su-top">
      <Logo locale={lang} href="/portal/dashboard" />
      <a class="su-exit" href="/portal/dashboard">{t.saveExit}</a>
    </header>

    <div class="su-head">
      <p class="su-eyebrow">{t.eyebrow} · #{property.ref}</p>
      <div class="su-progress">
        <div class="su-bar" aria-hidden="true"><span data-progress-bar></span></div>
        <p class="su-count" aria-live="polite"><b data-step-n>1</b> / {STEPS.length} <span class="sr-only">{t.of}</span></p>
      </div>
      <ol class="su-steps">
        {STEPS.map((step, i) => (
          <li><a href={`#${step}`} data-step-link={step}><span class="n">{i + 1}</span><span class="l">{t.steps[i]}</span></a></li>
        ))}
      </ol>
    </div>

    {/* ── 1. Package ── */}
    <section class="su-step" id="package" data-step="package" aria-labelledby="h-package" tabindex="-1">
      <h1 id="h-package">{t.steps[0]}</h1>
      <p class="su-intro">{t.intros[0]}</p>
      <form data-step-form="package" id="su-package" novalidate>
        <div class="su-packages">
          {cards.map(({ pkg, card }) => (
            <PackageCard
              pkg={card}
              mode="select"
              radioName="package"
              checked={pkg.id === chosen.id}
              priceCents={card.priceCents}
              recommendedLabel={t.recommended}
            />
          ))}
        </div>

        <fieldset class="su-extras">
          <legend>{t.extrasHead}</legend>
          <p class="su-note">{t.extrasNote}</p>
          <div class="chips">
            {TRANSLATION_LANGUAGES.map((code) => (
              <label class="chip">
                <input type="checkbox" name="translations" value={code} checked={requested.translations?.includes(code)} />
                <span class="box" aria-hidden="true"></span>
                <span class="chip-name">{t.translation}: {LOCALE_META[code].label}</span>
                <span class="chip-price">€ {extra('translation').priceEur} {t.perLanguage}</span>
              </label>
            ))}
            <label class="chip">
              <input type="checkbox" name="categoryHighlight" value="yes" checked={requested.categoryHighlight} />
              <span class="box" aria-hidden="true"></span>
              <span class="chip-name">{t.categoryHighlight}</span>
              <span class="chip-price">€ {extra('category-highlight').priceEur} {t.perMonth} · {t.minMonths(extra('category-highlight').minMonths ?? 1)}</span>
            </label>
            <label class="chip">
              <input type="checkbox" name="homepageHighlight" value="yes" checked={requested.homepageHighlight} />
              <span class="box" aria-hidden="true"></span>
              <span class="chip-name">{t.homepageHighlight}</span>
              <span class="chip-price">€ {extra('homepage-highlight').priceEur} {t.perMonth} · {t.minMonths(extra('homepage-highlight').minMonths ?? 1)}</span>
            </label>
            <label class="chip" data-video-chip>
              <input type="checkbox" name="video" value="yes" checked={requested.video} />
              <span class="box" aria-hidden="true"></span>
              <span class="chip-name">{t.video}</span>
              <span class="chip-price">€ {extra('video').priceEur} {t.once}</span>
            </label>
          </div>
        </fieldset>

        <div class="su-onsite">
          <OnsiteServiceChoice locale={lang} selected={service} />
        </div>

        <div class="su-total" aria-live="polite">
          <p><span class="su-total-label">{t.total}</span><span class="su-total-note">{t.totalNote}</span></p>
          <strong class="num" data-total>—</strong>
        </div>
      </form>
    </section>

    {/* ── 2. The property ── */}
    <section class="su-step" id="property" data-step="property" aria-labelledby="h-property" tabindex="-1">
      <h1 id="h-property">{t.steps[1]}</h1>
      <p class="su-intro">{t.intros[1]}</p>
      <form data-step-form="property" novalidate class="su-grid">
        <Field locale={lang} name="category" label={t.category} type="select" required value={property.category} options={options('category', false)} />
        <div class="field fld span-full su-settlement">
          <label for="f-settlement">{t.settlement} <span class="req">({hu ? 'kötelező' : 'verplicht'})</span></label>
          <p class="hint" id="f-settlement-hint">{t.settlementHint}</p>
          <input id="f-settlement" name="settlement" required list="su-places" value={property.settlement} autocomplete="address-level2" enterkeyhint="next" maxlength="120" aria-describedby="f-settlement-hint f-settlement-error" data-label={t.settlement} />
          <datalist id="su-places"></datalist>
          <p class="error" id="f-settlement-error" hidden></p>
        </div>
        <Field locale={lang} name="county" label={t.county} type="select" required value={property.county} options={[{ value: '', label: '—' }, ...counties.map((c) => ({ value: c, label: c }))]} />
        <Field locale={lang} name="price_huf" label={t.price} type="number" required inputmode="numeric" hint={t.priceHint} value={blank(property.price_huf)} min={1000} />
        <Field locale={lang} name="floor_m2" label={t.floor} type="number" inputmode="decimal" hint={t.floorHint} value={blank(property.floor_m2)} span="half" min={1} />
        <Field locale={lang} name="plot_m2" label={t.plot} type="number" inputmode="decimal" hint={t.plotHint} value={blank(property.plot_m2)} span="half" min={1} />
        <Field locale={lang} name="condition_key" label={t.condition} type="select" value={property.condition_key ?? ''} options={options('condition', true)} span="half" />
        <Field locale={lang} name="heating_key" label={t.heating} type="select" value={property.heating_key ?? ''} options={options('heating', true)} span="half" />
        <Field locale={lang} name="wall_key" label={t.wall} type="select" hint={t.wallHint} value={property.wall_key ?? ''} options={options('wall', true)} />
        <Field
          locale={lang}
          name="precision"
          label={t.precision}
          type="select"
          hint={t.precisionHint}
          value={property.precision}
          options={[{ value: 'approximate', label: t.approx }, { value: 'exact', label: t.exact }]}
        />
      </form>
    </section>

    {/* ── 3. Description and contact ── */}
    <section class="su-step" id="description" data-step="description" aria-labelledby="h-description" tabindex="-1">
      <h1 id="h-description">{t.steps[2]}</h1>
      <p class="su-intro">{t.intros[2]}</p>
      <form data-step-form="description" novalidate>
        <aside class="su-good">
          <p class="su-good-head">{t.goodHead}</p>
          <ul>{t.good.map((line) => <li>{line}</li>)}</ul>
        </aside>
        <Field locale={lang} name="description" label={t.description} type="textarea" rows={10} required hint={t.descriptionHint} value={description} maxlength={DESCRIPTION_MAX} />
        <p class="su-counter num" aria-live="polite"><span data-counter>{description.length.toLocaleString(hu ? 'hu-HU' : 'nl-NL')}</span> / {DESCRIPTION_MAX.toLocaleString(hu ? 'hu-HU' : 'nl-NL')} {t.chars}</p>

        <fieldset class="su-fieldset">
          <legend>{t.speaks}</legend>
          <p class="su-note">{t.speaksHint}</p>
          <div class="chips">
            {speakOptions.map((code) => (
              <label class="chip">
                <input type="checkbox" name="seller_speaks" value={code} checked={property.seller_speaks.includes(code)} />
                <span class="box" aria-hidden="true"></span>
                <span class="chip-name">{LOCALE_META[code].label}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset class="su-fieldset" data-contact-choice>
          <legend>{t.contact}</legend>
          <p class="su-note">{t.contactHint}</p>
          <label class="su-radio"><input type="radio" name="contact" value="yes" checked={property.seller_contact_visible} /> {t.contactYes}</label>
          <label class="su-radio"><input type="radio" name="contact" value="no" checked={!property.seller_contact_visible} /> {t.contactNo}</label>
        </fieldset>
        <p class="su-note su-contact-off" data-contact-off>{t.contactNotInPackage}</p>
      </form>
    </section>

    {/* ── 4. Photos ── */}
    <section class="su-step" id="photos" data-step="photos" aria-labelledby="h-photos" tabindex="-1">
      <h1 id="h-photos">{t.steps[3]}</h1>
      <p class="su-intro">{t.intros[3]}</p>
      <div class="su-card">
        <PhotoUploader
          propertyId={property.id}
          media={property.media}
          photoLimit={packageOf(catalog, property.package).maxImages}
          packageName={packageOf(catalog, property.package).names[lang]}
          editable={true}
          isAdmin={isAdmin}
          locale={lang}
          withHeading={false}
        />
      </div>
    </section>

    {/* ── 5. Billing ── */}
    <section class="su-step" id="billing" data-step="billing" aria-labelledby="h-billing" tabindex="-1">
      <h1 id="h-billing">{t.steps[4]}</h1>
      <p class="su-intro">{t.intros[4]}</p>
      <div class="su-card">
        <BillingForm billing={billing} fallbackName={(billingRow as any)?.full_name ?? ''} fallbackPhone={(billingRow as any)?.phone ?? ''} locale={lang} embedded />
      </div>
    </section>

    {/* ── 6. Review ── */}
    <section class="su-step" id="review" data-step="review" aria-labelledby="h-review" tabindex="-1">
      <h1 id="h-review">{t.steps[5]}</h1>
      <p class="su-intro">{t.intros[5]}</p>
      <div class="su-review" data-review>
        <dl>
          {[
            ['package', t.reviewPackage],
            ['property', t.reviewProperty],
            ['description', t.reviewDescription],
            ['photos', t.reviewPhotos],
            ['billing', t.reviewBilling],
          ].map(([key, label]) => (
            <div class="su-row">
              <dt>{label}</dt>
              <dd data-summary={key}></dd>
              <a class="su-edit" href={`#${key}`}>{t.edit}<span class="sr-only">: {label}</span></a>
            </div>
          ))}
        </dl>
        <div class="su-total">
          <p><span class="su-total-label">{t.total}</span><span class="su-total-note">{t.totalNote}</span></p>
          <strong class="num" data-total>—</strong>
        </div>
        <div class="su-missing" data-missing hidden></div>
        <p class="su-submit-status" role="status" data-submit-status></p>
      </div>
      <div class="su-done" data-done hidden tabindex="-1">
        <span class="su-done-mark" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 22 22" fill="none"><path d="M5 11.5l4 4 8-9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </span>
        <h2>{t.doneTitle}</h2>
        <p>{t.doneBody}</p>
        <a class="su-btn" href="/portal/dashboard">{t.doneCta} <ArrowChip size={32} /></a>
      </div>
    </section>

    <nav class="su-nav" aria-label={t.title}>
      <button type="button" class="su-back" data-back>{t.back}</button>
      <p class="su-saved" role="status" data-save-status></p>
      <button type="button" class="su-btn" data-next>
        <span data-next-label>{t.next}</span>
        <ArrowChip size={32} />
      </button>
      <button type="button" class="su-btn" data-submit hidden>
        <span>{t.submit}</span>
        <ArrowChip size={32} />
      </button>
    </nav>
  </div>
</Portal>

<script>
  type Pricing = {
    packages: Record<string, { name: string; cents: number; aboveCents: number | null; threshold: number | null; video: string; phone: boolean }>;
    translationCents: number;
    categoryCents: number;
    homepageCents: number;
    videoCents: number;
    services: Record<string, { name: string; cents: number }>;
  };

  const root = document.querySelector<HTMLElement>('[data-setup]')!;
  const id = root.dataset.propertyId!;
  const lang = (root.dataset.lang === 'nl' ? 'nl' : 'hu') as 'hu' | 'nl';
  const steps = root.dataset.steps!.split(',');
  const s = JSON.parse(root.dataset.strings!);
  const pricing = JSON.parse(root.dataset.pricing!) as Pricing;
  const saveStatus = root.querySelector<HTMLElement>('[data-save-status]')!;
  const nextBtn = root.querySelector<HTMLButtonElement>('[data-next]')!;
  const backBtn = root.querySelector<HTMLButtonElement>('[data-back]')!;
  const submitBtn = root.querySelector<HTMLButtonElement>('[data-submit]')!;
  const form = (step: string) => root.querySelector<HTMLFormElement>(`[data-step-form="${step}"]`);
  const nf = new Intl.NumberFormat(lang === 'hu' ? 'hu-HU' : 'nl-NL');
  const money = (cents: number) => `€ ${(cents / 100).toLocaleString('de-DE')}`;

  let lib: typeof import('~/lib/validation') | null = null;
  const loadLib = async () => (lib ??= await import('~/lib/validation'));

  /* ── Steps ─────────────────────────────────────────────────────────── */

  const show = (step: string, focus = true) => {
    const at = Math.max(0, steps.indexOf(step));
    const name = steps[at];
    root.dataset.active = name;
    root.querySelector<HTMLElement>('[data-step-n]')!.textContent = String(at + 1);
    root.querySelector<HTMLElement>('[data-progress-bar]')!.style.transform = `scaleX(${(at + 1) / steps.length})`;
    root.querySelectorAll<HTMLElement>('[data-step-link]').forEach((a, i) => {
      a.toggleAttribute('aria-current', i === at);
      a.dataset.done = String(i < at);
    });
    backBtn.hidden = at === 0;
    nextBtn.hidden = name === 'review';
    submitBtn.hidden = name !== 'review';
    saveStatus.textContent = '';
    if (name === 'review') renderReview();
    if (focus) {
      const section = root.querySelector<HTMLElement>(`[data-step="${name}"]`)!;
      section.focus({ preventScroll: true });
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  };
  window.addEventListener('hashchange', () => show(location.hash.slice(1)));
  show(root.dataset.active ?? steps[0], false);

  /* ── Validation (the same rules as every public form) ──────────────── */

  const fieldError = (control: HTMLElement) =>
    control.closest('.field, .fld')?.querySelector<HTMLElement>(':scope > .error');

  async function validate(scope: HTMLElement): Promise<HTMLElement | null> {
    const { validateField, errorMessage } = await loadLib();
    let first: HTMLElement | null = null;
    scope.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('input[name], textarea[name], select[name]').forEach((control) => {
      if (control.type === 'radio' || control.type === 'checkbox' || control.type === 'hidden') return;
      const error = validateField(
        {
          rule: (control.dataset.rule as never) ?? 'text',
          required: control.required,
          min: control.dataset.min ? Number(control.dataset.min) : undefined,
          max: control.dataset.max ? Number(control.dataset.max) : undefined,
          maxLength: 'maxLength' in control && control.maxLength > 0 ? control.maxLength : undefined,
        },
        control.value
      );
      const el = fieldError(control);
      if (error) {
        control.setAttribute('aria-invalid', 'true');
        if (el) {
          el.textContent = errorMessage(error, lang);
          el.hidden = false;
        }
        first ??= control;
      } else {
        control.removeAttribute('aria-invalid');
        if (el) el.hidden = true;
      }
    });
    return first;
  }

  /** The server's own refusals, shown on the fields they belong to. */
  async function showServerErrors(scope: HTMLElement, errors: Record<string, { code: string }>) {
    const { errorMessage } = await loadLib();
    let first: HTMLElement | null = null;
    for (const [name, error] of Object.entries(errors)) {
      const control = scope.querySelector<HTMLElement>(`[name="${name}"]`);
      if (!control) continue;
      control.setAttribute('aria-invalid', 'true');
      const el = fieldError(control);
      if (el) {
        el.textContent = errorMessage(error as never, lang);
        el.hidden = false;
      }
      first ??= control;
    }
    first?.focus();
  }

  /* ── Saving ────────────────────────────────────────────────────────── */

  async function save(step: string, quiet = false): Promise<boolean> {
    const f = form(step);
    if (!f) return true;
    const body = new FormData(f);
    body.set('step', step);
    if (!quiet) saveStatus.textContent = s.saving;
    try {
      const res = await fetch(`/api/portal/properties/${id}/update`, { method: 'POST', headers: { Accept: 'application/json' }, body });
      const json = await res.json().catch(() => ({}));
      if (!res.ok || !json.ok) {
        if (json.errors) await showServerErrors(f, json.errors);
        saveStatus.textContent = s.saveFailed;
        return false;
      }
      saveStatus.textContent = s.saved;
      return true;
    } catch {
      saveStatus.textContent = s.saveFailed;
      return false;
    }
  }

  // Autosave when a field is left — quietly, and only once something changed.
  let pending: number | undefined;
  root.querySelectorAll<HTMLFormElement>('[data-step-form]').forEach((f) => {
    f.addEventListener('change', () => {
      window.clearTimeout(pending);
      pending = window.setTimeout(() => void save(f.dataset.stepForm!, true), 400);
    });
    f.addEventListener('submit', (e) => e.preventDefault());
  });

  /** The billing step saves through its own form (BillingForm.astro). */
  const saveBilling = () =>
    new Promise<boolean>((resolve) => {
      const billing = root.querySelector<HTMLFormElement>('form[data-billing]');
      if (!billing) return resolve(true);
      const invalid = (window as any).fodelValidateBilling?.(billing) as HTMLElement | null;
      if (invalid) {
        invalid.focus();
        return resolve(false);
      }
      const done = (ok: boolean) => () => resolve(ok);
      billing.addEventListener('billing:saved', done(true), { once: true });
      billing.addEventListener('billing:failed', done(false), { once: true });
      // requestSubmit (Safari 16+) runs the form's own submit handler; older
      // engines get the same event dispatched by hand.
      if (typeof billing.requestSubmit === 'function') billing.requestSubmit();
      else billing.dispatchEvent(new Event('submit', { cancelable: true }));
    });

  nextBtn.addEventListener('click', async () => {
    const current = root.dataset.active!;
    const scope = root.querySelector<HTMLElement>(`[data-step="${current}"]`)!;
    window.clearTimeout(pending);
    nextBtn.disabled = true;
    try {
      const invalid = await validate(scope);
      if (invalid) {
        invalid.focus();
        return;
      }
      const ok = current === 'billing' ? await saveBilling() : await save(current);
      if (!ok) return;
      location.hash = steps[steps.indexOf(current) + 1];
    } finally {
      nextBtn.disabled = false;
    }
  });
  backBtn.addEventListener('click', () => {
    const at = steps.indexOf(root.dataset.active!);
    if (at > 0) location.hash = steps[at - 1];
  });

  /* ── Step 1: price estimate, video and phone follow the package ────── */

  const priceHuf = () => {
    const raw = (form('property')?.elements.namedItem('price_huf') as HTMLInputElement | null)?.value ?? '';
    const digits = raw.replace(/[^\d]/g, '');
    return digits ? Number(digits) : 0;
  };
  const selectedPackage = () => (form('package')?.querySelector<HTMLInputElement>('input[name="package"]:checked')?.value ?? '');

  function estimate(): { cents: number; lines: string[] } {
    const f = form('package');
    const pkg = pricing.packages[selectedPackage()];
    if (!f || !pkg) return { cents: 0, lines: [] };
    const above = pkg.aboveCents !== null && pkg.threshold !== null && priceHuf() > pkg.threshold;
    let cents = above ? pkg.aboveCents! : pkg.cents;
    const lines = [pkg.name];
    const translations = f.querySelectorAll<HTMLInputElement>('input[name="translations"]:checked');
    if (translations.length) {
      cents += translations.length * pricing.translationCents;
      lines.push(`${s.translation} × ${translations.length}`);
    }
    const flag = (name: string) => Boolean(f.querySelector<HTMLInputElement>(`input[name="${name}"]`)?.checked);
    const add = (when: boolean, amount: number, label: string) => {
      if (!when) return;
      cents += amount;
      lines.push(label);
    };
    add(flag('categoryHighlight'), pricing.categoryCents, s.categoryHighlight);
    add(flag('homepageHighlight'), pricing.homepageCents, s.homepageHighlight);
    add(pkg.video === 'extra' && flag('video'), pricing.videoCents, s.video);
    const service = f.querySelector<HTMLInputElement>('input[name="service"]:checked')?.value ?? '';
    add(Boolean(pricing.services[service]), pricing.services[service]?.cents ?? 0, pricing.services[service]?.name ?? '');
    return { cents, lines };
  }

  function syncPackage() {
    const pkg = pricing.packages[selectedPackage()];
    const videoChip = root.querySelector<HTMLElement>('[data-video-chip]');
    if (videoChip) videoChip.hidden = pkg?.video !== 'extra';
    const contact = root.querySelector<HTMLElement>('[data-contact-choice]');
    const off = root.querySelector<HTMLElement>('[data-contact-off]');
    if (contact) contact.hidden = !pkg?.phone;
    if (off) off.hidden = Boolean(pkg?.phone);
    const total = money(estimate().cents);
    root.querySelectorAll<HTMLElement>('[data-total]').forEach((el) => (el.textContent = total));
  }
  form('package')?.addEventListener('change', syncPackage);
  form('property')?.addEventListener('change', syncPackage);
  syncPackage();

  /* ── Step 2: settlement list and county, price grouping ────────────── */

  type Place = [string, string, string, number];
  let places: Place[] = [];
  const settlement = root.querySelector<HTMLInputElement>('#f-settlement');
  settlement?.addEventListener(
    'focus',
    async () => {
      try {
        const res = await fetch('/data/telepulesek.json');
        places = await res.json();
        root.querySelector('#su-places')!.innerHTML = places
          .filter((p) => p[3] !== 0)
          .map((p) => `<option value="${p[1].replaceAll('&', '&amp;').replaceAll('"', '&quot;')}"></option>`)
          .join('');
      } catch {
        /* free text still works */
      }
    },
    { once: true }
  );
  settlement?.addEventListener('change', () => {
    const match = places.find((p) => p[3] !== 0 && p[1].localeCompare(settlement.value.trim(), 'hu', { sensitivity: 'base' }) === 0);
    const county = places.find((p) => p[3] === 0 && p[0] === match?.[2])?.[1].replace(/ vármegye$/, '');
    const select = form('property')?.elements.namedItem('county') as HTMLSelectElement | null;
    if (match) settlement.value = match[1];
    if (county && select && [...select.options].some((o) => o.value === county)) select.value = county;
  });
  const price = form('property')?.elements.namedItem('price_huf') as HTMLInputElement | null;
  price?.addEventListener('blur', () => {
    const digits = price.value.replace(/[^\d]/g, '');
    if (digits) price.value = nf.format(Number(digits));
  });

  /* ── Step 3: character counter ─────────────────────────────────────── */

  const text = form('description')?.elements.namedItem('description') as HTMLTextAreaElement | null;
  const counter = root.querySelector<HTMLElement>('[data-counter]');
  text?.addEventListener('input', () => {
    if (counter) counter.textContent = nf.format(text.value.length);
  });

  /* ── Step 6: review and submit ─────────────────────────────────────── */

  const value = (step: string, name: string) => {
    const el = form(step)?.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | null;
    if (!el) return '';
    if (el instanceof HTMLSelectElement) return el.value ? el.selectedOptions[0]?.textContent?.trim() ?? '' : '';
    return el.value.trim();
  };
  const photoCount = () => Number(root.querySelector<HTMLElement>('[data-photo-count]')?.dataset.photoCount ?? 0);
  const billingName = () => (root.querySelector<HTMLFormElement>('form[data-billing]')?.elements.namedItem('name') as HTMLInputElement | null)?.value.trim() ?? '';

  function missing(): [string, string][] {
    const list: [string, string][] = [];
    if (!value('property', 'settlement')) list.push(['property', s.missing.settlement]);
    if (!priceHuf()) list.push(['property', s.missing.price]);
    if (!value('description', 'description')) list.push(['description', s.missing.description]);
    if (photoCount() < 1) list.push(['photos', s.missing.photos]);
    if (!billingName()) list.push(['billing', s.missing.billing]);
    return list;
  }

  function renderReview() {
    const put = (key: string, lines: string[]) => {
      const dd = root.querySelector<HTMLElement>(`[data-summary="${key}"]`)!;
      dd.textContent = '';
      const shown = lines.filter(Boolean);
      (shown.length ? shown : [s.none]).forEach((line) => {
        const span = document.createElement('span');
        span.textContent = line;
        dd.append(span);
      });
    };
    const est = estimate();
    put('package', est.lines);
    put('property', [
      [value('property', 'category'), value('property', 'settlement'), value('property', 'county')].filter(Boolean).join(', '),
      priceHuf() ? `${nf.format(priceHuf())} Ft` : '',
      [value('property', 'floor_m2') && `${value('property', 'floor_m2')} m²`, value('property', 'plot_m2') && `${value('property', 'plot_m2')} m²`].filter(Boolean).join(' · '),
    ]);
    const desc = value('description', 'description');
    put('description', [desc.length > 220 ? `${desc.slice(0, 220)}…` : desc]);
    put('photos', [photoCount() ? s.photosCount.replace('{n}', String(photoCount())) : '']);
    const b = root.querySelector<HTMLFormElement>('form[data-billing]');
    const bv = (n: string) => (b?.elements.namedItem(n) as HTMLInputElement | null)?.value.trim() ?? '';
    put('billing', [bv('name'), [bv('postalCode'), bv('city'), bv('street')].filter(Boolean).join(' ')]);
    root.querySelectorAll<HTMLElement>('[data-total]').forEach((el) => (el.textContent = money(est.cents)));

    const gaps = missing();
    const box = root.querySelector<HTMLElement>('[data-missing]')!;
    box.hidden = gaps.length === 0;
    box.innerHTML = '';
    if (gaps.length) {
      const head = document.createElement('p');
      head.textContent = s.missingHead;
      const ul = document.createElement('ul');
      gaps.forEach(([step, label]) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `#${step}`;
        a.textContent = label;
        li.append(a);
        ul.append(li);
      });
      box.append(head, ul);
    }
    submitBtn.disabled = gaps.length > 0;
  }

  submitBtn.addEventListener('click', async () => {
    const status = root.querySelector<HTMLElement>('[data-submit-status]')!;
    submitBtn.disabled = true;
    status.textContent = s.submitting;
    try {
      const res = await fetch(`/api/portal/properties/${id}/status`, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ action: 'submit' }),
      });
      const json = await res.json().catch(() => ({}));
      if (!res.ok || !json.ok) throw new Error(json.error ?? 'failed');
      status.textContent = '';
      root.querySelector<HTMLElement>('[data-review]')!.hidden = true;
      root.querySelector<HTMLElement>('.su-nav')!.hidden = true;
      root.querySelector<HTMLElement>('.su-steps')!.hidden = true;
      const done = root.querySelector<HTMLElement>('[data-done]')!;
      done.hidden = false;
      done.focus();
    } catch (error) {
      status.textContent = (error as Error).message === 'no-photos' ? s.noPhotos : s.submitFailed;
      submitBtn.disabled = false;
    }
  });
</script>

<style>
  .su { display: flex; flex-direction: column; gap: 0; width: 100%; }
  .su-top { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 8px 4px 28px; }
  .su-exit { display: inline-flex; align-items: center; min-height: 44px; padding: 0 18px; border-radius: var(--r-pill); font-size: 14.5px; font-weight: var(--fw-medium); color: var(--ink); text-decoration: none; background: var(--white); box-shadow: var(--shadow-xs), 0 0 0 1px var(--pt-hair); }
  .su-exit:focus-visible { outline: var(--focus-ring); outline-offset: 3px; }

  .su-head { margin-bottom: 28px; }
  .su-eyebrow { font-size: 13px; letter-spacing: 0.04em; color: var(--ink-quiet); margin-bottom: 14px; }
  .su-progress { display: flex; align-items: center; gap: 16px; }
  .su-bar { flex: 1; height: 6px; border-radius: var(--r-pill); background: rgba(16, 42, 67, 0.08); overflow: hidden; }
  .su-bar span { display: block; height: 100%; border-radius: inherit; background: var(--ink); transform-origin: left; transform: scaleX(0.1667); transition: transform 0.6s var(--ease-out); }
  .su-count { font-size: 14px; color: var(--ink-quiet); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .su-count b { color: var(--ink); font-weight: var(--fw-medium); }
  .su-steps { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 16px; list-style: none; }
  .su-steps a { display: inline-flex; align-items: center; gap: 8px; min-height: 36px; padding: 4px 14px 4px 5px; border-radius: var(--r-pill); font-size: 13.5px; color: var(--ink-quiet); text-decoration: none; transition: background-color 0.25s var(--ease-out), color 0.25s var(--ease-out); }
  .su-steps .n { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: var(--white); box-shadow: 0 0 0 1px var(--pt-hair); font-size: 12px; font-variant-numeric: tabular-nums; }
  .su-steps a[data-done='true'] .n { background: rgba(16, 42, 67, 0.12); box-shadow: none; color: var(--ink); }
  .su-steps a[aria-current] { background: var(--white); color: var(--ink); font-weight: var(--fw-medium); box-shadow: var(--shadow-xs), 0 0 0 1px var(--pt-hair); }
  .su-steps a[aria-current] .n { background: var(--ink); color: var(--cream); box-shadow: none; }
  .su-steps a:focus-visible { outline: var(--focus-ring); outline-offset: 2px; }
  @media (hover: hover) { .su-steps a:hover { color: var(--ink); } }
  @media (max-width: 760px) { .su-steps .l { display: none; } .su-steps a[aria-current] .l { display: inline; } }

  /* One step at a time once the script runs; without it every step stacks. */
