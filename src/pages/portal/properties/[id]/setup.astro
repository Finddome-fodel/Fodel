  .chip input { position: absolute; opacity: 0; width: 1px; height: 1px; pointer-events: none; }
  .box { position: relative; display: grid; place-items: center; flex-shrink: 0; width: 28px; height: 28px; border-radius: 50%; background: rgba(16, 42, 67, 0.07); transition: background-color 0.3s var(--ease-out); }
  .box::after { content: ''; width: 9px; height: 5px; margin-top: -2px; border-left: 1.6px solid var(--ink); border-bottom: 1.6px solid var(--ink); transform: rotate(-45deg) scale(0); transition: transform 0.35s var(--ease-out); }
  .chip:has(input:checked) { background: var(--ink); border-color: var(--ink); }
  .chip:has(input:checked) .box { background: var(--cream); }
  .chip:has(input:checked) .box::after { transform: rotate(-45deg) scale(1); }
  .chip:has(input:checked) :is(.chip-name, .chip-price) { color: var(--cream); }
  .chip:has(input:focus-visible) { outline: var(--focus-ring); outline-offset: 3px; }
  .chip-name { font-size: var(--fs-small); font-weight: var(--fw-medium); color: var(--ink); }
  .chip-price { font-size: 13px; color: var(--ink-quiet); white-space: nowrap; }

  .su-total { display: flex; justify-content: space-between; align-items: center; gap: 24px; padding: 20px 26px; border-radius: var(--r-xl); background: var(--white); box-shadow: var(--shadow-sm), 0 0 0 1px var(--pt-hair); }
  .su-total p { display: flex; flex-direction: column; gap: 3px; }
  .su-total-label { font-size: var(--fs-body); font-weight: var(--fw-medium); color: var(--ink); }
  .su-total-note { font-size: 13px; line-height: 1.5; color: var(--ink-quiet); max-width: 52ch; }
  .su-total strong { flex-shrink: 0; font-family: var(--serif); font-weight: var(--fw-medium); font-size: clamp(26px, 3vw, 34px); letter-spacing: -0.02em; color: var(--ink); }
  @media (max-width: 520px) { .su-total { flex-direction: column; align-items: flex-start; gap: 10px; } }

  .su-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 18px; }
  @media (max-width: 620px) { .su-grid { grid-template-columns: 1fr; } .su-grid :global(.fld.span-half) { grid-column: 1 / -1; } }
  .su-settlement datalist { display: none; }

  .su-good { margin-bottom: 22px; padding: 18px 22px; border-radius: var(--r-lg); background: rgba(16, 42, 67, 0.04); }
  .su-good-head { font-weight: var(--fw-medium); color: var(--ink); margin-bottom: 8px; }
  .su-good ul { display: grid; gap: 4px; padding-left: 18px; font-size: 14.5px; line-height: 1.6; color: var(--ink-quiet); }
  .su-counter { margin: -10px 0 26px; font-size: 13px; color: var(--ink-quiet); text-align: right; }
  .su-radio { display: flex; align-items: center; gap: 12px; min-height: 48px; padding: 10px 16px; margin-bottom: 8px; border-radius: var(--r-md); background: var(--white); box-shadow: 0 0 0 1px var(--pt-hair); font-size: var(--fs-small); color: var(--ink); cursor: pointer; }
  .su-radio:has(input:checked) { box-shadow: 0 0 0 2px var(--ink); }
  .su-radio input { width: 18px; height: 18px; accent-color: var(--ink); }
  .su-contact-off[hidden] { display: none; }

  .su-review dl { display: grid; gap: 2px; margin-bottom: 16px; border-radius: var(--r-xl); overflow: hidden; box-shadow: 0 0 0 1px var(--pt-hair); }
  .su-row { display: grid; grid-template-columns: 170px minmax(0, 1fr) auto; gap: 8px 20px; align-items: start; padding: 18px 22px; background: var(--white); }
  .su-row dt { font-size: 14px; color: var(--ink-quiet); }
  .su-row dd { display: grid; gap: 2px; font-size: var(--fs-small); color: var(--ink); overflow-wrap: anywhere; }
  .su-edit { font-size: 14px; font-weight: var(--fw-medium); color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 620px) { .su-row { grid-template-columns: minmax(0, 1fr) auto; } .su-row dd { grid-column: 1 / -1; grid-row: 2; } }
  .su-missing { margin-top: 14px; padding: 14px 18px; border-radius: var(--r-md); background: var(--pt-amber-bg); color: var(--pt-amber); font-size: 14.5px; }
  .su-missing :global(ul) { margin-top: 4px; padding-left: 18px; }
  .su-missing :global(a) { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  .su-missing[hidden] { display: none; }
  .su-submit-status { min-height: 1.4em; margin-top: 12px; font-size: 14px; color: var(--ink-quiet); }

  .su-done { padding: clamp(28px, 4vw, 44px); border-radius: var(--r-xl); background: var(--white); box-shadow: var(--shadow-md); }
