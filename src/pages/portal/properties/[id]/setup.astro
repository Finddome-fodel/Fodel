  .su-bar { flex: 1; height: 6px; border-radius: var(--r-pill); background: rgba(16, 42, 67, 0.08); overflow: hidden; }
  .su-bar span { display: block; height: 100%; border-radius: inherit; background: var(--ink); transform-origin: left; transform: scaleX(0.1667); transition: transform 0.6s var(--ease-out); }
  .su-count { font-size: 14px; color: var(--ink-quiet); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .su-count b { color: var(--ink); font-weight: var(--fw-medium); }
  .su-steps { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 16px; list-style: none; }
  .su-steps a { display: inline-flex; align-items: center; gap: 8px; min-height: 36px; padding: 4px 14px 4px 5px; border-radius: var(--r-pill); font-size: 13.5px; color: var(--ink-quiet); text-decoration: none; transition: background-color 0.25s var(--ease-out), color 0.25s var(--ease-out); }
  .su-steps .n { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: var(--white); box-shadow: 0 0 0 1px var(--pt-hair); font-size: 12px; font-variant-numeric: tabular-nums; }
  .su-steps a[data-done='true'] .n { background: rgba(16, 42, 67, 0.12); box-shadow: none; color: var(--ink); }
  .su-steps a[aria-current] { background: var(--white); color: var(--ink); font-weight: var(--fw-medium); box-shadow: var(--shadow-xs), 0 0 0 1px var(--pt-hair); }
  .su-steps a[aria-current] .n { background: var(--ink); color: var(--cream); box-shadow: none; }
  .su-steps a:focus-visible { outline: var(--focus-ring); outline-offset: 2px; }
  @media (hover: hover) { .su-steps a:hover { color: var(--ink); } }
  @media (max-width: 760px) { .su-steps .l { display: none; } .su-steps a[aria-current] .l { display: inline; } }

  /* One step at a time once the script runs; without it every step stacks. */
  .su.js .su-step { display: none; }
  .su.js[data-active='package'] [data-step='package'],
  .su.js[data-active='property'] [data-step='property'],
  .su.js[data-active='description'] [data-step='description'],
  .su.js[data-active='photos'] [data-step='photos'],
  .su.js[data-active='billing'] [data-step='billing'],
  .su.js[data-active='review'] [data-step='review'] { display: block; animation: su-in 0.5s var(--ease-out) both; }
  @keyframes su-in { from { opacity: 0; transform: translateY(10px); } }
  .su-step { scroll-margin-top: 24px; }
  .su-step:focus { outline: none; }
  .su-step h1 { font-family: var(--serif); font-weight: var(--fw-display); font-size: clamp(28px, 4vw, 40px); letter-spacing: var(--ls-heading); line-height: 1.12; color: var(--ink); margin-bottom: 10px; }
  .su-intro { max-width: 60ch; font-size: var(--fs-body); line-height: 1.6; color: var(--ink-quiet); margin-bottom: 28px; }
  .su :global(.su-flash) { outline: var(--focus-ring); outline-offset: 3px; border-radius: 10px; }
  .su-note { font-size: 14px; line-height: 1.6; color: var(--ink-quiet); margin-bottom: 14px; max-width: 64ch; }
  .su-note[hidden] { display: none; }
  .su-card { padding: clamp(20px, 3vw, 32px); border-radius: var(--r-xl); background: var(--white); box-shadow: var(--shadow-xs), 0 0 0 1px var(--pt-hair); }

  .su-packages { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin-bottom: 28px; }
  @media (max-width: 760px) { .su-packages { grid-template-columns: 1fr; } }
  .su-extras, .su-fieldset { border: 0; padding: 0; margin: 0 0 24px; min-width: 0; }
  .su-extras legend, .su-fieldset legend { font-family: var(--serif); font-weight: var(--fw-medium); font-size: 20px; color: var(--ink); margin-bottom: 6px; }
  .su-fieldset[hidden] { display: none; }
  .su-onsite { margin-bottom: 24px; padding: clamp(20px, 3vw, 28px); border-radius: var(--r-xl); background: var(--white); box-shadow: 0 0 0 1px var(--pt-hair); }

  /* Extras: pills that fill when chosen, with a drawn tick. */
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { position: relative; display: flex; align-items: center; gap: 10px; min-height: 48px; padding: 8px 18px 8px 10px; border-radius: var(--r-pill); background: var(--white); border: 1px solid rgba(16, 42, 67, 0.12); cursor: pointer; transition: border-color 0.3s var(--ease-out), background-color 0.3s var(--ease-out); }
