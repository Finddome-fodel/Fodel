      reviewPackage: 'Pakket',
      reviewProperty: 'De woning',
      reviewDescription: 'Omschrijving',
      reviewPhotos: 'Foto’s',
      reviewBilling: 'Facturering',
      edit: 'Wijzigen',
      none: 'Niet ingevuld',
      photosCount: (n: number) => `${n} foto’s`,
      missingHead: 'Om in te dienen ontbreekt nog:',
      missing: {
        photos: 'minstens één foto',
        price: 'de vraagprijs',
        settlement: 'de plaats',
        description: 'de omschrijving',
        billing: 'de factuurgegevens',
      },
      submit: 'Indienen voor beoordeling',
      submitting: 'Indienen…',
      submitFailed: 'Indienen is niet gelukt. Probeer het opnieuw.',
      noPhotos: 'Upload minstens één foto voordat u indient.',
