---
/**
 * Property editor — one long sectioned form, not tabs (per the build plan:
 * friendlier for a non-technical Hungarian seller, simpler to build).
 * Sections: basics · location · details · features · media · translations.
 *
 * Saving here only ever touches field values. Moving the listing through the
 * workflow (submit for review, approve, request changes, mark sold) is a
 * separate action with its own endpoint — see /api/portal/properties/[id]/status.ts
 * (Stage 4) — so "save my edits" and "change what state this listing is in"
 * can never be accidentally conflated in one submit.
 */
export const prerender = false;

import Portal from '~/layouts/Portal.astro';
import ListingFields from '~/components/portal/ListingFields.astro';
import { HEARD_FROM, GAP_LABELS } from '~/lib/listing-details';
import PromotionChoices from '~/components/portal/PromotionChoices.astro';
import ContactLanguages from '~/components/portal/ContactLanguages.astro';
import Field from '~/components/forms/Field.astro';
import PhotoUploader from '~/components/portal/PhotoUploader.astro';
import { ONSITE_SERVICES } from '~/config/company';
import { serviceName, servicePrice, SERVICE_STATUS_LABEL, type ServiceStatus } from '~/lib/portal/service-requests';
import { getProperty, STATUS_LABEL, LOCALE_OPTIONS, OWNER_EDITABLE } from '~/lib/portal/properties';
import { getTaxonomy, getCompany } from '~/lib/runtime-config';
import { formatCents, type OrderLine } from '~/lib/orders';
import { eur } from '~/lib/format';
import { isStripeEnabled } from '~/lib/stripe';
import { isAiEnabled } from '~/lib/ai/client';
import { COMPANY } from '~/config/company';
import { listingCatalog, packageOf } from '~/lib/listing-packages';
import BillingForm from '~/components/BillingForm.astro';
import { billingComplete } from '~/lib/invoicing/model';
import { SITE_HOST } from '~/config/site.mjs';
import { listingRules, daysLeft, isUnresponsive } from '~/lib/listing-rules';

const { supabase, profile, user } = Astro.locals;
const { id } = Astro.params;
const isAdmin = profile?.role === 'admin';

const property = await getProperty(supabase, id!);
if (!property) {
  return new Response('Ingatlan nem található, vagy nincs hozzáférése.', { status: 404 });
}
const isOwnProperty = property.owner_id === user?.id;
if (!isAdmin && !isOwnProperty) {
  return new Response('Nincs hozzáférése ehhez az ingatlanhoz.', { status: 403 });
}


// Everything the page reads besides the listing itself is independent, so it
// is fetched together: one round trip to the database instead of six.
const needsNote = property.status === 'changes_requested' || property.status === 'rejected';
const [taxonomy, suggestionsResult, notesResult, orderResult, company, serviceResult] = await Promise.all([
  getTaxonomy(),
  supabase.from('ai_suggestions').select('id, locale, suggested, issues').eq('property_id', id).eq('status', 'pending'),
  needsNote
    ? supabase.from('review_notes').select('note, created_at').eq('property_id', property.id).order('created_at', { ascending: false }).limit(1)
    : Promise.resolve({ data: null }),
  // What is outstanding on this listing, if anything.
  supabase.from('payments').select('id, amount_cents, line_items, status').eq('property_id', property.id).in('status', ['pending', 'paid', 'manual']).order('created_at', { ascending: false }).limit(1).maybeSingle(),
  getCompany(),
  // The on-site service for this listing, if one is open (0015). A read error
  // (migration not yet run) simply hides the section's status.
  supabase.from('service_requests').select('id, service_id, status, scheduled_for').eq('property_id', property.id).in('status', ['requested', 'scheduled']).order('created_at', { ascending: false }).limit(1).maybeSingle(),
]);
const editable = isAdmin || OWNER_EDITABLE.includes(property.status);

const saved = Astro.url.searchParams.get('saved') === '1';
const err = Astro.url.searchParams.get('error');
const payment = Astro.url.searchParams.get('payment');

const trByLocale = Object.fromEntries(property.translations.map((t) => [t.locale, t]));

const suggestionByLocale = Object.fromEntries((suggestionsResult.data ?? []).map((s) => [s.locale, s]));

/** The description an owner wrote for a photo. Empty until they fill it in. */
const captionOf = (m: (typeof property.media)[number]) =>
  (m.alt as Record<string, string> | null)?.hu ?? '';

// Why the listing was sent back — the owner can read it back since migration 0005.
const latestNote = notesResult.data?.[0] ?? null;

const order = orderResult.data;
const awaitingPayment = property.status === 'awaiting_payment';
// The details the invoice will carry: what was saved on the order, else on the account.
// Read separately and tolerantly: the columns arrive with migration 0018 and the
// payment panel must keep working before it has been run.
const [{ data: billingRow }, { data: orderBilling }] = awaitingPayment && Astro.locals.user && order
  ? await Promise.all([
      supabase.from('profiles').select('billing, full_name, phone').eq('id', Astro.locals.user.id).maybeSingle(),
      supabase.from('payments').select('billing').eq('id', order.id).maybeSingle(),
    ])
  : [{ data: null }, { data: null }];
const payBilling = ((orderBilling as any)?.billing ?? (billingRow as any)?.billing ?? null) as Record<string, string> | null;
const refundPolicy = company.services.refundPolicy?.hu?.trim();
const orderLines = (order?.line_items ?? []) as OrderLine[];
const cardEnabled = isStripeEnabled();

/**
 * What still stands between this listing and being submitted.
 *
 * The endpoint already refuses a submission with no photos, but in 1.0 the
 * owner only discovered that after clicking. Showing the same rules up front
 * is the difference between a form that guides and a form that scolds.
 */
const blockers: string[] = [];
if (property.media.length === 0) blockers.push('Legalább egy fényképet fel kell tölteni.');
if (!trByLocale.hu?.title?.trim()) blockers.push('A magyar cím kitöltése kötelező.');
if (!trByLocale.hu?.description?.trim()) blockers.push('A magyar rövid leírás kitöltése kötelező.');
if (!property.country || !Number.isFinite(property.lat) || !Number.isFinite(property.lng) || property.location_confirmed===false) blockers.push('Adja meg az országot és a helyet.');
if (!(property.original_price && property.original_price>0) && (property.price_eur <= 1 || property.price_huf <= 1)) blockers.push('Adja meg az irányárat.');

const openService = serviceResult.data;
const servicesAvailable = !serviceResult.error;
const canRequestService = servicesAvailable && isOwnProperty && OWNER_EDITABLE.includes(property.status) && !openService;

// The same rules as `blockers`, shown as a checklist so progress is visible, not only what is left.
const checks = [
  { label: 'Magyar cím', done: Boolean(trByLocale.hu?.title?.trim()) },
  { label: 'Rövid leírás', done: Boolean(trByLocale.hu?.description?.trim()) },
  { label: 'Ország és térképi hely', done: Boolean(property.country && Number.isFinite(property.lat) && Number.isFinite(property.lng) && property.location_confirmed!==false) },
  { label: 'Irányár', done: Boolean(property.original_price && property.original_price>0) || (property.price_eur > 1 && property.price_huf > 1) },
  { label: 'Legalább egy fénykép', done: property.media.length > 0 },
];
const doneCount = checks.filter((check) => check.done).length;
const readyPct = Math.round((doneCount / checks.length) * 100);
const RING = 2 * Math.PI * 26;

const railItems: { id: string; label: string; pay?: boolean }[] = [
  // The one thing left to do on an approved listing, so it leads the list.
  ...(awaitingPayment && order ? [{ id: 'pay', label: 'Fizetés', pay: true }] : []),
  { id: 'basics', label: 'Alapadatok' },
  { id: 'location', label: 'Elhelyezkedés' },
  { id: 'details', label: 'Részletek' },
  { id: 'features', label: 'Jellemzők' },
  { id: 'curation', label: 'Kiemelések' },
  { id: 'seller', label: 'Eladó' },
  { id: 'translations', label: 'Szövegek' },
  { id: 'media', label: 'Fényképek' },
  ...(servicesAvailable && (openService || canRequestService) ? [{ id: 'service', label: 'Szolgáltatás' }] : []),
];


/** Not a blocker — but it costs the listing real search traffic. */
const missingCaptions = property.media.filter((m) => !captionOf(m).trim()).length;

// Expiry and the monthly owner check (admin view of a live or expired listing).
const expiredListing = property.status === 'archived' && Boolean(property.expired_at);
const showLifecycle = isAdmin && (property.status === 'published' || expiredListing);
const left = property.expires_at ? daysLeft(property.expires_at) : null;
const hd = (iso?: string | null) => (iso ? new Date(iso).toLocaleDateString('hu-HU', { year: 'numeric', month: 'long', day: 'numeric' }) : '—');
const unresponsive = property.status === 'published' && isUnresponsive(property, listingRules(company.services));

// The package's photo limit (admin-set in Szolgáltatások). Admins may exceed it.
const listingPackage = packageOf(listingCatalog(company.services), property.package);
const photoLimit = listingPackage.maxImages;
---

<Portal title={`Ingatlan #${property.ref}`}>
  <header class="hero">
    <div class="hero-main">
      <p class="crumbs"><a href="/portal/properties">← Ingatlanok</a><span>#{property.ref}</span></p>
      <h1>{trByLocale.hu?.title || 'Névtelen hirdetés'}</h1>
      <p class="hero-meta">
        <span class="status-pill" data-status={property.status}>{STATUS_LABEL[property.status] ?? property.status}</span>
        {property.settlement && <span>{property.settlement}{property.county ? `, ${property.county}` : ''}</span>}
        {property.price_eur > 1 && <span>{eur(property.price_eur)}</span>}
      </p>
      {isAdmin && property.status === 'submitted' && (
        <a class="btn review-link" href={`/portal/review/${property.id}`}>Elbírálás megnyitása</a>
      )}
    </div>
    {OWNER_EDITABLE.includes(property.status) && (
      <div class="ring" role="img" aria-label={`Beküldésre kész: ${doneCount} / ${checks.length}`}>
        <svg viewBox="0 0 64 64" aria-hidden="true">
          <circle class="ring-bg" cx="32" cy="32" r="26" />
          <circle class="ring-fg" cx="32" cy="32" r="26" stroke-dasharray={RING} stroke-dashoffset={RING * (1 - readyPct / 100)} />
        </svg>
        <span class="ring-n">{doneCount}<small>/{checks.length}</small></span>
        <span class="ring-l">kész</span>
      </div>
    )}
  </header>

  {saved && <p class="notice ok" data-toast="ok">Mentve.</p>}
  {err && <p class="notice error">Nem sikerült menteni: {err}</p>}
  {payment === 'success' && (
    <p class="notice ok">
      Köszönjük, a fizetés megérkezett. A hirdetés élesítve — a visszaigazolást e-mailben is elküldtük.
    </p>
  )}
  {payment === 'cancelled' && (
    <p class="notice warn">
      A fizetés félbeszakadt, a hirdetés még nem élesedett. Bármikor újrapróbálhatja alább.
    </p>
  )}

  {latestNote && property.status === 'changes_requested' && (
    <section class="review-note">
      <p class="eyebrow">Munkatársunk megjegyzése</p>
      <blockquote>{latestNote.note}</blockquote>
      <p class="review-note-foot">
        Kérjük, végezze el a javítást — pótolja vagy cserélje a fényképeket, ha arra van szükség —,
        majd küldje be ismét. A folyamat innen ugyanúgy folytatódik.
      </p>
    </section>
  )}

  {property.status === 'rejected' && (
    <section class="review-note rejected">
      <p class="eyebrow">A hirdetést elutasítottuk</p>
      {latestNote && <blockquote>{latestNote.note}</blockquote>}
      <p class="review-note-foot">
        Az elutasított hirdetés nem szerkeszthető és nem küldhető be újra.
        {property.refund_required && ' A visszatérítésről munkatársunk külön felveszi Önnel a kapcsolatot.'}
        {isAdmin && property.refund_required && ' (Admin: visszatérítés szükséges — a Fizetések oldalon rögzíthető.)'}
      </p>
    </section>
  )}

  {!editable && (
    <p class="notice warn">
      Ez a hirdetés jelenleg <strong>{STATUS_LABEL[property.status]}</strong> állapotban van, ezért
      a mezők nem szerkeszthetők.
      {property.status === 'submitted' && ' Amint elbírálásra kerül, ismét szerkesztheti, ha javítás szükséges.'}
      {awaitingPayment && ' A díj rendezése után a hirdetés automatikusan élesedik.'}
      {awaitingPayment && order && <> <a href="#pay"><strong>Ugrás a fizetéshez ↓</strong></a></>}
    </p>
  )}

  <div class="ed-layout">
  <nav class="ed-rail" aria-label="Szerkesztő szakaszai">
    <ul>
      {railItems.map((item) => (
        <li>
          <a href={`#${item.id}`} data-rail={item.id} class:list={[item.pay && 'rail-pay']}>
            <span class="n">{item.pay ? '€' : railItems.filter((i) => !i.pay).indexOf(item) + 1}</span>{item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <div class="ed-body">
  <form method="POST" action={`/api/portal/properties/${property.id}/update`} class="editor" id="editor-form">
    <fieldset disabled={!editable}>

      <div class="ed-card"><ListingFields property={property} taxonomy={taxonomy} locale="hu" /></div>
      <div class="ed-card"><PromotionChoices property={property} isAdmin={isAdmin}/></div>

      <section id="seller" class="ed-card">
        <header class="card-head"><div><h2>Eladó elérhetősége</h2><p>Ha engedi, a vevő közvetlenül is felveheti Önnel a kapcsolatot.</p></div></header>
        <p class="hint">
          A FINDDOME egyedi modellje: ha ehhez hozzájárul, a neve és telefonszáma megjelenik a
          hirdetésen, hogy a vevő közvetlenül is felvehesse Önnel a kapcsolatot.
        </p>
        <label class="checkbox">
          <input type="checkbox" name="seller_contact_visible" value="yes" checked={property.seller_contact_visible} />
          Nevem és telefonszámom megjelenítése a hirdetésben
        </label>
        <div class="grid-2">
          <Field locale="hu" name="seller_name" label="Név" value={property.seller_name ?? ''} />
          <Field locale="hu" name="seller_phone" label="Telefonszám" type="tel" value={property.seller_phone ?? ''} />
        </div>
        <h3>Kapcsolattartás nyelvei</h3><p class="hint">Azok a nyelvek, amelyeken az érdeklődőkkel beszélni tud. Ez a hirdetés fordításától független.</p>
        <ContactLanguages selected={property.seller_speaks} locale="hu"/>
      </section>

      <section id="translations" class="ed-card">
        <header class="card-head"><div><h2>Szövegek</h2><p>Minden nyelven külön szöveg. A magyar kötelező, a többi bővíti az elérést.</p></div></header>
        <div class="locale-tabs" role="tablist">
          {LOCALE_OPTIONS.map((l, i) => (
            <button type="button" class="locale-tab" data-locale-tab={l.value} aria-selected={i === 0}>
              {l.label}
            </button>
          ))}
        </div>
        {LOCALE_OPTIONS.map((l, i) => {
          const t = trByLocale[l.value];
          const required = l.value === 'hu';
          const suggestion = suggestionByLocale[l.value];
          return (
            <div class="locale-panel" data-locale-panel={l.value} hidden={i !== 0}>
              <Field locale="hu" name={`title_${l.value}`} label="Hirdetés címe" required={required} value={t?.title ?? ''} />
              <Field locale="hu" name={`description_${l.value}`} label="Rövid leírás" type="textarea" rows={3} required={required} value={t?.description ?? ''} />
              <Field locale="hu" name={`body_${l.value}`} label="Részletes leírás" type="textarea" rows={8} value={t?.body ?? ''}
                hint="Bekezdéseket üres sorral válasszon el." />
              {isAiEnabled() && t && (
                <div class="ai-box" data-ai-locale={l.value}>
                  {suggestion ? (
                    <div class="ai-suggestion" data-suggestion-id={suggestion.id}>
                      <p class="ai-label">AI szövegjavaslat</p>
                      <div class="diff">
                        <div><p class="diff-label">Jelenlegi</p><p class="diff-text">{t.description}</p></div>
                        <div><p class="diff-label">Javasolt</p><p class="diff-text">{suggestion.suggested.description}</p></div>
                      </div>
                      {suggestion.issues?.length > 0 && (
                        <ul class="ai-issues">{suggestion.issues.map((iss: string) => <li>{iss}</li>)}</ul>
                      )}
                      <button type="button" class="btn ghost small ai-accept">Elfogadom</button>
                      <button type="button" class="btn ghost small ai-reject">Elvetem</button>
                      <p class="hint">Az "Elfogadom" a teljes szöveget (cím, rövid és részletes leírás) lecseréli — mentés előtt még szerkesztheti a fenti mezőkben.</p>
                    </div>
                  ) : (
                    <button type="button" class="btn ghost small ai-request">Szövegjavaslat kérése</button>
                  )}
                  <p class="ai-status" data-ai-status={l.value} role="status"></p>
                </div>
              )}
            </div>
          );
        })}
        <Field locale="hu" name="heard_from" label="Honnan értesült a FINDDOME-ről?" type="select" value={property.heard_from||''} options={[{value:'',label:'Nincs megadva'},...HEARD_FROM.map(o=>({value:o.key,label:o.labels.hu}))]} hint="Csak a FINDDOME munkatársai látják."/>
        <Field locale="hu" name="internal_note" label="Megjegyzés (belső használatra)" type="textarea" rows={3} value={property.internal_note||''} hint="Csak Ön és a FINDDOME munkatársai láthatják. A nyilvános hirdetésben soha nem jelenik meg." maxlength={10000}/>
      </section>

      {editable && (
        <div class="savebar" id="savebar" data-state="clean">
          <div class="savebar-in">
            <p class="savebar-msg" role="status"><span class="dot"></span><span class="txt" id="savebar-txt">Minden módosítás mentve</span></p>
            <button type="submit" class="btn" id="save-btn">Mentés <kbd>⌘S</kbd></button>
          </div>
        </div>
      )}
    </fieldset>
  </form>

  {awaitingPayment && order && (
    <section class="pay ed-card" id="pay">
      <h2>Fizetendő díj</h2>
      <p class="hint">
        Hirdetését jóváhagytuk. A fizetés beérkezése után azonnal megjelenik a {SITE_HOST} oldalon.
      </p>

      <table class="order-table">
        <tbody>
          {orderLines.map((line) => (
            <tr>
              <td>{line.label}</td>
              <td class="amount">{formatCents(line.unitCents * line.quantity)}</td>
            </tr>
          ))}
        </tbody>
        <tfoot>
          <tr>
            <td>Fizetendő</td>
            <td class="amount total">{formatCents(order.amount_cents)}</td>
          </tr>
        </tfoot>
      </table>
      <p class="vat-note">Az ár tartalmazza a 21% holland áfát. Vállalkozásként, érvényes uniós adószámmal áfa nélküli számlát kaphat.</p>

      <details class="bill" open={!billingComplete(payBilling)}>
        <summary>
          <span>Számlázási adatok</span>
          <em data-ok={billingComplete(payBilling) ? 'yes' : 'no'}>{billingComplete(payBilling) ? 'Megadva' : 'Hiányzik'}</em>
        </summary>
        <BillingForm compact billing={payBilling} fallbackName={(billingRow as any)?.full_name ?? ''} fallbackPhone={(billingRow as any)?.phone ?? ''} paymentId={(order as any)?.id} />
      </details>
      {refundPolicy && <p class="hint"><strong>Visszatérítési szabály:</strong> {refundPolicy}</p>}

      {cardEnabled ? (
        <>
          <button type="button" class="btn" id="pay-btn">Fizetés bankkártyával</button>
          <p class="hint">
            A fizetés a Stripe biztonságos felületén történik. A kártyaadatokat a FINDDOME nem látja
            és nem tárolja.
          </p>
        </>
      ) : (
        <p class="hint">A díj banki átutalással rendezhető, az alábbi számlaszámok egyikére.</p>
      )}

      <h3>Banki átutalás</h3>
      <dl class="bank">
        <div><dt>IBAN</dt><dd>{COMPANY.banks.nl.iban}</dd></div>
        <div><dt>BIC</dt><dd>{COMPANY.banks.nl.bic}</dd></div>
        <div><dt>Magyar számla</dt><dd>{COMPANY.banks.hu.account}</dd></div>
        <div><dt>Közlemény</dt><dd>#{property.ref}</dd></div>
      </dl>
      <p class="hint">
        Az átutalás beérkezése után munkatársunk élesíti a hirdetést — ez néhány munkanapot vehet
        igénybe. Bankkártyás fizetésnél a hirdetés azonnal megjelenik.
      </p>
      <p class="workflow-status" id="pay-status" role="status"></p>
    </section>
  )}

  <section class="workflow ed-card">
    {OWNER_EDITABLE.includes(property.status) && (
      <>
        <p class="wf-title">Beküldés elbírálásra</p>
        <ul class="steps">
          {checks.map((check) => (
            <li data-done={check.done}><span class="tick" aria-hidden="true"></span>{check.label}</li>
          ))}
        </ul>
        <button type="button" class="btn" id="submit-btn" disabled={blockers.length > 0}>
          Beküldés elbírálásra
        </button>
        {blockers.length === 0 && missingCaptions > 0 && (
          <p class="soft-warn">
            {missingCaptions} fénykép még leírás nélkül van. Beküldheti így is, de a leírásokkal
            a hirdetés jóval több érdeklődőt ér el a Google képkeresőjéből.
          </p>
        )}
      </>
    )}
    {showLifecycle && (
      <div class="wf-life">
        <p class="wf-title">Lejárat és hosszabbítás</p>
        <dl class="wf-facts">
          <div><dt>Lejárat</dt><dd>{hd(property.expires_at)} {left !== null && (left > 0 ? <span class:list={['pill', left <= 30 ? 'pill-warn' : 'pill-ok']}>{left} nap</span> : <span class="pill pill-bad">Lejárt</span>)}</dd></div>
          <div><dt>Utolsó visszaigazolás</dt><dd>{hd(property.confirmed_at)} {unresponsive && <span class="pill pill-bad">Nem válaszolt</span>}</dd></div>
        </dl>
        <div class="wf-extend">
          <label class="sr-only" for="extend-months">Időtartam</label>
          <select id="extend-months">
            <option value="1">1 hónap</option>
            <option value="3">3 hónap</option>
            <option value="6" selected>6 hónap</option>
            <option value="12">12 hónap</option>
          </select>
          <button type="button" class="btn ghost" id="extend-btn">{expiredListing ? 'Meghosszabbítás és újra online' : 'Meghosszabbítás'}</button>
        </div>
      </div>
    )}
    {property.status === 'published' && (
      <button type="button" class="btn ghost" id="sold-btn">Megjelölés eladottként</button>
    )}
    {isAdmin && ['archived', 'sold'].includes(property.status) && !expiredListing && (
      <div class="wf-life">
        <p class="wf-title">{property.status === 'sold' ? 'Eladottként jelölve' : 'Inaktív hirdetés'}</p>
        <p class="wf-note">A hirdetés most nem látható a nyilvános oldalon. Újraaktiváláskor azonnal visszakerül; ha az időszaka már lejárt, a csomagjának megfelelő új időszakot kap.</p>
        <button type="button" class="btn" id="reactivate-btn">Újraaktiválás</button>
      </div>
    )}
    {isAdmin && property.status === 'published' && (
      <button type="button" class="btn ghost" id="archive-btn">Inaktiválás</button>
    )}
    <p class="workflow-status" id="workflow-status" role="status"></p>
  </section>

  <div class="media-section ed-card">
    <PhotoUploader
      propertyId={property.id}
      media={property.media}
      photoLimit={photoLimit}
      packageName={listingPackage.names.hu}
      editable={editable}
      isAdmin={isAdmin}
      locale="hu"
    />
  </div>

  {servicesAvailable && (openService || canRequestService) && (
    <section id="service" class="service-section ed-card">
      <header class="card-head"><div><h2>Helyszíni szolgáltatás</h2><p>Nem kötelező: szakember fotózza le az ingatlant Ön helyett.</p></div></header>
      {openService ? (
        <div class="service-status">
          <p>
            <strong>{serviceName(openService.service_id)}</strong> — {servicePrice(openService.service_id)}
          </p>
          <p class="hint">
            Állapot: {SERVICE_STATUS_LABEL[openService.status as ServiceStatus] ?? openService.status}
            {openService.scheduled_for && ` · időpont: ${new Date(openService.scheduled_for).toLocaleDateString('hu-HU')}`}.
            {openService.status === 'requested' && ' Munkatársunk felveszi Önnel a kapcsolatot az időpont egyeztetéséhez.'}
          </p>
          {isOwnProperty && openService.status === 'requested' && (
            <button type="button" class="btn ghost" id="service-cancel">Igény visszavonása</button>
          )}
          {isAdmin && <a class="hint-link" href="/portal/services">Kezelés a Helyszíni szolgáltatások oldalon →</a>}
        </div>
      ) : (
        <form id="service-form" class="service-form">
          <p class="hint">
            Nem szeretne maga fotózni? Kérje szakember segítségét — nem kötelező. Munkatársunk felveszi
            Önnel a kapcsolatot az időpont egyeztetéséhez, és ekkor tájékoztatja a díj rendezéséről.
          </p>
          <div class="service-options">
            {ONSITE_SERVICES.map((service) => (
              <label class="service-option">
                <input type="radio" name="serviceId" value={service.id} />
                <span>
                  <strong>{service.names.hu}</strong>
                  <span class="service-price">{servicePrice(service.id)} · egyszeri díj</span>
                  <span class="service-includes">{service.includes.hu.join(' · ')}</span>
                </span>
              </label>
            ))}
          </div>
          <label class="service-note">
            Megjegyzés (nem kötelező)
            <textarea name="note" rows="2" maxlength="2000" placeholder="pl. mikor alkalmas, hogyan lehet bejutni"></textarea>
          </label>
          <button type="submit" class="btn">Szolgáltatás kérése</button>
        </form>
      )}
      <p class="workflow-status" id="service-status" role="status"></p>
    </section>
  )}
  </div>
  </div>
</Portal>

<script define:vars={{ servicePropertyId: property.id }}>
  // On-site service: ask for one, or withdraw it before it is scheduled.
  const serviceStatus = document.getElementById('service-status');
  async function serviceCall(payload) {
    const res = await fetch(`/api/portal/properties/${servicePropertyId}/service`, {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify(payload),
    });
    const json = await res.json().catch(() => ({}));
    if (res.ok && json.ok) {
      location.hash = 'service';
      location.reload();
    } else if (serviceStatus) {
      serviceStatus.textContent = json.error || 'Nem sikerült. Próbálja újra.';
    }
  }
  document.getElementById('service-form')?.addEventListener('submit', (event) => {
    event.preventDefault();
    const form = event.currentTarget;
    const chosen = form.querySelector('input[name="serviceId"]:checked');
    if (!chosen) {
      if (serviceStatus) serviceStatus.textContent = 'Válassza ki, melyik szolgáltatást kéri.';
      return;
    }
    if (serviceStatus) serviceStatus.textContent = 'Küldés…';
    serviceCall({ action: 'request', serviceId: chosen.value, note: form.note.value });
  });
  document.getElementById('service-cancel')?.addEventListener('click', async () => {
    if (await window.pf.confirm({ title: 'Visszavonja az igényt?', body: 'A helyszíni szolgáltatás iránti kérést visszavonja; munkatársunk nem keresi Önt időpont miatt.', confirmLabel: 'Igény visszavonása', danger: true })) serviceCall({ action: 'cancel' });
  });
</script>


<script>
  /* ── Section rail: the section being read lights up ─────────────────── */
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-rail]')];
  const targets = links.map((link) => document.getElementById(link.dataset.rail!)).filter((el): el is HTMLElement => Boolean(el));
  if (links.length && 'IntersectionObserver' in window) {
    const visible = new Set<string>();
    const mark = () => {
      // The first visible section in page order is the one being read.
      const current = targets.find((el) => visible.has(el.id))?.id ?? links[0].dataset.rail;
      links.forEach((link) => link.setAttribute('aria-current', String(link.dataset.rail === current)));
    };
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => (entry.isIntersecting ? visible.add(entry.target.id) : visible.delete(entry.target.id)));
        mark();
      },
      { rootMargin: '-15% 0px -55% 0px' }
    );
    targets.forEach((el) => observer.observe(el));
    mark();
  }
  links.forEach((link) =>
    link.addEventListener('click', (event) => {
      const el = document.getElementById(link.dataset.rail!);
      if (!el) return;
      event.preventDefault();
      el.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
      history.replaceState(null, '', `#${el.id}`);
    })
  );

  /* ── Save bar: says plainly whether anything is unsaved ──────────────── */
  const form = document.getElementById('editor-form') as HTMLFormElement | null;
  const bar = document.getElementById('savebar');
  const text = document.getElementById('savebar-txt');
  if (form && bar && text) {
    let dirty = false;
    let saving = false;
    const set = (state: 'clean' | 'dirty' | 'saving') => {
      bar.dataset.state = state;
      text.textContent = state === 'dirty' ? 'Nem mentett módosítások' : state === 'saving' ? 'Mentés…' : 'Minden módosítás mentve';
    };
    form.addEventListener('input', () => {
      dirty = true;
      set('dirty');
    });
    form.addEventListener('submit', () => {
      saving = true;
      set('saving');
    });
    window.addEventListener('beforeunload', (event) => {
      if (dirty && !saving) event.preventDefault();
    });
    document.addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 's') {
        event.preventDefault();
        if (!saving) form.requestSubmit();
      }
    });
  }
</script>

<script define:vars={{ propertyId: property.id, gapLabels: GAP_LABELS.hu }}>
  // Locale tabs — plain show/hide, no framework.
  document.querySelectorAll('[data-locale-tab]').forEach((tab) => {
    tab.addEventListener('click', () => {
      const locale = tab.getAttribute('data-locale-tab');
      document.querySelectorAll('[data-locale-tab]').forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
      document.querySelectorAll('[data-locale-panel]').forEach((p) => {
        p.hidden = p.getAttribute('data-locale-panel') !== locale;
      });
    });
  });

  // AI description-rewrite suggestion — request, accept (optionally after
  // editing the fields above), or reject. Never auto-runs; always a click.
  document.querySelectorAll('.ai-request').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const box = btn.closest('.ai-box');
      const locale = box.dataset.aiLocale;
      const statusEl = box.querySelector(`[data-ai-status="${locale}"]`);
      btn.disabled = true;
      statusEl.textContent = 'Javaslat készítése… (ez akár 30 másodpercig is tarthat)';
      const res = await fetch(`/api/portal/properties/${propertyId}/ai-suggestion`, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ action: 'request', locale }),
      });
      const json = await res.json().catch(() => ({}));
      if (res.ok && json.ok) {
        location.reload();
      } else {
        statusEl.textContent = 'Nem sikerült javaslatot készíteni.';
        btn.disabled = false;
      }
    });
  });

  document.querySelectorAll('.ai-accept').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const wrap = btn.closest('.ai-suggestion');
      const box = btn.closest('.ai-box');
      const locale = box.dataset.aiLocale;
      const statusEl = box.querySelector(`[data-ai-status="${locale}"]`);
      statusEl.textContent = 'Elfogadás…';
      const res = await fetch(`/api/portal/properties/${propertyId}/ai-suggestion`, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ action: 'accept', suggestionId: wrap.dataset.suggestionId }),
      });
      statusEl.textContent = res.ok ? 'Elfogadva — az oldal frissül…' : 'Nem sikerült.';
      if (res.ok) location.reload();
    });
  });

  document.querySelectorAll('.ai-reject').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const wrap = btn.closest('.ai-suggestion');
      const box = btn.closest('.ai-box');
      const locale = box.dataset.aiLocale;
      const statusEl = box.querySelector(`[data-ai-status="${locale}"]`);
      const res = await fetch(`/api/portal/properties/${propertyId}/ai-suggestion`, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ action: 'reject', suggestionId: wrap.dataset.suggestionId }),
      });
      statusEl.textContent = res.ok ? 'Elvetve.' : 'Nem sikerült.';
      if (res.ok) location.reload();
    });
  });

  const workflowStatus = document.getElementById('workflow-status');

  async function doAction(action, note) {
    const res = await fetch(`/api/portal/properties/${propertyId}/status`, {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ action, note }),
    });
    const json = await res.json().catch(() => ({}));
    if (!res.ok || !json.ok) {
      const messages = {
        'no-photos': 'Legalább egy fényképet fel kell tölteni a beküldés előtt.',
        'incomplete-listing': 'A beküldéshez töltse ki az országot, a pontos helyet, az árat, a címet és a leírást, és mentse a hirdetést.',
      };
      workflowStatus.textContent = json.error === 'incomplete-details' && json.fields?.length
        ? `A beküldéshez még hiányzik: ${json.fields.map((name) => gapLabels[name] || name).join(', ')}. Töltse ki, és mentse a hirdetést.`
        : messages[json.error] || 'Nem sikerült végrehajtani.';
      return;
    }
    location.reload();
  }

  document.getElementById('submit-btn')?.addEventListener('click', async () => {
    if (await window.pf.confirm({ title: 'Beküldi elbírálásra?', body: 'Munkatársunk átnézi a hirdetést. Amíg az elbírálás tart, a mezők nem szerkeszthetők.', confirmLabel: 'Beküldés' })) doAction('submit');
  });
  document.getElementById('extend-btn')?.addEventListener('click', async () => {
    const months = Number(document.getElementById('extend-months')?.value ?? 6);
    const ok = await window.pf.confirm({
      title: `Meghosszabbítja ${months} hónappal?`,
      body: 'A lejárat a mostani lejárattól számít (ha már lejárt, a mai naptól), és a hirdetés online marad vagy újra megjelenik. A lépés naplózásra kerül; díjat nem számol fel.',
      confirmLabel: 'Meghosszabbítás',
    });
    if (!ok) return;
    const res = await fetch(`/api/portal/properties/${propertyId}/status`, {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ action: 'extend', months }),
    });
    const json = await res.json().catch(() => ({}));
    if (!res.ok || !json.ok) {
      workflowStatus.textContent = json.error === 'not-renewable' ? 'Ez a hirdetés nem hosszabbítható.' : 'Nem sikerült meghosszabbítani.';
      return;
    }
    location.reload();
  });
  document.getElementById('reactivate-btn')?.addEventListener('click', async () => {
    if (await window.pf.confirm({ title: 'Újra aktiválja?', body: 'A hirdetés azonnal újra megjelenik a nyilvános oldalon. A lépés naplózásra kerül; díjat nem számol fel.', confirmLabel: 'Újraaktiválás' })) doAction('reactivate');
  });
  document.getElementById('archive-btn')?.addEventListener('click', async () => {
    if (await window.pf.confirm({ title: 'Inaktiválja?', body: 'A hirdetés lekerül a nyilvános oldalról, de minden adata megmarad. Bármikor újraaktiválhatja.', confirmLabel: 'Inaktiválás' })) doAction('archive');
  });
  document.getElementById('sold-btn')?.addEventListener('click', async () => {
    if (await window.pf.confirm({ title: 'Megjelöli eladottként?', body: 'A hirdetés lekerül az élő listáról, és az eladott ingatlanok közé kerül.', confirmLabel: 'Megjelölés eladottként' })) doAction('mark_sold');
  });

  // Card payment. The session is minted on click, not when the approval email
  // was sent — a Stripe session created days earlier would already have expired.
  const payBtn = document.getElementById('pay-btn');
  payBtn?.addEventListener('click', async () => {
    const payStatus = document.getElementById('pay-status');
    payBtn.setAttribute('disabled', 'true');
    payStatus.textContent = 'Átirányítás a fizetéshez…';
    try {
      const res = await fetch('/api/stripe/checkout', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ propertyId }),
      });
      const json = await res.json();
      if (!res.ok || !json.ok || !json.url) throw new Error(json.error ?? 'checkout-failed');
      window.location.href = json.url;
    } catch (error) {
      payBtn.removeAttribute('disabled');
      payStatus.textContent =
        'A bankkártyás fizetés most nem érhető el. Kérjük, utaljon a fenti számlaszámra, vagy próbálja újra később.';
    }
  });

</script>

