---
/**
 * New mail template: a name first, then where it starts from. The editor
 * opens straight after (src/pages/api/portal/email/templates/index.ts).
 */
export const prerender = false;

import Portal from '~/layouts/Portal.astro';
import { LOCALES } from '~/i18n/ui';
import { LOCALE_LABEL } from '~/lib/portal/labels';
import { BASE_LOCALES } from '~/lib/mail/base-templates';

const { supabase, profile } = Astro.locals;
if (profile?.role !== 'admin') return Astro.redirect('/portal/dashboard');

const error = Astro.url.searchParams.get('error');
const [{ data: templates }, { data: listings }] = await Promise.all([
  supabase.from('mail_templates').select('id, name, locale').order('name'),
  supabase.from('properties').select('id, ref, settlement, status').in('status', ['published', 'awaiting_payment', 'submitted', 'draft']).order('created_at', { ascending: false }).limit(500),
]);
const STATUS: Record<string, string> = { published: 'élő', awaiting_payment: 'fizetésre vár', submitted: 'jóváhagyásra vár', draft: 'piszkozat' };
---

<Portal title="Új sablon">
  <header class="ph">
    <div>
      <p class="eyebrow"><a href="/portal/email">← E-mail automatizáció</a></p>
      <h1>Új <em>sablon</em></h1>
      <p class="lede">Adjon nevet a sablonnak, és válassza ki, miből induljon. A sablon inaktívként jön létre: a szerkesztőben töltse ki a sárgával jelölt részeket, és utána kapcsolja be.</p>
    </div>
  </header>

  {error && <p class="notice error">{error}</p>}

  <form method="post" action="/api/portal/email/templates" class="set-card new-form">
    <label class="set-field">Sablon neve
      <input name="name" required maxlength="120" placeholder="pl. Válasz érdeklődésre — holland" autofocus />
    </label>

    <fieldset class="start">
      <legend>Kiindulás</legend>
      <label class="choice"><input type="radio" name="start" value="property" checked />
        <span><b>Ingatlan-bemutató</b><small>Megszólítás, fő fotó, cím, leírás, három adat, „Hirdetés megtekintése” gomb, „Miért a FINDDOME”, elérhetőség. Ez a válasz egy érdeklődőnek.</small></span>
      </label>
      <label class="choice"><input type="radio" name="start" value="general" />
        <span><b>Általános levél</b><small>Cím, néhány bekezdés és egy gomb — hírek a tulajdonosoknak, hírlevél, bejelentés.</small></span>
      </label>
      {(templates ?? []).length > 0 && (
        <label class="choice"><input type="radio" name="start" value="copy" />
          <span><b>Meglévő sablon alapján</b><small>A szövegek és a beállítások átjönnek; a konkrét ingatlanra vonatkozó részek kitöltendőként jelölve.</small></span>
        </label>
      )}
    </fieldset>

    <div class="row">
      <label class="set-field" data-show="property general">A levél nyelve
        <select name="locale">
          {LOCALES.map((l) => <option value={l}>{LOCALE_LABEL[l]}{(BASE_LOCALES as readonly string[]).includes(l) ? '' : ' (angol szövegből indul)'}</option>)}
        </select>
      </label>
      <label class="set-field" data-show="property">Hirdetés, amelyből kitöltjük (nem kötelező)
        <select name="linkedPropertyId">
          <option value="">Nincs — a sablon minden hirdetéshez jó</option>
          {(listings ?? []).map((l: any) => <option value={l.id}>#{l.ref} — {l.settlement} ({STATUS[l.status] ?? l.status})</option>)}
        </select>
      </label>
      <label class="set-field" data-show="copy" hidden>Kiinduló sablon
        <select name="sourceTemplateId" disabled>
          {(templates ?? []).map((t: any) => <option value={t.id}>{t.name} ({LOCALE_LABEL[t.locale] ?? t.locale})</option>)}
        </select>
      </label>
    </div>
    <input type="hidden" name="kind" value="property" />
    <p class="hint" data-show="property">Hirdetés nélkül is használható: érdeklődőnek küldve mindig az a hirdetés kerül bele, amelyről érdeklődött. Hirdetéssel a leírás, az alapterület, a hálószobák és a fő fotó előre kitöltődik.</p>

    <div class="actions"><button class="btn" type="submit">Sablon létrehozása és szerkesztése</button></div>
  </form>
</Portal>

<script>
  const form = document.querySelector<HTMLFormElement>('.new-form');
  const sync = () => {
    if (!form) return;
    const start = (form.querySelector<HTMLInputElement>('input[name="start"]:checked')?.value ?? 'property');
    form.querySelector<HTMLInputElement>('input[name="kind"]')!.value = start === 'general' ? 'general' : 'property';
    form.querySelectorAll<HTMLElement>('[data-show]').forEach((el) => {
      const visible = (el.dataset.show ?? '').split(' ').includes(start);
      el.hidden = !visible;
      el.querySelectorAll<HTMLSelectElement>('select').forEach((s) => (s.disabled = !visible));
    });
  };
  form?.addEventListener('change', sync);
  sync();
</script>

<style>
  .new-form { max-width: 820px; display: grid; gap: 22px; }
  .start { border: 0; margin: 0; padding: 0; display: grid; gap: 10px; }
  .start legend { margin-bottom: 8px; font-size: 14px; color: var(--ink-quiet); }
  .choice { display: flex; gap: 14px; align-items: flex-start; padding: 16px 18px; border-radius: var(--r-md); box-shadow: 0 0 0 1.5px var(--border); cursor: pointer; transition: box-shadow 0.2s; }
  .choice:has(input:checked) { box-shadow: 0 0 0 2px var(--ink); background: var(--cream); }
  .choice input { margin-top: 4px; }
  .choice b { display: block; color: var(--ink); font-weight: var(--fw-medium); }
  .choice small { display: block; margin-top: 4px; font-size: 14px; line-height: 1.5; color: var(--ink-quiet); }
  .row { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; }
  .hint { margin: -8px 0 0; font-size: 14px; color: var(--ink-quiet); }
  .actions { display: flex; justify-content: flex-end; }
  [hidden] { display: none !important; }
</style>
