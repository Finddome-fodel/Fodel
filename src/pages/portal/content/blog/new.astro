---
// Same "create then redirect into the editor" pattern as
// /portal/properties/new.astro — a blank draft, not a separate empty form.
export const prerender = false;

import { isBlogLocale } from '~/lib/blog';
import { friendlyError } from '~/lib/portal/labels';

const { supabase, user, profile } = Astro.locals;
if (!user || profile?.role !== 'admin') return Astro.redirect('/portal/login');

const requested = Astro.url.searchParams.get('locale');
if (!isBlogLocale(requested)) return Astro.redirect('/portal/content/blog');
const locale = requested;
const caseStudy = Astro.url.searchParams.get('kind') === 'case_study';

const NEW_TITLE = { hu: 'Új cikk', nl: 'Nieuw artikel', en: 'New article', de: 'Neuer Artikel', fr: 'Nouvel article', es: 'Nuevo artículo', pl: 'Nowy artykuł', ro: 'Articol nou', sk: 'Nový článok', it: 'Nuovo articolo', pt: 'Novo artigo', el: 'Νέο άρθρο', cs: 'Nový článek', sl: 'Nov članek', sv: 'Ny artikel', da: 'Ny artikel', no: 'Ny artikkel', fi: 'Uusi artikkeli', et: 'Uus artikkel', lv: 'Jauns raksts', lt: 'Naujas straipsnis' } as const;
const NEW_SLUG = { hu: 'uj-cikk', nl: 'nieuw-artikel', en: 'new-article', de: 'neuer-artikel', fr: 'nouvel-article', es: 'nuevo-articulo', pl: 'nowy-artykul', ro: 'articol-nou', sk: 'novy-clanok', it: 'nuovo-articolo', pt: 'novo-artigo', el: 'neo-arthro', cs: 'novy-clanek', sl: 'nov-clanek', sv: 'ny-artikel', da: 'ny-artikel', no: 'ny-artikkel', fi: 'uusi-artikkeli', et: 'uus-artikkel', lv: 'jauns-raksts', lt: 'naujas-straipsnis' } as const;

const draft: Record<string, unknown> = {
  locale,
  slug: `${NEW_SLUG[locale]}-${Date.now().toString(36)}`,
  title: NEW_TITLE[locale],
  excerpt: '',
  body_md: '',
  category: '',
  published: false,
  created_by: user.id,
};
if (caseStudy) draft.kind = 'case_study';

const { data, error } = await supabase.from('blog_posts').insert(draft).select('id').single();

if (error || !data) return new Response(friendlyError(error?.message), { status: 500 });
return Astro.redirect(`/portal/content/blog/${data.id}`);
---
