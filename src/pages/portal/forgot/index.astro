---
export const prerender = false;

import AuthPanel from '~/components/portal/AuthPanel.astro';
import { AUTH_COPY, authLang } from '~/lib/portal/auth-copy';

if (Astro.locals.user) return Astro.redirect('/portal/dashboard');

const lang = authLang(Astro.url, Astro.cookies);
const t = AUTH_COPY[lang].forgot;
const sent = Astro.url.searchParams.get('sent') === '1';
---

<AuthPanel title={t.title} heading={t.heading} lang={lang}>
  {
    sent ? (
      <>
        <p class="notice ok" role="status">{t.sent}</p>
        <p class="hint">{t.validity} <a href={`/portal/login?lang=${lang}`}>{t.back}</a></p>
      </>
    ) : (
      <>
        <p class="body">{t.body}</p>
        <form method="POST" action="/api/portal/forgot">
          <input type="hidden" name="lang" value={lang} />
          <div class="field">
            <label for="email">{t.email}</label>
            <input id="email" name="email" type="email" required autocomplete="username" inputmode="email" enterkeyhint="send" autofocus />
          </div>
          <button type="submit" class="submit">{t.submit}</button>
        </form>
        <p class="hint"><a href={`/portal/login?lang=${lang}`}>{t.back}</a></p>
      </>
    )
  }
</AuthPanel>
