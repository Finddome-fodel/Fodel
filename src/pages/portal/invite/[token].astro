/**
 * Public by necessity — the token itself, not a session, is the credential
 * here (see src/middleware.ts's PUBLIC_PORTAL_PATHS). Validated by hashing
 * the token from the URL and comparing to the stored hash, same principle as
 * a password: the raw value never round-trips through the database.
 *
 * 2.1: the screen speaks the language the invite was written in, so a German
 * invitee does not land on a Hungarian page straight from a German email.
 *
 * Launch round: step 3 of the seller flow. The name typed at registration is
 * filled in (and can be corrected), the address is shown but not editable,
 * and there is one password field with a show/hide switch and the one rule
 * visible as it is met — no "type it again" field. An expired, used or
 * unknown link says which it is and offers a fresh one in place
 * (api/portal/invite/renew.ts), instead of sending the person back to FODEL.
 */
export const prerender = false;

import crypto from 'node:crypto';
import AuthPanel from '~/components/portal/AuthPanel.astro';
import { createSupabaseAdminClient } from '~/lib/supabase-server';
import { isInviteLocale, type InviteLocale } from '~/lib/portal/invites';
import { authLang } from '~/lib/portal/auth-copy';

const { token } = Astro.params;
const err = Astro.url.searchParams.get('error');
const renewed = Astro.url.searchParams.get('renewed') === '1';

if (Astro.locals.user) {
  return Astro.redirect('/portal/dashboard');
}

const tokenHash = crypto.createHash('sha256').update(token!).digest('hex');
const admin = createSupabaseAdminClient();
const { data: invite } = token === 'new'
  ? { data: null }
  : await admin
      .from('invites')
      .select('email, role, expires_at, accepted_at, payload')
      .eq('token_hash', tokenHash)
      .maybeSingle();

const invalid = !invite;
const expired = Boolean(invite && new Date(invite.expires_at) < new Date());
const used = Boolean(invite && invite.accepted_at);
const usable = !invalid && !expired && !used;

const payload = (invite?.payload ?? {}) as { name?: string; locale?: string };
const lang: InviteLocale = isInviteLocale(payload.locale) ? payload.locale : authLang(Astro.url, Astro.cookies);

