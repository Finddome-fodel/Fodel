---
/**
 * Admin — photos added to live listings (spec §4c part 2, migration 0053).
 * Owners add photos to a published listing for free; each one waits here
 * until an admin approves it (it then appears on the public page, SSR, no
 * rebuild) or rejects it with a reason (the file is deleted and the owner gets
 * an e-mail in their language). Grouped by listing, oldest submission first.
 * Admin-only: the middleware (ADMIN_ONLY_PREFIXES) and the check below.
 */
export const prerender = false;

import Portal from '~/layouts/Portal.astro';
import { icon } from '~/lib/portal/icons';
import { timeAgo } from '~/lib/portal/time';
import { STATUS_LABEL } from '~/lib/portal/properties';
import { listingTitle } from '~/lib/portal/publish';
import { resolveImage } from '~/lib/property-images';
import { REJECTION_REASONS, NOTE_MAX, PHOTO_LIVE_STATUSES } from '~/lib/portal/photo-moderation';

const { supabase, profile } = Astro.locals;
if (profile?.role !== 'admin') return Astro.redirect('/portal/dashboard');

type Photo = {
  id: string;
  property_id: string;
  storage_path: string;
  alt: Record<string, string> | null;
  width: number | null;
  height: number | null;
  sort_order: number;
  pending: boolean;
  is_hero: boolean;
  submitted_at: string | null;
  created_at: string | null;
};

const { data: pendingRows, error } = await supabase
  .from('property_media')
  .select('id, property_id, storage_path, alt, width, height, sort_order, pending, is_hero, submitted_at, created_at')
  .eq('pending', true)
  .order('submitted_at', { ascending: true })
  .limit(600);
const migrated = !error;
const pending = (pendingRows ?? []) as Photo[];
const propertyIds = [...new Set(pending.map((p) => p.property_id))];

const [{ data: props }, { data: approvedRows }] = propertyIds.length
  ? await Promise.all([
      supabase.from('properties').select('id, ref, status, owner_id').in('id', propertyIds),
      supabase
        .from('property_media')
        .select('id, property_id, storage_path, is_hero, sort_order')
        .in('property_id', propertyIds)
        .eq('pending', false)
        .order('sort_order', { ascending: true }),
    ])
  : [{ data: [] }, { data: [] }];
const ownerIds = [...new Set((props ?? []).map((p: any) => p.owner_id).filter(Boolean))] as string[];
const { data: owners } = ownerIds.length
  ? await supabase.from('profiles').select('id, full_name, email').in('id', ownerIds)
  : { data: [] };

const titles = new Map(
  await Promise.all((props ?? []).map(async (p: any) => [p.id, await listingTitle(supabase, p.id, 'hu', p.ref)] as const))
);

const groups = propertyIds
  .map((id) => {
    const property = (props ?? []).find((p: any) => p.id === id) as { id: string; ref: string; status: string; owner_id: string | null } | undefined;
    const owner = (owners ?? []).find((o: any) => o.id === property?.owner_id) as { full_name: string | null; email: string | null } | undefined;
    const photos = pending.filter((p) => p.property_id === id).sort((a, b) => a.sort_order - b.sort_order);
    const approved = (approvedRows ?? []).filter((m: any) => m.property_id === id);
    const since = photos.map((p) => p.submitted_at ?? p.created_at).filter(Boolean).sort()[0] ?? null;
    return { id, property, owner, photos, approved, since, title: titles.get(id) ?? '' };
  })
  .filter((g) => g.property)
  .sort((a, b) => String(a.since).localeCompare(String(b.since)));

const total = groups.reduce((sum, g) => sum + g.photos.length, 0);

const src = (path: string) => (path.startsWith('http') ? path : resolveImage(path).src);
const caption = (p: Photo) => p.alt?.hu ?? p.alt?.nl ?? Object.values(p.alt ?? {})[0] ?? '';
const dateFmt = new Intl.DateTimeFormat('hu-HU', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Budapest' });
---

<Portal title="Új fotók">
  <header class="ph">
    <div>
      <p class="eyebrow">Fotómoderálás</p>
      <h1>Új fotók <em>jóváhagyásra</em></h1>
      <p class="lede">
        A tulajdonosok élő hirdetésükhöz díjmentesen tölthetnek fel új képeket. A nyilvános oldalon csak
        az itt jóváhagyott fotók jelennek meg, azonnal. Elutasításkor a kép törlődik, a tulajdonos pedig
        a saját nyelvén kap e-mailt az okkal.
      </p>
    </div>
    <p class="count" data-total-wrap><b data-total>{total}</b><span>kép vár</span></p>
  </header>

  {!migrated && <p class="notice error">Ehhez az oldalhoz futtassa le a 0053-as migrációt.</p>}

  {groups.length > 0 && (
    <div class="queue" data-queue>
      {groups.map((g) => (
        <section class="listing" id={`listing-${g.id}`} data-listing={g.id}>
          <header class="l-head">
            <div class="l-id">
              <p class="l-top">
                <span class="ref">#{g.property!.ref}</span>
                {!PHOTO_LIVE_STATUSES.includes(g.property!.status) && (
                  <span class="pill warn" title="A hirdetés közben kikerült az élő állapotból">{STATUS_LABEL[g.property!.status as keyof typeof STATUS_LABEL] ?? g.property!.status}</span>
                )}
                {g.since && <span class="muted" title={dateFmt.format(new Date(g.since))}>beküldve {timeAgo(g.since)}</span>}
              </p>
              <h2>{g.title || 'Névtelen hirdetés'}</h2>
              <p class="owner">
                <Fragment set:html={icon('users', 15)} />
                <span>{g.owner?.full_name || 'Ismeretlen tulajdonos'}</span>
                {g.owner?.email && <a href={`mailto:${g.owner.email}`} class="muted">{g.owner.email}</a>}
              </p>
            </div>
            <a class="btn ghost small" href={`/portal/properties/${g.id}#media`}>Hirdetés megnyitása →</a>
          </header>

          {g.approved.length > 0 && (
            <div class="current">
              <p class="current-t">Már a hirdetésben ({g.approved.length}) <span class="muted">— ismétlődés ellenőrzéséhez</span></p>
              <ul class="strip">
                {g.approved.slice(0, 14).map((m: any) => (
                  <li class:list={{ hero: m.is_hero }}><img src={src(m.storage_path)} alt="" loading="lazy" decoding="async" /></li>
                ))}
                {g.approved.length > 14 && <li class="more">+{g.approved.length - 14}</li>}
              </ul>
            </div>
          )}

          <ul class="grid">
            {g.photos.map((p) => (
              <li class="photo" data-photo={p.id}>
                <a class="thumb" href={src(p.storage_path)} target="_blank" rel="noopener" title="Teljes méret új lapon">
                  <img src={src(p.storage_path)} alt={caption(p)} loading="lazy" decoding="async" />
                  {p.width && p.height && <span class="dims">{p.width}×{p.height}</span>}
                  <span class="zoom" aria-hidden="true">↗</span>
                </a>
                <div class="p-body">
                  {caption(p) ? <p class="cap">„{caption(p)}”</p> : <p class="cap muted">Nincs leírás</p>}
                  <div class="choice" role="radiogroup" aria-label="Döntés">
                    <label class="opt ok"><input type="radio" name={`d-${p.id}`} value="approve" /><span>✓ Jóváhagyás</span></label>
                    <label class="opt no"><input type="radio" name={`d-${p.id}`} value="reject" /><span>✕ Elutasítás</span></label>
                  </div>
                  <div class="why">
                    <label>Elutasítás oka
                      <select data-reason>
                        <option value="">Válasszon…</option>
                        {REJECTION_REASONS.map((r) => <option value={r.code}>{r.label}</option>)}
                      </select>
                    </label>
                    <label>Megjegyzés a tulajdonosnak <span class="muted" data-note-hint>(nem kötelező)</span>
                      <textarea data-note rows="2" maxlength={NOTE_MAX} placeholder="Pl. a fürdőszoba képe túl sötét."></textarea>
                    </label>
                  </div>
                </div>
              </li>
            ))}
          </ul>

          <footer class="l-foot">
            <button type="button" class="btn ghost" data-approve-all>Összes jóváhagyása</button>
            <p class="tally" data-tally aria-live="polite">{g.photos.length} kép vár döntésre</p>
            <button type="button" class="btn" data-submit disabled>Döntések mentése</button>
          </footer>
        </section>
      ))}
    </div>
  )}

  <div class="empty" data-empty hidden={!migrated || groups.length > 0}>
    <span class="empty-ic" set:html={icon('image', 26)} />
    <p class="empty-t">Nincs jóváhagyásra váró fotó.</p>
    <p>Ha egy tulajdonos új képet tölt fel élő hirdetéséhez, itt jelenik meg, és e-mailt is küldünk róla.</p>
  </div>
</Portal>

<script>
  const ERRORS: Record<string, string> = {
    'no-decisions': 'Előbb döntsön legalább egy képről.',
    'too-many': 'Egyszerre legfeljebb 200 képről dönthet.',
    'invalid-photo': 'Egy kép már nem található. Frissítse az oldalt.',
    'invalid-action': 'Érvénytelen döntés.',
    'reason-required': 'Minden elutasított képhez válasszon okot.',
    'note-required': 'Az „Egyéb ok” esetén írja le az okot a megjegyzésben.',
    'note-too-long': 'A megjegyzés legfeljebb 500 karakter lehet.',
    'not-pending': 'Egy kép közben már elbírálásra került. Frissítse az oldalt.',
    'not-found': 'A hirdetés nem található.',
    forbidden: 'Nincs jogosultsága.',
  };
  const toast = (text: string, kind: 'ok' | 'error') => (window as any).pf?.toast(text, kind);

  type Decision = { id: string; action: 'approve' } | { id: string; action: 'reject'; reason: string; note?: string };

  function readSection(section: HTMLElement): { decisions: Decision[]; approve: number; reject: number; undecided: number; problem: string | null } {
    const decisions: Decision[] = [];
    let approve = 0, reject = 0, undecided = 0;
    let problem: string | null = null;
    section.querySelectorAll<HTMLElement>('[data-photo]').forEach((card) => {
      const id = card.dataset.photo!;
      const chosen = card.querySelector<HTMLInputElement>('input[type=radio]:checked')?.value;
      if (chosen === 'approve') { approve++; decisions.push({ id, action: 'approve' }); return; }
      if (chosen !== 'reject') { undecided++; return; }
      reject++;
      const reason = card.querySelector<HTMLSelectElement>('[data-reason]')!.value;
      const note = card.querySelector<HTMLTextAreaElement>('[data-note]')!.value.trim();
      if (!reason) problem ??= 'reason-required';
      else if (reason === 'other' && !note) problem ??= 'note-required';
      decisions.push(note ? { id, action: 'reject', reason, note } : { id, action: 'reject', reason });
    });
    return { decisions, approve, reject, undecided, problem };
  }

  function refresh(section: HTMLElement) {
    const { approve, reject, undecided } = readSection(section);
    const parts = [approve && `${approve} jóváhagyás`, reject && `${reject} elutasítás`, undecided && `${undecided} még döntésre vár`].filter(Boolean);
    section.querySelector('[data-tally]')!.textContent = parts.join(' · ');
    const submit = section.querySelector<HTMLButtonElement>('[data-submit]')!;
    submit.disabled = approve + reject === 0;
    submit.textContent = approve + reject > 0 ? `Döntések mentése (${approve + reject})` : 'Döntések mentése';
    section.querySelectorAll<HTMLElement>('[data-photo]').forEach((card) => {
      const reason = card.querySelector<HTMLSelectElement>('[data-reason]')!.value;
      card.querySelector('[data-note-hint]')!.textContent = reason === 'other' ? '(kötelező)' : '(nem kötelező)';
    });
  }

  function updateTotal() {
    const left = document.querySelectorAll('[data-photo]').length;
    const total = document.querySelector('[data-total]');
    if (total) total.textContent = String(left);
    if (!document.querySelector('[data-listing]')) {
      document.querySelector('[data-queue]')?.remove();
      document.querySelector<HTMLElement>('[data-empty]')?.removeAttribute('hidden');
    }
  }

  document.querySelectorAll<HTMLElement>('[data-listing]').forEach((section) => {
    section.addEventListener('change', (event) => {
      const target = event.target as HTMLElement;
      if (target.matches('input[value=reject]')) {
        target.closest('[data-photo]')?.querySelector<HTMLSelectElement>('[data-reason]')?.focus();
      }
      refresh(section);
    });
    section.addEventListener('input', () => refresh(section));

    section.querySelector('[data-approve-all]')!.addEventListener('click', () => {
      section.querySelectorAll<HTMLInputElement>('input[value=approve]').forEach((input) => { input.checked = true; });
      refresh(section);
    });

    const submit = section.querySelector<HTMLButtonElement>('[data-submit]')!;
    submit.addEventListener('click', async () => {
      const { decisions, problem } = readSection(section);
      if (problem) { toast(ERRORS[problem], 'error'); return; }
      if (!decisions.length) return;
      submit.disabled = true;
      submit.textContent = 'Mentés…';
      const response = await fetch('/api/portal/photos', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ propertyId: section.dataset.listing, decisions }),
      }).catch(() => null);
      const json = response ? await response.json().catch(() => ({})) : {};
      if (!response?.ok || !json.ok) {
        toast(ERRORS[json.error] ?? 'Nem sikerült menteni. Próbálja újra.', 'error');
        refresh(section);
        return;
      }
      const sentence = [
        json.approved ? `${json.approved} kép jóváhagyva` : '',
        json.rejected ? `${json.rejected} elutasítva` : '',
      ].filter(Boolean).join(', ');
      toast(`${sentence}.${json.emailed ? ' A tulajdonost e-mailben értesítettük.' : ''}`, 'ok');
      const done = new Set(decisions.map((d) => d.id));
      section.querySelectorAll<HTMLElement>('[data-photo]').forEach((card) => {
        if (!done.has(card.dataset.photo!)) return;
        card.classList.add('leaving');
        setTimeout(() => card.remove(), 280);
      });
      setTimeout(() => {
        if (!section.querySelector('[data-photo]')) {
          section.classList.add('leaving');
          setTimeout(() => { section.remove(); updateTotal(); }, 300);
        } else refresh(section);
        updateTotal();
      }, 300);
    });
  });
</script>

<style>
  .ph { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 20px 48px; margin-bottom: 30px; }
  .eyebrow { margin-bottom: 14px; }
  h1 em { font-style: normal; font-weight: inherit; color: var(--ink-quiet); }
  .lede { max-width: 66ch; margin-top: 14px; font-size: var(--fs-body); line-height: 1.7; color: var(--ink-quiet); }
  .count { display: flex; align-items: baseline; gap: 8px; }
  .count b { font-family: var(--serif); font-weight: var(--fw-display); font-size: 44px; line-height: 1; color: var(--ink); }
  .count span { color: var(--ink-quiet); }
  .muted { color: var(--ink-quiet); }

  .queue { display: grid; gap: 22px; }
  .listing { position: relative; padding: clamp(20px, 2.4vw, 30px); border-radius: var(--r-xl); background: var(--white); box-shadow: var(--shadow-xs), 0 0 0 1px var(--pt-hair); overflow: clip; scroll-margin-top: 90px; transition: opacity 0.3s var(--ease-out), transform 0.3s var(--ease-out); }
  .listing::before { content: ''; position: absolute; inset: 0 auto 0 0; width: 4px; background: #c99a1b; }
  .listing:target { box-shadow: var(--shadow-md), 0 0 0 2px var(--ink); }
  .listing.leaving { opacity: 0; transform: translateY(-6px); }
  .l-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-start; gap: 14px 24px; margin-bottom: 18px; }
  .l-top { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-bottom: 8px; font-size: 13.5px; }
  .ref { font-variant-numeric: tabular-nums; letter-spacing: 0.04em; color: var(--ink); font-weight: var(--fw-medium); }
  .pill { padding: 3px 12px; border-radius: var(--r-pill); font-size: 12.5px; }
  .pill.warn { background: var(--pt-amber-bg); color: var(--pt-amber); }
  .l-head h2 { font-family: var(--serif); font-weight: var(--fw-display); font-size: 22px; line-height: 1.3; letter-spacing: var(--ls-heading); color: var(--ink); text-wrap: balance; }
  .owner { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 8px; font-size: 14px; color: var(--ink); }
  .owner :global(svg) { width: 15px; height: 15px; color: var(--ink-quiet); }
  .owner a { text-decoration: none; }
  .owner a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .btn.small { min-height: 38px; padding: 8px 16px; font-size: 14px; }

  .current { margin-bottom: 20px; padding: 12px 14px; border-radius: var(--r-lg); background: var(--paper); }
  .current-t { margin-bottom: 10px; font-size: 13px; color: var(--ink); }
  .strip { display: flex; flex-wrap: wrap; gap: 6px; padding: 0; list-style: none; }
  .strip li { width: 64px; height: 46px; border-radius: 6px; overflow: hidden; background: var(--white); }
  .strip li.hero { box-shadow: 0 0 0 2px var(--ink); }
  .strip img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .strip .more { display: grid; place-items: center; font-size: 13px; color: var(--ink-quiet); }

  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 16px; padding: 0; list-style: none; }
  .photo { display: flex; flex-direction: column; border-radius: var(--r-lg); background: var(--white); box-shadow: 0 0 0 1px var(--pt-hair); overflow: hidden; transition: box-shadow 0.25s var(--ease-out), opacity 0.28s var(--ease-out), transform 0.28s var(--ease-out); }
  .photo.leaving { opacity: 0; transform: scale(0.97); }
  .photo:has(input[value=approve]:checked) { box-shadow: 0 0 0 2px var(--pt-green); }
  .photo:has(input[value=reject]:checked) { box-shadow: 0 0 0 2px var(--pt-red); }
  .thumb { position: relative; display: block; aspect-ratio: 4 / 3; background: var(--paper); overflow: hidden; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.5s var(--ease-out); }
  .dims, .zoom { position: absolute; bottom: 8px; padding: 3px 9px; border-radius: var(--r-pill); background: rgba(16, 42, 67, 0.72); color: var(--white); font-size: 11.5px; font-variant-numeric: tabular-nums; }
  .dims { left: 8px; }
  .zoom { right: 8px; opacity: 0; transition: opacity 0.2s var(--ease-out); }
  @media (hover: hover) {
    .thumb:hover img { transform: scale(1.03); }
    .thumb:hover .zoom, .thumb:focus-visible .zoom { opacity: 1; }
  }
  .p-body { display: grid; gap: 12px; padding: 14px; }
  .cap { font-size: 13.5px; line-height: 1.5; color: var(--ink); overflow-wrap: anywhere; }
  .choice { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; padding: 4px; border-radius: var(--r-pill); background: var(--paper); }
  .opt { position: relative; cursor: pointer; }
  .opt input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .opt span { display: grid; place-items: center; min-height: 38px; border-radius: var(--r-pill); font-size: 13.5px; color: var(--ink-quiet); transition: background-color 0.2s var(--ease-out), color 0.2s var(--ease-out); }
  .opt input:focus-visible + span { outline: 2px solid var(--ink); outline-offset: 2px; }
  .opt.ok input:checked + span { background: var(--pt-green); color: var(--white); }
  .opt.no input:checked + span { background: var(--pt-red); color: var(--white); }
  @media (hover: hover) { .opt input:not(:checked) + span:hover { color: var(--ink); background: var(--white); } }
  .why { display: none; gap: 10px; }
  .photo:has(input[value=reject]:checked) .why { display: grid; }
  .why label { display: grid; gap: 6px; font-size: 13px; color: var(--ink-quiet); }
  .why select, .why textarea { width: 100%; padding: 9px 12px; font-size: 14px; color: var(--ink); }

  .l-foot { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 18px; margin-top: 20px; padding-top: 18px; border-top: 1px solid var(--pt-hair); }
  .tally { flex: 1; min-width: 160px; font-size: 14px; color: var(--ink-quiet); }
  .l-foot [data-submit]:disabled { opacity: 0.45; cursor: not-allowed; }

  .empty { display: grid; justify-items: center; gap: 10px; padding: 56px 20px; border-radius: var(--r-xl); background: var(--paper); box-shadow: 0 0 0 1px var(--pt-hair); text-align: center; color: var(--ink-quiet); }
  .empty[hidden] { display: none; }
  .empty-t { font-size: 17px; color: var(--ink); }
  .empty-ic { display: grid; place-items: center; width: 60px; height: 60px; margin-bottom: 6px; border-radius: 50%; background: var(--white); color: var(--ink); box-shadow: var(--shadow-sm); }

  @media (max-width: 560px) {
    .l-foot { flex-direction: column; align-items: stretch; }
    .l-foot .btn { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) { .listing, .photo, .thumb img, .opt span, .zoom { transition: none; } }
</style>
