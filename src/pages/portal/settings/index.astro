---
export const prerender = false;

import Portal from '~/layouts/Portal.astro';
import { path } from '~/i18n/ui';
import { SITE_URL } from '~/config/site.mjs';
import { icon } from '~/lib/portal/icons';
import BillingForm from '~/components/BillingForm.astro';
import PhoneField from '~/components/forms/PhoneField.astro';
import { eur, dateHu, KIND_LABEL } from '~/lib/invoicing/model';

const { profile, supabase, user } = Astro.locals;
const saved = Astro.url.searchParams.get('saved');
const err = Astro.url.searchParams.get('error');

const referralLocale = profile?.locale === 'nl' ? 'nl' : 'hu';
const referralLink = profile?.referral_code
  ? `${SITE_URL}${path(referralLocale, 'submitAd')}?ref=${profile.referral_code}`
  : null;

// The customer's saved billing details and their own finalised invoices (RLS
// shows an owner nothing else). Both quietly come back empty until migration
// 0018 has been run.
const [{ data: billingRow }, { data: myInvoices }] = await Promise.all([
  supabase.from('profiles').select('billing').eq('id', user!.id).maybeSingle(),
  profile?.role === 'admin'
    ? Promise.resolve({ data: [] as any[] })
    : supabase.from('invoices').select('id, number, kind, status, gross_cents, vat_rate, issued_at, view_token').not('number', 'is', null).order('issued_at', { ascending: false }).limit(12),
]);
const billing = (billingRow as { billing?: Record<string, string> } | null)?.billing ?? null;
---

<Portal title="Beállítások">
  <header class="ph"><div>
    <p class="eyebrow">Fiók</p>
    <h1>Beállítások és <em>profil</em></h1>
    <p class="lede">Elérhetőségei, számlázási adatai és jelszava egy helyen.</p>
  </div></header>

  {profile?.role === 'admin' && (
    <nav class="pt-shortcuts" aria-label="Admin beállítások">
      {[
        ['/portal/settings/company', 'Cégadatok', 'Elérhetőségek, WhatsApp, nyilvános adatok', 'building'],
        ['/portal/settings/invoicing', 'Számlázás', 'Könyvelő, fizetési határidő, sorszámozás', 'invoice'],
        ['/portal/settings/packages', 'Hirdetési csomagok', 'Árak, időtartam, képszám, videó, telefonszám', 'card'],
        ['/portal/settings/services', 'Szolgáltatások', 'Értékbecslés, lejárat, automatizmusok', 'gear'],
        ['/portal/settings/templates', 'Meghívólevelek', 'A tulajdonosoknak küldött levelek szövege', 'mail'],
        ['/portal/taxonomy', 'Szótár', 'Ingatlantípusok, jellemzők, blogkategóriák fordításai', 'pen'],
      ].map(([href, title, text, ic]) => (
        <a class="pt-shortcut" href={href}>
          <div>
            <b>{title}</b>
            <span>{text}</span>
          </div>
          <Fragment set:html={icon(ic as any, 20)} />
        </a>
      ))}
    </nav>
  )}

  {saved === 'profile' && <p class="notice ok" data-toast="ok">Profil mentve.</p>}
  {saved === 'password' && <p class="notice ok" data-toast="ok">Jelszó megváltoztatva.</p>}
  {err && <p class="notice error">{decodeURIComponent(err)}</p>}

  <div class="set-stack">
    <form method="POST" action="/api/portal/settings/profile" class="set-card">
      <h2>Adatok</h2>
      <div class="set-grid">
        <label>Teljes név<input id="full_name" name="full_name" value={profile?.full_name ?? ''} autocomplete="name" /></label>
        <div class="wide ro"><span>E-mail cím</span><b>{profile?.email}</b></div>
      </div>
      <div class="set-phone"><PhoneField locale={referralLocale} name="phone" id="phone" value={profile?.phone ?? ''} /></div>
      <div class="actions"><button type="submit" class="btn">Mentés</button></div>
    </form>

    <section class="set-card" id="szamlazas">
      <h2>Számlázási adatok</h2>
      <p class="set-sub">
        Ezek az adatok kerülnek a számlákra. Egyszer adja meg, és minden megrendelésnél automatikusan használjuk.
        Vállalkozásként az adószámával áfa nélküli (fordított adózású) számlát kaphat.
      </p>
      <BillingForm billing={billing} fallbackName={profile?.full_name ?? ''} fallbackPhone={profile?.phone ?? ''} />
    </section>

    {(myInvoices ?? []).length > 0 && (
      <section class="set-card">
        <h2>Számláim</h2>
        <ul class="my-inv">
          {(myInvoices ?? []).map((i: any) => (
            <li>
              <a href={`/portal/invoices/${i.id}?t=${i.view_token}`}>
                <b>{i.number}</b>
                <span>{KIND_LABEL[i.kind as keyof typeof KIND_LABEL]?.short ?? 'Számla'} · {dateHu(String(i.issued_at).slice(0, 10))}</span>
              </a>
              <em>{eur(i.gross_cents * (i.kind === 'credit_note' ? -1 : 1))}</em>
              <a class="dl" href={`/portal/invoices/pdf/${i.id}?download=1`} aria-label={`PDF letöltése: ${i.number}`}><Fragment set:html={icon('download', 17)} /></a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <form method="POST" action="/api/portal/settings/password" class="set-card">
      <h2>Jelszó megváltoztatása</h2>
      <div class="set-grid">
        <label>Új jelszó<input id="password" name="password" type="password" required minlength="8" autocomplete="new-password" /></label>
        <label>Új jelszó ismét<input id="password2" name="password2" type="password" required minlength="8" autocomplete="new-password" /></label>
      </div>
      <div class="actions"><button type="submit" class="btn">Jelszó módosítása</button></div>
    </form>

    {referralLink && (
      <section class="set-card">
        <h2>Ajánlói link</h2>
        <p class="set-sub">
          Ha valaki ezen a linken keresztül ad fel hirdetést, 10% kedvezményt kap, és a következő
          hirdetésének díjából mi 10%-ot jóváírunk Önnek.
        </p>
        <div class="referral-row">
          <input id="referral-link" class="readonly-input" value={referralLink} readonly />
          <button type="button" class="btn ghost" id="copy-referral">Másolás</button>
        </div>
      </section>
    )}
  </div>
</Portal>

<script>
  const button = document.getElementById('copy-referral');
  const input = document.getElementById('referral-link') as HTMLInputElement | null;
  button?.addEventListener('click', async () => {
    if (!input) return;
    try {
      await navigator.clipboard.writeText(input.value);
      window.pf?.toast('Link vágólapra másolva.', 'ok');
    } catch {
      input.select();
      window.pf?.toast('Jelölje ki és másolja a linket.', 'warn');
    }
  });
</script>

<style>
  .ro { display: grid; gap: 6px; font-size: var(--fs-small); }
  .ro span { font-weight: var(--fw-medium); color: var(--ink); }
  .ro b { font-weight: var(--fw-regular); font-size: var(--fs-body); color: var(--ink-quiet); }
  .actions { margin-top: 20px; }
  .referral-row { display: flex; gap: 10px; flex-wrap: wrap; }
  .readonly-input { flex: 1; min-width: 220px; min-height: 50px; padding: 12px 16px; border-radius: var(--r-md); background: var(--paper); font: inherit; font-size: var(--fs-small); color: var(--ink); }
  .my-inv { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .my-inv li { display: grid; grid-template-columns: minmax(0, 1fr) auto 40px; align-items: center; gap: 14px; padding: 6px 8px 6px 4px; border-radius: var(--r-md); background: var(--paper); }
  .my-inv li > a:first-child { display: grid; gap: 1px; padding: 8px 12px; text-decoration: none; color: inherit; }
  .my-inv b { font-weight: var(--fw-medium); color: var(--ink); }
  .my-inv span { font-size: 13.5px; color: var(--ink-quiet); }
  .my-inv em { font-style: normal; font-weight: var(--fw-medium); font-variant-numeric: tabular-nums; }
  .my-inv .dl { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%; background: #fff; box-shadow: inset 0 0 0 1px var(--pt-hair); color: var(--ink); }
</style>
