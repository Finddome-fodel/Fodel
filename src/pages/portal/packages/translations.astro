---
/**
 * Csomagok → Fordítási csomagok: the three translation packages (Basic, Európa, World) as the owners see them.
 * Name, price, badge and pitch per package, which one is recommended, and which languages each covers (a rule
 * that follows the site's languages, or a hand-made list). The live preview shows the cards as an owner sees
 * them. Saved by /api/portal/packages/translations; new prices apply to new orders only.
 */
export const prerender = false;

import Portal from '~/layouts/Portal.astro';
import TranslationPackagesNav from '~/components/portal/TranslationPackagesNav.astro';
import { listingCatalog } from '~/lib/listing-packages';
import { ALL_LOCALES, HU_NAME } from '~/lib/ai/translate-core';
import { packageLanguageCount, packageLocales, renderPitch, worldDeal } from '~/lib/translation-packages';

const { supabase, profile } = Astro.locals;
if (profile?.role !== 'admin') return Astro.redirect('/portal/dashboard');

const { data: row } = await supabase.from('site_settings').select('*').eq('id', 1).maybeSingle();
const migrated = Boolean(row && 'services' in row);
const cfg = listingCatalog(row?.services).translation;
const deal = worldDeal(cfg);
const saved = Astro.url.searchParams.has('saved');
const err = Astro.url.searchParams.get('error');
const targets = ALL_LOCALES;
const languages = targets.filter((code) => code !== 'hu');
const eur = (n: number) => `${n.toLocaleString('hu-HU', { maximumFractionDigits: 2 })} €`;
const previewData = {
  cfg, targets,
  counts: Object.fromEntries(cfg.packages.map((pkg) => [pkg.id, packageLanguageCount(pkg, targets)])),
  pitches: Object.fromEntries(cfg.packages.map((pkg) => [pkg.id, renderPitch(pkg, 'hu', cfg, targets)])),
};
const PLACEHOLDERS = '{count} {europe} {world} {worldOnlySum} {europePlus} {singleEuropean} {singleWorld}';
---

<Portal title="Fordítási csomagok">
  <header class="ph">
    <div>
      <p class="eyebrow"><a href="/portal/settings">← Beállítások</a></p>
      <h1>Fordítási <em>csomagok</em></h1>
      <p class="lede">A Basic minden hirdetésben benne van, az Európa és a World megvásárolható. A csomag szabály, nem lista: ha új nyelv kerül az oldalra, magától bekerül az Európába vagy a Worldbe. Az angol minden csomagban benne van, és nem kapcsolható ki.</p>
    </div>
  </header>

  <TranslationPackagesNav current="translations" />

  {!migrated && <p class="notice error">Ehhez a beállításhoz futtassa le a 0014-es migrációt.</p>}
  {saved && <p class="notice ok" data-toast="ok">Mentve. Az új árak az új rendelésekre érvényesek.</p>}
  {err && <p class="notice error">{err}</p>}
  {!deal.ok && <p class="notice warn">A World ({eur(deal.world)}) drágább, mint az Európa és az összes Európán kívüli nyelv egyenként ({eur(deal.europePlusSingles)}). Ellenőrizze az árakat az „Egyedi nyelvek” fülön.</p>}

  <form method="POST" action="/api/portal/packages/translations" id="tp-form" class="tpa-form" data-preview={JSON.stringify(previewData)}>
    <fieldset disabled={!migrated}>
      <section class="tpa-card" aria-labelledby="pv-title">
        <h2 id="pv-title">Így látja a hirdető</h2>
        <div class="pv-cards" data-preview-cards>
          {cfg.packages.map((pkg) => (
            <div class="pv-card" data-pv={pkg.id}>
              <p class="pv-top"><b data-pv-name>{pkg.names.hu}</b><span class="pv-badge" data-pv-badge hidden={!pkg.badge.hu}>{pkg.badge.hu}</span></p>
              <p class="pv-price" data-pv-price>{pkg.id === 'basic' ? 'Benne van' : eur(pkg.priceEur)}</p>
              <p class="pv-count" data-pv-count>{previewData.counts[pkg.id]} nyelv</p>
              <p class="pv-pitch" data-pv-pitch>{previewData.pitches[pkg.id]}</p>
            </div>
          ))}
        </div>
      </section>

      {cfg.packages.map((pkg) => {
        const k = (field: string) => `${pkg.id}_${field}`;
        const covered = packageLocales(pkg, targets);
        const isGo = pkg.id === 'basic';
        return (
          <section class="tpa-card tpa-pkg" data-pkg={pkg.id}>
            <header class="tpa-head">
              <h2>{pkg.names.hu}</h2>
              {isGo ? (
                <span class="tpa-fixed">Mindig ingyenes és bekapcsolt</span>
              ) : (
                <span class="tpa-head-tools">
                  <label class="tpa-rec"><input type="radio" name="recommended" value={pkg.id} checked={pkg.recommended} /><span>Ajánlott</span></label>
                  <label class="tpa-sw"><input type="checkbox" name={k('active')} value="yes" checked={pkg.active} /><span class="tpa-switch" aria-hidden="true"></span><span>Megvásárolható</span></label>
                </span>
              )}
            </header>
            {isGo && <input type="hidden" name={k('active')} value="yes" />}

            <div class="tpa-grid">
              <div class="tpa-block">
                <p class="tpa-label">Név</p>
                <div class="tpa-row">
                  <label class="tpa-f"><span>Magyar</span><input type="text" name={k('name_hu')} maxlength="40" value={pkg.names.hu} data-bind="name" required /></label>
                  <label class="tpa-f"><span>Angol</span><input type="text" name={k('name_en')} maxlength="40" value={pkg.names.en} required /></label>
                  <label class="tpa-f"><span>Holland</span><input type="text" name={k('name_nl')} maxlength="40" value={pkg.names.nl} required /></label>
                </div>
              </div>
              <div class="tpa-block">
                <p class="tpa-label">Ár</p>
                <label class="tpa-f"><span class="tpa-unit"><input type="number" name={k('price')} min="0" max="10000" step="0.5" value={pkg.priceEur} data-bind="price" disabled={isGo} required={!isGo} /><i>€</i></span></label>
              </div>
              <div class="tpa-block">
                <p class="tpa-label">Címke a kártyán</p>
                <div class="tpa-row">
                  <label class="tpa-f"><span>Magyar</span><input type="text" name={k('badge_hu')} maxlength="40" value={pkg.badge.hu} data-bind="badge" /></label>
                  <label class="tpa-f"><span>Angol</span><input type="text" name={k('badge_en')} maxlength="40" value={pkg.badge.en} /></label>
                  <label class="tpa-f"><span>Holland</span><input type="text" name={k('badge_nl')} maxlength="40" value={pkg.badge.nl} /></label>
                </div>
              </div>
            </div>

            <div class="tpa-block">
              <p class="tpa-label">Meggyőző szöveg</p>
              <div class="tpa-row">
                <label class="tpa-f"><span>Magyar</span><textarea name={k('pitch_hu')} rows="6" maxlength="900" data-bind="pitch">{pkg.pitch.hu}</textarea></label>
                <label class="tpa-f"><span>Angol</span><textarea name={k('pitch_en')} rows="6" maxlength="900">{pkg.pitch.en}</textarea></label>
                <label class="tpa-f"><span>Holland</span><textarea name={k('pitch_nl')} rows="6" maxlength="900">{pkg.pitch.nl}</textarea></label>
              </div>
              <p class="tpa-note">A számokat a rendszer tölti ki, ezért nem kell őket beírni: <code>{PLACEHOLDERS}</code>. Az Egyedi nyelvek fülön módosított ár így a szövegben is frissül.</p>
            </div>

            <div class="tpa-block">
              <p class="tpa-label">Nyelvek ({packageLanguageCount(pkg, targets)} az eredetivel együtt)</p>
              <p class="tpa-note">
                {pkg.id === 'basic' ? 'Az eredeti nyelv, az angol és a német.' : pkg.id === 'europe' ? 'Minden nyelv, kivéve az Európán kívüli nyelveket (Egyedi nyelvek fül).' : 'Minden nyelv.'}
                Így követi a csomag az oldal nyelveit.
              </p>
              <label class="tpa-sw tpa-override">
                <input type="checkbox" name={k('override')} value="yes" checked={Boolean(pkg.locales)} data-override />
                <span class="tpa-switch" aria-hidden="true"></span>
                <span>Saját lista a szabály helyett</span>
              </label>
              <div class="tpa-chips" data-langs data-editable={pkg.locales ? 'yes' : 'no'}>
                {languages.map((code) => (
                  <label class={`tpa-chip${code === 'en' ? ' is-locked' : ''}`}>
                    <input type="checkbox" name={k('locale')} value={code} checked={covered.includes(code)} disabled={code === 'en' || !pkg.locales} />
                    <span class="tpa-box" aria-hidden="true"></span>
                    <span>{HU_NAME[code] ?? code}</span>
                  </label>
                ))}
              </div>
            </div>
          </section>
        );
      })}

      <div class="tpa-actions"><button type="submit" class="btn">Mentés</button></div>
    </fieldset>
  </form>
</Portal>

<script>
  const form = document.getElementById('tp-form') as HTMLFormElement | null;
  if (form) {
    const data = JSON.parse(form.dataset.preview || '{}');
    const eur = (n: number) => `${n.toLocaleString('hu-HU', { maximumFractionDigits: 2 })} €`;
    const sections = [...form.querySelectorAll<HTMLElement>('[data-pkg]')];

    function sync() {
      for (const section of sections) {
        const id = section.dataset.pkg!;
        const card = form!.querySelector<HTMLElement>(`[data-pv="${id}"]`)!;
        const val = (bind: string) => section.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[data-bind="${bind}"]`)?.value ?? '';
        card.querySelector('[data-pv-name]')!.textContent = val('name') || '—';
        const badge = card.querySelector<HTMLElement>('[data-pv-badge]')!;
        badge.textContent = val('badge');
        badge.hidden = !val('badge');
        card.querySelector('[data-pv-price]')!.textContent = id === 'basic' ? 'Benne van' : eur(Number(val('price')) || 0);
        // The numbers in the pitch come from the saved configuration: the text shown is the typed one with them filled in.
        const prices = { count: data.counts[id], europe: Number(form!.querySelector<HTMLInputElement>('[data-pkg="europe"] [data-bind="price"]')?.value) || 0, world: Number(form!.querySelector<HTMLInputElement>('[data-pkg="world"] [data-bind="price"]')?.value) || 0, singleEuropean: data.cfg.singleEur.european, singleWorld: data.cfg.singleEur.world, worldOnlySum: data.cfg.worldOnly.length * data.cfg.singleEur.world };
        const filled: Record<string, number> = { ...prices, europePlus: prices.europe + prices.worldOnlySum };
        card.querySelector('[data-pv-pitch]')!.textContent = val('pitch').replace(/\{(\w+)\}/g, (match, key) => (key in filled ? String(filled[key]) : match));
        const list = section.querySelector<HTMLElement>('[data-langs]')!;
        const override = section.querySelector<HTMLInputElement>('[data-override]')!;
        list.dataset.editable = override.checked ? 'yes' : 'no';
        list.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach((box) => (box.disabled = !override.checked || box.value === 'en'));
        const count = override.checked ? list.querySelectorAll<HTMLInputElement>('input:checked').length + 1 : data.counts[id];
        card.querySelector('[data-pv-count]')!.textContent = `${count} nyelv`;
      }
    }
    form.addEventListener('input', sync);
    form.addEventListener('change', sync);
    sync();
  }
</script>

<style is:global>
  .tpa-form fieldset { display: grid; gap: 20px; border: 0; padding: 0; margin: 0; min-width: 0; }
  .tpa-card { padding: 24px; border-radius: var(--r-lg); background: var(--white); box-shadow: inset 0 0 0 1px var(--pt-hair); }
  .tpa-card h2 { margin: 0; font-family: var(--serif); font-weight: var(--fw-medium); font-size: 20px; color: var(--ink); }
  .tpa-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px 20px; margin-bottom: 18px; }
  .tpa-head-tools { display: inline-flex; flex-wrap: wrap; gap: 6px 22px; align-items: center; }
  .tpa-fixed { font-size: 13px; color: var(--ink-quiet); }
  .tpa-grid { display: grid; gap: 20px 32px; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); margin-bottom: 20px; }
  .tpa-grid > .tpa-block:nth-child(3) { grid-column: 1 / -1; }
  .tpa-block { min-width: 0; }
  .tpa-block + .tpa-block { margin-top: 0; }
  .tpa-label { margin: 0 0 8px; font-size: 12px; letter-spacing: 0.05em; text-transform: uppercase; color: var(--ink-quiet); }
  .tpa-row { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(min(190px, 100%), 1fr)); }
  .tpa-f { display: grid; gap: 6px; font-size: 13.5px; color: var(--ink-quiet); min-width: 0; }
  .tpa-f input[type='text'], .tpa-f textarea { width: 100%; min-height: 44px; padding: 10px 12px; border: 1px solid var(--pt-hair); border-radius: var(--r-md); font: inherit; font-size: 15px; line-height: 1.5; color: var(--ink); background: var(--paper); }
  .tpa-f textarea { resize: vertical; min-height: 130px; }
  .tpa-f input:focus-visible, .tpa-f textarea:focus-visible { outline: var(--focus-ring); outline-offset: 2px; }
  .tpa-unit { display: flex; align-items: center; gap: 10px; }
  .tpa-unit input { width: 110px; min-height: 44px; padding: 0 12px; border: 1px solid var(--pt-hair); border-radius: var(--r-md); font: inherit; font-size: 16px; color: var(--ink); background: var(--paper); font-variant-numeric: tabular-nums; }
  .tpa-unit input:disabled { opacity: 0.55; }
  .tpa-unit input:focus-visible { outline: var(--focus-ring); outline-offset: 2px; }
  .tpa-unit i { font-style: normal; font-size: 13px; color: var(--ink-quiet); }
  .tpa-note { margin: 8px 0 12px; max-width: 70ch; font-size: 13px; line-height: 1.55; color: var(--ink-quiet); }
  .tpa-note code { font-size: 12px; background: var(--linen); padding: 1px 6px; border-radius: 6px; }
  .tpa-rec { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; color: var(--ink); cursor: pointer; }
  .tpa-sw { position: relative; display: inline-flex; align-items: center; gap: 10px; min-height: 44px; font-size: 14px; color: var(--ink); cursor: pointer; }
  .tpa-sw input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .tpa-switch { flex: none; position: relative; width: 36px; height: 20px; border-radius: 10px; background: rgba(16, 42, 67, 0.2); transition: background-color 0.3s var(--ease-out); }
  .tpa-switch::after { content: ''; position: absolute; top: 2px; left: 2px; width: 16px; height: 16px; border-radius: 50%; background: var(--white); transition: transform 0.25s var(--ease-out); }
  .tpa-sw:has(input:checked) .tpa-switch { background: var(--ink); }
  .tpa-sw:has(input:checked) .tpa-switch::after { transform: translateX(16px); }
  .tpa-sw:has(input:focus-visible) .tpa-switch { outline: var(--focus-ring); outline-offset: 3px; }
  .tpa-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 6px; }
  .tpa-chip { position: relative; display: inline-flex; align-items: center; gap: 10px; min-height: 40px; padding: 4px 14px 4px 10px; border-radius: var(--r-pill); border: 1px solid rgba(16, 42, 67, 0.14); background: var(--paper); font-size: 14px; color: var(--ink); cursor: pointer; transition: background-color 0.3s var(--ease-out), border-color 0.3s var(--ease-out); }
  .tpa-chip input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .tpa-box { width: 18px; height: 18px; border-radius: 50%; border: 1.5px solid rgba(16, 42, 67, 0.3); display: grid; place-items: center; }
  .tpa-box::after { content: ''; width: 7px; height: 4px; border-left: 2px solid var(--cream); border-bottom: 2px solid var(--cream); transform: rotate(-45deg) scale(0); margin-top: -2px; transition: transform 0.25s var(--ease-out); }
  .tpa-chip:has(input:checked) { background: var(--ink); border-color: var(--ink); color: var(--cream); }
  .tpa-chip:has(input:checked) .tpa-box { border-color: var(--cream); background: var(--ink); }
  .tpa-chip:has(input:checked) .tpa-box::after { transform: rotate(-45deg) scale(1); }
  .tpa-chip:has(input:focus-visible) { outline: var(--focus-ring); outline-offset: 3px; }
  [data-langs][data-editable='no'] .tpa-chip { cursor: default; }
  [data-langs][data-editable='no'] .tpa-chip:not(:has(input:checked)) { opacity: 0.5; }
  .tpa-actions { display: flex; justify-content: flex-end; }
  .pv-cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-top: 12px; }
  .pv-card { padding: 18px; border-radius: var(--r-lg); background: var(--paper); box-shadow: inset 0 0 0 1px var(--pt-hair); min-width: 0; }
  .pv-top { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 6px 10px; margin: 0 0 6px; }
  .pv-top b { font-family: var(--serif); font-weight: var(--fw-medium); font-size: 22px; color: var(--ink); }
  .pv-badge { font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; padding: 3px 9px; border-radius: var(--r-pill); background: var(--linen); color: var(--ink); }
  .pv-badge[hidden] { display: none; }
  .pv-price { margin: 0 0 2px; font-size: 18px; font-variant-numeric: tabular-nums; color: var(--ink); }
  .pv-count { margin: 0 0 10px; font-size: 13.5px; color: var(--ink-quiet); }
  .pv-pitch { margin: 0; font-size: 13.5px; line-height: 1.6; color: var(--ink-quiet); }
  @media (max-width: 860px) { .pv-cards { grid-template-columns: 1fr; } .tpa-grid { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .tpa-chip, .tpa-box::after, .tpa-switch, .tpa-switch::after { transition: none; } }
</style>
