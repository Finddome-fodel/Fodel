---
/**
 * Csomagok → Egyedi nyelvek: placeholder. The translation packages (CC-3 in
 * claude-code-translations.md) replace this page; the tab, the route, the
 * guard and the endpoint (/api/portal/packages/languages) already exist.
 */
export const prerender = false;

import PackagesShell from '~/components/portal/PackagesShell.astro';

const { profile } = Astro.locals;
if (profile?.role !== 'admin') return Astro.redirect('/portal/dashboard');
---

<PackagesShell tab="languages">
  <section class="set-card pk-soon">
    <span class="pill">Hamarosan</span>
    <h2>Egyedi nyelvek</h2>
    <p>Itt adhatja meg majd az egyenként rendelhető nyelvek árát (európai nyelvek és a csak a World csomagban elérhető nyelvek), és hogy melyik nyelv melyik csoportba tartozik.</p>
  </section>
</PackagesShell>
