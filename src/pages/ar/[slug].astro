---
/**
 * Property detail route.
 *
 * Slug mirrors FODEL's existing pattern (fodel.nl/woonhuis-te-koop-1550), so
 * when their real inventory migrates the 301 map is mechanical.
 *
 * Rendered on request now, not built once from a fixed list of Markdown
 * files: the property might have just been approved in the portal. A short
 * CDN cache keeps this as fast as the old static page.
 */
export const prerender = false;

import PropertyDetailPage from '~/components/pages/PropertyDetailPage.astro';
import { activeProperties, text } from '~/lib/properties';
import { localeGate } from '~/lib/listing-locale-gate';
import { ROUTES } from '~/i18n/ui';

const { slug } = Astro.params;
const properties = await activeProperties();
const property = properties.find(
  (p) =>
    slug ===
    ROUTES.ar.detail(p.data.categorySlugs.ar ?? p.data.category, p.data.ref)
);

if (!property) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}

// A language this listing is not published in has no page of its own: the visitor goes to the English one (F1, one rule for all 28 routes).
const gate = await localeGate(property, 'ar');
if (gate) return Astro.redirect(gate.to, gate.status);

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=120');

// The long-form prose below the summary, falling back to Hungarian when a
// locale has none — see the note in supabase/migrations/0002_seed_properties.sql.
const paragraphs = text(property.data.body, 'ar').split('\n\n').filter(Boolean);
---

<PropertyDetailPage locale="ar" property={property}>
  {paragraphs.map((para) => <p>{para}</p>)}
</PropertyDetailPage>
