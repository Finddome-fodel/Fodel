import { ownerLink, RENEW_LINK_DAYS } from '~/lib/owner-links';
import { localeFrom, localizer, type Locale } from '~/i18n/ui';
import { intlTag } from '~/lib/format';

const ACTIONS = ['still-available', 'price', 'sold', 'renew'] as const;
type Action = (typeof ACTIONS)[number];

const action = Astro.params.action as Action;
if (!ACTIONS.includes(action)) return new Response('Not found', { status: 404 });

const url = Astro.url;
const id = url.searchParams.get('p') ?? '';
const token = url.searchParams.get('t') ?? '';
const locale: Locale = localeFrom(url.searchParams.get('l'));
// Hungarian owners think in forints; everyone else in euros.
const hu = locale === 'hu';
const x = localizer(locale);
Astro.response.headers.set('cache-control', 'no-store');
Astro.response.headers.set('referrer-policy', 'no-referrer');

