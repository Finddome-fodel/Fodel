---
/**
 * One-click owner actions from the lifecycle emails — no sign-in needed:
 *
 *   /listing/still-available  confirms the listing (applies on open)
 *   /listing/price            a small form; the new price applies at once
 *   /listing/sold             asks once, then moves it to the sold archive
 *   /listing/renew            pay the 6-month renewal by card or transfer
 *
 * The link is the credential: ?p=<listing id>&t=<signed token>&l=<hu|nl|en|de|fr|es|pl|ro|sk>,
 * bound to exactly this action and listing and expiring on its own (see
 * src/lib/owner-links.ts). "Sold" and the price change ask for one button
 * press, so an email scanner that opens links cannot mark a house sold.
 * Writes use the service-role client; every change is in the activity log.
 */
export const prerender = false;

