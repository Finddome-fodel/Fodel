const T = COPY[locale];

type View =
  | { kind: 'message'; title: string; body: string; tone?: 'ok' | 'warn'; link?: { href: string; label: string } }
  | { kind: 'price'; error?: string }
  | { kind: 'sold' }
  | { kind: 'renew'; bank?: { amount: string; account: string; reference: string } };

let view: View = { kind: 'message', title: T.invalidTitle, body: T.invalidBody, tone: 'warn' };
let property: any = null;
let title = '';
let listingUrl = '';

const valid = /^[0-9a-f-]{36}$/.test(id) && (() => { try { return verifyAction(action as ActionPurpose, id, token); } catch { return false; } })();

if (valid) {
  const admin = createSupabaseAdminClient();
  const { data } = await admin.from('properties').select('*').eq('id', id).maybeSingle();
  property = data;
  if (property) {
    title = await listingTitle(admin, id, locale, property.ref);
    listingUrl = await publicUrl(property, locale);
  }
  const live = property?.status === 'published';
  const renewable = property && (live || (property.status === 'archived' && property.expired_at));
  const post = Astro.request.method === 'POST' ? await Astro.request.formData() : null;
  const now = new Date().toISOString();
  const log = (kind: string, payload: Record<string, unknown> = {}) =>
    logEvent({ kind, subjectType: 'property', subjectId: id, propertyId: id, source: 'owner-link', locale, payload }).catch(() => {});
  const notifyOffice = async (email: ReturnType<typeof lifecycleEmails.adminOwnerUpdate>) => {
    for (const to of await adminRecipients(admin)) await deliver(to, email);
  };
  const owner = property?.owner_id
    ? (await admin.from('profiles').select('full_name, email').eq('id', property.owner_id).maybeSingle()).data
    : null;
  const ownerName = owner?.full_name || owner?.email || x('A tulajdonos', 'De eigenaar', 'The owner', 'Der Eigentümer', 'Le propriétaire', 'El propietario', 'Właściciel', 'Proprietarul', 'Majiteľ', 'Il proprietario', 'O proprietário', 'Ο ιδιοκτήτης', 'Majitel', 'Lastnik', 'Ägaren', 'Ejeren', 'Eieren', 'Omistaja', 'Omanik', 'Īpašnieks', 'Savininkas');

  if (!property) {
    view = { kind: 'message', title: T.invalidTitle, body: T.invalidBody, tone: 'warn' };
  } else if (action === 'renew') {
    if (url.searchParams.get('paid') === '1') {
      view = { kind: 'message', title: T.paidTitle, body: T.paidBody, tone: 'ok' };
    } else if (!renewable) {
      view = { kind: 'message', title: T.goneTitle, body: T.notRenewable, tone: 'warn' };
    } else if (post) {
      try {
        const order = await openRenewalOrder(admin, property, locale, owner?.email);
        if (post.get('method') === 'card' && isStripeEnabled()) {
          const back = ownerLink('renew', id, locale, RENEW_LINK_DAYS).replace(SITE_URL, url.origin);
          return Astro.redirect(await renewalCheckoutUrl(admin, order, property, back), 303);
        }
        const company = await getCompany();
        const bank = {
          amount: formatCents(order.amount_cents, locale),
          account: `${company.banks.nl.iban} · BIC ${company.banks.nl.bic}`,
          reference: `#${property.ref} ${x('hosszabbítás', 'verlenging', 'extension', 'Verlängerung', 'prolongation', 'prórroga', 'przedłużenie', 'prelungire', 'predĺženie', 'proroga', 'prorrogação', 'παράταση', 'prodloužení', 'podaljšanje', 'förlängning', 'forlængelse', 'forlengelse', 'jatko', 'pikendus', 'pagarinājums', 'pratęsimas')}`,
        };
        if (post.get('method') === 'bank' && owner?.email) {
          await deliver(owner.email, lifecycleEmails.renewalTransfer(locale, { ref: property.ref, title, ...bank, payUrl: ownerLink('renew', id, locale, RENEW_LINK_DAYS) }));
          await log('listing.renewal_requested', { method: 'bank', orderId: order.id });
        }
        view = { kind: 'renew', bank };
      } catch (error) {
        console.error('[renew] could not open order', error);
        view = { kind: 'message', title: T.error, body: '', tone: 'warn' };
      }
    } else {
      view = { kind: 'renew' };
    }
  } else if (!live) {
    view = { kind: 'message', title: T.goneTitle, body: T.goneBody, tone: 'warn' };
  } else if (action === 'still-available') {
    // Harmless on open: confirming twice changes nothing but the date.
    const { error } = await admin.from('properties').update({ confirmed_at: now }).eq('id', id);
    if (!error) await log('listing.confirmed_available');
    view = error
      ? { kind: 'message', title: T.error, body: '', tone: 'warn' }
      : { kind: 'message', title: T.stillTitle, body: T.stillBody, tone: 'ok', link: { href: listingUrl, label: T.view } };
  } else if (action === 'sold') {
    if (post) {
      const { error } = await admin.from('properties').update({ status: 'sold', sold_at: now, confirmed_at: now }).eq('id', id).eq('status', 'published');
      if (error) {
        view = { kind: 'message', title: T.error, body: '', tone: 'warn' };
      } else {
        await log('listing.sold_by_owner');
        await notifyOffice(lifecycleEmails.adminOwnerUpdate({ kind: 'sold', ref: property.ref, title, owner: ownerName, editUrl: `${SITE_URL}/portal/properties/${id}` }));
        view = { kind: 'message', title: T.soldDone, body: T.soldDoneBody, tone: 'ok' };
      }
    } else {
      view = { kind: 'sold' };
    }
  } else if (action === 'price') {
    if (post) {
      const raw = String(post.get('price') ?? '').replace(/[\s.,]/g, '');
      const amount = Number(raw);
      if (!/^\d{1,12}$/.test(raw) || amount <= 0) {
        view = { kind: 'price', error: T.priceBad };
      } else {
        // Hungarian owners type forints, Dutch owners euros; the other
        // currency follows at the listing's own existing ratio — no new rate.
        const ratio = property.price_huf / property.price_eur;
        const next = hu
          ? { price_huf: Math.round(amount), price_eur: Math.max(1, Math.round(amount / ratio)) }
          : { price_eur: Math.round(amount), price_huf: Math.max(1, Math.round(amount * ratio)) };
        const { error } = await admin
          .from('properties')
          .update({ ...next, price_asof: now.slice(0, 10), confirmed_at: now })
          .eq('id', id).eq('status', 'published');
        if (error) {
          view = { kind: 'message', title: T.error, body: '', tone: 'warn' };
        } else {
          const history = await admin.from('property_price_history').insert({
            property_id: id, old_eur: property.price_eur, new_eur: next.price_eur, old_huf: property.price_huf, new_huf: next.price_huf, source: 'owner-refresh',
          });
          if (history.error) console.warn('[price] history not stored (migration 0019?)', history.error.message);
          await log('listing.price_changed_by_owner', { old_eur: property.price_eur, new_eur: next.price_eur, old_huf: property.price_huf, new_huf: next.price_huf });
          await notifyOffice(lifecycleEmails.adminOwnerUpdate({
            kind: 'price', ref: property.ref, title, owner: ownerName,
            oldPrice: `${eur(property.price_eur, 'hu')} / ${huf(property.price_huf, 'hu')}`,
            newPrice: `${eur(next.price_eur, 'hu')} / ${huf(next.price_huf, 'hu')}`,
            editUrl: `${SITE_URL}/portal/properties/${id}`,
          }));
          view = { kind: 'message', title: T.priceDone, body: hu ? `${huf(next.price_huf, 'hu')} (${eur(next.price_eur, 'hu')})` : `${eur(next.price_eur, locale)} (${huf(next.price_huf, locale)})`, tone: 'ok', link: { href: listingUrl, label: T.view } };
        }
      }
    } else {
      view = { kind: 'price' };
    }
  }
}

const currentPrice = property ? (hu ? `${huf(property.price_huf, 'hu')} · ${eur(property.price_eur, 'hu')}` : `${eur(property.price_eur, locale)} · ${huf(property.price_huf, locale)}`) : '';
const expiry = property?.expires_at ? new Date(property.expires_at) : null;
const expiryText = expiry ? expiry.toLocaleDateString(intlTag(locale), { year: 'numeric', month: 'long', day: 'numeric' }) : '—';
const renewalPrice = formatCents(await renewalPriceCents(), locale);
const pageTitle = view.kind === 'message' ? view.title : view.kind === 'price' ? T.priceTitle : view.kind === 'sold' ? T.soldTitle : T.renewTitle;
---

<Base locale={locale} title={pageTitle} description={pageTitle} noindex>
  <section class="owner-act">
    <div class="act-card">
      {title && (
        <p class="act-listing">
          <span class="ref num">#{property.ref}</span>
          <span>{title}</span>
        </p>
      )}

      {view.kind === 'message' && (
        <>
          <span class:list={['act-mark', view.tone]} aria-hidden="true">
            {view.tone === 'ok'
              ? <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M5 12.5l4.2 4.2L19 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
              : <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M12 7v6M12 16.8h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>}
          </span>
          <h1>{view.title}</h1>
          {view.body && <p class="act-body">{view.body}</p>}
          {view.link && (
            <a class="act-btn" href={view.link.href}>{view.link.label}<ArrowChip /></a>
          )}
        </>
      )}

      {view.kind === 'price' && (
        <form method="POST" class="act-form">
          <h1>{T.priceTitle}</h1>
          <p class="act-body">{T.priceBody}</p>
          <p class="act-meta"><span>{T.current}</span><b class="num">{currentPrice}</b></p>
          <label class="act-field">
            <span>{T.priceLabel}</span>
            <input type="text" name="price" inputmode="numeric" autocomplete="off" required pattern="[0-9 .,]{1,20}" aria-invalid={view.error ? 'true' : undefined} aria-describedby={view.error ? 'price-error' : undefined} />
          </label>
          {view.error && <p class="act-error" id="price-error" role="alert">{view.error}</p>}
          <button class="act-btn" type="submit">{T.priceSave}<ArrowChip /></button>
        </form>
      )}

      {view.kind === 'sold' && (
        <form method="POST" class="act-form">
          <h1>{T.soldTitle}</h1>
          <p class="act-body">{T.soldBody}</p>
          <button class="act-btn" type="submit">{T.soldConfirm}<ArrowChip /></button>
        </form>
      )}

      {view.kind === 'renew' && (
        <>
          <h1>{T.renewTitle}</h1>
          <p class="act-body">{T.renewBody(renewalPrice)}</p>
          <p class="act-meta">
            <span>{property.status === 'published' ? T.expires : T.expired}</span>
            <b class="num">{expiryText}</b>
          </p>
          {view.bank ? (
            <div class="act-bank" role="status">
              <h2>{T.bankTitle}</h2>
              <dl>
                <div><dt>{T.amount}</dt><dd class="num">{view.bank.amount}</dd></div>
                <div><dt>{T.account}</dt><dd class="num">{view.bank.account}</dd></div>
                <div><dt>{T.reference}</dt><dd>{view.bank.reference}</dd></div>
              </dl>
              <p>{T.bankBody}</p>
            </div>
          ) : (
            <form method="POST" class="act-choices">
              {isStripeEnabled() && <button class="act-btn" type="submit" name="method" value="card">{T.payCard}<ArrowChip /></button>}
              <button class:list={['act-btn', isStripeEnabled() && 'ghost']} type="submit" name="method" value="bank">{T.payBank}{!isStripeEnabled() && <ArrowChip />}</button>
            </form>
          )}
        </>
      )}
    </div>
  </section>
</Base>

<style>
  .owner-act {
    display: grid;
    place-items: center;
    min-height: 70vh;
    padding: calc(var(--nav-h, 88px) + 40px) var(--pad-x) 96px;
  }
  .act-card {
    width: 100%;
    max-width: 560px;
    padding: clamp(28px, 5vw, 48px);
    border-radius: var(--r-2xl);
    background: var(--white);
    box-shadow: var(--shadow-md), 0 0 0 1px rgba(16, 42, 67, 0.06);
  }
  .act-listing {
    display: flex;
    gap: 10px;
    align-items: baseline;
    margin-bottom: 22px;
    font-size: var(--fs-small);
    color: var(--taupe);
    min-width: 0;
  }
  .act-listing span:last-child {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .ref {
    flex-shrink: 0;
    padding: 3px 10px;
    border-radius: var(--r-pill);
    background: var(--linen);
    color: var(--ink);
    font-size: 13px;
  }
  .act-mark {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-bottom: 18px;
    border-radius: 50%;
    background: var(--linen);
    color: var(--ink);
  }
  .act-mark.ok {
    background: var(--ink);
    color: var(--cream);
  }
  h1 {
    font-family: var(--serif);
    font-weight: var(--fw-display);
    font-size: clamp(28px, 4vw, 38px);
    letter-spacing: var(--ls-heading);
    line-height: 1.1;
    color: var(--ink);
  }
  h2 {
    font-family: var(--serif);
    font-size: 19px;
    font-weight: var(--fw-semibold);
    color: var(--ink);
    margin-bottom: 12px;
  }
  .act-body {
    margin-top: 14px;
    font-size: var(--fs-body-lg);
    line-height: 1.65;
    color: var(--taupe);
  }
  .act-meta {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 22px;
    padding: 14px 18px;
    border-radius: var(--r-lg);
    background: var(--cream);
    font-size: var(--fs-small);
    color: var(--taupe);
  }
  .act-meta b {
    color: var(--ink);
    font-weight: var(--fw-semibold);
  }
  .act-form,
  .act-choices {
    display: grid;
    gap: 14px;
  }
  .act-choices {
    margin-top: 26px;
  }
  .act-field {
    display: grid;
    gap: 8px;
    margin-top: 10px;
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    color: var(--ink);
  }
  .act-field input {
    min-height: 56px;
    padding: 12px 18px;
    border-radius: var(--r-md);
    border: 1px solid var(--border);
    background: var(--white);
    font: inherit;
    font-size: 20px;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .act-field input:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  .act-error {
    color: #b42318;
    font-size: var(--fs-small);
  }
  .act-btn {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    width: 100%;
    min-height: 58px;
    margin-top: 12px;
