---
/**
 * Newsletter landing pages:
 *   /newsletter/confirm      the double opt-in click: pending → confirmed, consent stamped
 *   /newsletter/unsubscribe  one click, no questions (GET or RFC 8058 one-click POST)
 *   /newsletter/sent|error   where the no-JavaScript form post lands
 *
 * ?s=<subscriber id>&t=<signed token>&l=<hu|nl|en|de|fr|es|pl|ro|sk>. The token is bound to
 * the action and the subscriber; the unsubscribe token does not expire.
 */
export const prerender = false;

import Base from '~/layouts/Base.astro';
import { verifyAction } from '~/lib/valuation/action-token';
import { createSupabaseAdminClient } from '~/lib/supabase-server';
import { asNewsletterLocale, syncAudience } from '~/lib/newsletter';
import { logEvent } from '~/lib/activity';

const action = Astro.params.action ?? '';
if (!['confirm', 'unsubscribe', 'sent', 'error'].includes(action)) return new Response('Not found', { status: 404 });

const locale = asNewsletterLocale(Astro.url.searchParams.get('l'));
const id = Astro.url.searchParams.get('s') ?? '';
const token = Astro.url.searchParams.get('t') ?? '';
Astro.response.headers.set('cache-control', 'no-store');
Astro.response.headers.set('referrer-policy', 'no-referrer');

const T = {
  hu: { sent: ['Nézze meg a postafiókját', 'Küldtünk egy megerősítő e-mailt. A feliratkozás a benne lévő gombra kattintva válik érvényessé.'], error: ['Nem sikerült', 'Kérjük, ellenőrizze az e-mail-címet, és próbálja újra.'], confirmed: ['Feliratkozott!', 'Köszönjük. A következő hírlevelünket már Önnek is elküldjük.'], unsub: ['Leiratkozott', 'Több hírlevelet nem küldünk erre a címre. Ha meggondolja magát, bármikor újra feliratkozhat az oldal alján.'], invalid: ['Ez a link már nem érvényes', 'A megerősítő link 14 napig érvényes. Iratkozzon fel újra az oldal alján, és küldünk egy újat.'], home: 'Vissza a főoldalra' },
  nl: { sent: ['Kijk in uw mailbox', 'Wij stuurden u een bevestigingsmail. Uw inschrijving is pas geldig na een klik op de knop daarin.'], error: ['Dat lukte niet', 'Controleer het e-mailadres en probeer het opnieuw.'], confirmed: ['U bent ingeschreven!', 'Dank u. De volgende nieuwsbrief ontvangt u ook.'], unsub: ['Uitgeschreven', 'Wij sturen geen nieuwsbrieven meer naar dit adres. Toch weer interesse? Onderaan elke pagina kunt u zich opnieuw inschrijven.'], invalid: ['Deze link is niet meer geldig', 'De bevestigingslink is 14 dagen geldig. Schrijf u opnieuw in onderaan de pagina, dan sturen wij een nieuwe.'], home: 'Naar de homepage' },
  en: { sent: ['Check your inbox', 'We have sent you a confirmation email. Your subscription starts once you click the button in it.'], error: ['That did not work', 'Please check the email address and try again.'], confirmed: ['You are subscribed', 'Thank you. You will receive our next newsletter.'], unsub: ['Unsubscribed', 'We will send no more newsletters to this address. Changed your mind? You can subscribe again at any time.'], invalid: ['This link is no longer valid', 'Confirmation links are valid for 14 days. Subscribe again and we will send you a new one.'], home: 'Back to the homepage' },
  de: { sent: ['Bitte prüfen Sie Ihr Postfach', 'Wir haben Ihnen eine Bestätigungs-E-Mail gesendet. Ihr Abonnement gilt, sobald Sie auf den Button darin klicken.'], error: ['Das hat nicht geklappt', 'Bitte prüfen Sie die E-Mail-Adresse und versuchen Sie es erneut.'], confirmed: ['Sie sind angemeldet', 'Vielen Dank. Unseren nächsten Newsletter erhalten Sie auch.'], unsub: ['Abgemeldet', 'Wir senden keine Newsletter mehr an diese Adresse. Sie können sich jederzeit wieder anmelden.'], invalid: ['Dieser Link ist nicht mehr gültig', 'Bestätigungslinks gelten 14 Tage. Melden Sie sich erneut an, dann senden wir Ihnen einen neuen.'], home: 'Zur Startseite' },
  fr: { sent: ['Consultez votre boîte de réception', 'Nous vous avons envoyé un e-mail de confirmation. Votre inscription prend effet dès que vous cliquez sur le bouton qu’il contient.'], error: ['L’inscription a échoué', 'Veuillez vérifier l’adresse e-mail et réessayer.'], confirmed: ['Vous êtes inscrit', 'Merci. Vous recevrez aussi notre prochaine lettre d’information.'], unsub: ['Désabonné', 'Nous n’enverrons plus de lettre d’information à cette adresse. Vous pouvez vous réinscrire à tout moment.'], invalid: ['Ce lien n’est plus valable', 'Les liens de confirmation sont valables 14 jours. Inscrivez-vous de nouveau et nous vous en enverrons un nouveau.'], home: 'Retour à l’accueil' },
  es: { sent: ['Revise su bandeja de entrada', 'Le hemos enviado un correo de confirmación. Su suscripción se activará en cuanto haga clic en el botón que contiene.'], error: ['No se ha podido completar la suscripción', 'Compruebe la dirección de correo electrónico y vuelva a intentarlo.'], confirmed: ['Suscripción confirmada', 'Gracias. También recibirá nuestro próximo boletín.'], unsub: ['Baja confirmada', 'No enviaremos más boletines a esta dirección. Puede volver a suscribirse en cualquier momento.'], invalid: ['Este enlace ya no es válido', 'Los enlaces de confirmación son válidos durante 14 días. Vuelva a suscribirse y le enviaremos uno nuevo.'], home: 'Volver a la página de inicio' },
  pl: { sent: ['Prosimy sprawdzić skrzynkę odbiorczą', 'Wysłaliśmy Państwu e-mail z potwierdzeniem. Subskrypcja zacznie obowiązywać po kliknięciu znajdującego się w nim przycisku.'], error: ['Zapis się nie powiódł', 'Prosimy sprawdzić adres e-mail i spróbować ponownie.'], confirmed: ['Subskrypcja potwierdzona', 'Dziękujemy. Otrzymają Państwo również nasz najbliższy newsletter.'], unsub: ['Wypisano z newslettera', 'Nie będziemy już wysyłać newslettera na ten adres. W każdej chwili można zapisać się ponownie.'], invalid: ['Ten link jest już nieważny', 'Linki potwierdzające są ważne przez 14 dni. Wystarczy zapisać się ponownie, a wyślemy nowy.'], home: 'Powrót do strony głównej' },
  ro: { sent: ['Verificați-vă căsuța de e-mail', 'V-am trimis un e-mail de confirmare. Abonarea intră în vigoare imediat ce faceți clic pe butonul din mesaj.'], error: ['Abonarea nu a reușit', 'Verificați adresa de e-mail și încercați din nou.'], confirmed: ['Abonare confirmată', 'Vă mulțumim. Veți primi și următorul nostru newsletter.'], unsub: ['Dezabonare reușită', 'Nu vom mai trimite newslettere la această adresă. Vă puteți reabona oricând.'], invalid: ['Acest link nu mai este valabil', 'Linkurile de confirmare sunt valabile 14 zile. Abonați-vă din nou și vă trimitem unul nou.'], home: 'Înapoi la prima pagină' },
  sk: { sent: ['Skontrolujte si doručenú poštu', 'Poslali sme vám potvrdzovací e-mail. Odber sa aktivuje hneď, ako kliknete na tlačidlo v ňom.'], error: ['Prihlásenie na odber sa nepodarilo', 'Skontrolujte e-mailovú adresu a skúste to znova.'], confirmed: ['Odber je aktívny', 'Ďakujeme. Dostanete aj náš najbližší newsletter.'], unsub: ['Odber je zrušený', 'Na túto adresu už nebudeme posielať newsletter. Znova sa prihlásiť môžete kedykoľvek.'], invalid: ['Tento odkaz už nie je platný', 'Potvrdzovacie odkazy platia 14 dní. Prihláste sa znova a pošleme vám nový.'], home: 'Späť na úvodnú stránku' },
  it: { sent: ['Controlli la sua casella di posta', 'Le abbiamo inviato un’e-mail di conferma. L’iscrizione inizia quando clicca sul pulsante al suo interno.'], error: ['Non è stato possibile', 'Controlli l’indirizzo e-mail e riprovi.'], confirmed: ['Iscrizione completata', 'Grazie. Riceverà la nostra prossima newsletter.'], unsub: ['Iscrizione annullata', 'Non invieremo più newsletter a questo indirizzo. Ha cambiato idea? Può iscriversi di nuovo in qualsiasi momento.'], invalid: ['Questo link non è più valido', 'I link di conferma sono validi per 14 giorni. Si iscriva di nuovo e Le invieremo un nuovo link.'], home: 'Torna alla homepage' },
  pt: { sent: ['Consulte a sua caixa de correio', 'Enviámos-lhe um e-mail de confirmação. A subscrição começa quando clicar no botão que contém.'], error: ['Não foi possível', 'Verifique o endereço de e-mail e tente novamente.'], confirmed: ['Subscrição concluída', 'Obrigado. Irá receber a nossa próxima newsletter.'], unsub: ['Subscrição cancelada', 'Não enviaremos mais newsletters para este endereço. Mudou de ideias? Pode voltar a subscrever a qualquer momento.'], invalid: ['Esta ligação já não é válida', 'As ligações de confirmação são válidas durante 14 dias. Subscreva novamente e enviamos-lhe uma nova.'], home: 'Voltar à página inicial' },
  el: { sent: ['Ελέγξτε τα εισερχόμενά σας', 'Σας στείλαμε email επιβεβαίωσης. Η εγγραφή σας ξεκινά μόλις πατήσετε το κουμπί που περιέχει.'], error: ['Δεν ήταν δυνατό', 'Ελέγξτε τη διεύθυνση email και δοκιμάστε ξανά.'], confirmed: ['Η εγγραφή ολοκληρώθηκε', 'Σας ευχαριστούμε. Θα λάβετε το επόμενο ενημερωτικό μας δελτίο.'], unsub: ['Η διαγραφή ολοκληρώθηκε', 'Δεν θα στέλνουμε πλέον ενημερωτικά δελτία σε αυτή τη διεύθυνση. Αλλάξατε γνώμη; Μπορείτε να εγγραφείτε ξανά οποιαδήποτε στιγμή.'], invalid: ['Ο σύνδεσμος δεν ισχύει πλέον', 'Οι σύνδεσμοι επιβεβαίωσης ισχύουν για 14 ημέρες. Εγγραφείτε ξανά και θα σας στείλουμε νέο.'], home: 'Επιστροφή στην αρχική σελίδα' },
  cs: { sent: ['Zkontrolujte svou e-mailovou schránku', 'Poslali jsme vám potvrzovací e-mail. Odběr začne, jakmile kliknete na tlačítko v něm.'], error: ['Nepodařilo se', 'Zkontrolujte e-mailovou adresu a zkuste to znovu.'], confirmed: ['Odběr je aktivní', 'Děkujeme. Obdržíte náš příští newsletter.'], unsub: ['Odběr zrušen', 'Na tuto adresu již nebudeme posílat žádné newslettery. Změnili jste názor? Znovu se můžete přihlásit kdykoli.'], invalid: ['Tento odkaz již není platný', 'Potvrzovací odkazy platí 14 dní. Přihlaste se znovu a pošleme vám nový.'], home: 'Zpět na úvodní stránku' },
  sl: { sent: ['Preverite svoj e-poštni predal', 'Poslali smo vam potrditveno sporočilo. Naročnina začne veljati, ko kliknete gumb v njem.'], error: ['Ni uspelo', 'Preverite e-poštni naslov in poskusite znova.'], confirmed: ['Naročeni ste', 'Hvala. Prejeli boste naše naslednje novice.'], unsub: ['Odjava je uspela', 'Na ta naslov ne bomo več pošiljali novic. Ste si premislili? Znova se lahko prijavite kadar koli.'], invalid: ['Ta povezava ni več veljavna', 'Potrditvene povezave veljajo 14 dni. Znova se prijavite in poslali vam bomo novo.'], home: 'Nazaj na domačo stran' },
  sv: { sent: ['Kolla din inkorg', 'Vi har skickat ett bekräftelsemejl till dig. Prenumerationen börjar när du klickar på knappen i det.'], error: ['Det gick inte', 'Kontrollera e-postadressen och försök igen.'], confirmed: ['Du prenumererar nu', 'Tack. Du får vårt nästa nyhetsbrev.'], unsub: ['Prenumerationen avslutad', 'Vi skickar inga fler nyhetsbrev till den här adressen. Ändrat dig? Du kan prenumerera igen när som helst.'], invalid: ['Den här länken är inte längre giltig', 'Bekräftelselänkar gäller i 14 dagar. Prenumerera igen så skickar vi en ny.'], home: 'Tillbaka till startsidan' },
  da: { sent: ['Tjek din indbakke', 'Vi har sendt dig en bekræftelsesmail. Dit abonnement starter, når du klikker på knappen i den.'], error: ['Det lykkedes ikke', 'Kontrollér e-mailadressen, og prøv igen.'], confirmed: ['Du er tilmeldt', 'Tak. Du modtager vores næste nyhedsbrev.'], unsub: ['Afmeldt', 'Vi sender ikke flere nyhedsbreve til denne adresse. Har du fortrudt? Du kan tilmelde dig igen når som helst.'], invalid: ['Linket er ikke længere gyldigt', 'Bekræftelseslinks er gyldige i 14 dage. Tilmeld dig igen, så sender vi dig et nyt.'], home: 'Tilbage til forsiden' },
  no: { sent: ['Sjekk innboksen din', 'Vi har sendt deg en bekreftelse på e-post. Abonnementet starter når du klikker på knappen i den.'], error: ['Det gikk ikke', 'Kontroller e-postadressen og prøv igjen.'], confirmed: ['Du er påmeldt', 'Takk. Du får vårt neste nyhetsbrev.'], unsub: ['Avmeldt', 'Vi sender ikke flere nyhetsbrev til denne adressen. Ombestemt deg? Du kan melde deg på igjen når som helst.'], invalid: ['Lenken er ikke lenger gyldig', 'Bekreftelseslenker er gyldige i 14 dager. Meld deg på igjen, så sender vi deg en ny.'], home: 'Tilbake til forsiden' },
  fi: { sent: ['Tarkista sähköpostisi', 'Lähetimme sinulle vahvistusviestin. Tilauksesi alkaa, kun napsautat siinä olevaa painiketta.'], error: ['Se ei onnistunut', 'Tarkista sähköpostiosoite ja yritä uudelleen.'], confirmed: ['Tilaus on voimassa', 'Kiitos. Saat seuraavan uutiskirjeemme.'], unsub: ['Tilaus peruttu', 'Emme lähetä enää uutiskirjeitä tähän osoitteeseen. Muutitko mielesi? Voit tilata uudelleen milloin tahansa.'], invalid: ['Linkki ei ole enää voimassa', 'Vahvistuslinkit ovat voimassa 14 päivää. Tilaa uudelleen, niin lähetämme uuden.'], home: 'Takaisin etusivulle' },
  et: { sent: ['Vaadake oma postkasti', 'Saatsime teile kinnituskirja. Tellimus algab, kui klõpsate selles oleval nupul.'], error: ['See ei õnnestunud', 'Kontrollige e-posti aadressi ja proovige uuesti.'], confirmed: ['Olete tellinud', 'Aitäh. Saate meie järgmise uudiskirja.'], unsub: ['Tellimusest loobutud', 'Sellele aadressile me enam uudiskirju ei saada. Mõtlesite ümber? Saate igal ajal uuesti tellida.'], invalid: ['Link ei kehti enam', 'Kinnituslingid kehtivad 14 päeva. Tellige uuesti ja saadame teile uue.'], home: 'Tagasi avalehele' },
  lv: { sent: ['Pārbaudiet savu e-pastu', 'Mēs jums nosūtījām apstiprinājuma e-pastu. Abonements sāksies, tiklīdz noklikšķināsiet uz tajā esošās pogas.'], error: ['Neizdevās', 'Pārbaudiet e-pasta adresi un mēģiniet vēlreiz.'], confirmed: ['Jūs esat pierakstījies', 'Paldies. Jūs saņemsiet mūsu nākamo jaunumu vēstuli.'], unsub: ['Abonements atcelts', 'Uz šo adresi mēs vairs nesūtīsim jaunumu vēstules. Pārdomājāt? Varat pierakstīties no jauna jebkurā laikā.'], invalid: ['Saite vairs nav derīga', 'Apstiprinājuma saites ir derīgas 14 dienas. Pierakstieties vēlreiz, un mēs jums nosūtīsim jaunu.'], home: 'Atpakaļ uz sākumlapu' },
  lt: { sent: ['Patikrinkite el. pašto dėžutę', 'Išsiuntėme jums patvirtinimo laišką. Prenumerata prasidės, kai spustelėsite jame esantį mygtuką.'], error: ['Nepavyko', 'Patikrinkite el. pašto adresą ir bandykite dar kartą.'], confirmed: ['Prenumerata aktyvi', 'Ačiū. Gausite kitą mūsų naujienlaiškį.'], unsub: ['Prenumeratos atsisakyta', 'Šiuo adresu naujienlaiškių nebesiųsime. Persigalvojote? Užsiprenumeruoti iš naujo galite bet kada.'], invalid: ['Ši nuoroda nebegalioja', 'Patvirtinimo nuorodos galioja 14 dienų. Užsiprenumeruokite iš naujo ir atsiųsime naują.'], home: 'Atgal į pagrindinį puslapį' },
}[locale];

let message: [string, string] = action === 'sent' ? (T.sent as [string, string]) : (T.error as [string, string]);
let ok = action === 'sent';

if (action === 'confirm' || action === 'unsubscribe') {
  const purpose = action === 'confirm' ? 'newsletter-confirm' : 'newsletter-unsubscribe';
  const valid = /^[0-9a-f-]{36}$/.test(id) && (() => { try { return verifyAction(purpose, id, token); } catch { return false; } })();
  message = T.invalid as [string, string];
  ok = false;
  if (valid) {
    const admin = createSupabaseAdminClient();
    const { data: row } = await admin.from('newsletter_subscribers').select('id, email, status, locale').eq('id', id).maybeSingle();
    const now = new Date().toISOString();
    if (row && action === 'confirm') {
      if (row.status !== 'confirmed') {
        // Consent is the click itself: its time and the language it was given in.
        const contactId = await syncAudience(row.email, false);
        await admin.from('newsletter_subscribers')
          .update({ status: 'confirmed', consent_at: now, unsubscribed_at: null, locale, ...(contactId ? { resend_contact_id: contactId } : {}) })
          .eq('id', id);
        await logEvent({ kind: 'newsletter.confirmed', subjectType: 'newsletter', subjectId: id, locale, source: 'web' }).catch(() => {});
      }
      message = T.confirmed as [string, string];
      ok = true;
    } else if (row && action === 'unsubscribe') {
      if (row.status !== 'unsubscribed') {
        await admin.from('newsletter_subscribers').update({ status: 'unsubscribed', unsubscribed_at: now }).eq('id', id);
        await syncAudience(row.email, true);
        await logEvent({ kind: 'newsletter.unsubscribed', subjectType: 'newsletter', subjectId: id, locale, source: 'web' }).catch(() => {});
      }
      message = T.unsub as [string, string];
      ok = true;
    } else if (!row && action === 'unsubscribe') {
      // Already deleted by an admin: there is nothing left to unsubscribe.
      message = T.unsub as [string, string];
      ok = true;
    }
  }
  // RFC 8058 one-click unsubscribe from a mail client: no page needed.
  if (Astro.request.method === 'POST') return new Response(null, { status: ok ? 200 : 400 });
}

const homeHref = `/${locale}/`;
---

<Base locale={locale} title={message[0]} description={message[1]} noindex>
  <section class="nl-page">
    <div class="nl-card">
      <span class:list={['nl-mark', ok && 'ok']} aria-hidden="true">
        {ok
          ? <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M5 12.5l4.2 4.2L19 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
          : <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M12 7v6M12 16.8h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>}
      </span>
      <h1>{message[0]}</h1>
      <p>{message[1]}</p>
      <a class="nl-home" href={homeHref}>{T.home}</a>
    </div>
  </section>
</Base>

<style>
  .nl-page {
    display: grid;
    place-items: center;
    min-height: 60vh;
    padding: calc(var(--nav-h, 88px) + 32px) var(--pad-x) 96px;
  }
  .nl-card {
    width: 100%;
    max-width: 520px;
    padding: clamp(28px, 5vw, 48px);
    border-radius: var(--r-2xl);
    background: var(--white);
    box-shadow: var(--shadow-md), 0 0 0 1px rgba(16, 42, 67, 0.06);
  }
  .nl-mark {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-bottom: 18px;
    border-radius: 50%;
    background: var(--linen);
    color: var(--ink);
  }
  .nl-mark.ok {
    background: var(--ink);
    color: var(--cream);
  }
  h1 {
    font-family: var(--serif);
    font-weight: var(--fw-display);
    font-size: clamp(28px, 4vw, 36px);
    letter-spacing: var(--ls-heading);
    line-height: 1.12;
    color: var(--ink);
  }
  p {
    margin-top: 12px;
    font-size: var(--fs-body-lg);
    line-height: 1.65;
    color: var(--taupe);
  }
  .nl-home {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    margin-top: 24px;
    padding: 0 24px;
    border-radius: var(--r-pill);
    background: var(--ink);
    color: var(--cream);
    font-weight: var(--fw-medium);
    text-decoration: none;
  }
  .nl-home:hover {
    background: var(--ink-soft);
  }
  .nl-home:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }
</style>
