---
// Rendered on demand: [slug].astro rewrites unknown slugs here, and Astro
// forbids rewriting an on-demand route to a prerendered one (ForbiddenRewrite
// — every unknown property URL answered 500 instead of this page).
export const prerender = false;
/**
 * 404, in the language of the address that was not found (/de/nichts/ → German).
 * An address with no language in it (the old fodel.nl URLs, a typo at the
 * root) gets the language the visitor last picked, else the one their browser
 * asks for, else Dutch. Beside the
 * apology, the other four languages are one click away.
 */
import Base from '~/layouts/Base.astro';
import Button from '~/components/Button.astro';
import { LOCALES, LOCALE_META, FALLBACK_LOCALE, localeOfPath, localeFrom, path, localizer, type Locale } from '~/i18n/ui';
import { COMPANY } from '~/config/company';

// After a rewrite, Astro.url is the 404 route itself; the original address is
// what tells us the language.
const original: string = (Astro as unknown as { originPathname?: string }).originPathname ?? Astro.url.pathname;
// No language in the address: the visitor's own pick, then what their browser asks for, then the default.
// Back-office addresses are Hungarian (the portal is).
const acceptedLocale = (): Locale | undefined => {
  for (const part of (Astro.request.headers.get('accept-language') ?? '').split(',')) {
    const tag = part.split(';')[0].trim().toLowerCase().split('-')[0];
    const code = tag === 'nb' || tag === 'nn' ? 'no' : tag;
    if ((LOCALES as readonly string[]).includes(code)) return code as Locale;
  }
};
const cookieLocale = Astro.cookies.get('fodel_lang')?.value;
const locale =
  localeOfPath(original) ??
  (cookieLocale ? localeFrom(cookieLocale, FALLBACK_LOCALE) : undefined) ??
  (original.startsWith('/portal') ? 'hu' : undefined) ??
  acceptedLocale() ??
  FALLBACK_LOCALE;
const x = localizer(locale);
const others = LOCALES.filter((code) => code !== locale);

const title = x('Az oldal nem található', 'Pagina niet gevonden', 'Page not found', 'Seite nicht gefunden', 'Page introuvable', 'Página no encontrada', 'Nie znaleziono strony', 'Pagina nu a fost găsită', 'Stránka sa nenašla', 'Pagina non trovata', 'Página não encontrada', 'Η σελίδα δεν βρέθηκε', 'Stránka nenalezena', 'Stran ni bila najdena', 'Sidan hittades inte', 'Siden blev ikke fundet', 'Fant ikke siden', 'Sivua ei löytynyt', 'Lehte ei leitud', 'Lapa nav atrasta', 'Puslapis nerastas');
const body = x(
  'A keresett oldal nem létezik, vagy áthelyeztük. Nézze meg a kínálatunkat, vagy vegye fel velünk a kapcsolatot.',
  'De pagina die u zocht bestaat niet of is verplaatst. Bekijk ons aanbod, of neem contact met ons op.',
  'The page you were looking for does not exist or has moved. See our properties, or get in touch.',
  'Die gesuchte Seite gibt es nicht oder sie wurde verschoben. Sehen Sie sich unser Angebot an oder nehmen Sie Kontakt mit uns auf.',
  'La page que vous cherchez n’existe pas ou a été déplacée. Découvrez nos biens, ou contactez-nous.',
  'La página que busca no existe o se ha trasladado. Descubra nuestros inmuebles o póngase en contacto con nosotros.',
  'Strona, której Państwo szukają, nie istnieje lub została przeniesiona. Zapraszamy do przejrzenia naszych nieruchomości lub do kontaktu.',
  'Pagina pe care o căutați nu există sau a fost mutată. Descoperiți proprietățile noastre sau contactați-ne.',
  'Stránka, ktorú hľadáte, neexistuje alebo bola presunutá. Pozrite si naše nehnuteľnosti alebo nás kontaktujte.',
  'La pagina che cercava non esiste o è stata spostata. Veda i nostri immobili o ci contatti.',
  'A página que procurava não existe ou foi movida. Veja os nossos imóveis ou contacte-nos.',
  'Η σελίδα που αναζητούσατε δεν υπάρχει ή έχει μετακινηθεί. Δείτε τα ακίνητά μας ή επικοινωνήστε μαζί μας.',
  'Stránka, kterou hledáte, neexistuje nebo byla přesunuta. Prohlédněte si naše nemovitosti nebo nás kontaktujte.',
  'Stran, ki ste jo iskali, ne obstaja ali je bila premaknjena. Oglejte si naše nepremičnine ali nas kontaktirajte.',
  'Sidan du letade efter finns inte eller har flyttats. Se våra fastigheter eller kontakta oss.',
  'Siden, du ledte efter, findes ikke eller er flyttet. Se vores ejendomme, eller kontakt os.',
  'Siden du lette etter, finnes ikke eller er flyttet. Se eiendommene våre eller ta kontakt.',
  'Etsimääsi sivua ei ole tai se on siirretty. Katso kiinteistömme tai ota yhteyttä.',
  'Otsitud lehte ei ole olemas või see on teisaldatud. Vaadake meie kinnisvara või võtke ühendust.',
  'Meklētā lapa neeksistē vai ir pārvietota. Apskatiet mūsu īpašumus vai sazinieties ar mums.',
  'Ieškomo puslapio nėra arba jis perkeltas. Peržiūrėkite mūsų turtą arba susisiekite su mumis.'
);
const otherLanguages = x('Más nyelven', 'In een andere taal', 'In another language', 'In einer anderen Sprache', 'Dans une autre langue', 'En otro idioma', 'W innym języku', 'În altă limbă', 'V inom jazyku', 'In un’altra lingua', 'Noutra língua', 'Σε άλλη γλώσσα', 'V jiném jazyce', 'V drugem jeziku', 'På ett annat språk', 'På et andet sprog', 'På et annet språk', 'Toisella kielellä', 'Teises keeles', 'Citā valodā', 'Kita kalba');
---

<Base locale={locale} title={`404 | ${title}`} description={body} noindex>
  <section class="notfound">
    <p class="code num" aria-hidden="true">404</p>

    <div class="copy">
      <h1>{title}</h1>

      <div class="cols">
        <div class="col">
          <p class="col-body">{body}</p>
          <div class="actions">
            <Button variant="dark" href={path(locale, 'properties')}>{x('Ingatlanok', 'Ons aanbod', 'Our properties', 'Unser Angebot', 'Nos biens', 'Nuestros inmuebles', 'Nasze nieruchomości', 'Proprietățile noastre', 'Naše nehnuteľnosti', 'I nostri immobili', 'Os nossos imóveis', 'Τα ακίνητά μας', 'Naše nemovitosti', 'Naše nepremičnine', 'Våra fastigheter', 'Vores ejendomme', 'Våre eiendommer', 'Kohteemme', 'Meie kinnisvara', 'Mūsu īpašumi', 'Mūsų nekilnojamasis turtas')}</Button>
            <Button variant="text" href={path(locale, 'contact')}>{x('Kapcsolat', 'Contact', 'Contact', 'Kontakt', 'Contact', 'Contacto', 'Kontakt', 'Contact', 'Kontakt', 'Contatti', 'Contacto', 'Επικοινωνία', 'Kontakt', 'Kontakt', 'Kontakt', 'Kontakt', 'Kontakt', 'Yhteystiedot', 'Kontakt', 'Kontakti', 'Kontaktai')}</Button>
          </div>
        </div>

        <nav class="col" aria-label={otherLanguages}>
          <p class="col-lang">{otherLanguages}</p>
          <ul class="langs">
            {
              others.map((code) => (
                <li>
                  <a href={`/${code}/`} lang={LOCALE_META[code].htmlLang} hreflang={LOCALE_META[code].hreflang}>{LOCALE_META[code].label}</a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>

      <p class="reach">
        <a href={COMPANY.phones[0].href}>{COMPANY.phones[0].display}</a>
        <a href={COMPANY.phones[1].href}>{COMPANY.phones[1].display}</a>
        <a href={`mailto:${COMPANY.email.primary}`}>{COMPANY.email.primary}</a>
      </p>
    </div>
  </section>
</Base>

<style>
  /* A light 404 set like the site's figures: the apology in the visitor's
     language, a way onward, and the other languages. */
  .notfound {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 80px;
    align-items: start;
    padding: 120px var(--pad-x) var(--section-y);
  }
  /* -0.035em: the 4's own side bearing, so its ink meets the margin. */
  .code {
    margin-left: -0.035em;
    font-family: var(--serif);
    font-weight: var(--fw-light);
    font-size: clamp(140px, 19vw, 300px);
    line-height: 0.8;
    letter-spacing: -0.045em;
    color: var(--ink);
    animation: fx-fade-up 1.3s var(--ease-out) 0.2s both;
  }
  .copy {
    animation: fx-fade-up 1.3s var(--ease-out) 0.4s both;
  }
  h1 {
    margin-bottom: 56px;
    font-family: var(--serif);
    font-weight: var(--fw-hero);
    font-size: clamp(34px, 3.8vw, 58px);
    line-height: 1.05;
    letter-spacing: var(--ls-display);
    color: var(--ink);
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 48px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
  }
  .langs {
    display: flex;
    flex-direction: column;
    gap: 12px;
    list-style: none;
  }
  .langs a {
    font-size: var(--fs-body);
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .col-lang {
    margin-bottom: 12px;
    font-size: 0.75rem;
    font-weight: var(--fw-medium);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--taupe);
  }
  .col-body {
    margin-bottom: 28px;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--taupe);
  }
  /* Stacked in both columns, so neither language wraps differently. */
  .actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }
  .reach {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    font-size: var(--fs-small);
    color: var(--taupe);
  }
  .reach a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  @media (max-width: 1100px) {
    .notfound {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
  @media (max-width: 768px) {
    .notfound {
      padding: 56px var(--pad-x-mob) var(--section-y-mob);
    }
    h1 {
      margin-bottom: 40px;
    }
    .cols {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }
</style>
