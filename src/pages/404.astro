---
// Rendered on demand: [slug].astro rewrites unknown slugs here, and Astro
// forbids rewriting an on-demand route to a prerendered one (ForbiddenRewrite
// — every unknown property URL answered 500 instead of this page).
export const prerender = false;
/**
 * 404, in the language of the address that was not found (/de/nichts/ → German).
 * An address with no language in it (the old fodel.nl URLs, a typo at the
 * root) gets the language the visitor last picked, else the one their browser
 * asks for, else Dutch. Beside the
 * apology, the other four languages are one click away.
 */
import Base from '~/layouts/Base.astro';
import Button from '~/components/Button.astro';
import { LOCALES, LOCALE_META, FALLBACK_LOCALE, localeOfPath, localeFrom, path, localizer, type Locale } from '~/i18n/ui';
import { COMPANY } from '~/config/company';

// After a rewrite, Astro.url is the 404 route itself; the original address is
// what tells us the language.
const original: string = (Astro as unknown as { originPathname?: string }).originPathname ?? Astro.url.pathname;
// No language in the address: the visitor's own pick, then what their browser asks for, then the default.
// Back-office addresses are Hungarian (the portal is).
const acceptedLocale = (): Locale | undefined => {
  for (const part of (Astro.request.headers.get('accept-language') ?? '').split(',')) {
    const tag = part.split(';')[0].trim().toLowerCase().split('-')[0];
    const code = tag === 'nb' || tag === 'nn' ? 'no' : tag;
    if ((LOCALES as readonly string[]).includes(code)) return code as Locale;
  }
};
const cookieLocale = Astro.cookies.get('fodel_lang')?.value;
const locale =
  localeOfPath(original) ??
  (cookieLocale ? localeFrom(cookieLocale, FALLBACK_LOCALE) : undefined) ??
  (original.startsWith('/portal') ? 'hu' : undefined) ??
  acceptedLocale() ??
  FALLBACK_LOCALE;
const x = localizer(locale);
const others = LOCALES.filter((code) => code !== locale);

const title = x({ hu: 'Az oldal nem található', nl: 'Pagina niet gevonden', en: 'Page not found', de: 'Seite nicht gefunden', fr: 'Page introuvable', es: 'Página no encontrada', pl: 'Nie znaleziono strony', ro: 'Pagina nu a fost găsită', sk: 'Stránka sa nenašla', it: 'Pagina non trovata', pt: 'Página não encontrada', el: 'Η σελίδα δεν βρέθηκε', cs: 'Stránka nenalezena', sl: 'Stran ni bila najdena', sv: 'Sidan hittades inte', da: 'Siden blev ikke fundet', no: 'Fant ikke siden', fi: 'Sivua ei löytynyt', et: 'Lehte ei leitud', lv: 'Lapa nav atrasta', lt: 'Puslapis nerastas', sr: 'Stranica nije pronađena', uk: 'Сторінку не знайдено', tr: 'Sayfa bulunamadı', he: 'הדף לא נמצא', ar: 'Page not found', ru: 'Страница не найдена', zh: 'Page not found' });
const body = x({
  hu: 'A keresett oldal nem létezik, vagy áthelyeztük. Nézze meg a kínálatunkat, vagy vegye fel velünk a kapcsolatot.',
  nl: 'De pagina die u zocht bestaat niet of is verplaatst. Bekijk ons aanbod, of neem contact met ons op.',
  en: 'The page you were looking for does not exist or has moved. See our properties, or get in touch.',
  de: 'Die gesuchte Seite gibt es nicht oder sie wurde verschoben. Sehen Sie sich unser Angebot an oder nehmen Sie Kontakt mit uns auf.',
  fr: 'La page que vous cherchez n’existe pas ou a été déplacée. Découvrez nos biens, ou contactez-nous.',
  es: 'La página que busca no existe o se ha trasladado. Descubra nuestros inmuebles o póngase en contacto con nosotros.',
  pl: 'Strona, której Państwo szukają, nie istnieje lub została przeniesiona. Zapraszamy do przejrzenia naszych nieruchomości lub do kontaktu.',
  ro: 'Pagina pe care o căutați nu există sau a fost mutată. Descoperiți proprietățile noastre sau contactați-ne.',
  sk: 'Stránka, ktorú hľadáte, neexistuje alebo bola presunutá. Pozrite si naše nehnuteľnosti alebo nás kontaktujte.',
  it: 'La pagina che cercava non esiste o è stata spostata. Veda i nostri immobili o ci contatti.',
  pt: 'A página que procurava não existe ou foi movida. Veja os nossos imóveis ou contacte-nos.',
  el: 'Η σελίδα που αναζητούσατε δεν υπάρχει ή έχει μετακινηθεί. Δείτε τα ακίνητά μας ή επικοινωνήστε μαζί μας.',
  cs: 'Stránka, kterou hledáte, neexistuje nebo byla přesunuta. Prohlédněte si naše nemovitosti nebo nás kontaktujte.',
  sl: 'Stran, ki ste jo iskali, ne obstaja ali je bila premaknjena. Oglejte si naše nepremičnine ali nas kontaktirajte.',
  sv: 'Sidan du letade efter finns inte eller har flyttats. Se våra fastigheter eller kontakta oss.',
  da: 'Siden, du ledte efter, findes ikke eller er flyttet. Se vores ejendomme, eller kontakt os.',
  no: 'Siden du lette etter, finnes ikke eller er flyttet. Se eiendommene våre eller ta kontakt.',
  fi: 'Etsimääsi sivua ei ole tai se on siirretty. Katso kiinteistömme tai ota yhteyttä.',
  et: 'Otsitud lehte ei ole olemas või see on teisaldatud. Vaadake meie kinnisvara või võtke ühendust.',
  lv: 'Meklētā lapa neeksistē vai ir pārvietota. Apskatiet mūsu īpašumus vai sazinieties ar mums.',
  lt: 'Ieškomo puslapio nėra arba jis perkeltas. Peržiūrėkite mūsų turtą arba susisiekite su mumis.',
  sr: 'Stranica koju ste tražili ne postoji ili je premeštena. Pogledajte naše nekretnine ili nam se obratite.',
  uk: 'Сторінки, яку ви шукали, не існує або її переміщено. Перегляньте нашу нерухомість або зв’яжіться з нами.',
  tr: 'Aradığınız sayfa mevcut değil veya taşınmış. Mülklerimize göz atın ya da bizimle iletişime geçin.',
  he: 'הדף שחיפשתם אינו קיים או שהועבר. עיינו בנכסים שלנו או צרו איתנו קשר.',
  ar: 'The page you were looking for does not exist or has moved. See our properties, or get in touch.',
  ru: 'Страница, которую вы искали, не существует или была перемещена. Посмотрите нашу недвижимость или свяжитесь с нами.',
  zh: 'The page you were looking for does not exist or has moved. See our properties, or get in touch.',
});
const otherLanguages = x({ hu: 'Más nyelven', nl: 'In een andere taal', en: 'In another language', de: 'In einer anderen Sprache', fr: 'Dans une autre langue', es: 'En otro idioma', pl: 'W innym języku', ro: 'În altă limbă', sk: 'V inom jazyku', it: 'In un’altra lingua', pt: 'Noutra língua', el: 'Σε άλλη γλώσσα', cs: 'V jiném jazyce', sl: 'V drugem jeziku', sv: 'På ett annat språk', da: 'På et andet sprog', no: 'På et annet språk', fi: 'Toisella kielellä', et: 'Teises keeles', lv: 'Citā valodā', lt: 'Kita kalba', sr: 'Na drugom jeziku', uk: 'Іншою мовою', tr: 'Başka bir dilde', he: 'בשפה אחרת', ar: 'In another language', ru: 'На другом языке', zh: 'In another language' });
---

<Base locale={locale} title={`404 | ${title}`} description={body} noindex>
  <section class="notfound">
    <p class="code num" aria-hidden="true">404</p>

    <div class="copy">
      <h1>{title}</h1>

      <div class="cols">
        <div class="col">
          <p class="col-body">{body}</p>
          <div class="actions">
            <Button variant="dark" href={path(locale, 'properties')}>{x({ hu: 'Ingatlanok', nl: 'Ons aanbod', en: 'Our properties', de: 'Unser Angebot', fr: 'Nos biens', es: 'Nuestros inmuebles', pl: 'Nasze nieruchomości', ro: 'Proprietățile noastre', sk: 'Naše nehnuteľnosti', it: 'I nostri immobili', pt: 'Os nossos imóveis', el: 'Τα ακίνητά μας', cs: 'Naše nemovitosti', sl: 'Naše nepremičnine', sv: 'Våra fastigheter', da: 'Vores ejendomme', no: 'Våre eiendommer', fi: 'Kohteemme', et: 'Meie kinnisvara', lv: 'Mūsu īpašumi', lt: 'Mūsų nekilnojamasis turtas', sr: 'Naše nekretnine', uk: 'Наші об’єкти', tr: 'Mülklerimiz', he: 'הנכסים שלנו', ar: 'عقاراتنا', ru: 'Наши объекты', zh: '我们的房源' })}</Button>
            <Button variant="text" href={path(locale, 'contact')}>{x({ hu: 'Kapcsolat', nl: 'Contact', en: 'Contact', de: 'Kontakt', fr: 'Contact', es: 'Contacto', pl: 'Kontakt', ro: 'Contact', sk: 'Kontakt', it: 'Contatti', pt: 'Contacto', el: 'Επικοινωνία', cs: 'Kontakt', sl: 'Kontakt', sv: 'Kontakt', da: 'Kontakt', no: 'Kontakt', fi: 'Yhteystiedot', et: 'Kontakt', lv: 'Kontakti', lt: 'Kontaktai', sr: 'Kontakt', uk: 'Контакти', tr: 'İletişim', he: 'צור קשר', ar: 'Contact', ru: 'Контакты', zh: 'Contact' })}</Button>
          </div>
        </div>

        <nav class="col" aria-label={otherLanguages}>
          <p class="col-lang">{otherLanguages}</p>
          <ul class="langs">
            {
              others.map((code) => (
                <li>
                  <a href={`/${code}/`} lang={LOCALE_META[code].htmlLang} hreflang={LOCALE_META[code].hreflang}>{LOCALE_META[code].label}</a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>

      <p class="reach">
        <a href={COMPANY.phones[0].href}>{COMPANY.phones[0].display}</a>
        <a href={COMPANY.phones[1].href}>{COMPANY.phones[1].display}</a>
        <a href={`mailto:${COMPANY.email.primary}`}>{COMPANY.email.primary}</a>
      </p>
    </div>
  </section>
</Base>

<style>
  /* A light 404 set like the site's figures: the apology in the visitor's
     language, a way onward, and the other languages. */
  .notfound {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 80px;
    align-items: start;
    padding: 120px var(--pad-x) var(--section-y);
  }
  /* -0.035em: the 4's own side bearing, so its ink meets the margin. */
  .code {
    margin-left: -0.035em;
    font-family: var(--serif);
    font-weight: var(--fw-light);
    font-size: clamp(140px, 19vw, 300px);
    line-height: 0.8;
    letter-spacing: -0.045em;
    color: var(--ink);
    animation: fx-fade-up 1.3s var(--ease-out) 0.2s both;
  }
  .copy {
    animation: fx-fade-up 1.3s var(--ease-out) 0.4s both;
  }
  h1 {
    margin-bottom: 56px;
    font-family: var(--serif);
    font-weight: var(--fw-hero);
    font-size: clamp(34px, 3.8vw, 58px);
    line-height: 1.05;
    letter-spacing: var(--ls-display);
    color: var(--ink);
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 48px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
  }
  .langs {
    display: flex;
    flex-direction: column;
    gap: 12px;
    list-style: none;
  }
  .langs a {
    font-size: var(--fs-body);
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .col-lang {
    margin-bottom: 12px;
    font-size: 0.75rem;
    font-weight: var(--fw-medium);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--taupe);
  }
  .col-body {
    margin-bottom: 28px;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--taupe);
  }
  /* Stacked in both columns, so neither language wraps differently. */
  .actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }
  .reach {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    font-size: var(--fs-small);
    color: var(--taupe);
  }
  .reach a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  @media (max-width: 1100px) {
    .notfound {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
  @media (max-width: 768px) {
    .notfound {
      padding: 56px var(--pad-x-mob) var(--section-y-mob);
    }
    h1 {
      margin-bottom: 40px;
    }
    .cols {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }
</style>
