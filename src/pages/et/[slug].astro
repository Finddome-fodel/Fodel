---
/**
 * Property detail route.
 *
 * Slug mirrors FODEL's existing pattern (fodel.nl/woonhuis-te-koop-1550), so
 * when their real inventory migrates the 301 map is mechanical.
 *
 * Rendered on request now, not built once from a fixed list of Markdown
 * files: the property might have just been approved in the portal. A short
 * CDN cache keeps this as fast as the old static page.
 */
export const prerender = false;

import PropertyDetailPage from '~/components/pages/PropertyDetailPage.astro';
import { activeProperties, englishUrl, servingFor, text, translationConfig } from '~/lib/properties';
import { ROUTES } from '~/i18n/ui';

const { slug } = Astro.params;
const properties = await activeProperties();
const property = properties.find(
  (p) =>
    slug ===
    ROUTES.et.detail(p.data.categorySlugs.et ?? p.data.category, p.data.ref)
);

if (!property) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}

// A language this listing is not published in (not bought, switched off, or not translated yet) has no page of
// its own: the visitor goes to the English one. See src/lib/listing-languages.ts.
const serving = servingFor(property, 'et', await translationConfig());
if (serving.serve === 'redirect') return Astro.redirect(englishUrl(property), serving.permanent ? 301 : 302);

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=120');

// The long-form prose below the summary, falling back to Hungarian when a
// locale has none — see the note in supabase/migrations/0002_seed_properties.sql.
const paragraphs = text(property.data.body, 'et').split('\n\n').filter(Boolean);
---

<PropertyDetailPage locale="et" property={property}>
  {paragraphs.map((para) => <p>{para}</p>)}
</PropertyDetailPage>
