---
/**
 * Root. Sends visitors to a locale rather than serving content at `/`, so no
 * page is reachable at two URLs.
 *
 * Dutch is x-default: FODEL's buyer demand is Dutch and Belgian, and the
 * Hungarian side arrives through direct links and the old fodel.hu.
 *
 * Order of preference: the language the visitor last picked in the switcher
 * (the `fodel_lang` cookie, set by LanguageSwitcher.astro), then the
 * browser's own languages (en-GB, de-AT, fr-BE, es-MX and the like all count; nb and nn count as Norwegian), then Dutch.
 * Without JavaScript the meta refresh sends everyone to Dutch, and the links
 * below the fold stay usable.
 */
export const prerender = true;
import { SITE_URL } from '~/config/site.mjs';
import { LOCALES, FALLBACK_LOCALE, LOCALE_META } from '~/i18n/ui';

const fallback = FALLBACK_LOCALE;
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>FODEL — Kies uw taal / Válasszon nyelvet / Choose your language</title>
    <meta
      name="description"
      content="Kies uw taal om verder te gaan. Válasszon nyelvet a folytatáshoz. Choose your language to continue. Wählen Sie Ihre Sprache. Choisissez votre langue. Elija su idioma. Prosimy wybrać język. Alegeți limba. Vyberte si jazyk. Scelga la sua lingua. Escolha o seu idioma. Επιλέξτε γλώσσα. Zvolte jazyk. Izberite jezik. Välj språk. Vælg sprog. Velg språk. Valitse kieli. Valige keel. Izvēlieties valodu. Pasirinkite kalbą."
    />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={`${SITE_URL}/${fallback}/`} />
    {LOCALES.map((code) => <link rel="alternate" hreflang={LOCALE_META[code].hreflang} href={`${SITE_URL}/${code}/`} />)}
    <link rel="alternate" hreflang="x-default" href={`${SITE_URL}/${fallback}/`} />
    <noscript><meta http-equiv="refresh" content={`0; url=/${fallback}/`} /></noscript>
    <script is:inline define:vars={{ supported: LOCALES, fallback }}>
      // The visitor's own choice first, then their browser's languages.
      (function () {
        var chosen = (document.cookie.match(/(?:^|;\s*)fodel_lang=([a-z]{2})/) || [])[1];
        if (chosen && supported.indexOf(chosen) !== -1) {
          location.replace('/' + chosen + '/');
          return;
        }
        var languages = navigator.languages || [navigator.language || fallback];
        var match = fallback;
        for (var i = 0; i < languages.length; i++) {
          // "en-GB", "de-AT", "fr-BE": the primary subtag decides.
          var code = String(languages[i]).slice(0, 2).toLowerCase();
          // Norwegian browsers say nb (Bokmål), nn (Nynorsk) or no: all read Bokmål here.
          if (code === 'nb' || code === 'nn') code = 'no';
          if (supported.indexOf(code) !== -1) {
            match = code;
            break;
          }
        }
        location.replace('/' + match + '/');
      })();
    </script>
  </head>
  <body>
    <p>
      {
        LOCALES.map((code, index) => (
          <>
            {index > 0 && ' · '}
            <a href={`/${code}/`} lang={LOCALE_META[code].htmlLang}>{LOCALE_META[code].label}</a>
          </>
        ))
      }
    </p>
  </body>
</html>
