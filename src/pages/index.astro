---
/**
 * Root. Sends visitors to a locale rather than serving content at `/`, so no
 * page is reachable at two URLs.
 *
 * Dutch is x-default: FODEL's buyer demand is Dutch and Belgian, and the
 * Hungarian side arrives through direct links and the old fodel.hu.
 *
 * Order of preference: the language the visitor last picked in the switcher
 * (the `fodel_lang` cookie, set by LanguageSwitcher.astro), then the
 * browser's own languages, then Dutch. Without JavaScript the meta refresh
 * inside <noscript> sends everyone to Dutch, as before.
 */
export const prerender = true;
import { SITE_URL } from '~/config/site.mjs';
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>FODEL — Kies uw taal / Válasszon nyelvet</title>
    <meta name="description" content="Kies uw taal om verder te gaan: Nederlands of Hongaars. Válasszon nyelvet a folytatáshoz." />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={`${SITE_URL}/nl/`} />
    <link rel="alternate" hreflang="nl" href={`${SITE_URL}/nl/`} />
    <link rel="alternate" hreflang="hu" href={`${SITE_URL}/hu/`} />
    <link rel="alternate" hreflang="x-default" href={`${SITE_URL}/nl/`} />
    <noscript><meta http-equiv="refresh" content="0; url=/nl/" /></noscript>
    <script is:inline>
      // The visitor's own choice first, then their browser's languages.
      (function () {
        var supported = ['nl', 'hu'];
        var chosen = (document.cookie.match(/(?:^|;\s*)fodel_lang=([a-z]{2})/) || [])[1];
        if (chosen) {
          // The bridge languages have their own home page; hu/nl are full sites.
          if (supported.concat(['en', 'de', 'fr']).indexOf(chosen) !== -1) {
            location.replace('/' + chosen + '/');
            return;
          }
        }
        var languages = navigator.languages || [navigator.language || 'nl'];
        var match = 'nl';
        for (var i = 0; i < languages.length; i++) {
          var code = String(languages[i]).slice(0, 2).toLowerCase();
          if (supported.indexOf(code) !== -1) {
            match = code;
            break;
          }
        }
        location.replace('/' + match + '/');
      })();
    </script>
  </head>
  <body>
    <p>
      <a href="/nl/">Ga verder in het Nederlands</a> ·
      <a href="/hu/">Tovább magyarul</a>
    </p>
  </body>
</html>
