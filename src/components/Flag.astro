---
/**
 * Inline SVG flags for the language switcher — not emoji, which don't
 * render at all on Windows. Hand-drawn, one shared 4:3 viewBox.
 */
type Code =
  | 'hu' | 'nl' | 'gb' | 'de' | 'fr' | 'it' | 'es' | 'pl' | 'ro' | 'sk'
  | 'pt' | 'gr' | 'cz' | 'si' | 'se' | 'dk' | 'no' | 'fi' | 'ee' | 'lv' | 'lt'
  | 'rs' | 'ua' | 'tr' | 'il' | 'ru' | 'cn'
  /** Arabic is the language of many countries: a neutral script badge, not one nation's flag. */
  | 'ar';

interface Props {
  code: Code;
  class?: string;
}

const { code, class: className } = Astro.props;
const clipId = `flag-clip-${code}-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  class:list={['flag', className]}
  viewBox="0 0 24 18"
  width="20"
  height="15"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <clipPath id={clipId}>
      <rect width="24" height="18" rx="2.5" />
    </clipPath>
  </defs>
  <g clip-path={`url(#${clipId})`}>
    {
      code === 'hu' && (
        <>
          <rect width="24" height="18" fill="#fff" />
          <rect width="24" height="6" fill="#CE2939" />
          <rect width="24" height="6" y="12" fill="#436F4D" />
        </>
      )
    }
    {
      code === 'nl' && (
        <>
          <rect width="24" height="18" fill="#fff" />
          <rect width="24" height="6" fill="#AE1C28" />
          <rect width="24" height="6" y="12" fill="#21468B" />
        </>
      )
    }
    {
      code === 'de' && (
        <>
          <rect width="24" height="6" fill="#000" />
          <rect width="24" height="6" y="6" fill="#DD0000" />
          <rect width="24" height="6" y="12" fill="#FFCE00" />
        </>
      )
    }
    {
      code === 'fr' && (
        <>
          <rect width="24" height="18" fill="#fff" />
          <rect width="8" height="18" fill="#0055A4" />
          <rect width="8" height="18" x="16" fill="#EF4135" />
        </>
      )
    }
    {
      code === 'it' && (
        <>
          <rect width="24" height="18" fill="#fff" />
          <rect width="8" height="18" fill="#009246" />
          <rect width="8" height="18" x="16" fill="#CE2B37" />
        </>
      )
    }
    {
      code === 'es' && (
        <>
          <rect width="24" height="18" fill="#AA151B" />
          <rect width="24" height="9" y="4.5" fill="#F1BF00" />
        </>
      )
    }
    {
      code === 'pl' && (
        <>
          <rect width="24" height="18" fill="#fff" />
          <rect width="24" height="9" y="9" fill="#DC143C" />
        </>
      )
    }
    {
      code === 'ro' && (
        <>
          <rect width="24" height="18" fill="#FCD116" />
          <rect width="8" height="18" fill="#002B7F" />
          <rect width="8" height="18" x="16" fill="#CE1126" />
        </>
      )
    }
    {
      code === 'sk' && (
        <>
          <rect width="24" height="18" fill="#fff" />
          <rect width="24" height="6" y="6" fill="#0B4EA2" />
          <rect width="24" height="6" y="12" fill="#EE1C25" />
          <path d="M5,4 H12 V9.5 C12,12.5 8.5,14 8.5,14 C8.5,14 5,12.5 5,9.5 Z" fill="#EE1C25" stroke="#fff" stroke-width="0.7" />
          <path d="M8.5,5.2 V11.4 M6.9,7 H10.1 M6.3,8.8 H10.7" stroke="#fff" stroke-width="0.8" />
          <path d="M5.4,11.2 C6.4,10.4 7.4,10.6 8.5,11.2 C9.6,10.6 10.6,10.4 11.6,11.2 C10.8,12.6 8.5,13.6 8.5,13.6 C8.5,13.6 6.2,12.6 5.4,11.2 Z" fill="#0B4EA2" />
        </>
      )
    }
    {
      code === 'pt' && (
        <>
          <rect width="24" height="18" fill="#FF0000" />
          <rect width="9.6" height="18" fill="#006600" />
          <circle cx="9.6" cy="9" r="3.4" fill="#FFE000" />
          <path d="M7.9,7.1 H11.3 V9.4 C11.3,10.6 9.6,11.4 9.6,11.4 C9.6,11.4 7.9,10.6 7.9,9.4 Z" fill="#FF0000" stroke="#fff" stroke-width="0.5" />
        </>
      )
    }
    {
      code === 'gr' && (
        <>
          <rect width="24" height="18" fill="#0D5EAF" />
          <rect width="24" height="2" y="2" fill="#fff" />
          <rect width="24" height="2" y="6" fill="#fff" />
          <rect width="24" height="2" y="10" fill="#fff" />
          <rect width="24" height="2" y="14" fill="#fff" />
          <rect width="10" height="10" fill="#0D5EAF" />
          <rect width="2" height="10" x="4" fill="#fff" />
          <rect width="10" height="2" y="4" fill="#fff" />
        </>
      )
    }
    {
      code === 'cz' && (
        <>
          <rect width="24" height="18" fill="#fff" />
          <rect width="24" height="9" y="9" fill="#D7141A" />
          <path d="M0,0 L12,9 L0,18 Z" fill="#11457E" />
        </>
      )
    }
    {
      code === 'si' && (
        <>
          <rect width="24" height="18" fill="#fff" />
          <rect width="24" height="6" y="6" fill="#005DA4" />
          <rect width="24" height="6" y="12" fill="#ED1C24" />
          <path d="M4,3.4 H10 V8.4 C10,11.2 7,12.8 7,12.8 C7,12.8 4,11.2 4,8.4 Z" fill="#005DA4" stroke="#fff" stroke-width="0.6" />
          <path d="M4.9,9.6 L6.3,7.3 L7,8.4 L7.7,7.3 L9.1,9.6 Z" fill="#fff" />
          <circle cx="5.9" cy="5.2" r="0.55" fill="#FFDD00" />
          <circle cx="8.1" cy="5.2" r="0.55" fill="#FFDD00" />
          <circle cx="7" cy="6.2" r="0.55" fill="#FFDD00" />
        </>
      )
    }
    {
      code === 'se' && (
        <>
          <rect width="24" height="18" fill="#006AA7" />
          <rect width="3" height="18" x="7" fill="#FECC00" />
          <rect width="24" height="3" y="7.5" fill="#FECC00" />
        </>
      )
    }
    {
      code === 'dk' && (
        <>
          <rect width="24" height="18" fill="#C8102E" />
          <rect width="3" height="18" x="7" fill="#fff" />
          <rect width="24" height="3" y="7.5" fill="#fff" />
        </>
      )
    }
    {
      code === 'no' && (
        <>
          <rect width="24" height="18" fill="#BA0C2F" />
          <rect width="4" height="18" x="6" fill="#fff" />
          <rect width="24" height="4" y="7" fill="#fff" />
          <rect width="2" height="18" x="7" fill="#00205B" />
          <rect width="24" height="2" y="8" fill="#00205B" />
        </>
      )
    }
    {
      code === 'fi' && (
        <>
          <rect width="24" height="18" fill="#fff" />
          <rect width="3.6" height="18" x="6.2" fill="#003580" />
          <rect width="24" height="3.6" y="7.2" fill="#003580" />
        </>
      )
    }
    {
      code === 'ee' && (
        <>
          <rect width="24" height="18" fill="#fff" />
          <rect width="24" height="6" fill="#0072CE" />
          <rect width="24" height="6" y="6" fill="#000" />
        </>
      )
    }
    {
      code === 'lv' && (
        <>
          <rect width="24" height="18" fill="#9E3039" />
          <rect width="24" height="3.6" y="7.2" fill="#fff" />
        </>
      )
    }
    {
      code === 'lt' && (
        <>
          <rect width="24" height="18" fill="#006A44" />
          <rect width="24" height="6" fill="#FDB913" />
          <rect width="24" height="6" y="12" fill="#C1272D" />
        </>
      )
    }
    {
      code === 'gb' && (
        <>
          <rect width="24" height="18" fill="#012169" />
          <path d="M0,0 L24,18 M24,0 L0,18" stroke="#fff" stroke-width="3.6" />
          <path d="M0,0 L10.4,7.8 M24,0 L13.6,10.2" stroke="#C8102E" stroke-width="1.2" />
          <path d="M0,18 L10.4,10.2 M24,18 L13.6,7.8" stroke="#C8102E" stroke-width="1.2" />
          <path d="M12,0 V18 M0,9 H24" stroke="#fff" stroke-width="6" />
          <path d="M12,0 V18 M0,9 H24" stroke="#C8102E" stroke-width="3.6" />
        </>
      )
    }
    {
      code === 'rs' && (
        <>
          <rect width="24" height="6" fill="#C6363C" />
          <rect width="24" height="6" y="6" fill="#0C4076" />
          <rect width="24" height="6" y="12" fill="#fff" />
          <path d="M6 4.6h4v4.2c0 1.5-1 2.4-2 2.8-1-.4-2-1.3-2-2.8z" fill="#C6363C" stroke="#EDB92E" stroke-width="0.6" />
          <path d="M8 5.6v5M6.6 7.6h2.8" stroke="#fff" stroke-width="0.7" />
        </>
      )
    }
    {
      code === 'ua' && (
        <>
          <rect width="24" height="9" fill="#0057B7" />
          <rect width="24" height="9" y="9" fill="#FFD700" />
        </>
      )
    }
    {
      code === 'tr' && (
        <>
          <rect width="24" height="18" fill="#E30A17" />
          <circle cx="9" cy="9" r="4.5" fill="#fff" />
          <circle cx="10.1" cy="9" r="3.6" fill="#E30A17" />
          <polygon points="14.60,6.90 15.07,8.35 16.60,8.35 15.36,9.25 15.83,10.70 14.60,9.80 13.37,10.70 13.84,9.25 12.60,8.35 14.13,8.35" fill="#fff" transform="rotate(-18 14.6 9)" />
        </>
      )
    }
    {
      code === 'il' && (
        <>
          <rect width="24" height="18" fill="#fff" />
          <rect width="24" height="2.2" y="1.8" fill="#0038B8" />
          <rect width="24" height="2.2" y="14" fill="#0038B8" />
          <path d="M12 5.6l2.9 5.05H9.1zM12 12.4l-2.9-5.05h5.8z" fill="none" stroke="#0038B8" stroke-width="0.75" stroke-linejoin="round" />
        </>
      )
    }
    {
      code === 'ru' && (
        <>
          <rect width="24" height="6" fill="#fff" />
          <rect width="24" height="6" y="6" fill="#0039A6" />
          <rect width="24" height="6" y="12" fill="#D52B1E" />
        </>
      )
    }
    {
      code === 'cn' && (
        <>
          <rect width="24" height="18" fill="#DE2910" />
          <polygon points="4.50,1.80 5.11,3.67 7.07,3.67 5.48,4.82 6.09,6.68 4.50,5.53 2.91,6.68 3.52,4.82 1.93,3.67 3.89,3.67" fill="#FFDE00" />
          <polygon points="9.00,0.90 9.20,1.52 9.86,1.52 9.33,1.91 9.53,2.53 9.00,2.14 8.47,2.53 8.67,1.91 8.14,1.52 8.80,1.52" fill="#FFDE00" />
          <polygon points="10.80,2.70 11.00,3.32 11.66,3.32 11.13,3.71 11.33,4.33 10.80,3.94 10.27,4.33 10.47,3.71 9.94,3.32 10.60,3.32" fill="#FFDE00" />
          <polygon points="10.80,5.40 11.00,6.02 11.66,6.02 11.13,6.41 11.33,7.03 10.80,6.64 10.27,7.03 10.47,6.41 9.94,6.02 10.60,6.02" fill="#FFDE00" />
          <polygon points="9.00,7.20 9.20,7.82 9.86,7.82 9.33,8.21 9.53,8.83 9.00,8.44 8.47,8.83 8.67,8.21 8.14,7.82 8.80,7.82" fill="#FFDE00" />
        </>
      )
    }
    {
      code === 'ar' && (
        <>
          <rect width="24" height="18" fill="#1F4E46" />
          <text x="12" y="13.4" text-anchor="middle" font-size="12" font-family="'Noto Sans Arabic Variable', 'Noto Sans Arabic', Tahoma, sans-serif" fill="#fff">ع</text>
        </>
      )
    }
  </g>
</svg>

<style>
  .flag {
    display: block;
    flex-shrink: 0;
    border-radius: 2.5px;
    outline: 1px solid rgba(16, 42, 67, 0.12);
    outline-offset: -0.5px;
  }
</style>
