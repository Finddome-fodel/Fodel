---
/**
 * "A Dutch-speaking agent" as one checkbox card, plus the note that professional
 * photography is a custom premium price. The price is always agreed personally
 * (src/lib/portal/dutch-agent.ts), so the card shows words, never an amount, and
 * adds nothing to the order total. Posts `dutchAgent` = 'yes' when ticked.
 *
 * Sits under the on-site service cards: both are "would you rather have a
 * professional do this?", and the photography note belongs next to the shoot.
 */
import { CHROME } from '~/i18n/chrome';
import type { Locale } from '~/i18n/ui';

interface Props {
  locale: Locale;
  checked?: boolean;
  name?: string;
}

const { locale, checked = false, name = 'dutchAgent' } = Astro.props;
const t = CHROME[locale].dutchAgent;
---

<div class="dutch">
  <label class="card">
    <input type="checkbox" name={name} value="yes" checked={checked} />
    <span class="box" aria-hidden="true">
      <svg width="14" height="14" viewBox="0 0 12 12" fill="none"><path d="M2.5 6.25 5 8.75l4.5-5.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </span>
    <span class="body">
      <span class="price">{t.price}</span>
      <span class="name">{t.title}</span>
      <span class="note">{t.body}</span>
    </span>
  </label>
  <p class="photo">{t.photoNote}</p>
</div>

<style>
  .dutch {
    display: grid;
    gap: 12px;
    margin-top: 10px;
    container-type: inline-size;
  }
  .card {
    position: relative;
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
    gap: 14px;
    align-items: start;
    padding: 20px 22px;
    border-radius: var(--r-lg);
    background: var(--white);
    border: 1px solid rgba(16, 42, 67, 0.12);
    cursor: pointer;
    transition:
      border-color 0.3s var(--ease-out),
      box-shadow 0.3s var(--ease-out);
  }
  .card:hover {
    border-color: rgba(16, 42, 67, 0.34);
  }
  .card input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }
  .card:has(input:checked) {
    border-color: var(--ink);
    box-shadow: 0 0 0 1px var(--ink);
  }
  .card:has(input:focus-visible) {
    outline: var(--focus-ring);
    outline-offset: 3px;
  }
  .box {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    margin-top: 1px;
    border-radius: 6px;
    border: 1.5px solid rgba(16, 42, 67, 0.3);
    color: transparent;
    transition:
      background 0.3s var(--ease-out),
      border-color 0.3s var(--ease-out),
      color 0.3s var(--ease-out);
  }
  .card:has(input:checked) .box {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--cream);
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  .price {
    font-family: var(--serif);
    font-weight: var(--fw-medium);
    font-size: 20px;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .name {
    font-size: var(--fs-body);
    font-weight: var(--fw-medium);
    line-height: 1.4;
    color: var(--ink);
  }
  .note {
    font-size: var(--fs-small);
    line-height: 1.55;
    color: var(--taupe);
  }
  .photo {
    margin: 0;
    padding-left: 22px;
    font-size: var(--fs-small);
    line-height: 1.55;
    color: var(--taupe);
    max-width: 62ch;
  }
</style>
