---
/**
 * Sticky nav, ported from the prototype.
 *
 * Fixed here: links are anchors, so they are crawlable and openable in a new
 * tab; the language switcher actually switches (in the prototype it rendered
 * HU|EN|NL spans with a pointer cursor and no click handler); the mobile
 * drawer reports aria-expanded, traps focus, and is removed from the tab
 * order when closed.
 *
 * 2.0: at the top of a page the bar has no surface at all — it is the page's
 * own header line. Once the page scrolls it lifts into a floating, rounded
 * island of frosted cream. Links are set in sentence case at reading size,
 * with one soft pill that glides to whichever link is pointed at and rests
 * on the current page. The mobile menu is a rounded sheet that unfolds
 * beneath the bar.
 *
 * Launch round: the dark pill at the end of the bar is "Hirdetés feladása"
 * — the action FODEL most wants — with the calm sheen/halo from global.css
 * (.cta-sheen, .cta-halo). "Kapcsolat" moved into the links row. The account
 * control is one quiet pill, "Belépés / Regisztráció", that collapses to its
 * icon where the row would otherwise not fit; the portal pages it opens are
 * told the visitor's language through `?lang=`.
 */
import Logo from './Logo.astro';
import Button from './Button.astro';
import ArrowChip from './ArrowChip.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { UI, path, type Locale } from '~/i18n/ui';
import { getCompany } from '~/lib/runtime-config';

interface Props {
  locale: Locale;
  alternates?: Partial<Record<Locale, string>>;
}

const { locale, alternates = {} } = Astro.props;
const ui = UI[locale];
const current = Astro.url.pathname;
const COMPANY = await getCompany();

const links = [
  { key: 'properties', label: ui.nav.properties },
  { key: 'sellers', label: ui.nav.sellers },
  { key: 'buyers', label: ui.nav.buyers },
  { key: 'about', label: ui.nav.about },
  { key: 'blog', label: ui.nav.blog },
  { key: 'contact', label: ui.nav.contact },
] as const;

const loginHref = `/portal/login?lang=${locale}`;
const registerHref = `/portal/register?lang=${locale}`;
const accountLabel = `${ui.cta.accountLogin} / ${ui.cta.accountRegister}`;

const isCurrent = (href: string) =>
  href === `/${locale}/` ? current === href : current.startsWith(href);
---

<nav class="nav" id="site-nav" aria-label={ui.a11y.mainNav}>
  <div class="nav-inner">
    <div class="nav-start">
      <Logo locale={locale} href={`/${locale}/`} />
    </div>

    <ul class="nav-links" data-nav-links>
      <li class="nav-pill" aria-hidden="true"></li>
      {
        links.map((l) => {
          const href = path(locale, l.key);
          return (
            <li>
              <a class="nav-link" href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          );
        })
      }
    </ul>

    <div class="nav-end">
      <LanguageSwitcher locale={locale} alternates={alternates} align="right" />

      <a class="nav-account" href={loginHref} rel="nofollow" aria-label={accountLabel}>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <circle cx="8" cy="5.25" r="2.9" stroke="currentColor" stroke-width="1.3" />
          <path d="M2.5 14.25c.65-2.85 2.85-4.5 5.5-4.5s4.85 1.65 5.5 4.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
        </svg>
        <span class="nav-account-text" aria-hidden="true">
          {ui.cta.accountLogin}<span class="nav-account-slash">/</span>{ui.cta.accountRegister}
        </span>
      </a>
      <span class="cta-halo nav-cta">
        <Button variant="dark" size="sm" href={path(locale, 'submitAd')} class="cta-sheen">
          {ui.cta.submitAd}
        </Button>
      </span>
    </div>

    <div class="nav-mobile-only">
      <LanguageSwitcher locale={locale} alternates={alternates} align="right" />

      <button
        class="burger"
        type="button"
        id="nav-toggle"
        aria-expanded="false"
        aria-controls="nav-drawer"
        aria-label={ui.menu}
      >
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>
  </div>
</nav>

<div class="drawer" id="nav-drawer" inert>
  <div class="drawer-scrim" data-drawer-close></div>
  <div class="drawer-panel">
    <ul class="drawer-links">
      {
        links.map((l, i) => {
          const href = path(locale, l.key);
          return (
            <li style={`--i:${i}`}>
              <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
                <span class="drawer-num num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="drawer-label">{l.label}</span>
                <ArrowChip size={36} />
              </a>
            </li>
          );
        })
      }
    </ul>

    <div class="drawer-foot" style={`--i:${links.length + 1}`}>
      <Button variant="dark" href={path(locale, 'submitAd')} block class="cta-sheen">{ui.cta.submitAd}</Button>
      <Button variant="outline" href={path(locale, 'contact')} block>{ui.cta.callback}</Button>
      <div class="drawer-account">
        <Button variant="outline" size="sm" href={loginHref} rel="nofollow" block arrow={false}>{ui.cta.accountLogin}</Button>
        <Button variant="outline" size="sm" href={registerHref} rel="nofollow" block arrow={false}>{ui.cta.accountRegister}</Button>
      </div>
      <p class="drawer-contact">
        {COMPANY.phones.filter((p) => p.public).slice(0, 2).map((p) => <a href={p.href}>{p.display}</a>)}
        <a href={`mailto:${COMPANY.email.primary}`}>{COMPANY.email.primary}</a>
      </p>
    </div>
  </div>
</div>

<script>
  const nav = document.getElementById('site-nav')!;
  const toggle = document.getElementById('nav-toggle')!;
  const drawer = document.getElementById('nav-drawer')!;

  // The bar lifts into its island a little way down the page.
  let ticking = false;
  const onScroll = () => {
    ticking = false;
    nav.toggleAttribute('data-scrolled', window.scrollY > 24);
  };
  window.addEventListener(
    'scroll',
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(onScroll);
    },
    { passive: true }
  );
  onScroll();

  /* ── The gliding pill ──
     One element, moved under whichever link is pointed at or focused, and
     returned to the current page's link (or faded out) when the pointer
     leaves the list. */
  const list = nav.querySelector<HTMLElement>('[data-nav-links]');
  const pill = list?.querySelector<HTMLElement>('.nav-pill');
  if (list && pill) {
    const links = Array.from(list.querySelectorAll<HTMLElement>('.nav-link'));
    const home = links.find((a) => a.getAttribute('aria-current') === 'page') ?? null;
    const place = (target: HTMLElement | null, instant = false) => {
      if (!target) {
        pill.style.opacity = '0';
        return;
      }
      if (instant) pill.style.transition = 'none';
      pill.style.setProperty('--x', `${target.offsetLeft}px`);
      pill.style.setProperty('--w', `${target.offsetWidth}px`);
      pill.style.opacity = '1';
      pill.toggleAttribute('data-current', target === home);
      if (instant) {
        pill.getBoundingClientRect();
        pill.style.transition = '';
      }
    };
    const settle = () => place(home, false);
    // Fonts change the link widths once they load; measure after that.
    document.fonts?.ready.then(() => place(home, true));
    place(home, true);
    links.forEach((a) => {
      a.addEventListener('pointerenter', () => place(a));
      a.addEventListener('focus', () => place(a));
    });
    list.addEventListener('pointerleave', settle);
    // Only when focus has really moved elsewhere: Safari reports a mouse
    // click on a link as focus going nowhere (relatedTarget null).
    list.addEventListener('focusout', (e: FocusEvent) => {
      const next = e.relatedTarget;
      if (!(next instanceof Element) || !list.contains(next)) settle();
    });
    window.addEventListener('resize', () => place(home, true), { passive: true });
  }

  /* ── Mobile sheet ── */
  const focusable = () =>
    Array.from(drawer.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'));

  const setOpen = (open: boolean, moveFocus = true) => {
    toggle.setAttribute('aria-expanded', String(open));
    drawer.toggleAttribute('data-open', open);
    nav.toggleAttribute('data-menu-open', open);
    // inert (not `hidden`) so the sheet can still animate while it's
    // closing — `hidden` would rip it out of layout mid-transition.
    drawer.inert = !open;
    document.documentElement.style.overflow = open ? 'hidden' : '';
    if (open && moveFocus) focusable()[0]?.focus();
  };

  // A page restored by the Back button (bfcache) comes back exactly as it was
  // left: sheet open, page scroll locked. Start it clean instead.
  window.addEventListener('pageshow', (e) => {
    if (e.persisted && drawer.hasAttribute('data-open')) setOpen(false, false);
    onScroll();
  });

  toggle.addEventListener('click', () => {
    setOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });
  drawer.querySelectorAll('[data-drawer-close]').forEach((el) => el.addEventListener('click', () => setOpen(false)));
  window.matchMedia('(min-width: 1081px)').addEventListener('change', (e) => {
    if (e.matches && drawer.hasAttribute('data-open')) setOpen(false);
  });

  document.addEventListener('keydown', (e) => {
    if (!drawer.hasAttribute('data-open')) return;

    if (e.key === 'Escape') {
      setOpen(false);
      toggle.focus();
      return;
    }

    if (e.key === 'Tab') {
      const items = [toggle, ...focusable()];
      const first = items[0];
      const last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });
</script>

<style>
  /* ══ Bar ══════════════════════════════════════════════════════════════ */
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-nav);
    padding: 0;
    view-transition-name: site-nav;
    transition: padding 0.7s var(--ease-out);
    pointer-events: none;
  }
  .nav-inner {
    pointer-events: auto;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 24px;
    min-height: var(--nav-h);
    max-width: calc(var(--maxw) + 2 * var(--pad-x));
    margin-inline: auto;
    padding: 0 max(var(--pad-x), env(safe-area-inset-right, 0px)) 0 max(var(--pad-x), env(safe-area-inset-left, 0px));
    border-radius: 0;
    background: rgba(244, 244, 242, 0);
    border: 1px solid transparent;
    transition:
      min-height 0.7s var(--ease-out),
      padding 0.7s var(--ease-out),
      background-color 0.5s var(--ease-out),
      border-color 0.5s var(--ease-out),
      border-radius 0.7s var(--ease-out),
      box-shadow 0.7s var(--ease-out),
      max-width 0.7s var(--ease-out);
  }

  /* Scrolled: the island. The left padding is chosen so the logo moves by
     only the inset — it stays over the page's own margin. */
  .nav[data-scrolled] {
    padding: max(10px, env(safe-area-inset-top, 0px)) max(var(--slab-x), env(safe-area-inset-right, 0px)) 10px
      max(var(--slab-x), env(safe-area-inset-left, 0px));
  }
  .nav[data-scrolled] .nav-inner,
  .nav[data-menu-open] .nav-inner {
    min-height: 66px;
    padding: 0 8px 0 calc(var(--pad-x) - var(--slab-x));
    border-radius: var(--r-pill);
    background: rgba(250, 250, 248, 0.88);
    border-color: rgba(16, 42, 67, 0.07);
    box-shadow:
      0 1px 1px rgba(var(--shadow-ink), 0.03),
      0 10px 30px -12px rgba(var(--shadow-ink), 0.22);
    backdrop-filter: blur(24px) saturate(1.6);
    -webkit-backdrop-filter: blur(24px) saturate(1.6);
  }

  .nav-start {
    display: flex;
    align-items: center;
    min-width: 0;
  }

  /* ══ Links + pill ═════════════════════════════════════════════════════ */
  /* Beside the logo rather than centred on the page: the actions on the
     right weigh more than the logo on the left, and a centred row looked
     pushed against them. */
  .nav-links {
    position: relative;
    display: flex;
    align-items: center;
    gap: 2px;
    margin-left: clamp(16px, 3.4vw, 56px);
    list-style: none;
  }
  .nav-pill {
    position: absolute;
    top: 50%;
    left: 0;
    height: 40px;
    width: var(--w, 0px);
    margin-top: -20px;
    border-radius: var(--r-pill);
    background: rgba(16, 42, 67, 0.065);
    transform: translateX(var(--x, 0px));
    opacity: 0;
    pointer-events: none;
    transition:
      transform 0.5s var(--ease-out),
      width 0.5s var(--ease-out),
      opacity 0.3s ease,
      background-color 0.3s ease;
  }
  .nav-link {
    position: relative;
    display: block;
    padding: 10px 17px;
    border-radius: var(--r-pill);
    font-family: var(--sans);
    font-weight: var(--fw-regular);
    font-size: 1rem;
    letter-spacing: 0.005em;
    line-height: 20px;
    color: var(--ink);
    white-space: nowrap;
  }
  .nav-link[aria-current='page'] {
    font-weight: var(--fw-medium);
  }
  /* The shared underline from global.css is not used on this bar. */
  .nav-link::after {
    content: none;
  }

  /* ══ End ══════════════════════════════════════════════════════════════ */
  .nav-end {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 6px;
  }
  /* One quiet pill: icon, "Belépés / Regisztráció". The slash is a thin
     divider in the same ink — one colour, one weight, no two-tone text. */
  .nav-account {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    height: 44px;
    padding: 0 16px;
    border-radius: var(--r-pill);
    box-shadow: inset 0 0 0 1px rgba(16, 42, 67, 0.12);
    font-size: 0.9375rem;
    color: var(--ink);
    white-space: nowrap;
    transition:
      background-color var(--dur-fast) ease,
      box-shadow var(--dur-fast) ease;
  }
  @media (hover: hover) {
    .nav-account:hover {
      background: rgba(16, 42, 67, 0.065);
      box-shadow: inset 0 0 0 1px rgba(16, 42, 67, 0.2);
    }
  }
  .nav-account svg {
    flex-shrink: 0;
  }
  .nav-account-text {
    display: inline-flex;
    align-items: baseline;
  }
  .nav-account-slash {
    margin: 0 0.42em;
    font-weight: var(--fw-light);
    opacity: 0.45;
  }
  .nav-end .nav-cta {
    margin-left: 6px;
  }
  .nav-cta :global(.btn) {
    white-space: nowrap;
  }

  .nav-mobile-only {
    display: none;
    align-items: center;
    justify-content: flex-end;
    gap: 4px;
    grid-column: 3;
  }
  .burger {
    position: relative;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--ink);
    transition: transform 0.25s var(--ease-out);
  }
  .burger:active {
    transform: scale(0.94);
  }
  .burger span {
    position: absolute;
    left: 15px;
    right: 15px;
    height: 1.5px;
    border-radius: 2px;
    background: var(--cream);
    transition:
      transform 0.55s var(--ease-out),
      top 0.55s var(--ease-out),
      left 0.55s var(--ease-out);
  }
  .burger span:nth-child(1) {
    top: 20px;
  }
  .burger span:nth-child(2) {
    top: 27px;
    left: 21px;
  }
  .burger[aria-expanded='true'] span:nth-child(1) {
    top: 23.5px;
    transform: rotate(45deg);
  }
  .burger[aria-expanded='true'] span:nth-child(2) {
    top: 23.5px;
    left: 15px;
    transform: rotate(-45deg);
  }

  /* ══ Mobile sheet ═════════════════════════════════════════════════════ */
  .drawer {
    position: fixed;
    inset: 0;
    z-index: calc(var(--z-nav) - 2);
    pointer-events: none;
  }
  .drawer[data-open] {
    pointer-events: auto;
  }
  .drawer-scrim {
    position: absolute;
    inset: 0;
    background: rgba(10, 29, 48, 0.28);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    opacity: 0;
    transition: opacity 0.6s var(--ease-out);
  }
  .drawer[data-open] .drawer-scrim {
    opacity: 1;
  }
  .drawer-panel {
    position: absolute;
    top: calc(max(10px, env(safe-area-inset-top, 0px)) + 66px + 8px);
    left: max(var(--slab-x), env(safe-area-inset-left, 0px));
    right: max(var(--slab-x), env(safe-area-inset-right, 0px));
    max-height: calc(100vh - 10px - 66px - 8px - var(--slab-x));
    max-height: calc(100dvh - 10px - 66px - 8px - var(--slab-x) - env(safe-area-inset-bottom, 0px));
    overflow-y: auto;
    overscroll-behavior: contain;
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 10px 10px 20px;
    border-radius: var(--r-xl);
    background: var(--paper);
    box-shadow: var(--shadow-float);
    clip-path: inset(0 0 100% 0 round var(--r-xl));
    /* Out of the tab order once closed even without `inert` support; the
       delay lets the closing wipe finish first. */
    visibility: hidden;
    transition:
      clip-path 0.75s var(--ease-in-out),
      visibility 0s linear 0.75s;
  }
  .drawer[data-open] .drawer-panel {
    clip-path: inset(0 0 0 0 round var(--r-xl));
    visibility: visible;
    transition-delay: 0s;
  }
  .drawer-links {
    list-style: none;
  }
  .drawer-links li,
  .drawer-foot {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.25s ease,
      transform 0.25s ease;
  }
  .drawer[data-open] .drawer-links li,
  .drawer[data-open] .drawer-foot {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.7s var(--ease-out),
      transform 0.8s var(--ease-out);
    transition-delay: calc(0.14s + var(--i, 0) * 0.045s);
  }
  .drawer-links a {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px;
    padding: 12px 8px 12px 14px;
    border-radius: var(--r-lg);
    font-family: var(--serif);
    font-weight: var(--fw-medium);
    font-size: clamp(26px, 7.4vw, 34px);
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--ink);
    --chip-bg: rgba(16, 42, 67, 0.07);
    --chip-fg: var(--ink);
    transition: background-color 0.3s ease;
  }
  .drawer-links a:active,
  .drawer-links a[aria-current='page'] {
    background: rgba(16, 42, 67, 0.05);
  }
  .drawer-links a[aria-current='page'] {
    --chip-bg: var(--ink);
    --chip-fg: var(--cream);
  }
  .drawer-num {
    font-family: var(--sans);
    font-size: 13px;
    font-weight: var(--fw-medium);
    letter-spacing: 0.04em;
    color: var(--taupe);
  }
  .drawer-foot {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 0 6px;
  }
  .drawer-account {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .drawer-account :global(.btn) {
    min-height: 48px;
    padding-inline: 12px;
  }
  .drawer-contact {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 18px;
    margin-top: 10px;
    font-size: var(--fs-small);
    color: var(--taupe);
    font-variant-numeric: tabular-nums;
  }

  @media (prefers-reduced-motion: reduce) {
    .drawer-panel,
    .drawer-links li,
    .drawer-foot {
      transition-duration: 0.01ms !important;
      transition-delay: 0s !important;
    }
  }

  /* Six links, the switcher, the account pill and the CTA, measured in
     Hungarian (the longest words): below 1440px the links tighten, and below
     1400px the account pill keeps only its icon — the full "Belépés /
     Regisztráció" stays its accessible name — so nothing ever touches. */
  @media (max-width: 1440px) {
    .nav-link {
      padding-inline: 12px;
    }
    .nav-links {
      margin-left: clamp(12px, 2vw, 32px);
    }
  }
  @media (max-width: 1400px) {
    .nav-account-text {
      display: none;
    }
    .nav-account {
      width: 44px;
      padding: 0;
      justify-content: center;
    }
  }
  @media (max-width: 1200px) {
    .nav-link {
      padding-inline: 8px;
      font-size: 0.9625rem;
    }
    .nav-inner {
      gap: 14px;
    }
    /* The switcher shows its flag alone here; "HU" stays in its accessible name. */
    .nav-end :global(.switcher-toggle > span[aria-hidden='true']) {
      display: none;
    }
    .nav-end :global(.switcher-toggle) {
      padding: 0 10px;
    }
  }

  @media (max-width: 1080px) {
    .nav-inner {
      grid-template-columns: minmax(0, 1fr) auto;
      min-height: var(--nav-h-mob);
      padding: 0 var(--pad-x);
    }
    .nav[data-scrolled] .nav-inner,
    .nav[data-menu-open] .nav-inner {
      min-height: 66px;
      padding: 0 8px 0 calc(var(--pad-x) - var(--slab-x));
    }
    .nav[data-menu-open] {
      padding: 10px var(--slab-x);
    }
    .nav-links,
    .nav-end {
      display: none;
    }
    .nav-mobile-only {
      display: flex;
      grid-column: 2;
    }
    .nav:not([data-scrolled]):not([data-menu-open]) .burger {
      margin-right: -4px;
    }
  }
</style>
