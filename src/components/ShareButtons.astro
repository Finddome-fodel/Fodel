---
/**
 * Share a listing (master §10b): Facebook, WhatsApp and e-mail are plain links, so they work without JavaScript; the
 * link button and the phone's own share sheet appear when the script runs (src/scripts/share.ts). Every address is
 * built here, on the server, by src/lib/share.ts. Nothing third-party is loaded: no SDK, no pixel, no iframe.
 *
 * On a wide screen: the label and four quiet buttons. On a phone: icons only, or one "Share" button that opens the
 * phone's share sheet when it has one (and the icons again if the sheet refuses). The row keeps its height either way.
 */
import { EMAIL_LABEL, SHARE_COPY } from '~/i18n/share-copy';
import { LOCALE_META, type Locale } from '~/i18n/ui';
import { shareUtm } from '~/config/flags';
import { facebookUrl, mailtoUrl, shareText, shareUrl, whatsappUrl } from '~/lib/share';

interface Props {
  locale: Locale;
  /** The absolute address the visitor is on (the canonical one), never one that redirects. */
  url: string;
  title: string;
  /** The public price as the page writes it; none when the listing has none. */
  price?: string | null;
}

const { locale, url, title, price = null } = Astro.props;
const words = SHARE_COPY[locale];
const rtl = LOCALE_META[locale].dir === 'rtl';
const utm = shareUtm();
const text = shareText({ title, price });
const subject = shareText({ title, brand: 'FINDDOME' });
const headingId = `share-${Math.abs([...url].reduce((hash, c) => (hash * 31 + c.charCodeAt(0)) | 0, 7))}`;

const links = {
  facebook: facebookUrl(url, utm),
  whatsapp: whatsappUrl(text, url, { utm, rtl }),
  email: mailtoUrl({ subject, intro: words.mailIntro, text, url, utm, rtl }),
};
---

<div
  class="share no-print"
  role="group"
  aria-labelledby={headingId}
  data-share
  data-share-title={title}
  data-share-text={text}
  data-share-native={shareUrl(url, 'native', utm)}
  data-share-copy={shareUrl(url, 'copy', utm)}
  data-share-copied={words.copied}
>
  <span class="share-label" id={headingId}>{words.share}</span>

  <div class="share-actions">
    <button type="button" class="share-btn share-native" data-share-native-button>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M12 15V4m0 0L8 8m4-4 4 4M5 12v6.5A1.5 1.5 0 0 0 6.5 20h11a1.5 1.5 0 0 0 1.5-1.5V12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <span>{words.share}</span>
    </button>

    <div class="share-links">
      <a class="share-btn" href={links.facebook} target="_blank" rel="noopener noreferrer">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M14.2 21v-7.6h2.6l.4-3h-3V8.5c0-.9.3-1.5 1.5-1.5h1.6V4.3A21 21 0 0 0 15 4.2c-2.3 0-3.8 1.4-3.8 3.9v2.3H8.6v3h2.6V21" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span class="share-text" aria-hidden="true">Facebook</span>
        <span class="sr-only">{words.facebook} {words.newWindow}</span>
      </a>
      <a class="share-btn" href={links.whatsapp} target="_blank" rel="noopener noreferrer">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 3.5a8.5 8.5 0 0 0-7.3 12.8L3.5 20.5l4.3-1.1A8.5 8.5 0 1 0 12 3.5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
          <path d="M9.2 8.6c-.3.5-.4 1.1 0 1.9a7.4 7.4 0 0 0 3.2 3.1c.9.4 1.5.3 2-.1l.5-.8-1.6-.9-.6.6a4.3 4.3 0 0 1-1.7-1.6l.5-.6-.8-1.6-1 .1Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
        </svg>
        <span class="share-text" aria-hidden="true">WhatsApp</span>
        <span class="sr-only">{words.whatsapp} {words.newWindow}</span>
      </a>
      <a class="share-btn" href={links.email}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect x="3.5" y="5.5" width="17" height="13" rx="2" stroke="currentColor" stroke-width="1.6" />
          <path d="m4.5 7.5 7.5 5.5 7.5-5.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span class="share-text" aria-hidden="true">{EMAIL_LABEL[locale]}</span>
        <span class="sr-only">{words.email}</span>
      </a>
      <button type="button" class="share-btn share-copy" data-share-copy-button data-share-js aria-label={words.copy}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3A4 4 0 0 0 11 18.7l1-1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span class="share-text" aria-hidden="true">{words.copy}</span>
      </button>
    </div>
  </div>

  <span class="share-toast" role="status" aria-live="polite" data-share-toast></span>
</div>

<noscript><style is:inline>.share [data-share-js]{display:none}</style></noscript>

<script>
  import '~/scripts/share';
</script>

<style>
  /* A quiet row under the figures: it never competes with the enquiry panel. */
  .share {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    min-height: 44px;
    padding: 0 4px;
    margin-bottom: 20px;
  }
  .share-label {
    font-size: 13px;
    font-weight: var(--fw-medium);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--taupe);
  }
  .share-actions {
    display: flex;
    align-items: center;
    min-width: 0;
  }
  .share-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }
  .share-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 44px;
    min-width: 44px;
    padding: 0 18px;
    border-radius: var(--r-pill);
    border: 1px solid rgba(16, 42, 67, 0.16);
    background: transparent;
    font: inherit;
    font-size: 14px;
    font-weight: var(--fw-medium);
    color: var(--ink);
    cursor: pointer;
    transition:
      background-color var(--dur-fast) ease,
      border-color var(--dur-fast) ease;
  }
  .share-btn:hover {
    background: var(--white);
    border-color: rgba(16, 42, 67, 0.3);
  }
  .share-btn:focus-visible {
    outline: var(--focus-ring);
    outline-offset: 2px;
  }
  /* Icons keep their shape in right-to-left pages. */
  .share-btn svg {
    flex: none;
  }

  /* The link button needs the script: its place stays, it just is not seen until the script is ready. */
  .share:not([data-share-ready]) [data-share-js] {
    visibility: hidden;
  }

  .share-native {
    display: none;
  }
  .share[data-share-failed] .share-native {
    display: none;
  }

  .share-toast {
    position: absolute;
    inset-inline-end: 4px;
    inset-block-end: calc(100% + 4px);
    padding: 8px 14px;
    border-radius: var(--r-pill);
    background: var(--ink);
    color: var(--cream);
    font-size: 14px;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-fast) ease;
  }
  .share-toast:not(:empty) {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .share {
      margin-bottom: 16px;
    }
    /* A phone: round icon buttons, or the one share button when the phone has its own sheet. */
    .share-text {
      display: none;
    }
    .share-links .share-btn {
      width: 44px;
      padding: 0;
    }
    .share[data-share-has-native]:not([data-share-failed]) .share-native {
      display: inline-flex;
    }
    .share[data-share-has-native]:not([data-share-failed]) .share-links {
      display: none;
    }
    .share[data-share-has-native]:not([data-share-failed]) .share-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .share-btn,
    .share-toast {
      transition: none;
    }
  }
</style>
