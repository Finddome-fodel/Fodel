---
/**
 * Form wrapper: consent, spam traps, submission, and status messaging.
 *
 * With JavaScript the form posts via fetch and swaps in the success panel.
 * Without it, the browser does a native POST and the endpoint redirects to a
 * real thank-you page — a prerendered page cannot read ?sent= at build time,
 * so the confirmation has to be its own URL.
 *
 * The prototype's forms ran `e.preventDefault(); setSent(true)` — the user was
 * told "Üzenetét megkaptuk" while the message was discarded. This one posts to
 * a real endpoint and reports what actually happened.
 *
 * Spam handling is a honeypot plus a time-trap, both checked server-side. No
 * third-party captcha, so nothing is loaded from another origin and no
 * consent is required for the form to work.
 *
 * Launch round — validation people can follow:
 *   - a field is checked when the person leaves it, never while they are
 *     still typing it for the first time; once it shows an error, the error
 *     clears as soon as the value is right;
 *   - the rules and the wording come from src/lib/validation.ts, the module
 *     the server runs too, so both always agree ("Adjon meg egy érvényes
 *     holland telefonszámot, pl. +31 6 12345678");
 *   - a failed submit lists every problem in a summary above the form and
 *     puts the cursor in the first field to fix;
 *   - a server refusal (422) is shown the same way, in place, with every
 *     value the person typed still there.
 * A form with its own confirmation (the registration's "check your inbox")
 * passes it in the `success` slot.
 */
import Button from '~/components/Button.astro';
import { UI, path, localizer, type Locale } from '~/i18n/ui';
import { getCompany } from '~/lib/runtime-config';
import { fillHours } from '~/lib/hours';

interface Props {
  locale: Locale;
  /** POST target, e.g. /api/enquiry */
  endpoint: string;
  formId: string;
  submitLabel?: string;
  onDark?: boolean;
  /** Hidden context passed to the endpoint (property ref, source page…). */
  meta?: Record<string, string>;
  successTitle?: string;
  successBody?: string;
  /** Set when the form carries files (the valuation photos). */
  multipart?: boolean;
}

const {
  locale,
  endpoint,
  formId,
  submitLabel,
  onDark = false,
  meta = {},
  successTitle,
  successBody,
  multipart = false,
} = Astro.props;

const ui = UI[locale];
const x = localizer(locale);
const company = await getCompany();
const publicPhones = company.phones.filter((phone) => phone.public);
// A Hungarian visitor is shown the Hungarian number, everyone else the Dutch one.
const contactPhone = publicPhones.find((phone) => phone.href.startsWith(locale === 'hu' ? 'tel:+36' : 'tel:+31')) ?? publicPhones[0];
const phoneDisplay = contactPhone?.display ?? '';
---

<div class:list={['form-shell', { 'on-dark': onDark }]}>
  <div class="status" id={`${formId}-success`} role="status" hidden>
    {
      Astro.slots.has('success') ? (
        <slot name="success" />
      ) : (
        <>
          <span class="status-mark" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
              <path d="M5 11.5l4 4 8-9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <h3 tabindex="-1">{successTitle ?? ui.form.successTitle}</h3>
          <p>{successBody ?? fillHours(ui.form.successBody, company.hours, locale)}</p>
        </>
      )
    }
  </div>

  <form
    id={formId}
    class="form"
    method="POST"
    action={endpoint}
    enctype={multipart ? 'multipart/form-data' : undefined}
    novalidate
    data-locale={locale}
    data-sending={ui.form.sending}
    data-send-error={ui.form.sendError}
  >
    <input type="hidden" name="locale" value={locale} />
    <input type="hidden" name="formId" value={formId} />
    <input type="hidden" name="returnTo" value={Astro.url.pathname} />
    {Object.entries(meta).map(([k, v]) => <input type="hidden" name={k} value={v} />)}

    {/* Honeypot — hidden from people, irresistible to bots. */}
    {/* No visible label at all, and hidden inline so it stays hidden even if
        this component's stylesheet arrives late or not at all (a stale
        style module once let a stray "Company" label show on the homepage). */}
    <div class="hp" aria-hidden="true" style="position:absolute;left:-10000px;top:auto;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);">
      <input id={`${formId}-company`} type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" />
    </div>
    {/* Time-trap: submissions faster than a human can type are rejected. */}
    <input type="hidden" name="renderedAt" value={Date.now()} />

    <div class="error-summary" id={`${formId}-summary`} role="alert" hidden>
      <p class="error-summary-head"></p>
      <ul></ul>
    </div>

    <div class="fields">
      <slot />
    </div>

    <div class="consent">
      <input type="checkbox" id={`${formId}-consent`} name="consent" required value="yes" />
      <label for={`${formId}-consent`}>
        {ui.form.consent}
        <a href={path(locale, 'privacy')} target="_blank" rel="noopener">{ui.form.consentLink}</a>
      </label>
      <p class="error" id={`${formId}-consent-error`} hidden></p>
    </div>

    <p class="form-error" id={`${formId}-error`} role="alert" hidden></p>

    <Button variant="dark" light={onDark} type="submit" block class="submit">
      {submitLabel ?? ui.form.submit}
    </Button>

    <noscript>
      <p class="noscript">
        {x(
          `Ha az űrlap nem működne, hívjon minket a ${phoneDisplay} számon vagy írjon az ${company.email.primary} címre.`,
          `Werkt het formulier niet? Bel ons op ${phoneDisplay} of mail naar ${company.email.primary}.`,
          `If the form does not work, call us on ${phoneDisplay} or email ${company.email.primary}.`,
          `Funktioniert das Formular nicht? Rufen Sie uns an unter ${phoneDisplay} oder schreiben Sie an ${company.email.primary}.`,
          `Si le formulaire ne fonctionne pas, appelez-nous au ${phoneDisplay} ou écrivez à ${company.email.primary}.`,
          `Si el formulario no funciona, llámenos al ${phoneDisplay} o escriba a ${company.email.primary}.`,
          `Jeśli formularz nie działa, prosimy zadzwonić pod numer ${phoneDisplay} lub napisać na adres ${company.email.primary}.`,
          `Dacă formularul nu funcționează, sunați-ne la ${phoneDisplay} sau scrieți-ne la ${company.email.primary}.`,
          `Ak formulár nefunguje, zavolajte nám na ${phoneDisplay} alebo napíšte na ${company.email.primary}.`
        )}
      </p>
    </noscript>
  </form>
</div>

<script>
  type FieldError = { code: string; country?: string; example?: string; limit?: number };
  type Control = HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;

  // The rules (and the phone metadata) arrive the first time they are needed —
  // a blur or a submit — never with the page.
  let lib: typeof import('~/lib/validation') | null = null;
  const loadLib = async () => (lib ??= await import('~/lib/validation'));
  // The wording is one small file per language, fetched for this page's own.
  const wording = async (locale: string) => {
    const [{ loadValidationCopy }, messages] = await Promise.all([import('~/lib/validation-client'), import('~/lib/validation-messages')]);
    const copy = await loadValidationCopy(locale);
    return {
      errorMessage: (error: never) => messages.errorMessageIn(copy, error),
      summaryHeading: (count: number) => messages.summaryHeadingIn(copy, count),
    };
  };

  document.querySelectorAll<HTMLFormElement>('form.form').forEach((form) => {
    const locale = form.dataset.locale ?? 'nl';
    const sendError = form.dataset.sendError ?? '';
    const sendingText = form.dataset.sending ?? '';
    const formId = form.id;
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    // The label lives in its own span beside the arrow chip; only it changes.
    const submitLabel = submit.querySelector<HTMLElement>('.label') ?? submit;
    const formError = document.getElementById(`${formId}-error`)!;
    const success = document.getElementById(`${formId}-success`)!;
    const summary = document.getElementById(`${formId}-summary`)!;
    const originalLabel = submitLabel.textContent ?? '';

    const controls = () =>
      Array.from(
        form.querySelectorAll<Control>('input:not([type=hidden]):not([tabindex="-1"]):not([aria-hidden="true"]), textarea, select:not([aria-hidden="true"])')
      ).filter((c) => !c.disabled && !c.closest('[hidden]'));

    const errorEl = (control: Control) =>
      (control.closest('.field') ?? control.closest('.consent'))?.querySelector<HTMLElement>(':scope > .error, .error');

    const show = (control: Control, message: string) => {
      control.setAttribute('aria-invalid', 'true');
      const el = errorEl(control);
      if (el) {
        el.textContent = message;
        el.hidden = false;
      }
    };
    const clear = (control: Control) => {
      control.removeAttribute('aria-invalid');
      const el = errorEl(control);
      if (el) el.hidden = true;
    };

    /** The country a phone number or a postcode is checked against. */
    const countryOf = (control: Control) => {
      const byId = control.dataset.countryInput;
      if (byId) return (document.getElementById(byId) as HTMLSelectElement | null)?.value;
      const byName = control.dataset.countryField;
      if (byName) return (form.elements.namedItem(byName) as HTMLSelectElement | null)?.value?.toUpperCase();
      return undefined;
    };

    const check = async (control: Control): Promise<string | null> => {
      const [{ validateField }, { errorMessage }] = await Promise.all([loadLib(), wording(locale)]);
      if (control instanceof HTMLInputElement && control.type === 'checkbox') {
        return control.required && !control.checked ? errorMessage({ code: 'consent' } as never) : null;
      }
      const error = validateField(
        {
          rule: (control.dataset.rule as never) ?? 'text',
          required: control.required,
          min: control.dataset.min ? Number(control.dataset.min) : undefined,
          max: control.dataset.max ? Number(control.dataset.max) : undefined,
          maxLength: 'maxLength' in control && control.maxLength > 0 ? control.maxLength : undefined,
          minLength: control instanceof HTMLInputElement && control.minLength > 0 ? control.minLength : undefined,
        },
        control.value,
        countryOf(control)
      );
      return error ? errorMessage(error as never) : null;
    };

    const validateOne = async (control: Control) => {
      const message = await check(control);
      if (message) show(control, message);
      else clear(control);
      return message;
    };

    // Inline: on leaving a field the person has typed in (or one already
    // marked wrong) — and, once marked, again on every keystroke so the error
    // disappears the moment the value is right.
    form.addEventListener('input', (e) => {
      const control = e.target as Control;
      control.dataset.dirty = '';
      if (control.getAttribute('aria-invalid') === 'true') void validateOne(control);
    });
    form.addEventListener('change', (e) => {
      const control = e.target as Control;
      if (control.matches('select, [type=checkbox], [type=radio]') || control.getAttribute('aria-invalid') === 'true') {
        control.dataset.dirty = '';
        void validateOne(control);
      }
    });
    // An error that appears when a field loses focus pushes the page down; if
    // that happens between pressing and releasing a button or checkbox, the
    // click is lost. So while the pointer is down on such a control, leaving a
    // field validates nothing: submitting checks everything anyway.
    let pressing = false;
    form.addEventListener('pointerdown', (e) => {
      pressing = !!(e.target as Element).closest('button, label, select, [type=checkbox], [type=radio], a');
    }, true);
    const release = () => setTimeout(() => (pressing = false), 0);
    document.addEventListener('pointerup', release);
    document.addEventListener('pointercancel', release);
    form.addEventListener('focusout', (e) => {
      const control = e.target as Control;
      if (!control.matches?.('input, textarea, select')) return;
      if (pressing) return;
      if ('dirty' in control.dataset || control.getAttribute('aria-invalid') === 'true') void validateOne(control);
    });

    const labelOf = (control: Control) =>
      control.dataset.label ??
      form.querySelector(`label[for="${control.id}"]`)?.firstChild?.textContent?.trim() ??
      control.name;

    const showSummary = async (invalid: { control: Control; message: string }[]) => {
      const { summaryHeading } = await wording(locale);
      summary.querySelector('.error-summary-head')!.textContent = summaryHeading(invalid.length);
      const list = summary.querySelector('ul')!;
      list.innerHTML = '';
      for (const { control, message } of invalid) {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `#${control.id}`;
        a.textContent = control.type === 'checkbox' ? message : `${labelOf(control)}: ${message}`;
        a.addEventListener('click', (ev) => {
          ev.preventDefault();
          control.focus();
        });
        li.append(a);
        list.append(li);
      }
      summary.hidden = false;
      invalid[0].control.focus();
      invalid[0].control.scrollIntoView({ block: 'center', behavior: 'smooth' });
    };

    const validateAll = async () => {
      const invalid: { control: Control; message: string }[] = [];
      for (const control of controls()) {
        const message = await validateOne(control);
        if (message) invalid.push({ control, message });
      }
      return invalid;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      formError.hidden = true;
      summary.hidden = true;

      const invalid = await validateAll();
      if (invalid.length) {
        await showSummary(invalid);
        return;
      }

      submit.disabled = true;
      submitLabel.textContent = sendingText;

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        const data = await response.json().catch(() => ({}));

        // The server's own checks failed: show them exactly like the browser's.
        if (response.status === 422 && data?.errors) {
          const { errorMessage } = await wording(locale);
          const serverInvalid: { control: Control; message: string }[] = [];
          for (const [name, raw] of Object.entries(data.errors as Record<string, FieldError | string>)) {
            const error = typeof raw === 'string' ? { code: raw } : raw;
            const control = (name === 'consent'
              ? form.querySelector<Control>('input[name="consent"]')
              : form.querySelector<Control>(`[name="${CSS.escape(name)}"]`));
            if (!control) continue;
            const message = errorMessage(error as never);
            show(control, message);
            serverInvalid.push({ control, message });
          }
          submit.disabled = false;
          submitLabel.textContent = originalLabel;
          if (serverInvalid.length) {
            await showSummary(serverInvalid);
            return;
          }
          throw new Error('422');
        }

        if (!response.ok) throw new Error(String(response.status));
        form.dispatchEvent(new CustomEvent('fodel:success', { detail: data }));

        form.hidden = true;
        success.hidden = false;
        submit.disabled = false;
        submitLabel.textContent = originalLabel;
        success.scrollIntoView({ behavior: 'smooth', block: 'center' });
        (success.querySelector('h3, h2, [tabindex="-1"]') as HTMLElement | null)?.focus?.();
      } catch {
        formError.textContent = sendError;
        formError.hidden = false;
        submit.disabled = false;
        submitLabel.textContent = originalLabel;
      }
    });
  });
</script>

<style>
  .form-shell {
    width: 100%;
  }
  .fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 16px;
  }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .consent {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 10px 14px;
    align-items: start;
    margin: 4px 0 26px;
  }
  /* A rounded box of our own; the native one ignores the radius scale. */
  .consent input {
    appearance: none;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    margin-top: 1px;
    border: 1px solid rgba(16, 42, 67, 0.3);
    border-radius: 7px;
    background: var(--white);
    cursor: pointer;
    transition:
      background-color 0.3s var(--ease-out),
      border-color 0.3s var(--ease-out);
  }
  .consent input::after {
    content: '';
    width: 10px;
    height: 6px;
    margin-top: -3px;
    border-left: 1.6px solid var(--cream);
    border-bottom: 1.6px solid var(--cream);
    transform: rotate(-45deg) scale(0);
    transition: transform 0.3s var(--ease-out);
  }
  .consent input:checked {
    background: var(--ink);
    border-color: var(--ink);
  }
  .consent input:checked::after {
    transform: rotate(-45deg) scale(1);
  }
  .consent input:hover {
    border-color: var(--ink);
  }
  .consent input:focus-visible {
    outline: var(--focus-ring);
    outline-offset: 3px;
  }
  .consent input[aria-invalid='true'] {
    border-color: #b3261e;
  }
  .consent label {
    font-size: var(--fs-small);
    line-height: 1.65;
    color: var(--taupe);
  }
  .consent a {
    text-decoration: underline;
    text-underline-offset: 3px;
    margin-left: 4px;
  }
  .consent .error {
    grid-column: 2;
    font-size: var(--fs-micro);
    color: #b3261e;
  }
  .consent .error[hidden] {
    display: none;
  }

  .error-summary {
    margin-bottom: 22px;
    padding: 16px 20px;
    border-radius: var(--r-md);
    background: rgba(179, 38, 30, 0.07);
    color: #8c1d17;
  }
  .error-summary[hidden] {
    display: none;
  }
  .error-summary-head {
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    margin-bottom: 6px;
  }
  .error-summary ul {
    display: grid;
    gap: 4px;
    padding-left: 18px;
    font-size: var(--fs-small);
    line-height: 1.5;
  }
  .error-summary a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .on-dark .error-summary {
    background: rgba(240, 180, 174, 0.12);
    color: #f6cdc8;
  }

  .form-error {
    font-size: var(--fs-small);
    line-height: 1.6;
    color: #b3261e;
    padding: 12px 16px;
    border-radius: var(--r-sm);
    background: rgba(179, 38, 30, 0.07);
    margin-bottom: 18px;
  }
  .form-error[hidden] {
    display: none;
  }

  .status {
    text-align: center;
    padding: 24px 0;
  }
  .status-mark {
    display: inline-grid;
    place-items: center;
    width: 56px;
    height: 56px;
    margin-bottom: 24px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--cream);
  }
  .on-dark .status-mark {
    background: var(--cream);
    color: var(--ink);
  }
  .status[hidden] {
    display: none;
  }
  .status h3 {
    font-family: var(--serif);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-heading);
    font-size: clamp(28px, 4vw, 40px);
    color: var(--ink);
    margin-bottom: 14px;
  }
  .status p {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--taupe);
    max-width: 46ch;
    margin-inline: auto;
  }

  .noscript {
    font-size: var(--fs-small);
    line-height: 1.7;
    color: var(--taupe);
    margin-top: 16px;
  }

  /* Dark panel */
  .on-dark .consent label,
  .on-dark .noscript {
    color: var(--on-dark-muted);
  }
  .on-dark .consent input {
    background: var(--on-dark-field);
    border-color: var(--on-dark-field-border);
  }
  .on-dark .consent input::after {
    border-color: var(--ink);
  }
  .on-dark .consent input:checked {
    background: var(--cream);
    border-color: var(--cream);
  }
  .on-dark .status h3 {
    color: var(--cream);
  }
  .on-dark .status p {
    color: var(--on-dark-body);
  }
  .on-dark .form-error {
    color: #f0b4ae;
    background: rgba(240, 180, 174, 0.1);
  }

  @media (max-width: 640px) {
    .fields {
      grid-template-columns: 1fr;
    }
  }
</style>
