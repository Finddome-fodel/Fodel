---
/**
 * One labelled control. Every field is a real <label for>, every error has
 * aria-describedby, and required fields are marked in text as well as with
 * the attribute — the prototype's forms had labels but no association,
 * no validation and no error surface at all.
 *
 * Launch round: every field says "(kötelező)" or "(nem kötelező)", carries
 * the keyboard hints a phone needs (`inputmode`, `enterkeyhint`,
 * `autocomplete`) and a `data-rule` that FormShell checks on blur and on
 * submit with the same rules the server runs (src/lib/validation.ts).
 *
 * `type="number"` renders a text field with a numeric keyboard rather than
 * <input type=number>: the native control throws away "64.000.000" or
 * "1 200 000" — exactly how people write a price — and spins the value when
 * the page is scrolled over it. The server reads those forms correctly.
 *
 * `type="tel"` renders PhoneField.astro (country picker + number), so every
 * form that asks for a phone gets the international field.
 */
import { UI, type Locale } from '~/i18n/ui';
import PhoneField from './PhoneField.astro';
import '~/styles/fields.css';

interface Props {
  locale: Locale;
  name: string;
  label: string;
  type?: 'text' | 'email' | 'tel' | 'number' | 'url' | 'textarea' | 'select' | 'postcode' | 'coordinate';
  required?: boolean;
  placeholder?: string;
  autocomplete?: string;
  rows?: number;
  options?: { value: string; label: string }[];
  value?: string;
  hint?: string;
  /** Dark form surfaces (the property enquiry panel) invert the field styling. */
  onDark?: boolean;
  min?: number;
  max?: number;
  maxlength?: number;
  span?: 'full' | 'half';
  inputmode?: 'text' | 'numeric' | 'decimal' | 'email' | 'tel' | 'url' | 'search' | 'none';
  enterkeyhint?: 'enter' | 'done' | 'go' | 'next' | 'previous' | 'search' | 'send';
  /** `type="postcode"`: the name of the field holding the address's ISO country code. */
  countryField?: string;
}

const {
  locale,
  name,
  label,
  type = 'text',
  required = false,
  placeholder,
  autocomplete,
  rows = 4,
  options = [],
  value,
  hint,
  onDark = false,
  min,
  max,
  maxlength,
  span = 'full',
  inputmode,
  enterkeyhint,
  countryField,
} = Astro.props;

const ui = UI[locale];
const id = `f-${name}`;
const errorId = `${id}-error`;
const hintId = hint ? `${id}-hint` : undefined;
const describedBy = [hintId, errorId].filter(Boolean).join(' ');

/** What FormShell and the server check this value against. */
const rule = { email: 'email', tel: 'phone', number: 'number', url: 'url', postcode: 'postcode', coordinate:'coordinate' }[type as string];
const htmlType = (type === 'number' || type === 'postcode' || type === 'coordinate' ? 'text' : type) as 'text' | 'email' | 'tel' | 'url';
const keyboard =
  inputmode ?? (type === 'number' || type==='coordinate' ? 'decimal' : type === 'email' ? 'email' : type === 'tel' ? 'tel' : type === 'url' ? 'url' : undefined);
const autoComplete =
  autocomplete ?? (type === 'email' ? 'email' : type === 'tel' ? 'tel' : type === 'postcode' ? 'postal-code' : undefined);
---

{type === 'tel' ? (
  <PhoneField locale={locale} name={name} label={label} required={required} value={value} hint={hint} onDark={onDark} span={span} enterkeyhint={enterkeyhint === 'next' || enterkeyhint === 'done' || enterkeyhint === 'send' || enterkeyhint === 'go' ? enterkeyhint : undefined} />
) : (
<div class:list={['field', 'fld', `span-${span}`, { 'on-dark': onDark }]}>
  <label for={id}>
    {label}
    <span class="req">{required ? `(${ui.form.required})` : `(${ui.form.optional})`}</span>
  </label>

  {hint && <p class="hint" id={hintId}>{hint}</p>}

  {
    type === 'textarea' ? (
      <textarea
        id={id}
        name={name}
        rows={rows}
        required={required}
        placeholder={placeholder}
        aria-describedby={describedBy}
        autocomplete={autoComplete}
        maxlength={maxlength}
        enterkeyhint={enterkeyhint}
        data-label={label}
      >{value}</textarea>
    ) : type === 'select' ? (
      <select
        id={id}
        name={name}
        required={required}
        aria-describedby={describedBy}
        autocomplete={autoComplete}
        data-label={label}
      >
        {options.map((o) => (
          <option value={o.value} selected={o.value === value}>
            {o.label}
          </option>
        ))}
      </select>
    ) : (
      <input
        id={id}
        name={name}
        type={htmlType}
        required={required}
        placeholder={placeholder}
        value={value}
        aria-describedby={describedBy}
        autocomplete={autoComplete}
        inputmode={keyboard}
        enterkeyhint={enterkeyhint}
        maxlength={maxlength}
        autocapitalize={type === 'email' || type === 'url' ? 'off' : type === 'postcode' ? 'characters' : undefined}
        spellcheck={type === 'email' || type === 'url' ? 'false' : undefined}
        data-rule={rule}
        data-min={min}
        data-max={max}
        data-country-field={countryField}
        data-label={label}
      />
    )
  }

  <p class="error" id={errorId} hidden></p>
</div>
)}
