---

<div class="register" data-register data-form={formId}>
  <FormShell locale={locale} endpoint="/api/listing-order" formId={formId} submitLabel={t.submit} onDark={onDark}>
    <input type="hidden" name="referralCode" value={referralCode} />

    <Field locale={locale} name="name" label={ui.form.name} required autocomplete="name" enterkeyhint="next" maxlength={120} span="full" onDark={onDark} />
    <Field locale={locale} name="email" label={ui.form.email} type="email" required enterkeyhint="next" maxlength={160} span="full" onDark={onDark} />
    <PhoneField locale={locale} name="phone" required enterkeyhint="done" onDark={onDark} />

    <div slot="success" class="inbox">
      <span class="inbox-mark" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
          <rect x="3" y="5.5" width="18" height="13" rx="2.5" stroke="currentColor" stroke-width="1.6" />
          <path d="m4 7.5 8 6 8-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
      <h3 tabindex="-1">{t.title}</h3>
      <p class="inbox-to">{t.sentTo} <strong data-sent-to></strong></p>
      <dl class="inbox-facts">
        <div><dt>{t.from}</dt><dd>{sender}</dd></div>
        <div><dt>{t.subject}</dt><dd>{subject}</dd></div>
      </dl>
      <p class="inbox-note">{t.validity} {t.spam}</p>
      <div class="inbox-actions">
        <button type="button" class="inbox-resend" data-resend data-label={t.resend} data-wait={t.resendIn(0)} disabled>{t.resendIn(60)}</button>
        <p class="inbox-change">{t.wrong} <a href="#" data-change>{t.change}</a></p>
      </div>
      <p class="inbox-status" role="status" data-resend-status data-ok={t.resent} data-fail={t.resendFailed}></p>
    </div>
  </FormShell>
</div>

<script>
  const WAIT_SECONDS = 60;

  document.querySelectorAll<HTMLElement>('[data-register]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('form.form');
    const panel = root.querySelector<HTMLElement>('.status');
    const resend = root.querySelector<HTMLButtonElement>('[data-resend]');
    const change = root.querySelector<HTMLAnchorElement>('[data-change]');
    const sentTo = root.querySelector<HTMLElement>('[data-sent-to]');
    const status = root.querySelector<HTMLElement>('[data-resend-status]');
    if (!form || !panel || !resend || !change || !sentTo || !status) return;

    const label = resend.dataset.label ?? '';
    const waitText = resend.dataset.wait ?? '';
    let timer: number | undefined;

    // The countdown is shown on the button itself; screen readers hear only
    // the start and the end (the button's own text change), not every second.
    const countdown = () => {
      window.clearInterval(timer);
      let left = WAIT_SECONDS;
      resend.disabled = true;
      const tick = () => {
        resend.textContent = waitText.replace(/0(?=\D*$)/, String(left));
        if (left-- <= 0) {
          window.clearInterval(timer);
          resend.disabled = false;
          resend.textContent = label;
        }
      };
      tick();
      timer = window.setInterval(tick, 1000);
    };

    form.addEventListener('fodel:success', () => {
      sentTo.textContent = (form.elements.namedItem('email') as HTMLInputElement).value.trim();
      status.textContent = '';
      countdown();
    });

    resend.addEventListener('click', async () => {
      countdown();
      try {
        // The same submission again: the server gives the open invite a new
        // link and sends it (the old one stops working).
        const res = await fetch(form.action, { method: 'POST', headers: { Accept: 'application/json' }, body: new FormData(form) });
        status.textContent = (res.ok ? status.dataset.ok : status.dataset.fail) ?? '';
      } catch {
        status.textContent = status.dataset.fail ?? '';
      }
    });

    // Back to the form with every value still in it.
    change.addEventListener('click', (e) => {
      e.preventDefault();
      window.clearInterval(timer);
      panel.hidden = true;
      form.hidden = false;
      const email = form.elements.namedItem('email') as HTMLInputElement;
      email.focus();
      email.select();
    });
  });
</script>

<style>
  .inbox {
    text-align: left;
  }
  .inbox-mark {
    display: inline-grid;
    place-items: center;
    width: 56px;
    height: 56px;
    margin-bottom: 20px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--cream);
  }
  :global(.on-dark) .inbox-mark {
    background: var(--cream);
    color: var(--ink);
  }
  .inbox h3 {
    font-family: var(--serif);
    font-weight: var(--fw-medium);
    font-size: clamp(26px, 3.4vw, 34px);
