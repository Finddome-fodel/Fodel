---
/**
 * The landing page's video strip: the channel's latest uploads in a calm row.
 *
 * Each card shows YouTube's own poster image (a plain static file: no cookie,
 * no script from YouTube) and only loads the player, from the privacy-enhanced
 * domain, when a visitor presses play. If the channel cannot be read the whole
 * section is left out rather than shown empty.
 */
import SectionHead from '~/components/SectionHead.astro';
import Button from '~/components/Button.astro';
import { CHROME } from '~/i18n/chrome';
import { localizer, type Locale } from '~/i18n/ui';
import { latestVideos, YOUTUBE } from '~/lib/youtube';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const x = localizer(locale);
const videos = await latestVideos(8);
const play = CHROME[locale].playVideo;

const title = x({ hu: 'Legfrissebb videóink', nl: 'Onze nieuwste video’s', en: 'Our latest videos', de: 'Unsere neuesten Videos', fr: 'Nos dernières vidéos', es: 'Nuestros últimos vídeos', pl: 'Nasze najnowsze filmy', ro: 'Cele mai recente videoclipuri', sk: 'Naše najnovšie videá', it: 'I nostri ultimi video', pt: 'Os nossos vídeos mais recentes', el: 'Τα τελευταία μας βίντεο', cs: 'Naše nejnovější videa', sl: 'Naši najnovejši videoposnetki', sv: 'Våra senaste videor', da: 'Vores seneste videoer', no: 'Våre nyeste videoer', fi: 'Uusimmat videomme', et: 'Meie uusimad videod', lv: 'Mūsu jaunākie video', lt: 'Mūsų naujausi vaizdo įrašai', sr: 'Our latest videos', uk: 'Our latest videos', tr: 'Our latest videos', he: 'Our latest videos', ar: 'Our latest videos', ru: 'Our latest videos', zh: 'Our latest videos' });
const allVideos = x({ hu: 'Minden videó', nl: 'Alle video’s', en: 'All videos', de: 'Alle Videos', fr: 'Toutes les vidéos', es: 'Todos los vídeos', pl: 'Wszystkie filmy', ro: 'Toate videoclipurile', sk: 'Všetky videá', it: 'Tutti i video', pt: 'Todos os vídeos', el: 'Όλα τα βίντεο', cs: 'Všechna videa', sl: 'Vsi videoposnetki', sv: 'Alla videor', da: 'Alle videoer', no: 'Alle videoer', fi: 'Kaikki videot', et: 'Kõik videod', lv: 'Visi video', lt: 'Visi vaizdo įrašai', sr: 'All videos', uk: 'All videos', tr: 'All videos', he: 'All videos', ar: 'All videos', ru: 'All videos', zh: 'All videos' });
const prev = x({ hu: 'Előző', nl: 'Vorige', en: 'Previous', de: 'Zurück', fr: 'Précédent', es: 'Anterior', pl: 'Poprzednie', ro: 'Anterior', sk: 'Predchádzajúce', it: 'Precedente', pt: 'Anterior', el: 'Προηγούμενο', cs: 'Předchozí', sl: 'Prejšnje', sv: 'Föregående', da: 'Forrige', no: 'Forrige', fi: 'Edellinen', et: 'Eelmine', lv: 'Iepriekšējais', lt: 'Ankstesnis', sr: 'Previous', uk: 'Previous', tr: 'Previous', he: 'Previous', ar: 'Previous', ru: 'Previous', zh: 'Previous' });
const next = x({ hu: 'Következő', nl: 'Volgende', en: 'Next', de: 'Weiter', fr: 'Suivant', es: 'Siguiente', pl: 'Następne', ro: 'Următorul', sk: 'Nasledujúce', it: 'Successivo', pt: 'Seguinte', el: 'Επόμενο', cs: 'Další', sl: 'Naslednje', sv: 'Nästa', da: 'Næste', no: 'Neste', fi: 'Seuraava', et: 'Järgmine', lv: 'Nākamais', lt: 'Kitas', sr: 'Next', uk: 'Next', tr: 'Next', he: 'Next', ar: 'Next', ru: 'Next', zh: 'Next' });

const date = (iso: string) => new Intl.DateTimeFormat(locale === 'no' ? 'nb' : locale, { year: 'numeric', month: 'long', day: 'numeric' }).format(new Date(iso));
---

{
  videos.length > 0 && (
    <section class="videos" aria-labelledby="videos-title">
      <div class="videos-head">
        <SectionHead eyebrow="YouTube" title={title} size="large" class="reveal" />
        <div class="videos-controls">
          <Button variant="text" href={YOUTUBE.url} target="_blank" rel="noopener">{allVideos}</Button>
          <div class="videos-arrows">
            <button type="button" class="videos-btn" data-videos="prev" aria-label={prev}>
              <svg class="icon-dir" width="16" height="12" viewBox="0 0 16 12" fill="none" aria-hidden="true"><path d="M15 6H2M6.5 1.5 2 6l4.5 4.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </button>
            <button type="button" class="videos-btn" data-videos="next" aria-label={next}>
              <svg class="icon-dir" width="16" height="12" viewBox="0 0 16 12" fill="none" aria-hidden="true"><path d="M1 6h13M9.5 1.5 14 6l-4.5 4.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </button>
          </div>
        </div>
      </div>

      <ul class="videos-row" data-videos-row tabindex="0" aria-label={title}>
        {videos.map((video) => (
          <li class="video-card" data-video-id={video.id}>
            <button type="button" class="video-poster" aria-label={`${play}: ${video.title}`}>
              <img src={`https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`} alt="" width="480" height="360" loading="lazy" decoding="async" />
              <span class="video-play" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 22 22" fill="currentColor"><path d="M7 4.6v12.8a.8.8 0 0 0 1.2.7l10.2-6.4a.8.8 0 0 0 0-1.4L8.2 3.9A.8.8 0 0 0 7 4.6Z" /></svg>
              </span>
            </button>
            <div class="video-meta">
              <h3 class="video-title">{video.title}</h3>
              <time datetime={video.published}>{date(video.published)}</time>
            </div>
          </li>
        ))}
      </ul>
    </section>
  )
}

<script>
  const section = document.querySelector<HTMLElement>('.videos');
  const row = section?.querySelector<HTMLElement>('[data-videos-row]');
  if (section && row) {
    const buttons = section.querySelectorAll<HTMLButtonElement>('[data-videos]');
    const step = () => (row.querySelector<HTMLElement>('.video-card')?.offsetWidth ?? 320) + 24;
    const update = () => {
      const max = row.scrollWidth - row.clientWidth - 2;
      section.toggleAttribute('data-static', max <= 0);
      const at = Math.abs(row.scrollLeft); // negative on right-to-left pages
      buttons.forEach((b) => b.setAttribute('aria-disabled', String(b.dataset.videos === 'prev' ? at <= 2 : at >= max)));
    };
    buttons.forEach((b) =>
      b.addEventListener('click', () => row.scrollBy({ left: (b.dataset.videos === 'prev' ? -1 : 1) * (getComputedStyle(row).direction === 'rtl' ? -1 : 1) * step(), behavior: 'smooth' }))
    );
    row.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
    update();

    // Press play: swap the poster for the player (privacy-enhanced domain, autoplay).
    row.addEventListener('click', (event) => {
      const poster = (event.target as HTMLElement).closest<HTMLButtonElement>('.video-poster');
      const card = poster?.closest<HTMLElement>('.video-card');
      if (!poster || !card?.dataset.videoId) return;
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube-nocookie.com/embed/${card.dataset.videoId}?autoplay=1&rel=0&modestbranding=1`;
      frame.title = card.querySelector('.video-title')?.textContent ?? '';
      frame.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; fullscreen';
      frame.allowFullscreen = true;
      frame.className = 'video-frame';
      poster.replaceWith(frame);
      frame.focus();
    });
  }
</script>

<style>
  .videos {
    padding: var(--section-y) 0 calc(var(--section-y) * 0.8);
  }
  .videos-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    padding: 0 var(--pad-x);
    margin-bottom: 48px;
  }
  .videos-head :global(.section-head-standard) {
    margin-bottom: 0;
  }
  .videos-controls {
    display: flex;
    align-items: center;
    gap: 28px;
    padding-bottom: 6px;
  }
  .videos-arrows {
    display: flex;
    gap: 8px;
  }
  .videos-btn {
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: var(--white);
    border: 1px solid rgba(16, 42, 67, 0.1);
    color: var(--ink);
    transition:
      background-color 0.4s var(--ease-out),
      color 0.4s var(--ease-out),
      opacity 0.4s ease,
      transform 0.25s var(--ease-out);
  }
  .videos-btn:hover {
    background: var(--ink);
    color: var(--cream);
  }
  .videos-btn:active {
    transform: scale(0.94);
  }
  .videos-btn[aria-disabled='true'] {
    opacity: 0.35;
    pointer-events: none;
  }
  .videos[data-static] .videos-arrows {
    display: none;
  }

  .videos-row {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: clamp(280px, 29vw, 440px);
    gap: 24px;
    margin: 0;
    padding: 0 var(--pad-x) 8px;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--pad-x);
    scrollbar-width: none;
  }
  .videos-row::-webkit-scrollbar {
    display: none;
  }
  .video-card {
    scroll-snap-align: start;
    min-width: 0;
  }
  .video-poster,
  .video-card :global(.video-frame) {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    padding: 0;
    overflow: hidden;
    border-radius: var(--r-lg);
    background: var(--ink);
  }
  .video-poster {
    cursor: pointer;
  }
  /* YouTube's 4:3 poster carries black bars above and below the picture; cover crops them. */
  .video-poster img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.001);
    transition: transform 0.9s var(--ease-out), filter 0.5s ease;
  }
  .video-poster::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(16, 42, 67, 0.38), rgba(16, 42, 67, 0) 55%);
    pointer-events: none;
  }
  .video-play {
    position: absolute;
    inset-inline-start: 20px;
    bottom: 20px;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--cream);
    color: var(--ink);
    padding-inline-start: 3px;
    transition: transform 0.4s var(--ease-out), background-color 0.4s var(--ease-out);
  }
  .video-poster:hover img,
  .video-poster:focus-visible img {
    transform: scale(1.04);
  }
  .video-poster:hover .video-play,
  .video-poster:focus-visible .video-play {
    transform: scale(1.08);
    background: var(--white);
  }
  .video-poster:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }
  .video-meta {
    margin-top: 16px;
    padding-inline-end: 8px;
  }
  .video-title {
    margin: 0 0 6px;
    font-family: var(--serif);
    font-weight: var(--fw-medium);
    font-size: clamp(18px, 1.5vw, 21px);
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--ink);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .video-meta time {
    font-size: 13px;
    letter-spacing: 0.02em;
    color: var(--ink-quiet);
  }

  @media (max-width: 1000px) {
    .videos-row {
      grid-auto-columns: clamp(260px, 52vw, 380px);
    }
  }
  @media (max-width: 700px) {
    .videos {
      padding: 72px 0 56px;
    }
    .videos-head {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
      padding: 0 var(--pad-x-mob);
      margin-bottom: 28px;
    }
    .videos-arrows {
      display: none;
    }
    .videos-row {
      grid-auto-columns: 80vw;
      gap: 16px;
      padding: 0 var(--pad-x-mob) 8px;
      scroll-padding-inline: var(--pad-x-mob);
    }
    .video-play {
      inset-inline-start: 14px;
      bottom: 14px;
      width: 48px;
      height: 48px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .video-poster img,
    .video-play {
      transition: none;
    }
  }
</style>
