---
/**
 * The FINDDOME logo: the magnifier over Europe and the "Finddome.com" wordmark.
 * Built from the one supplied master by scripts/build-brand.mjs (transparent
 * background; `light` is the navy-background variant with a cream wordmark).
 *
 * `size` fixes the height the logo is drawn at; the image is generated at 1x/2x/3x
 * of that, so it stays sharp on phones and retina screens without shipping the master.
 */
import { Image } from 'astro:assets';
import { BRAND, type Locale } from '~/i18n/ui';
import dark from '~/assets/brand/finddome-logo.png';
import light from '~/assets/brand/finddome-logo-light.png';

interface Props {
  locale: Locale;
  light?: boolean;
  href?: string;
  /** Rendered height in px on desktop: nav 62, auth 84, setup 56, footer 112. */
  size?: 'nav' | 'auth' | 'setup' | 'footer';
}

const { locale, light: onDark = false, href = `/${locale}/`, size = 'nav' } = Astro.props;
const HEIGHT = { nav: 62, auth: 84, setup: 56, footer: 112 } as const;
const height = HEIGHT[size];
const source = onDark ? light : dark;
const width = Math.round((height * source.width) / source.height);
---

<a class="logo" class:list={[size]} href={href} aria-label={BRAND[locale].name}>
  <Image
    src={source}
    alt=""
    width={width}
    height={height}
    densities={[1, 2, 3]}
    format="webp"
    quality={90}
    loading="eager"
    decoding="async"
    draggable="false"
  />
</a>

<style>
  .logo {
    display: inline-flex;
    vertical-align: top;
    line-height: 0;
    user-select: none;
    border-radius: var(--r-xs);
  }
  .logo :global(img) {
    display: block;
    height: var(--logo-h);
    width: auto;
    max-width: none;
  }
  .nav {
    --logo-h: 62px;
  }
  .auth {
    --logo-h: 84px;
  }
  .setup {
    --logo-h: 56px;
  }
  .footer {
    --logo-h: 112px;
  }
  /* The floating bar is 68 px tall on phones and 66 once scrolled: keep a breath above and below. */
  @media (max-width: 1080px) {
    .nav {
      --logo-h: 48px;
    }
  }
  @media (max-width: 700px) {
    .auth {
      --logo-h: 68px;
    }
    .footer {
      --logo-h: 92px;
    }
  }
</style>
