---
/**
 * Cookie consent — opt-in, with genuine reject parity.
 *
 * The site currently sets no non-essential cookies at all, so nothing is
 * gated behind this yet. It exists because the moment analytics is added,
 * ePrivacy requires prior consent, and retrofitting a compliant banner is
 * how sites end up with dark patterns. Accept and reject are the same size,
 * the same weight, and the same distance from the user's thumb.
 *
 * 1.4: a card in the corner rather than a bar across the page, so it never
 * sits on the content it is asking about; both answers are the same button.
 */
import Button from './Button.astro';
import { path, type Locale } from '~/i18n/ui';
import { CHROME } from '~/i18n/chrome';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const copy = CHROME[locale].cookie;
---

<aside
  class="cookie-consent"
  id="cookie-consent"
  role="dialog"
  aria-labelledby="cookie-title"
  aria-describedby="cookie-body"
  hidden
>
  <h2 id="cookie-title">
    <span class="rule" aria-hidden="true"></span>
    {copy.title}
  </h2>
  <p id="cookie-body">
    {copy.body}
    <a href={path(locale, 'cookies')}>{copy.more}</a>
  </p>
  <div class="actions">
    <Button variant="outline" light size="sm" id="cookie-reject">{copy.reject}</Button>
    <Button variant="outline" light size="sm" id="cookie-accept">{copy.accept}</Button>
  </div>
</aside>

<script>
  const KEY = 'fodel:consent';
  const banner = document.getElementById('cookie-consent');

  // Safari has no requestIdleCallback (an undeclared name throws, so test it on window),
  // and storage can throw in private windows: either way the banner still appears.
  let decided = false;
  try {
    decided = !!localStorage.getItem(KEY);
  } catch {
    /* treated as undecided */
  }
  if (banner && !decided) {
    // Deferred so the banner never competes with the LCP element.
    const show = () => banner.removeAttribute('hidden');
    if ('requestIdleCallback' in window) window.requestIdleCallback(show, { timeout: 1500 });
    else setTimeout(show, 800);
  }

  const decide = (value: 'granted' | 'denied') => {
    try {
      localStorage.setItem(KEY, JSON.stringify({ analytics: value, at: Date.now() }));
    } catch {
      /* the choice then lasts for this page only */
    }
    banner?.setAttribute('hidden', '');
    // When analytics is added, it initialises here — and only here.
    document.dispatchEvent(new CustomEvent('fodel:consent', { detail: { analytics: value } }));
  };

  document.getElementById('cookie-accept')?.addEventListener('click', () => decide('granted'));
  document.getElementById('cookie-reject')?.addEventListener('click', () => decide('denied'));
</script>

<style>
  /* Above the navigation. */
  .cookie-consent {
    position: fixed;
    left: 24px;
    bottom: 24px;
    z-index: var(--z-cookie);
    width: min(420px, calc(100vw - 48px));
    padding: 26px 26px 22px;
    border-radius: var(--r-xl);
    background:
      radial-gradient(120% 90% at 100% 0%, var(--ink-soft) 0%, transparent 60%),
      var(--ink);
    color: var(--cream);
    border: 1px solid var(--on-dark-rule);
    box-shadow: var(--shadow-float);
    animation: fx-fade-up 0.9s var(--ease-out) both;
  }
  .cookie-consent[hidden] {
    display: none;
  }
  h2 {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 14px;
    font-family: var(--sans);
    font-weight: var(--fw-regular);
    font-size: var(--fs-eyebrow);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--cream);
  }
  .rule {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--cream);
  }
  p {
    font-size: var(--fs-small);
    line-height: 1.7;
    color: var(--on-dark-body);
  }
  p a {
    color: var(--cream);
    white-space: nowrap;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  /* Equal weight by design — no visual nudge toward accepting. */
  .actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: 22px;
  }
  .actions :global(.btn) {
    padding-inline: 12px;
    width: 100%;
  }

  @media (max-width: 600px) {
    .cookie-consent {
      left: 12px;
      right: 12px;
      bottom: 12px;
      width: auto;
      padding: 22px 20px 20px;
    }
  }
</style>
