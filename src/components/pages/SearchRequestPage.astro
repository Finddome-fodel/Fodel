      { n: '04', t: 'Le acompañamos', b: 'Visita, negociación y contrato bilingüe: estamos a su lado en todo momento.' },
    ],
    formHead: 'Búsqueda gratuita',
    free: 'Gratis',
    submit: 'Enviar la solicitud',
    successTitle: 'Gracias',
    successBody:
      'Hemos recibido su solicitud de búsqueda. En cuanto encontremos un inmueble que se ajuste a sus criterios, le escribiremos por correo electrónico.',
  },
  pl: {
    metaTitle: 'Poszukiwanie nieruchomości: bezpłatne zlecenie poszukiwania na Węgrzech',
    metaDescription:
      'Nie znaleźli Państwo tego, czego szukają? Prosimy opisać swoje oczekiwania, a my poszukamy za Państwa, także poza naszymi ogłoszeniami. Usługa poszukiwania jest bezpłatna.',
    eyebrow: 'Poszukiwanie nieruchomości',
    title: 'Prosimy napisać, czego Państwo szukają,',
    titleEm: 'a my poszukamy',
    body: 'Jeśli odpowiedniej nieruchomości nie ma wśród naszych ogłoszeń, prosimy opisać swoje oczekiwania. Dzięki sieci naszych węgierskich partnerów docieramy także do nieruchomości, których jeszcze nie ma w internecie. Usługa jest bezpłatna.',
    howHead: 'Jak to działa',
    steps: [
      { n: '01', t: 'Wypełniają Państwo formularz', b: 'Rodzaj nieruchomości, region, budżet i Państwa szczególne życzenia.' },
      { n: '02', t: 'Szukamy', b: 'Razem z partnerami, także poza ogłoszonymi nieruchomościami.' },
      { n: '03', t: 'Odzywamy się do Państwa', b: 'E-mailem otrzymują Państwo oferty spełniające Państwa kryteria.' },
      { n: '04', t: 'Towarzyszymy Państwu', b: 'Oględziny, negocjacje i dwujęzyczna umowa: jesteśmy przy Państwu na każdym etapie.' },
    ],
    formHead: 'Bezpłatne poszukiwanie',
    free: 'Bezpłatnie',
    submit: 'Wyślij zlecenie',
