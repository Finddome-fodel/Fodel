const t = copies[locale];

const taxonomy = await getTaxonomy();
const categoryOptions = taxonomy.category.filter((term) => term.enabled).map((term) => ({
  value: term.key, label: termLabel(term, locale),
}));
---

<Base
  locale={locale}
  title={t.metaTitle}
  description={t.metaDescription}
  alternates={alternatesFor('searchRequest')}
  schema={[serviceSchema(locale, t.eyebrow, t.metaDescription)]}
>
  <PageHeader eyebrow={t.eyebrow} title={t.title} titleEm={t.titleEm} body={t.body} compact />

  <section class="how">
    <Eyebrow space="24px">{t.howHead}</Eyebrow>
    <ol>
      {
        t.steps.map((s: any) => (
          <li>
            <span class="n">{s.n}</span>
            <h2>{s.t}</h2>
            <p>{s.b}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="form-section slab">
    <div class="form-inner">
      <div class="form-head">
        <span class="badge">{t.free}</span>
        <h2>{t.formHead}</h2>
      </div>

      <FormShell
        locale={locale}
        endpoint="/api/search-request"
        formId="search-request"
        submitLabel={t.submit}
        successTitle={t.successTitle}
        successBody={t.successBody}
      >
        <Field locale={locale} name="name" label={ui.form.name} required autocomplete="name" span="half" />
        <Field locale={locale} name="email" label={ui.form.email} type="email" required autocomplete="email" span="half" />
        <Field locale={locale} name="phone" label={ui.form.phone} type="tel" autocomplete="tel" span="full" />
        <Field
          locale={locale}
          name="propertyType"
          label={x('Keresett ingatlantípus', 'Gezocht type', 'Type of property wanted', 'Gesuchte Immobilienart', 'Type de bien recherché', 'Tipo de inmueble buscado', 'Rodzaj poszukiwanej nieruchomości', 'Tipul de proprietate căutat', 'Typ hľadanej nehnuteľnosti', 'Tipologia di immobile cercata', 'Tipo de imóvel pretendido', 'Τύπος ακινήτου που αναζητάτε', 'Hledaný typ nemovitosti', 'Iskana vrsta nepremičnine', 'Önskad typ av fastighet', 'Ønsket ejendomstype', 'Ønsket eiendomstype', 'Haettu kiinteistötyyppi', 'Soovitud kinnisvara tüüp', 'Vēlamais īpašuma veids', 'Pageidaujamas turto tipas')}
          type="select"
          required
          options={categoryOptions}
          span="full"
        />
        <Field
          locale={locale}
          name="region"
          label={x('Régió, megye vagy település', 'Streek, comitaat of plaats', 'Region, county or town', 'Region, Komitat oder Ort', 'Région, comitat ou localité', 'Región, condado o localidad', 'Region, komitat lub miejscowość', 'Regiune, județ sau localitate', 'Región, župa alebo obec', 'Regione, contea o località', 'Região, condado ou localidade', 'Περιφέρεια, νομός ή πόλη', 'Region, župa nebo obec', 'Regija, županija ali kraj', 'Region, län eller ort', 'Region, amt eller by', 'Region, fylke eller sted', 'Alue, maakunta tai paikkakunta', 'Piirkond, maakond või asula', 'Reģions, medze vai apdzīvota vieta', 'Regionas, apskritis arba gyvenvietė')}
          placeholder={x('pl. Balaton, Zala megye', 'bijv. Balaton, comitaat Zala', 'e.g. Lake Balaton, Zala County', 'z. B. Plattensee, Komitat Zala', 'p. ex. lac Balaton, comitat de Zala', 'p. ej., lago Balaton, condado de Zala', 'np. Balaton, komitat Zala', 'de ex. lacul Balaton, județul Zala', 'napr. Balaton, župa Zala', 'ad es. Lago Balaton, contea di Zala', 'p. ex. Lago Balaton, condado de Zala', 'π.χ. Λίμνη Μπάλατον, νομός Ζάλα', 'např. Balaton, župa Zala', 'npr. Blatno jezero, županija Zala', 't.ex. Balatonsjön, Zala län', 'f.eks. Balatonsøen, Zala amt', 'f.eks. Balatonsjøen, Zala fylke', 'esim. Balaton-järvi, Zalan maakunta', 'nt Balatoni järv, Zala maakond', 'piem., Balatona ezers, Zalas medze', 'pvz., Balatono ežeras, Zalos apskritis')}
          span="full"
        />
        <Field
          locale={locale}
          name="budgetMin"
          label={x('Keret-tól (€)', 'Budget vanaf (€)', 'Budget from (€)', 'Budget ab (€)', 'Budget à partir de (€)', 'Presupuesto desde (€)', 'Budżet od (€)', 'Buget de la (€)', 'Rozpočet od (€)', 'Budget da (€)', 'Orçamento a partir de (€)', 'Προϋπολογισμός από (€)', 'Rozpočet od (€)', 'Proračun od (€)', 'Budget från (€)', 'Budget fra (€)', 'Budsjett fra (€)', 'Budjetti alkaen (€)', 'Eelarve alates (€)', 'Budžets no (€)', 'Biudžetas nuo (€)')}
