---
/**
 * Map browse. A full-viewport clustered map of every active listing, with a
 * "search this area" action that hands the current bounds to the listings
 * page as a `?bbox=` parameter.
 *
 * (The comment that stood here claimed bbox filtering was only approximate,
 * matching on settlement text. That is no longer true and had not been since
 * Stage 6: `search_properties()` takes a real `p_bbox` and compares lat/lng
 * directly — see supabase/migrations/0004_search.sql. Plain range comparisons
 * are exact and need no PostGIS, because Hungary is small and never crosses
 * the antimeridian.)
 *
 * A secondary view by decision, not by accident: the list is the primary way
 * to browse, and the map is reachable from it rather than from the main
 * navigation. Until 1.1 nothing linked here at all.
 */
import Base from '~/layouts/Base.astro';
import Eyebrow from '~/components/Eyebrow.astro';
import Map from '~/components/Map.astro';
import { UI, path, localizer, type Locale } from '~/i18n/ui';
import { alternatesFor, crumbs } from '~/lib/page';
import { breadcrumbSchema } from '~/lib/seo';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = UI[locale];

const x = localizer(locale);
const title = x('Ingatlanok térképen', 'Woningen op de kaart', 'Properties on the map', 'Immobilien auf der Karte', 'Les biens sur la carte', 'Los inmuebles en el mapa', 'Nieruchomości na mapie', 'Proprietățile pe hartă', 'Nehnuteľnosti na mape', 'Immobili sulla mappa', 'Imóveis no mapa', 'Ακίνητα στον χάρτη', 'Nemovitosti na mapě', 'Nepremičnine na zemljevidu', 'Fastigheter på kartan', 'Ejendomme på kortet', 'Eiendommer på kartet', 'Kohteet kartalla', 'Kinnisvara kaardil', 'Īpašumi kartē', 'Turtas žemėlapyje');
const description = x(
  'Böngéssze a FINDDOME magyarországi ingatlanait térképen, régió szerint csoportosítva.',
  'Blader door het Hongaarse vastgoed van FINDDOME op de kaart, gegroepeerd per regio.',
  'Browse FINDDOME’s Hungarian properties on a map, grouped by region.',
  'Stöbern Sie auf der Karte durch die ungarischen Immobilien von FINDDOME, nach Region gruppiert.',
  'Parcourez sur la carte les biens hongrois de FINDDOME, regroupés par région.',
  'Explore en el mapa los inmuebles húngaros de FINDDOME, agrupados por región.',
  'Przeglądaj na mapie węgierskie nieruchomości FINDDOME pogrupowane według regionów.',
  'Explorați pe hartă proprietățile FINDDOME din Ungaria, grupate pe regiuni.',
  'Prezrite si na mape maďarské nehnuteľnosti FINDDOME zoskupené podľa regiónov.',
  'Sfogli gli immobili ungheresi di FINDDOME su una mappa, raggruppati per regione.',
  'Explore os imóveis húngaros da FINDDOME num mapa, agrupados por região.',
  'Περιηγηθείτε στα ουγγρικά ακίνητα της FINDDOME σε χάρτη, ομαδοποιημένα ανά περιφέρεια.',
  'Prohlédněte si maďarské nemovitosti FINDDOME na mapě, seskupené podle regionů.',
  'Prebrskajte madžarske nepremičnine FINDDOME na zemljevidu, razvrščene po regijah.',
  'Bläddra bland FINDDOME:s ungerska fastigheter på en karta, grupperade per region.',
  'Se FINDDOME’s ungarske ejendomme på et kort, grupperet efter region.',
  'Se FINDDOMEs ungarske eiendommer på et kart, gruppert etter region.',
  'Selaa FINDDOMEn unkarilaisia kohteita kartalla alueittain ryhmiteltyinä.',
  'Sirvige FINDDOME’i Ungari kinnisvara kaardil, piirkondade kaupa rühmitatuna.',
  'Pārlūkojiet FINDDOME īpašumus Ungārijā kartē, sagrupētus pa reģioniem.',
  'Peržiūrėkite FINDDOME nekilnojamąjį turtą Vengrijoje žemėlapyje, sugrupuotą pagal regionus.'
);

const trail = crumbs(locale, [
  { name: ui.nav.properties, url: path(locale, 'properties') },
  { name: title, url: path(locale, 'map') },
]);

/**
 * Filters arrive from the listings page and go back with the visitor.
 * Switching view is meant to be a change of presentation, not a reset — the
 * map hands `bbox` forward to the list, and this hands everything else back.
 */
const carried = new URLSearchParams(Astro.url.searchParams);
carried.delete('page');
const carriedQuery = carried.toString();
const listHref = carriedQuery
  ? `${path(locale, 'properties')}?${carriedQuery}`
  : path(locale, 'properties');
---

<Base
  locale={locale}
  title={title}
  description={description}
  alternates={alternatesFor('map')}
  schema={[breadcrumbSchema(trail)]}
  flush
>
  <div class="map-page">
    <div class="map-head">
      <Eyebrow space="8px">{ui.nav.properties}</Eyebrow>
      <h1>{title}</h1>
      <a href={listHref} class="list-link">{ui.filters.viewList}</a>
      <button type="button" id="search-this-area" class="area-btn">
        {x('Keresés ezen a területen', 'Zoek in dit gebied', 'Search this area', 'In diesem Bereich suchen', 'Rechercher dans cette zone', 'Buscar en esta zona', 'Szukaj w tym obszarze', 'Căutați în această zonă', 'Hľadať v tejto oblasti', 'Cerca in quest’area', 'Pesquisar nesta zona', 'Αναζήτηση σε αυτή την περιοχή', 'Hledat v této oblasti', 'Išči na tem območju', 'Sök i det här området', 'Søg i dette område', 'Søk i dette området', 'Hae tältä alueelta', 'Otsi sellelt alalt', 'Meklēt šajā apgabalā', 'Ieškoti šioje vietovėje')}
      </button>
    </div>
    <div class="map-wrap">
      <Map mode="browse" locale={locale} id="browse-map" />
    </div>
  </div>
</Base>

<style>
  /* 2.0: the map is a rounded stage under a slim header of pill controls. */
  .map-page {
    display: flex;
    flex-direction: column;
    gap: 12px;
    /* The page is `flush` (no automatic top offset) and the nav floats over
       it, so the space under the nav is reserved here — otherwise the title
       and the two pills sat underneath the navigation. */
    height: 100svh;
    padding: var(--nav-h) var(--slab-x) var(--slab-x);
  }
  .map-head {
    display: flex;
    align-items: center;
    gap: 10px 12px;
    padding: 12px calc(var(--pad-x) - var(--slab-x)) 4px;
    flex-wrap: wrap;
  }
  .map-head :global(.eyebrow) {
    display: none;
  }
  h1 {
    font-family: var(--serif);
    font-weight: var(--fw-medium);
    font-size: clamp(22px, 2vw, 28px);
    letter-spacing: -0.015em;
    color: var(--ink);
    flex: 1;
    min-width: 200px;
  }
  .area-btn,
  .list-link {
    display: inline-flex;
    align-items: center;
    height: 44px;
    padding: 0 20px;
    border-radius: var(--r-pill);
    font-size: 15px;
    font-weight: var(--fw-medium);
    transition:
      background-color 0.35s var(--ease-out),
      border-color 0.35s var(--ease-out),
      color 0.35s var(--ease-out);
  }
  .area-btn {
    background: var(--ink);
    color: var(--cream);
  }
  .area-btn:hover {
    background: var(--ink-soft);
  }
  .list-link {
    color: var(--ink);
    border: 1px solid rgba(16, 42, 67, 0.2);
  }
  .list-link:hover {
    background: var(--white);
    border-color: rgba(16, 42, 67, 0.36);
  }
  .map-wrap {
    flex: 1;
    min-height: 0;
    overflow: hidden;
    border-radius: var(--r-2xl);
    isolation: isolate;
    background: var(--mist);
  }
  @media (max-width: 1080px) {
    .map-page {
      padding-top: var(--nav-h-mob);
    }
  }
  @media (max-width: 768px) {
    .map-head {
      padding: 8px calc(var(--pad-x-mob) - var(--slab-x) + 4px) 0;
    }
    .map-wrap {
      border-radius: var(--r-xl);
    }
  }
  @media (max-width: 520px) {
    h1 {
      flex-basis: 100%;
    }
    .area-btn,
    .list-link {
      flex: 1 1 0;
      justify-content: center;
      padding: 0 12px;
      font-size: 14px;
      white-space: nowrap;
    }
  }
</style>
