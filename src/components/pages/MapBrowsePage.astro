---
/**
 * Map browse. A full-viewport clustered map of every active listing, with a
 * "search this area" action that hands the current bounds to the listings
 * page as a `?bbox=` parameter.
 *
 * (The comment that stood here claimed bbox filtering was only approximate,
 * matching on settlement text. That is no longer true and had not been since
 * Stage 6: `search_properties()` takes a real `p_bbox` and compares lat/lng
 * directly — see supabase/migrations/0004_search.sql. Plain range comparisons
 * are exact and need no PostGIS, because Hungary is small and never crosses
 * the antimeridian.)
 *
 * A secondary view by decision, not by accident: the list is the primary way
 * to browse, and the map is reachable from it rather than from the main
 * navigation. Until 1.1 nothing linked here at all.
 */
import Base from '~/layouts/Base.astro';
import Eyebrow from '~/components/Eyebrow.astro';
import Map from '~/components/Map.astro';
import { UI, path, localizer, type Locale } from '~/i18n/ui';
import { alternatesFor, crumbs } from '~/lib/page';
import { breadcrumbSchema } from '~/lib/seo';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = UI[locale];

const x = localizer(locale);
const title = x({ hu: 'Ingatlanok térképen', nl: 'Woningen op de kaart', en: 'Properties on the map', de: 'Immobilien auf der Karte', fr: 'Les biens sur la carte', es: 'Los inmuebles en el mapa', pl: 'Nieruchomości na mapie', ro: 'Proprietățile pe hartă', sk: 'Nehnuteľnosti na mape', it: 'Immobili sulla mappa', pt: 'Imóveis no mapa', el: 'Ακίνητα στον χάρτη', cs: 'Nemovitosti na mapě', sl: 'Nepremičnine na zemljevidu', sv: 'Fastigheter på kartan', da: 'Ejendomme på kortet', no: 'Eiendommer på kartet', fi: 'Kohteet kartalla', et: 'Kinnisvara kaardil', lv: 'Īpašumi kartē', lt: 'Turtas žemėlapyje', sr: 'Properties on the map', uk: 'Properties on the map', tr: 'Properties on the map', he: 'Properties on the map', ar: 'Properties on the map', ru: 'Properties on the map', zh: 'Properties on the map' });
const description = x({
  hu: 'Böngéssze a FINDDOME magyarországi ingatlanait térképen, régió szerint csoportosítva.',
  nl: 'Blader door het Hongaarse vastgoed van FINDDOME op de kaart, gegroepeerd per regio.',
  en: 'Browse FINDDOME’s Hungarian properties on a map, grouped by region.',
  de: 'Stöbern Sie auf der Karte durch die ungarischen Immobilien von FINDDOME, nach Region gruppiert.',
  fr: 'Parcourez sur la carte les biens hongrois de FINDDOME, regroupés par région.',
  es: 'Explore en el mapa los inmuebles húngaros de FINDDOME, agrupados por región.',
  pl: 'Przeglądaj na mapie węgierskie nieruchomości FINDDOME pogrupowane według regionów.',
  ro: 'Explorați pe hartă proprietățile FINDDOME din Ungaria, grupate pe regiuni.',
  sk: 'Prezrite si na mape maďarské nehnuteľnosti FINDDOME zoskupené podľa regiónov.',
  it: 'Sfogli gli immobili ungheresi di FINDDOME su una mappa, raggruppati per regione.',
  pt: 'Explore os imóveis húngaros da FINDDOME num mapa, agrupados por região.',
  el: 'Περιηγηθείτε στα ουγγρικά ακίνητα της FINDDOME σε χάρτη, ομαδοποιημένα ανά περιφέρεια.',
  cs: 'Prohlédněte si maďarské nemovitosti FINDDOME na mapě, seskupené podle regionů.',
  sl: 'Prebrskajte madžarske nepremičnine FINDDOME na zemljevidu, razvrščene po regijah.',
  sv: 'Bläddra bland FINDDOME:s ungerska fastigheter på en karta, grupperade per region.',
  da: 'Se FINDDOME’s ungarske ejendomme på et kort, grupperet efter region.',
  no: 'Se FINDDOMEs ungarske eiendommer på et kart, gruppert etter region.',
  fi: 'Selaa FINDDOMEn unkarilaisia kohteita kartalla alueittain ryhmiteltyinä.',
  et: 'Sirvige FINDDOME’i Ungari kinnisvara kaardil, piirkondade kaupa rühmitatuna.',
  lv: 'Pārlūkojiet FINDDOME īpašumus Ungārijā kartē, sagrupētus pa reģioniem.',
  lt: 'Peržiūrėkite FINDDOME nekilnojamąjį turtą Vengrijoje žemėlapyje, sugrupuotą pagal regionus.',
  sr: 'Browse FINDDOME’s Hungarian properties on a map, grouped by region.',
  uk: 'Browse FINDDOME’s Hungarian properties on a map, grouped by region.',
  tr: 'Browse FINDDOME’s Hungarian properties on a map, grouped by region.',
  he: 'Browse FINDDOME’s Hungarian properties on a map, grouped by region.',
  ar: 'Browse FINDDOME’s Hungarian properties on a map, grouped by region.',
  ru: 'Browse FINDDOME’s Hungarian properties on a map, grouped by region.',
  zh: 'Browse FINDDOME’s Hungarian properties on a map, grouped by region.',
});

const trail = crumbs(locale, [
  { name: ui.nav.properties, url: path(locale, 'properties') },
  { name: title, url: path(locale, 'map') },
]);

/**
 * Filters arrive from the listings page and go back with the visitor.
 * Switching view is meant to be a change of presentation, not a reset — the
 * map hands `bbox` forward to the list, and this hands everything else back.
 */
const carried = new URLSearchParams(Astro.url.searchParams);
carried.delete('page');
const carriedQuery = carried.toString();
const listHref = carriedQuery
  ? `${path(locale, 'properties')}?${carriedQuery}`
  : path(locale, 'properties');
---

<Base
  locale={locale}
  title={title}
  description={description}
  alternates={alternatesFor('map')}
  schema={[breadcrumbSchema(trail)]}
  flush
>
  <div class="map-page">
    <div class="map-head">
      <Eyebrow space="8px">{ui.nav.properties}</Eyebrow>
      <h1>{title}</h1>
      <a href={listHref} class="list-link">{ui.filters.viewList}</a>
      <button type="button" id="search-this-area" class="area-btn">
        {x({ hu: 'Keresés ezen a területen', nl: 'Zoek in dit gebied', en: 'Search this area', de: 'In diesem Bereich suchen', fr: 'Rechercher dans cette zone', es: 'Buscar en esta zona', pl: 'Szukaj w tym obszarze', ro: 'Căutați în această zonă', sk: 'Hľadať v tejto oblasti', it: 'Cerca in quest’area', pt: 'Pesquisar nesta zona', el: 'Αναζήτηση σε αυτή την περιοχή', cs: 'Hledat v této oblasti', sl: 'Išči na tem območju', sv: 'Sök i det här området', da: 'Søg i dette område', no: 'Søk i dette området', fi: 'Hae tältä alueelta', et: 'Otsi sellelt alalt', lv: 'Meklēt šajā apgabalā', lt: 'Ieškoti šioje vietovėje', sr: 'Search this area', uk: 'Search this area', tr: 'Search this area', he: 'Search this area', ar: 'Search this area', ru: 'Search this area', zh: 'Search this area' })}
      </button>
    </div>
    <div class="map-wrap">
      <Map mode="browse" locale={locale} id="browse-map" />
    </div>
  </div>
</Base>

<style>
  /* 2.0: the map is a rounded stage under a slim header of pill controls. */
  .map-page {
    display: flex;
    flex-direction: column;
    gap: 12px;
    /* The page is `flush` (no automatic top offset) and the nav floats over
       it, so the space under the nav is reserved here — otherwise the title
       and the two pills sat underneath the navigation. */
    height: 100svh;
    padding: var(--nav-h) var(--slab-x) var(--slab-x);
  }
  .map-head {
    display: flex;
    align-items: center;
    gap: 10px 12px;
    padding: 12px calc(var(--pad-x) - var(--slab-x)) 4px;
    flex-wrap: wrap;
  }
  .map-head :global(.eyebrow) {
    display: none;
  }
  h1 {
    font-family: var(--serif);
    font-weight: var(--fw-medium);
    font-size: clamp(22px, 2vw, 28px);
    letter-spacing: -0.015em;
    color: var(--ink);
    flex: 1;
    min-width: 200px;
  }
  .area-btn,
  .list-link {
    display: inline-flex;
    align-items: center;
    height: 44px;
    padding: 0 20px;
    border-radius: var(--r-pill);
    font-size: 15px;
    font-weight: var(--fw-medium);
    transition:
      background-color 0.35s var(--ease-out),
      border-color 0.35s var(--ease-out),
      color 0.35s var(--ease-out);
  }
  .area-btn {
    background: var(--ink);
    color: var(--cream);
  }
  .area-btn:hover {
    background: var(--ink-soft);
  }
  .list-link {
    color: var(--ink);
    border: 1px solid rgba(16, 42, 67, 0.2);
  }
  .list-link:hover {
    background: var(--white);
    border-color: rgba(16, 42, 67, 0.36);
  }
  .map-wrap {
    flex: 1;
    min-height: 0;
    overflow: hidden;
    border-radius: var(--r-2xl);
    isolation: isolate;
    background: var(--mist);
  }
  @media (max-width: 1080px) {
    .map-page {
      padding-top: var(--nav-h-mob);
    }
  }
  @media (max-width: 768px) {
    .map-head {
      padding: 8px calc(var(--pad-x-mob) - var(--slab-x) + 4px) 0;
    }
    .map-wrap {
      border-radius: var(--r-xl);
    }
  }
  @media (max-width: 520px) {
    h1 {
      flex-basis: 100%;
    }
    .area-btn,
    .list-link {
      flex: 1 1 0;
      justify-content: center;
      padding: 0 12px;
      font-size: 14px;
      white-space: nowrap;
    }
  }
</style>
