---
/**
 * Home.
 *
 * 2.0 composition, top to bottom — a stack of rounded surfaces on the cream
 * page, each set in from the viewport edge by the same margin:
 *
 *   hero        The split, as before: copy on the cream page in its own
 *               column, the photograph beside it — now a rounded stage that
 *               moves through the featured listings, the listing's card and
 *               a progress line for each.
 *   search      The working tool, straight after the promise, as one
 *               floating panel.
 *   featured    An editorial grid whose big photograph always ends level
 *               with the two beside it.
 *   statement   One dark slab: FODEL's signature line in its five languages
 *               running across the top, the verbatim line about Dutch buyers
 *               lit word by word, and the four figures the model rests on.
 *   audiences   The dual-audience split — still the strategic heart of the
 *               page — as two photographic cards that open towards the one
 *               being pointed at.
 *   how         The three-step model as cards that stack as they are read.
 *   referral, cta
 */
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import Eyebrow from '~/components/Eyebrow.astro';
import SectionHead from '~/components/SectionHead.astro';
import Button from '~/components/Button.astro';
import PropertyCard from '~/components/PropertyCard.astro';
import HomeSearch from '~/components/HomeSearch.astro';
import NewsletterForm from '~/components/NewsletterForm.astro';
import ParallaxCta from '~/components/ParallaxCta.astro';
import StatsBand from '~/components/StatsBand.astro';
import ArrowChip from '~/components/ArrowChip.astro';
import FormShell from '~/components/forms/FormShell.astro';
import Field from '~/components/forms/Field.astro';
import { UI, BRAND, path, localizer, type Locale } from '~/i18n/ui';
import { copy } from '~/data/copy';
import { homeAlternates } from '~/lib/page';
import { activeProperties, homepageFeatured, regionsOf, text, url } from '~/lib/properties';
import { getTaxonomy, listingCategories, getCompany } from '~/lib/runtime-config';
import PostCard from '~/components/PostCard.astro';
import { latestArticles } from '~/lib/blog';
import { websiteSchema } from '~/lib/seo';
import { valuationPackages, priceLabel } from '~/lib/valuation/packages';
import { eur } from '~/lib/format';
import { splitOpeningQuote } from '~/lib/typography';
import sellersImage from '~/assets/properties/vineyard.png';
import buyersImage from '~/assets/properties/vevoknek.jpg';
import heroImage from '~/assets/properties/hero.png';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const x = localizer(locale);
/** Hungarian is the one language whose second call to action is "sell" rather than "search". */
const hu = locale === 'hu';
const ui = UI[locale];
const c = copy(locale).home;
const steps = copy(locale).steps;
const stats = copy(locale).stats;

const all = await activeProperties();
const featured = await homepageFeatured(3);
const taxonomy = await getTaxonomy();
const company = await getCompany();
// Brief 2 (§1/A): the three newest articles in this language — never another
// language's, never a case study, and no section at all when there are none.
const latest = await latestArticles(locale, 3);
const latestTitle = x('Legfrissebb cikkeink', 'Onze nieuwste artikelen', 'Our latest articles', 'Unsere neuesten Artikel', 'Nos derniers articles', 'Nuestros últimos artículos', 'Nasze najnowsze artykuły', 'Cele mai recente articole', 'Naše najnovšie články', 'I nostri ultimi articoli', 'Os nossos artigos mais recentes', 'Τα πιο πρόσφατα άρθρα μας', 'Naše nejnovější články', 'Naši najnovejši članki', 'Våra senaste artiklar', 'Vores seneste artikler', 'Våre nyeste artikler', 'Uusimmat artikkelimme', 'Meie uusimad artiklid', 'Mūsu jaunākie raksti', 'Mūsų naujausi straipsniai');
// The valuation entry point appears only while an admin has confirmed the
// service is staffed (Beállítások → Szolgáltatások), and says "free" only once
// that is confirmed too.
const valuation = company.services.valuationEntry
  ? {
      href: path(locale, 'valuation'),
      label: company.services.valuationFreeConfirmed
        ? x('Ingyenes értékbecslés', 'Gratis waardebepaling', 'Free valuation', 'Kostenlose Bewertung', 'Estimation gratuite', 'Valoración gratuita', 'Bezpłatna wycena', 'Evaluare gratuită', 'Bezplatný odhad ceny', 'Valutazione gratuita', 'Avaliação gratuita', 'Δωρεάν εκτίμηση', 'Odhad ceny zdarma', 'Brezplačna ocena vrednosti', 'Kostnadsfri värdering', 'Gratis vurdering', 'Gratis verdivurdering', 'Maksuton arvio', 'Tasuta hindamine', 'Bezmaksas novērtējums', 'Nemokamas vertinimas')
        : x('Mennyit ér az ingatlanom?', 'Wat is mijn woning waard?', 'What is my property worth?', 'Was ist meine Immobilie wert?', 'Que vaut mon bien\u202f?', '¿Cuánto vale mi inmueble?', 'Ile jest warta moja nieruchomość?', 'Cât valorează proprietatea mea?', 'Koľko má moja nehnuteľnosť hodnotu?', 'Quanto vale il mio immobile?', 'Quanto vale o meu imóvel?', 'Πόσο αξίζει το ακίνητό μου;', 'Kolik má moje nemovitost hodnotu?', 'Koliko je vredna moja nepremičnina?', 'Vad är min fastighet värd?', 'Hvad er min ejendom værd?', 'Hva er eiendommen min verdt?', 'Paljonko kiinteistöni on arvoltaan?', 'Kui palju on minu kinnisvara väärt?', 'Cik vērts ir mans īpašums?', 'Kiek vertas mano turtas?'),
    }
  : null;
// The three packages, named and priced in Beállítások → Szolgáltatások. The free
// estimate's price is spoken only once the free launch is confirmed.
const valuationTiers = valuationPackages(company.services)
  .filter((pkg) => pkg.enabled)
  .map((pkg) => ({
    kind: pkg.kind,
    name: pkg.names[locale],
    price: pkg.kind === 'indicative' && !company.services.valuationFreeConfirmed ? '' : priceLabel(pkg, locale),
  }));
const referral = c.referral;

const HERO_WIDTHS = [700, 1000, 1400, 1800];
const HERO_SIZES = '(max-width: 900px) 100vw, 54vw';
/** The stage moves through the featured listings; the first is the LCP. */
const slides = featured.slice(0, 4);
const alternates = homeAlternates();
const schema = [websiteSchema(locale, path(locale, 'properties'))];

/** The headline is sized from its longest unbreakable run. Lines may wrap at
 *  spaces and after a hyphen ("Nyugat-" / "Európában", as the prototype set
 *  it), so that — not the longest line — is what has to fit the column. */
const longestRun = Math.max(
  ...c.hero.title.flatMap((line: string) => line.split(/[\s-]+/)).map((run: string) => run.length)
);
/** …and from its longest authored line, which may wrap once but no more. */
const longestLine = Math.max(...c.hero.title.map((line: string) => line.length));

/** FODEL's signature line in each of the five languages it advertises in —
 *  verbatim from BRAND, which holds their own published wording. */
const signatures = (['hu', 'nl', 'de', 'en', 'fr'] as const).map((code) => ({
  code,
  text: BRAND[code].signature,
}));

const audienceImage = (to: string) => (to === 'sellers' ? sellersImage : buyersImage);
const quote = splitOpeningQuote(c.quote);
---


<Base
  locale={locale}
  title={c.meta.title}
  description={c.meta.description}
  alternates={alternates}
  schema={schema}
  whatsapp={{}}
>
  {/* ── HERO ── */}
  <section class="hero">
    <div class="hero-copy">
      <p class="hero-eyebrow">
        <span class="hero-eyebrow-rule" aria-hidden="true"></span>
        <span>{c.hero.eyebrow}</span>
      </p>

      <div class="hero-main">
        <h1 class="hero-title" style={`--run:${longestRun};--line:${longestLine}`}>
          {
            c.hero.title.map((line: string, i: number) => (
              <span class="line" style={`--i:${i}`}>
                <span class:list={{ quiet: i === c.hero.emphasis }}>{line}</span>
              </span>
            ))
          }
        </h1>

        <div class="hero-intro">
          <p class="hero-body">{c.hero.body}</p>
          <div class="hero-actions">
            <Button variant="dark" href={path(locale, 'properties')}>{c.hero.primary}</Button>
            <Button variant="text" href={path(locale, hu ? 'sellers' : 'searchRequest')}>{c.hero.secondary}</Button>
          </div>
        </div>
      </div>
    </div>

        <div class="hero-stage" data-hero>
          {slides.length === 0 && (
            <div class="hero-slide" data-active data-hero-fallback>
              <Image
                src={heroImage}
                alt={x('Tóparti otthon naplementében', 'Een huis aan het water bij zonsondergang', 'A lakeside home at sunset', 'Ein Haus am See bei Sonnenuntergang', 'Une maison au bord du lac au coucher du soleil', 'Una casa junto al lago al atardecer', 'Dom nad jeziorem o zachodzie słońca', 'O casă pe malul lacului la apus', 'Dom pri jazere pri západe slnka', 'Una casa sul lago al tramonto', 'Uma casa à beira do lago ao pôr do sol', 'Ένα σπίτι δίπλα στη λίμνη στο ηλιοβασίλεμα', 'Dům u jezera při západu slunce', 'Hiša ob jezeru ob sončnem zahodu', 'Ett hus vid sjön i solnedgången', 'Et hus ved søen i solnedgang', 'Et hus ved vannet i solnedgang', 'Järvenrantatalo auringonlaskussa', 'Järveäärne maja päikeseloojangul', 'Māja pie ezera saulrietā', 'Namas prie ežero saulei leidžiantis')}
                widths={HERO_WIDTHS}
                sizes={HERO_SIZES}
                loading="eager"
                fetchpriority="high"
                class="hero-img"
              />
            </div>
          )}
          {slides.map((p, i) => (
            <div class="hero-slide" id={`hero-photo-${i}`} data-vt data-active={i === 0 ? '' : undefined}>
              {/* astro:assets' <Image> has separate local/remote overloads; a src that can be either doesn't match either cleanly — the `as any` is a type-checker limitation, not a runtime one. */}
              <Image
                src={p.data.media.hero as any}
                alt={i === 0 ? text(p.data.media.heroAlt, locale) : ''}
                widths={HERO_WIDTHS}
                sizes={HERO_SIZES}
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : 'low'}
                inferSize={typeof p.data.media.hero === 'string'}
                class="hero-img"
              />
            </div>
          ))}
          {slides.length > 0 && <div class="hero-scrim" aria-hidden="true" />}

          {slides.length > 0 && (
          <div class="hero-panel">
          {slides.length > 1 && (
            <div class="hero-dots" role="group" aria-label={c.featured.title}>
              {slides.map((p, i) => (
                <button
                  type="button"
                  class="hero-dot"
                  data-go={i}
                  aria-label={text(p.data.title, locale)}
                  aria-current={i === 0 ? 'true' : 'false'}
                  data-active={i === 0 ? '' : undefined}
                >
                  <span class="hero-dot-track"><span class="hero-dot-fill" /></span>
                </button>
              ))}
            </div>
          )}
          <div class="hero-cards">
            {slides.map((p, i) => (
              <a
                class="hero-card"
                href={url(p, locale)}
                data-bg="dark"
                data-vt-for={`hero-photo-${i}`}
                data-active={i === 0 ? '' : undefined}
                inert={i !== 0}
              >
                <span class="hero-card-text">
                  <span class="hero-card-top">
                    <span class="hero-card-label">{c.hero.featuredLabel}</span>
                    <span class="hero-card-ref num">{ui.property.reference} {p.data.ref}</span>
                  </span>
                  <span class="hero-card-title">{text(p.data.title, locale)}</span>
                  <span class="hero-card-meta">
                    <span>{p.data.location.settlement}</span>
                    <span class="hero-card-dot" aria-hidden="true" />
                    <span class="num">{eur(p.data.price.eur, locale)}</span>
                  </span>
                </span>
                <ArrowChip size={48} />
                <span class="sr-only">, {ui.cta.viewProperty}</span>
              </a>
            ))}
          </div>
          </div>
          )}
        </div>
  </section>

  {/* ── SEARCH ── */}
  <section class="search-band reveal">
    <HomeSearch locale={locale} regions={regionsOf(all)} categories={listingCategories(taxonomy)}>
      <p class="search-count">
        <span class="search-count-n num" data-count={String(all.length)}>{all.length}</span>
        <span class="search-count-text">{x('aktív hirdetés, közvetlenül a tulajdonostól', 'actieve advertenties, direct van de eigenaar', 'active listings, direct from the owner', 'aktive Inserate, direkt vom Eigentümer', 'annonces actives, en direct du propriétaire', 'anuncios activos, directamente del propietario', 'aktywnych ogłoszeń bezpośrednio od właścicieli', 'anunțuri active, direct de la proprietar', 'aktívnych inzerátov priamo od majiteľov', 'annunci attivi, direttamente dal proprietario', 'anúncios ativos, diretamente do proprietário', 'ενεργές αγγελίες, απευθείας από τον ιδιοκτήτη', 'aktivních inzerátů přímo od vlastníků', 'aktivnih oglasov neposredno od lastnikov', 'aktiva annonser, direkt från ägaren', 'aktive annoncer direkte fra ejeren', 'aktive annonser, direkte fra eieren', 'aktiivista ilmoitusta suoraan omistajalta', 'aktiivset kuulutust otse omanikult', 'aktīvi sludinājumi tieši no īpašnieka', 'aktyvūs skelbimai tiesiogiai iš savininko')}</span>
      </p>
    </HomeSearch>
  </section>

  {/* ── VALUATION ── only while an admin has the service switched on */}
  {valuation && (
    <section class="valuation-slab slab reveal" aria-labelledby="valuation-slab-title">
      <div class="vs-copy">
        <SectionHead eyebrow={x('Értékmeghatározás', 'Waardebepaling', 'Valuation', 'Bewertung', 'Estimation', 'Valoración', 'Wycena', 'Evaluare', 'Odhad ceny', 'Valutazione', 'Avaliação', 'Εκτίμηση', 'Odhad ceny', 'Ocena vrednosti', 'Värdering', 'Vurdering', 'Verdivurdering', 'Arvio', 'Hindamine', 'Novērtējums', 'Vertinimas')} title={x('Mennyit ér\naz ingatlana?', 'Wat is uw woning\nwaard?', 'What is your\nproperty worth?', 'Was ist Ihre\nImmobilie wert?', 'Que vaut\nvotre bien\u202f?', '¿Cuánto vale\nsu inmueble?', 'Ile jest warta\nPaństwa nieruchomość?', 'Cât valorează\nproprietatea dumneavoastră?', 'Akú hodnotu má\nvaša nehnuteľnosť?', 'Quanto vale il suo\nimmobile?', 'Quanto vale o seu\nimóvel?', 'Πόσο αξίζει\nτο ακίνητό σας;', 'Kolik má vaše\nnemovitost hodnotu?', 'Koliko je vredna\nvaša nepremičnina?', 'Vad är din\nfastighet värd?', 'Hvad er din\nejendom værd?', 'Hva er eiendommen\ndin verdt?', 'Paljonko kiinteistösi\non arvoltaan?', 'Kui palju on teie\nkinnisvara väärt?', 'Cik vērts ir\njūsu īpašums?', 'Kiek vertas\njūsų turtas?')} size="large" />
        <p class="vs-body">
          {x(
            'Adja meg, amit tud az ingatlanról: fotókat, alaprajzot, dokumentumokat is csatolhat. Munkatársunk ellenőrzi az eredményt, és e-mailben küldi. Tájékoztató becslés, nem hivatalos szakvélemény.',
            'Vul in wat u van de woning weet; foto’s, plattegronden en documenten kunt u bijvoegen. Onze medewerker controleert het resultaat en stuurt het per e-mail. Indicatief, geen officieel taxatierapport.',
            'Tell us what you know about the property; you can attach photos, floor plans and documents. One of our team checks the result and sends it by email. Indicative only, not an official valuation report.',
            'Geben Sie an, was Sie über die Immobilie wissen; Fotos, Grundrisse und Unterlagen können Sie beifügen. Ein Mitarbeiter prüft das Ergebnis und schickt es per E-Mail. Unverbindliche Einschätzung, kein amtliches Gutachten.',
            'Indiquez ce que vous savez du bien\u202f; vous pouvez joindre des photos, des plans et des documents. Un collaborateur vérifie le résultat et vous l’envoie par e-mail. Estimation indicative, et non une expertise officielle.',
            'Indíquenos lo que sabe del inmueble; puede adjuntar fotos, planos y documentos. Un miembro de nuestro equipo revisa el resultado y se lo envía por correo electrónico. Valoración orientativa, no una tasación oficial.',
            'Prosimy podać, co Państwo wiedzą o nieruchomości; można dołączyć zdjęcia, rzuty i dokumenty. Nasz pracownik sprawdzi wynik i prześle go e-mailem. Wycena ma charakter orientacyjny i nie jest operatem szacunkowym.',
            'Spuneți-ne ce știți despre proprietate; puteți atașa fotografii, planuri și documente. Un coleg verifică rezultatul și vi-l trimite prin e-mail. Evaluare orientativă, nu o evaluare oficială.',
            'Napíšte nám, čo o nehnuteľnosti viete; môžete priložiť fotografie, pôdorysy a dokumenty. Náš kolega výsledok skontroluje a pošle vám ho e-mailom. Ide o orientačný odhad, nie o znalecký posudok.',
            'Ci dica ciò che sa dell’immobile; può allegare foto, planimetrie e documenti. Un membro del nostro team controlla il risultato e lo invia per e-mail. Ha valore puramente indicativo e non è una perizia ufficiale.',
            'Diga-nos o que sabe sobre o imóvel; pode anexar fotografias, plantas e documentos. Um membro da nossa equipa verifica o resultado e envia-o por e-mail. É apenas indicativo, não é um relatório de avaliação oficial.',
            'Πείτε μας ό,τι γνωρίζετε για το ακίνητο· μπορείτε να επισυνάψετε φωτογραφίες, κατόψεις και έγγραφα. Ένα μέλος της ομάδας μας ελέγχει το αποτέλεσμα και σας το στέλνει με email. Είναι μόνο ενδεικτικό και όχι επίσημη έκθεση εκτίμησης.',
            'Řekněte nám, co o nemovitosti víte; můžete přiložit fotografie, půdorysy a dokumenty. Někdo z našeho týmu výsledek zkontroluje a pošle vám ho e-mailem. Jde pouze o orientační odhad, nikoli o úřední znalecký posudek.',
            'Povejte nam, kar veste o nepremičnini; priložite lahko fotografije, tlorise in dokumente. Član naše ekipe preveri rezultat in vam ga pošlje po e-pošti. Ocena je le okvirna in ni uradno cenilno poročilo.',
            'Berätta vad du vet om fastigheten; du kan bifoga foton, planritningar och dokument. Någon i vårt team kontrollerar resultatet och skickar det via mejl. Endast vägledande, inte en officiell värderingsrapport.',
            'Fortæl os, hvad du ved om ejendommen; du kan vedhæfte fotos, plantegninger og dokumenter. En fra vores team kontrollerer resultatet og sender det på e-mail. Kun vejledende – ikke en officiel vurderingsrapport.',
            'Fortell oss det du vet om eiendommen; du kan legge ved bilder, plantegninger og dokumenter. En i teamet vårt kontrollerer resultatet og sender det på e-post. Kun veiledende, ikke en offisiell takstrapport.',
            'Kerro meille, mitä tiedät kiinteistöstä; voit liittää mukaan valokuvia, pohjapiirroksia ja asiakirjoja. Tiimimme jäsen tarkistaa tuloksen ja lähettää sen sähköpostitse. Arvio on suuntaa antava eikä virallinen arviolausunto.',
            'Rääkige meile, mida te kinnisvara kohta teate; võite lisada fotosid, korruseplaane ja dokumente. Meie meeskonna liige kontrollib tulemuse ja saadab selle e-postiga. Hinnang on üksnes soovituslik, mitte ametlik hindamisaruanne.',
            'Pastāstiet mums, ko zināt par īpašumu; varat pievienot fotoattēlus, plānus un dokumentus. Kāds no mūsu komandas pārbauda rezultātu un nosūta to e-pastā. Tas ir tikai orientējošs, nevis oficiāls vērtēšanas ziņojums.',
            'Papasakokite, ką žinote apie turtą; galite pridėti nuotraukų, planų ir dokumentų. Mūsų komandos narys patikrina rezultatą ir atsiunčia jį el. paštu. Vertinimas yra tik orientacinis, tai nėra oficiali vertinimo ataskaita.'
          )}
        </p>
        <Button variant="dark" href={valuation.href} arrow>{valuation.label}</Button>
      </div>
      <ul class="vs-tiers" aria-label={x('Értékmeghatározási csomagok', 'Waardebepalingspakketten', 'Valuation packages', 'Bewertungspakete', 'Forfaits d’estimation', 'Paquetes de valoración', 'Pakiety wyceny', 'Pachete de evaluare', 'Balíky odhadu ceny', 'Pacchetti di valutazione', 'Pacotes de avaliação', 'Πακέτα εκτίμησης', 'Balíčky odhadu ceny', 'Paketi ocene vrednosti', 'Värderingspaket', 'Vurderingspakker', 'Verdivurderingspakker', 'Arviopaketit', 'Hindamispaketid', 'Novērtējuma paketes', 'Vertinimo paketai')}>
        {valuationTiers.map((tier) => (
          <li>
            <span class="vs-name">{tier.name}</span>
            {tier.price && <span class="vs-price">{tier.price}</span>}
          </li>
        ))}
      </ul>
    </section>
  )}

  {/* ── FEATURED ── */}
  <section class="featured">
    <SectionHead eyebrow={c.featured.eyebrow} title={c.featured.title} size="large" class="section-head reveal">
      <Button variant="outline" href={path(locale, 'properties')} class="head-link" arrow>
        {ui.cta.allProperties}
      </Button>
    </SectionHead>

    <div class="bento">
      {
        featured.map((p, i) => (
          <PropertyCard
            property={p}
            locale={locale}
            class={`bento-item bento-${i}`}
            ratio={i === 0 ? '4 / 5' : '3 / 2'}
            sizes={i === 0 ? '(max-width: 900px) 100vw, 58vw' : '(max-width: 900px) 100vw, 40vw'}
          />
        ))
      }
    </div>

    <Button variant="outline" href={path(locale, 'properties')} block arrow class="cards-more">
      {ui.cta.allProperties}
    </Button>
  </section>

  {/* ── STATEMENT: five languages, the line, the figures ── */}
  <section class="statement slab" data-bg="dark">
    <div class="marquee" aria-hidden="true">
      <div class="marquee-track">
        {
          [0, 1].map(() => (
            <div class="marquee-group">
              {signatures.map((s) => (
                <span class="mq-item">
                  <span class="mq-lang">{s.code}</span>
                  <span class="mq-text">{s.text}</span>
                  <span class="mq-sep" />
                </span>
              ))}
            </div>
          ))
        }
      </div>
    </div>

    <div class="statement-body">
      <div class="statement-inner">
        <p class="statement-source reveal">
          <span class="statement-rule draw" aria-hidden="true"></span>
          {c.quoteSource}
        </p>
        <blockquote class="statement-quote" data-words>
          {quote.mark && <span class="hang-quote">{quote.mark}</span>}{quote.rest}
        </blockquote>
      </div>

      <StatsBand stats={stats} class="statement-stats" />
    </div>
  </section>

  {/* ── DUAL AUDIENCE ── */}
  <section class="audiences" data-bg="dark">
    {
      c.audiences.map((col: any, i: number) => (
        <a class="aud" href={path(locale, col.to)}>
          <div class="aud-media" data-parallax="0.06">
            <Image
              src={audienceImage(col.to)}
              alt=""
              widths={[600, 900, 1300]}
              sizes="(max-width: 900px) 100vw, 60vw"
