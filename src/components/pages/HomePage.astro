<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ── Hero stage ──
     Moves through the featured listings. The progress line under each dot
     IS the timer: the next listing comes up when its animation ends, so
     pausing the animation pauses the stage and the two can never disagree.
     It holds still while the listing's own card is pointed at or focused
     (nobody should click one house and land on another), while it is off
     screen, and while the tab is hidden. With reduced motion it does not
     advance on its own; the dots still work. */
  const stage = document.querySelector<HTMLElement>('[data-hero]');
  if (stage) {
    const slides = Array.from(stage.querySelectorAll<HTMLElement>('.hero-slide'));
    const cards = Array.from(stage.querySelectorAll<HTMLElement>('.hero-card'));
    const dots = Array.from(stage.querySelectorAll<HTMLButtonElement>('.hero-dot'));
    const count = slides.length;
    let index = 0;

    const holds = new Set<string>();
    const hold = (why: string, on: boolean) => {
      if (on) holds.add(why);
      else holds.delete(why);
      stage.toggleAttribute('data-paused', holds.size > 0);
    };

    const show = (next: number) => {
      index = (next + count) % count;
      slides.forEach((s, k) => s.toggleAttribute('data-active', k === index));
      cards.forEach((c, k) => {
        const on = k === index;
        c.toggleAttribute('data-active', on);
        c.inert = !on;
      });
      dots.forEach((d, k) => {
        d.removeAttribute('data-active');
        d.setAttribute('aria-current', String(k === index));
      });
      // Re-arm the active progress line from zero.
      const dot = dots[index];
      if (dot) {
        void dot.offsetWidth;
        dot.setAttribute('data-active', '');
      }
    };

    if (count > 1) {
      if (!reduced) stage.setAttribute('data-auto', '');
      dots.forEach((d) => {
        d.addEventListener('click', () => show(Number(d.dataset.go)));
        d.querySelector('.hero-dot-fill')?.addEventListener('animationend', () => {
          if (d.hasAttribute('data-active')) show(index + 1);
        });
      });
      cards.forEach((c) => {
        c.addEventListener('pointerenter', () => hold('pointer', true));
        c.addEventListener('pointerleave', () => hold('pointer', false));
        c.addEventListener('focusin', () => hold('focus', true));
        c.addEventListener('focusout', () => hold('focus', false));
      });
      document.addEventListener('visibilitychange', () => hold('hidden', document.hidden));
      // Watched through the hero section, not the stage: the stage opens
      // with a clip-path wipe, and Chrome reports a fully clipped element as
      // never intersecting — the stage would count as off screen for good.
      if ('IntersectionObserver' in window) {
        const hero = stage.closest('section') ?? stage;
        new IntersectionObserver(([entry]) => hold('offscreen', !entry.isIntersecting), { threshold: 0.2 }).observe(hero);
      }
    }
  }

  /* ── How it works: the cards stack as they are read. Each card eases back
     and dims a little as the next one slides up over it. Wide screens only;
     on phones they are an ordinary list. */
  const how = document.getElementById('how');
  const stacking = window.matchMedia('(min-width: 1001px)');
  if (how && !reduced) {
    const steps = Array.from(how.querySelectorAll<HTMLElement>('.how-step'));
    let ticking = false;
    const update = () => {
      ticking = false;
      if (!stacking.matches) {
        steps.forEach((s) => s.style.removeProperty('--p'));
        return;
      }
      const vh = window.innerHeight;
      steps.forEach((step, i) => {
        const next = steps[i + 1];
        if (!next) return;
        const stickAt = parseFloat(getComputedStyle(next).top) || 0;
        const distance = next.getBoundingClientRect().top - stickAt;
        const p = Math.min(1, Math.max(0, 1 - distance / (vh * 0.7)));
        step.style.setProperty('--p', p.toFixed(3));
      });
    };
    const request = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };
    window.addEventListener('scroll', request, { passive: true });
    window.addEventListener('resize', request, { passive: true });
    update();
  }


  /* ── Top 10 rail: arrow buttons, a progress line, and drag-to-scroll
     for a mouse (touch and trackpads already scroll it natively). */
  const rail = document.getElementById('top-rail');
  const bar = document.getElementById('rail-progress');
  if (rail) {
    const step = () => (rail.querySelector<HTMLElement>('.rail-item')?.offsetWidth ?? 320) + 24;
    // On right-to-left pages "next" is to the left and scrollLeft runs from 0 down to -max.
    const sign = () => (getComputedStyle(rail).direction === 'rtl' ? -1 : 1);
    document.querySelector('[data-rail="prev"]')?.addEventListener('click', () =>
      rail.scrollBy({ left: -step() * sign(), behavior: reduced ? 'auto' : 'smooth' })
    );
    document.querySelector('[data-rail="next"]')?.addEventListener('click', () =>
      rail.scrollBy({ left: step() * sign(), behavior: reduced ? 'auto' : 'smooth' })
    );

    // The arrows say when there is nothing further that way, and the
    // controls step aside altogether when every pick already fits.
    const section = rail.closest<HTMLElement>('.top-picks');
    const prevBtn = document.querySelector<HTMLElement>('[data-rail="prev"]');
    const nextBtn = document.querySelector<HTMLElement>('[data-rail="next"]');
    const progress = () => {
      const max = rail.scrollWidth - rail.clientWidth;
      const visible = rail.clientWidth / rail.scrollWidth;
      const at = Math.abs(rail.scrollLeft);
      const p = max > 0 ? at / max : 1;
      bar?.style.setProperty('--w', String(visible));
      bar?.style.setProperty('--p', String(p));
      prevBtn?.setAttribute('aria-disabled', String(at <= 1));
      nextBtn?.setAttribute('aria-disabled', String(at >= max - 1));
    };
    // Measured on the rail's natural layout (static mode stretches the cards
    // to fill the row, which would always "fit"); no paint happens between
    // removing and restoring the attribute.
    const measure = () => {
      section?.removeAttribute('data-static');
      const fits = rail.scrollWidth - rail.clientWidth <= 1;
      section?.toggleAttribute('data-static', fits);
      progress();
    };
    rail.addEventListener('scroll', progress, { passive: true });
    window.addEventListener('resize', measure, { passive: true });
    measure();

    let down = false;
    let moved = false;
    let startX = 0;
    let startLeft = 0;
    rail.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      down = true;
      moved = false;
      startX = e.clientX;
      startLeft = rail.scrollLeft;
    });
    window.addEventListener('pointermove', (e) => {
      if (!down) return;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 6) {
        moved = true;
        rail.setAttribute('data-dragging', '');
      }
      if (moved) rail.scrollLeft = startLeft - dx;
    });
    window.addEventListener('pointerup', () => {
      down = false;
      rail.removeAttribute('data-dragging');
    });
    // A drag must not also open the card it ended on.
    rail.addEventListener(
      'click',
      (e) => {
        if (moved) {
          e.preventDefault();
          e.stopPropagation();
          moved = false;
        }
      },
      true
    );
    rail.addEventListener('dragstart', (e) => e.preventDefault());
  }
</script>

<style>
  /* ══ HERO ═════════════════════════════════════════════════════════════ */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 45fr) minmax(0, 55fr);
    min-height: max(660px, calc(100svh - var(--nav-h)));
    padding-block: 0 var(--slab-x); padding-inline: 0 var(--slab-x);
  }

  .hero-copy {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding-block: 24px 32px; padding-inline: var(--pad-x) clamp(40px, 4.4vw, 80px);
  }
  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 0.75rem;
    font-weight: var(--fw-medium);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink);
    animation: fx-fade-up 1.2s var(--ease-out) 0.5s both;
  }
  .hero-eyebrow-rule {
    width: 32px;
    height: 1px;
    background: var(--ink);
    transform-origin: left;
    animation: fx-draw 1.2s var(--ease-out) 0.6s both;
  }
  :global([dir='rtl']) .hero-eyebrow-rule {
    transform-origin: right;
  }
  /* The headline and what follows it sit together, centred in the height
     the eyebrow leaves — no dead band between promise and proof. */
  .hero-main {
    margin-block: auto;
    padding-top: 40px;
  }

  /* The headline: as large as its longest word allows in the copy column,
     no larger than lets its longest line wrap at most once, and no larger
     than lets the whole block fit the viewport's height. */
  .hero-title {
    font-family: var(--serif);
    font-weight: var(--fw-hero);
    font-size: max(
      44px,
      min(
        calc(100cqw / (var(--run) * 0.58)),
        calc(100cqw / (var(--line) * 0.54) * 1.8),
        108px,
        calc((100svh - var(--nav-h) - 420px) / 3.4)
      )
    );
    line-height: 0.98;
    letter-spacing: -0.025em;
    color: var(--ink);
  }
  .hero-title .line > span {
    animation: fx-rise 1.4s var(--ease-out) both;
    animation-delay: calc(0.45s + var(--i, 0) * 0.11s);
  }
  .hero-title .quiet {
    color: var(--ink-quiet);
  }

  .hero-intro {
    margin-top: 40px;
    animation: fx-fade-up 1.3s var(--ease-out) 0.95s both;
  }
  .hero-body {
    max-width: 44ch;
    font-size: var(--fs-body-lg);
    line-height: 1.6;
    color: var(--taupe);
  }
  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px 28px;
    margin-top: 36px;
  }

  /* ── Stage ── */
  .hero-stage {
    position: relative;
    min-height: 0;
    overflow: hidden;
    border-radius: var(--r-2xl);
    background: var(--ink);
    isolation: isolate;
    animation: fx-wipe 1.6s var(--ease-in-out) both;
  }
  .hero-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(1.08);
    /* Leaving: fade only; the zoom resets once it is out of sight. */
    transition:
      opacity 1.4s var(--ease-in-out),
      transform 0s linear 1.4s;
  }
  .hero-slide[data-active] {
    z-index: 1;
    opacity: 1;
    transform: none;
    transition:
      opacity 1.4s var(--ease-in-out),
      transform 9s var(--ease-out);
  }
  .hero-slide:first-child :global(.hero-img) {
    animation: fx-settle 2.8s var(--ease-out) both;
  }
  .hero-stage :global(.hero-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background:
      linear-gradient(0deg, rgba(10, 29, 48, 0.62) 0%, rgba(10, 29, 48, 0.18) 34%, rgba(10, 29, 48, 0) 52%),
      linear-gradient(180deg, rgba(10, 29, 48, 0.32) 0%, rgba(10, 29, 48, 0) 20%);
  }

  /* ── The listing on stage: progress, then its card ── */
  .hero-panel {
    position: absolute;
    z-index: 3;
    inset-inline-start: 22px;
    bottom: 22px;
    width: min(440px, calc(100% - 44px));
    animation: fx-fade-up 1.3s var(--ease-out) 1.25s both;
  }
  .hero-dots {
    display: flex;
    gap: 4px;
    margin-block: 0 6px; margin-inline: 10px 0;
  }
  .hero-dot {
    display: grid;
    place-items: center;
    width: 44px;
    height: 32px;
    border-radius: var(--r-pill);
  }
  .hero-dot-track {
    position: relative;
    display: block;
    width: 36px;
    height: 3px;
    overflow: hidden;
    border-radius: 3px;
    background: rgba(244, 244, 242, 0.32);
  }
  .hero-dot-fill {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--cream);
    transform: scaleX(0);
    transform-origin: left;
  }
  :global([dir='rtl']) .hero-dot-fill {
    transform-origin: right;
  }
  .hero-dot[aria-current='true'] .hero-dot-fill {
    transform: none;
  }
  .hero-dot:hover .hero-dot-track {
    background: rgba(244, 244, 242, 0.55);
  }
  /* Autoplay: the fill runs as the timer. */
  .hero-stage[data-auto] .hero-dot[aria-current='true'] .hero-dot-fill {
    transform: scaleX(0);
  }
  .hero-stage[data-auto] .hero-dot[data-active] .hero-dot-fill {
    animation: hero-progress 7s linear forwards;
  }
  .hero-stage[data-paused] .hero-dot-fill {
    animation-play-state: paused !important;
  }
  @keyframes hero-progress {
    to {
      transform: none;
    }
  }

  .hero-cards {
    display: grid;
  }
  .hero-card {
    grid-area: 1 / 1;
    align-self: end;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 20px;
    padding-block: 20px; padding-inline: 24px 16px;
    border-radius: var(--r-xl);
    background: rgba(10, 29, 48, 0.44);
    border: 1px solid rgba(244, 244, 242, 0.16);
    box-shadow: inset 0 1px 0 rgba(244, 244, 242, 0.1);
    backdrop-filter: blur(22px) saturate(1.3);
    -webkit-backdrop-filter: blur(22px) saturate(1.3);
    color: var(--cream);
    --chip-bg: var(--cream);
    --chip-fg: var(--ink);
    opacity: 0;
    visibility: hidden;
    transform: translateY(14px);
    transition:
      opacity 0.5s var(--ease-out),
      transform 0.7s var(--ease-out),
      visibility 0s linear 0.7s,
      background-color 0.5s var(--ease-out);
  }
  .hero-card[data-active] {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 0.8s var(--ease-out) 0.35s,
      transform 1s var(--ease-out) 0.35s,
      visibility 0s,
      background-color 0.5s var(--ease-out);
  }
  .hero-card:hover,
  .hero-card:focus-visible {
    background: rgba(10, 29, 48, 0.62);
  }
  .hero-card:hover :global(.arrow-chip) {
    transform: scale(1.06);
  }
  .hero-card-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .hero-card-top {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 4px;
  }
  .hero-card-label {
    font-size: 11.5px;
    font-weight: var(--fw-medium);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-dark-strong);
  }
  .hero-card-ref {
    font-size: 12px;
    color: var(--on-dark-muted);
  }
  .hero-card-title {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    font-family: var(--serif);
    font-weight: var(--fw-medium);
    font-size: 22px;
    letter-spacing: -0.01em;
    line-height: 1.2;
    text-wrap: balance;
  }
  .hero-card-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: var(--fs-small);
    color: var(--on-dark-body);
  }
  .hero-card-dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: currentColor;
  }

  /* ══ SEARCH ═══════════════════════════════════════════════════════════ */
  .search-band {
    padding: calc(var(--section-y) * 0.85) var(--pad-x) calc(var(--section-y) * 0.5);
  }
  .search-count {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-bottom: 4px;
  }
  .search-count-n {
    font-family: var(--serif);
    font-weight: var(--fw-light);
    font-size: 64px;
    line-height: 0.8;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .search-count-text {
    max-width: 22ch;
    font-size: var(--fs-small);
    line-height: 1.45;
    color: var(--taupe);
  }

  /* ══ VALUATION ════════════════════════════════════════════════════════ */
  .valuation-slab {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(32px, 5vw, 80px);
    margin-top: calc(var(--section-y) * 0.3);
    padding: clamp(40px, 5vw, 72px) calc(var(--pad-x) - var(--slab-x));
    background: var(--linen);
  }
  .vs-copy {
    display: grid;
    gap: 24px;
    justify-items: start;
  }
  .vs-body {
    max-width: 52ch;
    font-size: var(--fs-body);
    line-height: 1.7;
    color: var(--ink-quiet);
  }
  .vs-tiers {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .vs-tiers li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 20px 26px;
    border-radius: var(--r-lg);
    background: var(--white);
    box-shadow: var(--shadow-md);
  }
  .vs-name {
    font-family: var(--serif);
    font-size: 19px;
    color: var(--ink);
  }
  .vs-price {
    flex: none;
    font-size: var(--fs-small);
    color: var(--ink-quiet);
  }
  @media (max-width: 900px) {
    .valuation-slab {
      grid-template-columns: 1fr;
      padding: 40px calc(var(--pad-x-mob) - var(--slab-x) + 4px);
    }
  }

  .news-slab {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(28px, 5vw, 80px);
    margin-top: calc(var(--section-y) * 0.3);
    padding: clamp(40px, 5vw, 64px) calc(var(--pad-x) - var(--slab-x));
    background: var(--linen);
  }
  .ns-copy {
    display: grid;
    gap: 20px;
  }
  .ns-copy :global(.section-head-standard) {
    margin-bottom: 0;
  }
  .ns-body {
    max-width: 48ch;
    font-size: var(--fs-body);
    line-height: 1.7;
    color: var(--ink-quiet);
  }
  @media (max-width: 900px) {
    .news-slab {
      grid-template-columns: 1fr;
      padding: 40px calc(var(--pad-x-mob) - var(--slab-x) + 4px);
    }
  }

  /* ══ FEATURED ═════════════════════════════════════════════════════════ */
  .featured {
    padding: calc(var(--section-y) * 0.5) var(--pad-x) var(--section-y);
  }
  .featured :global(.section-head) {
    margin-bottom: 56px;
  }
  /* A catalogue with nothing in it yet: one quiet, centred message. */
  .featured-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 56px 24px 24px;
    text-align: center;
  }
  .featured-empty-dot {
    width: 10px;
    height: 10px;
    margin-bottom: 28px;
    border-radius: 50%;
    background: var(--ink);
  }
  .featured-empty-title {
    max-width: 26ch;
    margin-bottom: 12px;
    font-family: var(--serif);
    font-weight: var(--fw-medium);
    font-size: clamp(24px, 2.2vw, 32px);
    letter-spacing: var(--ls-heading);
    line-height: 1.2;
    color: var(--ink);
  }
  .featured-empty-hint {
    max-width: 44ch;
    margin-bottom: 36px;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--taupe);
  }
  /* Big photograph on the left, two beside it. The big one has no ratio of
     its own: it takes whatever height the two on the right add up to, so
     the grid always closes in one straight line. */
  .bento {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 56px 28px;
  }
  .bento > :global(.bento-0) {
    grid-column: 1;
    grid-row: 1 / span 2;
  }
  .bento > :global(.bento-1) {
    grid-column: 2;
    grid-row: 1;
  }
  .bento > :global(.bento-2) {
    grid-column: 2;
    grid-row: 2;
  }
  .bento > :global(.bento-0 .card-img-wrap) {
    flex: 1;
    aspect-ratio: auto;
    min-height: 420px;
  }
  .bento > :global(.bento-0 .card-img-inner) {
    position: absolute;
    inset: 0;
  }
  .bento > :global(.bento-0 .card-body) {
    flex: none;
  }
  .bento > :global(.bento-0 .card-title) {
    font-size: clamp(24px, 2vw, 30px);
  }
  .cards-more {
    display: none;
    margin-top: 32px;
  }

  /* ══ STATEMENT ════════════════════════════════════════════════════════ */
  .statement {
    background:
      radial-gradient(120% 70% at 85% 0%, var(--ink-soft) 0%, transparent 55%),
      linear-gradient(180deg, var(--ink) 0%, var(--ink-deep) 100%);
  }
  .marquee {
    overflow: hidden;
    padding: 30px 0;
    border-bottom: 1px solid var(--on-dark-rule);
  }
  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 70s linear infinite;
  }
  .marquee-group {
    display: flex;
    flex-shrink: 0;
  }
  .mq-item {
    display: inline-flex;
    align-items: center;
    gap: 18px;
    padding-inline-end: 36px;
    white-space: nowrap;
  }
  .mq-lang {
    display: inline-grid;
    place-items: center;
    height: 26px;
    padding: 0 10px;
    border-radius: var(--r-pill);
    border: 1px solid rgba(244, 244, 242, 0.3);
    font-size: 11px;
    font-weight: var(--fw-medium);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-dark-body);
  }
  .mq-text {
    font-family: var(--serif);
    font-weight: var(--fw-hero);
    font-size: clamp(30px, 3.8vw, 58px);
    letter-spacing: var(--ls-display);
    line-height: 1.1;
    color: var(--cream);
  }
  .mq-sep {
    width: 8px;
    height: 8px;
    margin-inline-start: 18px;
    border-radius: 50%;
    background: rgba(244, 244, 242, 0.4);
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  .statement-body {
    padding: clamp(96px, 9vw, 144px) calc(var(--pad-x) - var(--slab-x)) clamp(72px, 7vw, 112px);
  }
  .statement-inner {
    max-width: 1180px;
  }
  .statement-source {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 40px;
    font-size: 0.75rem;
    font-weight: var(--fw-medium);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--on-dark-body);
  }
  .statement-rule {
    width: 32px;
    height: 1px;
    background: var(--cream);
  }
  .statement-quote {
    font-family: var(--serif);
    font-weight: var(--fw-light);
    font-size: clamp(32px, 4.3vw, 68px);
    line-height: 1.12;
    letter-spacing: var(--ls-display);
    color: var(--cream);
    text-wrap: balance;
  }

  /* ══ AUDIENCES ════════════════════════════════════════════════════════ */
  .audiences {
    display: flex;
    gap: 12px;
    min-height: min(90svh, 880px);
    padding: 12px var(--slab-x) 0;
  }
  .aud {
    position: relative;
    flex: 1 1 0;
    display: flex;
    overflow: hidden;
    border-radius: var(--r-2xl);
    isolation: isolate;
    background: var(--ink);
    color: var(--cream);
    --chip-bg: var(--cream);
    --chip-fg: var(--ink);
    transition: flex-grow 1.1s var(--ease-in-out);
  }
  .audiences:hover .aud:hover,
  .audiences:focus-within .aud:focus-visible {
    flex-grow: 1.4;
  }
  .aud-media {
    position: absolute;
    inset: -8% 0;
    transform: translate3d(0, var(--py, 0px), 0);
  }
  .aud-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.04);
    transition: transform 1.8s var(--ease-out);
  }
  .aud:hover .aud-media :global(img) {
    transform: scale(1.1);
  }
  .aud-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(10, 29, 48, 0.92) 0%, rgba(10, 29, 48, 0.55) 40%, rgba(10, 29, 48, 0.12) 100%);
    transition: opacity 1s var(--ease-out);
  }
  .aud:hover .aud-shade {
    opacity: 0.85;
  }
  .aud-copy {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
    padding: 28px clamp(28px, 3.4vw, 56px) clamp(32px, 3.6vw, 56px);
  }
  .aud-idx {
    align-self: flex-start;
    padding: 8px 14px;
    border-radius: var(--r-pill);
    background: rgba(10, 29, 48, 0.3);
    border: 1px solid rgba(244, 244, 242, 0.16);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    font-size: 12.5px;
    letter-spacing: 0.08em;
    color: var(--on-dark-strong);
  }
  .aud-text {
    max-width: 540px;
  }
  .aud-text :global(.aud-eyebrow) {
    color: var(--on-dark-strong);
  }
  .aud h2 {
    font-family: var(--serif);
    font-weight: var(--fw-hero);
    font-size: clamp(32px, 3.4vw, 56px);
    line-height: 1.04;
    letter-spacing: var(--ls-display);
    color: var(--cream);
    margin-bottom: 20px;
  }
  .aud-line {
    display: block;
  }
  .aud p {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--on-dark-body);
    max-width: 44ch;
    margin-bottom: 32px;
  }
  .aud-cta {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    padding-block: 6px; padding-inline: 24px 6px;
    border-radius: var(--r-pill);
    background: rgba(244, 244, 242, 0.1);
    border: 1px solid rgba(244, 244, 242, 0.22);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    font-size: 1rem;
    font-weight: var(--fw-medium);
    transition:
      background-color 0.5s var(--ease-out),
      color 0.5s var(--ease-out);
  }
  .aud:hover .aud-cta {
    background: var(--cream);
    color: var(--ink);
    --chip-bg: var(--ink);
    --chip-fg: var(--cream);
  }

  /* ══ HOW IT WORKS ═════════════════════════════════════════════════════ */
  .how {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(48px, 6vw, 96px);
    padding: var(--section-y) var(--pad-x);
  }
  .how-sticky {
    position: sticky;
    top: calc(var(--nav-h) + 56px);
  }
  .how-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 40px;
  }
  .how-steps {
    display: grid;
    gap: 28px;
    list-style: none;
  }
  /* Each card sticks a little lower than the last, so the stack shows its
     edges; --p (0 → 1, from the script) eases a card back as the next one
     covers it. */
  .how-step {
    position: sticky;
    top: calc(var(--nav-h) + 40px + var(--i, 0) * 24px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 64px;
    min-height: 440px;
    padding: 36px clamp(28px, 3.4vw, 52px) 44px;
    border-radius: var(--r-2xl);
    background: var(--tone-bg, var(--white));
    border: 1px solid rgba(16, 42, 67, 0.07);
    color: var(--ink);
    transform-origin: 50% 0;
    transform: scale(calc(1 - var(--p, 0) * 0.04));
    box-shadow: 0 -18px 40px -32px rgba(var(--shadow-ink), 0.4);
    will-change: transform;
  }
  .how-step::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--ink-deep);
    opacity: calc(var(--p, 0) * 0.1);
    pointer-events: none;
  }
  .how-step[data-tone='mist'] {
    --tone-bg: #e4e8eb;
  }
  .how-step[data-tone='dark'] {
    --tone-bg:
      radial-gradient(100% 90% at 100% 0%, var(--ink-soft) 0%, transparent 60%),
      var(--ink);
    border-color: var(--ink);
    color: var(--cream);
  }
  .how-step-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
  }
  .how-step-num {
    margin-inline-start: -0.05em;
    font-family: var(--serif);
    font-weight: var(--fw-light);
    font-size: clamp(72px, 6.4vw, 108px);
    line-height: 0.85;
    letter-spacing: -0.04em;
  }
  .how-step-icon {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: rgba(16, 42, 67, 0.07);
  }
  .how-step[data-tone='dark'] .how-step-icon {
    background: rgba(244, 244, 242, 0.1);
  }
  .how-step h3 {
    font-family: var(--serif);
    font-weight: var(--fw-medium);
    font-size: clamp(26px, 2.4vw, 38px);
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-bottom: 16px;
  }
  .how-step p {
    max-width: 48ch;
    font-size: var(--fs-body-lg);
    line-height: 1.65;
    color: var(--taupe);
  }
  .how-step[data-tone='dark'] p {
    color: var(--on-dark-body);
  }

  /* ══ TOP 10 RAIL ══════════════════════════════════════════════════════ */
  .top-picks {
    padding: var(--section-y) 0 calc(var(--section-y) * 0.8);
    background: var(--linen);
  }
  .rail-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    padding: 0 calc(var(--pad-x) - var(--slab-x));
    margin-bottom: 56px;
  }
  .rail-head :global(.section-head-standard) {
    margin-bottom: 0;
  }
  .rail-controls {
    display: flex;
    align-items: center;
    gap: 28px;
    padding-bottom: 6px;
  }
  .rail-arrows {
    display: flex;
    gap: 8px;
  }
  .rail-btn {
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: var(--white);
    border: 1px solid rgba(16, 42, 67, 0.1);
    color: var(--ink);
    transition:
      background-color 0.4s var(--ease-out),
      color 0.4s var(--ease-out),
      opacity 0.4s ease,
      transform 0.25s var(--ease-out);
  }
  .rail-btn:hover {
    background: var(--ink);
    color: var(--cream);
  }
  .rail-btn:active {
    transform: scale(0.94);
  }
  .rail-btn[aria-disabled='true'] {
    opacity: 0.35;
    pointer-events: none;
  }
  /* Every pick fits: no arrows, and the cards share the full measure. */
  .top-picks[data-static] .rail-arrows,
  .top-picks[data-static] .rail-progress {
    display: none;
  }
  .top-picks[data-static] .rail {
    grid-auto-columns: minmax(0, 1fr);
    cursor: auto;
  }
  .rail {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: clamp(280px, 26vw, 400px);
    gap: 24px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: calc(var(--pad-x) - var(--slab-x));
    padding: 0 calc(var(--pad-x) - var(--slab-x)) 8px;
    scrollbar-width: none;
    cursor: grab;
  }
  .rail::-webkit-scrollbar {
    display: none;
  }
  .rail[data-dragging] {
    cursor: grabbing;
    scroll-snap-type: none;
  }
  .rail[data-dragging] :global(a) {
    pointer-events: none;
  }
  .rail > :global(.rail-item) {
    scroll-snap-align: start;
  }
  .rail-progress {
    position: relative;
    height: 3px;
    margin: 48px calc(var(--pad-x) - var(--slab-x)) 0;
    overflow: hidden;
    border-radius: 3px;
    background: rgba(16, 42, 67, 0.1);
  }
  .rail-progress span {
    position: absolute;
    top: 0;
    left: 0; /* logical:keep: the whole track is mirrored on right-to-left pages instead */
    height: 100%;
    width: calc(var(--w, 0.3) * 100%);
    border-radius: 3px;
    background: var(--ink);
    transform: translateX(calc(var(--p, 0) * (1 / var(--w, 0.3) - 1) * 100%));
    transition: transform 0.2s linear;
  }


  /* ══ REFERRAL ═════════════════════════════════════════════════════════ */
  /* Latest articles — the same rounded cards as the blog index. */
  .latest {
    padding: var(--section-y) var(--pad-x) calc(var(--section-y) * 0.5);
  }
  .latest-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    margin-bottom: 48px;
  }
  .latest-head :global(.section-head-standard) {
    margin-bottom: 0;
  }
  .latest-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  @media (max-width: 1100px) {
    .latest-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 700px) {
    .latest {
      padding: var(--section-y-mob) var(--pad-x-mob) calc(var(--section-y-mob) * 0.5);
    }
    .latest-head {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
      margin-bottom: 28px;
    }
    .latest-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }

  .referral {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 540px);
    gap: clamp(56px, 7vw, 112px);
    align-items: start;
    padding: var(--section-y) var(--pad-x);
  }
  .referral-copy h2 {
    font-family: var(--serif);
    font-weight: var(--fw-hero);
    font-size: clamp(36px, 4.2vw, 64px);
    line-height: 1.04;
    letter-spacing: var(--ls-display);
    color: var(--ink);
    margin-bottom: 28px;
  }
  .referral-copy p {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--taupe);
    max-width: 54ch;
    margin-bottom: 44px;
  }
  .referral-steps {
    display: grid;
    gap: 8px;
    max-width: 560px;
    list-style: none;
  }
  .referral-steps li {
    display: grid;
    grid-template-columns: 40px 1fr;
    align-items: center;
    gap: 16px;
    padding-block: 14px; padding-inline: 14px 20px;
    border-radius: var(--r-lg);
    background: rgba(16, 42, 67, 0.04);
    font-size: var(--fs-body);
    line-height: 1.5;
    color: var(--ink);
  }
  .referral-steps .n {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--cream);
    font-size: 13px;
    font-weight: var(--fw-medium);
    letter-spacing: 0.02em;
  }
  .referral-form {
    padding: clamp(28px, 3vw, 44px);
    border-radius: var(--r-2xl);
    background: var(--white);
    border: 1px solid rgba(16, 42, 67, 0.06);
    box-shadow: var(--shadow-md);
  }
  .referral-form-title {
    margin-bottom: 28px;
    font-family: var(--serif);
    font-weight: var(--fw-medium);
    font-size: 26px;
    letter-spacing: -0.015em;
    line-height: 1.2;
    color: var(--ink);
  }

  /* ══ RESPONSIVE ═══════════════════════════════════════════════════════ */
  @media (max-width: 1200px) {
    .how {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    }
    .referral {
      grid-template-columns: minmax(0, 1fr) minmax(0, 460px);
    }
  }

  @media (max-width: 1000px) {
    .how {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .how-sticky {
      position: static;
    }
    .how-step {
      position: relative;
      top: auto;
      min-height: 0;
      gap: 40px;
      transform: none;
    }
    .how-step::after {
      display: none;
    }
    .how-steps {
      gap: 12px;
    }
  }

  @media (max-width: 900px) {
    .hero {
      display: flex;
      flex-direction: column;
      min-height: 0;
      padding: 0;
    }
    .hero-stage {
      order: -1;
      aspect-ratio: 4 / 5;
      max-height: 68svh;
      width: auto;
      margin: 0 var(--slab-x);
      border-radius: var(--r-xl);
    }
    .hero-copy {
      container-type: normal;
      padding: 36px var(--pad-x-mob) 8px;
    }
    .hero-main {
      padding-top: 28px;
    }
    .hero-title {
      font-size: clamp(
        40px,
        min(
          calc((100vw - 2 * var(--pad-x-mob)) / (var(--run) * 0.58)),
          calc((100vw - 2 * var(--pad-x-mob)) / (var(--line) * 0.54) * 1.8)
        ),
        88px
      );
    }
    .hero-intro {
      margin-top: 28px;
    }
    .hero-actions {
      margin-top: 28px;
    }
    .hero-panel {
      inset-inline-start: 12px;
      inset-inline-end: 12px;
      bottom: 12px;
      width: auto;
    }
    .hero-card {
      padding-block: 14px; padding-inline: 18px 12px;
      border-radius: var(--r-lg);
    }
    .hero-card-title {
      font-size: 19px;
    }
    .hero-card :global(.arrow-chip) {
      --chip: 40px !important;
    }

    .search-band {
      padding: 72px var(--pad-x-mob) 48px;
    }
    .search-count-n {
      font-size: 48px;
    }

    .featured {
      padding: 32px var(--pad-x-mob) var(--section-y-mob);
    }
    .featured :global(.section-head) {
      margin-bottom: 36px;
    }
    .featured :global(.head-link) {
      display: none;
    }
    .bento {
      grid-template-columns: 1fr;
      row-gap: 48px;
    }
    .bento > :global(.bento-item) {
      grid-column: 1 !important;
      grid-row: auto !important;
    }
    .bento > :global(.bento-0 .card-img-wrap) {
      flex: none;
      aspect-ratio: 4 / 3;
      min-height: 0;
    }
    .cards-more {
      display: flex;
    }

    .marquee {
      padding: 20px 0;
    }
    .statement-body {
      padding: 72px calc(var(--pad-x-mob) - var(--slab-x) + 4px) 56px;
    }

