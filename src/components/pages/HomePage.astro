  }
  .hero-card:hover,
  .hero-card:focus-visible {
    background: rgba(10, 29, 48, 0.62);
  }
  .hero-card:hover :global(.arrow-chip) {
    transform: scale(1.06);
  }
  .hero-card-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .hero-card-top {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 4px;
  }
  .hero-card-label {
    font-size: 11.5px;
    font-weight: var(--fw-medium);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-dark-strong);
  }
  .hero-card-ref {
    font-size: 12px;
    color: var(--on-dark-muted);
  }
  .hero-card-title {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    font-family: var(--serif);
    font-weight: var(--fw-medium);
    font-size: 22px;
    letter-spacing: -0.01em;
    line-height: 1.2;
    text-wrap: balance;
  }
  .hero-card-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: var(--fs-small);
    color: var(--on-dark-body);
  }
  .hero-card-dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: currentColor;
  }

  /* ══ SEARCH ═══════════════════════════════════════════════════════════ */
  .search-band {
    padding: calc(var(--section-y) * 0.85) var(--pad-x) calc(var(--section-y) * 0.5);
  }
  .search-count {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-bottom: 4px;
  }
  .search-count-n {
    font-family: var(--serif);
    font-weight: var(--fw-light);
    font-size: 64px;
    line-height: 0.8;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .search-count-text {
    max-width: 22ch;
    font-size: var(--fs-small);
    line-height: 1.45;
    color: var(--taupe);
  }

  /* ══ VALUATION ════════════════════════════════════════════════════════ */
  .valuation-slab {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(32px, 5vw, 80px);
    margin-top: calc(var(--section-y) * 0.3);
    padding: clamp(40px, 5vw, 72px) calc(var(--pad-x) - var(--slab-x));
    background: var(--linen);
  }
  .vs-copy {
    display: grid;
    gap: 24px;
    justify-items: start;
  }
  .vs-body {
    max-width: 52ch;
    font-size: var(--fs-body);
    line-height: 1.7;
    color: var(--ink-quiet);
  }
  .vs-tiers {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .vs-tiers li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 20px 26px;
    border-radius: var(--r-lg);
    background: var(--white);
    box-shadow: var(--shadow-md);
  }
  .vs-name {
    font-family: var(--serif);
    font-size: 19px;
    color: var(--ink);
  }
  .vs-price {
    flex: none;
    font-size: var(--fs-small);
    color: var(--ink-quiet);
  }
  @media (max-width: 900px) {
    .valuation-slab {
      grid-template-columns: 1fr;
      padding: 40px calc(var(--pad-x-mob) - var(--slab-x) + 4px);
    }
  }

  .news-slab {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(28px, 5vw, 80px);
    margin-top: calc(var(--section-y) * 0.3);
    padding: clamp(40px, 5vw, 64px) calc(var(--pad-x) - var(--slab-x));
    background: var(--linen);
  }
  .ns-copy {
    display: grid;
    gap: 20px;
  }
  .ns-copy :global(.section-head-standard) {
    margin-bottom: 0;
  }
  .ns-body {
    max-width: 48ch;
    font-size: var(--fs-body);
    line-height: 1.7;
    color: var(--ink-quiet);
  }
  @media (max-width: 900px) {
    .news-slab {
      grid-template-columns: 1fr;
      padding: 40px calc(var(--pad-x-mob) - var(--slab-x) + 4px);
    }
  }

  /* ══ FEATURED ═════════════════════════════════════════════════════════ */
  .featured {
    padding: calc(var(--section-y) * 0.5) var(--pad-x) var(--section-y);
  }
  .featured :global(.section-head) {
    margin-bottom: 56px;
  }
  /* Big photograph on the left, two beside it. The big one has no ratio of
     its own: it takes whatever height the two on the right add up to, so
     the grid always closes in one straight line. */
  .bento {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 56px 28px;
  }
  .bento > :global(.bento-0) {
    grid-column: 1;
    grid-row: 1 / span 2;
  }
  .bento > :global(.bento-1) {
    grid-column: 2;
    grid-row: 1;
  }
  .bento > :global(.bento-2) {
    grid-column: 2;
    grid-row: 2;
  }
  .bento > :global(.bento-0 .card-img-wrap) {
    flex: 1;
    aspect-ratio: auto;
    min-height: 420px;
  }
  .bento > :global(.bento-0 .card-img-inner) {
    position: absolute;
    inset: 0;
  }
  .bento > :global(.bento-0 .card-body) {
    flex: none;
  }
  .bento > :global(.bento-0 .card-title) {
    font-size: clamp(24px, 2vw, 30px);
  }
  .cards-more {
    display: none;
    margin-top: 32px;
  }

  /* ══ STATEMENT ════════════════════════════════════════════════════════ */
  .statement {
    background:
      radial-gradient(120% 70% at 85% 0%, var(--ink-soft) 0%, transparent 55%),
      linear-gradient(180deg, var(--ink) 0%, var(--ink-deep) 100%);
  }
  .marquee {
    overflow: hidden;
    padding: 30px 0;
    border-bottom: 1px solid var(--on-dark-rule);
  }
  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 70s linear infinite;
  }
  .marquee-group {
    display: flex;
    flex-shrink: 0;
  }
  .mq-item {
    display: inline-flex;
    align-items: center;
    gap: 18px;
    padding-right: 36px;
    white-space: nowrap;
  }
  .mq-lang {
    display: inline-grid;
    place-items: center;
    height: 26px;
    padding: 0 10px;
    border-radius: var(--r-pill);
    border: 1px solid rgba(244, 244, 242, 0.3);
    font-size: 11px;
    font-weight: var(--fw-medium);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-dark-body);
  }
  .mq-text {
    font-family: var(--serif);
    font-weight: var(--fw-hero);
    font-size: clamp(30px, 3.8vw, 58px);
    letter-spacing: var(--ls-display);
    line-height: 1.1;
    color: var(--cream);
  }
  .mq-sep {
    width: 8px;
    height: 8px;
    margin-left: 18px;
    border-radius: 50%;
    background: rgba(244, 244, 242, 0.4);
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  .statement-body {
    padding: clamp(96px, 9vw, 144px) calc(var(--pad-x) - var(--slab-x)) clamp(72px, 7vw, 112px);
  }
  .statement-inner {
    max-width: 1180px;
  }
  .statement-source {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 40px;
    font-size: 0.75rem;
    font-weight: var(--fw-medium);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--on-dark-body);
  }
  .statement-rule {
    width: 32px;
    height: 1px;
    background: var(--cream);
  }
  .statement-quote {
    font-family: var(--serif);
    font-weight: var(--fw-light);
    font-size: clamp(32px, 4.3vw, 68px);
    line-height: 1.12;
    letter-spacing: var(--ls-display);
    color: var(--cream);
    text-wrap: balance;
  }
  .statement :global(.statement-stats) {
    margin-top: clamp(80px, 8vw, 128px);
  }

  /* ══ AUDIENCES ════════════════════════════════════════════════════════ */
  .audiences {
    display: flex;
    gap: 12px;
    min-height: min(90svh, 880px);
    padding: 12px var(--slab-x) 0;
  }
  .aud {
    position: relative;
    flex: 1 1 0;
    display: flex;
    overflow: hidden;
    border-radius: var(--r-2xl);
    isolation: isolate;
    background: var(--ink);
    color: var(--cream);
    --chip-bg: var(--cream);
    --chip-fg: var(--ink);
    transition: flex-grow 1.1s var(--ease-in-out);
  }
  .audiences:hover .aud:hover,
  .audiences:focus-within .aud:focus-visible {
    flex-grow: 1.4;
  }
  .aud-media {
    position: absolute;
    inset: -8% 0;
    transform: translate3d(0, var(--py, 0px), 0);
  }
  .aud-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.04);
    transition: transform 1.8s var(--ease-out);
  }
  .aud:hover .aud-media :global(img) {
    transform: scale(1.1);
  }
  .aud-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(10, 29, 48, 0.92) 0%, rgba(10, 29, 48, 0.55) 40%, rgba(10, 29, 48, 0.12) 100%);
    transition: opacity 1s var(--ease-out);
  }
  .aud:hover .aud-shade {
    opacity: 0.85;
  }
  .aud-copy {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
    padding: 28px clamp(28px, 3.4vw, 56px) clamp(32px, 3.6vw, 56px);
  }
  .aud-idx {
    align-self: flex-start;
    padding: 8px 14px;
    border-radius: var(--r-pill);
    background: rgba(10, 29, 48, 0.3);
    border: 1px solid rgba(244, 244, 242, 0.16);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    font-size: 12.5px;
    letter-spacing: 0.08em;
    color: var(--on-dark-strong);
  }
  .aud-text {
    max-width: 540px;
  }
  .aud-text :global(.aud-eyebrow) {
    color: var(--on-dark-strong);
  }
  .aud h2 {
    font-family: var(--serif);
    font-weight: var(--fw-hero);
    font-size: clamp(32px, 3.4vw, 56px);
    line-height: 1.04;
    letter-spacing: var(--ls-display);
    color: var(--cream);
    margin-bottom: 20px;
  }
  .aud-line {
    display: block;
  }
  .aud p {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--on-dark-body);
    max-width: 44ch;
    margin-bottom: 32px;
  }
  .aud-cta {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    padding: 6px 6px 6px 24px;
    border-radius: var(--r-pill);
    background: rgba(244, 244, 242, 0.1);
    border: 1px solid rgba(244, 244, 242, 0.22);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    font-size: 1rem;
    font-weight: var(--fw-medium);
    transition:
      background-color 0.5s var(--ease-out),
      color 0.5s var(--ease-out);
  }
  .aud:hover .aud-cta {
    background: var(--cream);
    color: var(--ink);
    --chip-bg: var(--ink);
    --chip-fg: var(--cream);
  }

  /* ══ HOW IT WORKS ═════════════════════════════════════════════════════ */
  .how {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(48px, 6vw, 96px);
    padding: var(--section-y) var(--pad-x);
  }
  .how-sticky {
    position: sticky;
    top: calc(var(--nav-h) + 56px);
  }
  .how-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 40px;
  }
  .how-steps {
    display: grid;
    gap: 28px;
    list-style: none;
  }
  /* Each card sticks a little lower than the last, so the stack shows its
     edges; --p (0 → 1, from the script) eases a card back as the next one
     covers it. */
  .how-step {
    position: sticky;
    top: calc(var(--nav-h) + 40px + var(--i, 0) * 24px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 64px;
    min-height: 440px;
    padding: 36px clamp(28px, 3.4vw, 52px) 44px;
    border-radius: var(--r-2xl);
    background: var(--tone-bg, var(--white));
    border: 1px solid rgba(16, 42, 67, 0.07);
    color: var(--ink);
    transform-origin: 50% 0;
    transform: scale(calc(1 - var(--p, 0) * 0.04));
    box-shadow: 0 -18px 40px -32px rgba(var(--shadow-ink), 0.4);
    will-change: transform;
  }
  .how-step::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--ink-deep);
    opacity: calc(var(--p, 0) * 0.1);
    pointer-events: none;
  }
  .how-step[data-tone='mist'] {
    --tone-bg: #e4e8eb;
  }
  .how-step[data-tone='dark'] {
    --tone-bg:
      radial-gradient(100% 90% at 100% 0%, var(--ink-soft) 0%, transparent 60%),
      var(--ink);
    border-color: var(--ink);
    color: var(--cream);
  }
  .how-step-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
  }
  .how-step-num {
    margin-left: -0.05em;
    font-family: var(--serif);
    font-weight: var(--fw-light);
    font-size: clamp(72px, 6.4vw, 108px);
    line-height: 0.85;
    letter-spacing: -0.04em;
  }
  .how-step-icon {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: rgba(16, 42, 67, 0.07);
  }
  .how-step[data-tone='dark'] .how-step-icon {
    background: rgba(244, 244, 242, 0.1);
  }
  .how-step h3 {
    font-family: var(--serif);
    font-weight: var(--fw-medium);
    font-size: clamp(26px, 2.4vw, 38px);
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-bottom: 16px;
  }
  .how-step p {
    max-width: 48ch;
    font-size: var(--fs-body-lg);
    line-height: 1.65;
    color: var(--taupe);
  }
  .how-step[data-tone='dark'] p {
    color: var(--on-dark-body);
  }

  /* ══ REFERRAL ═════════════════════════════════════════════════════════ */
  /* Latest articles — the same rounded cards as the blog index. */
  .latest {
    padding: var(--section-y) var(--pad-x) calc(var(--section-y) * 0.5);
  }
  .latest-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    margin-bottom: 48px;
  }
  .latest-head :global(.section-head-standard) {
    margin-bottom: 0;
  }
  .latest-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  @media (max-width: 1100px) {
    .latest-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 700px) {
    .latest {
      padding: var(--section-y-mob) var(--pad-x-mob) calc(var(--section-y-mob) * 0.5);
    }
    .latest-head {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
      margin-bottom: 28px;
    }
    .latest-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }

  .referral {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 540px);
    gap: clamp(56px, 7vw, 112px);
    align-items: start;
    padding: var(--section-y) var(--pad-x);
  }
  .referral-copy h2 {
    font-family: var(--serif);
    font-weight: var(--fw-hero);
    font-size: clamp(36px, 4.2vw, 64px);
    line-height: 1.04;
    letter-spacing: var(--ls-display);
    color: var(--ink);
    margin-bottom: 28px;
  }
  .referral-copy p {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--taupe);
    max-width: 54ch;
    margin-bottom: 44px;
  }
  .referral-steps {
    display: grid;
    gap: 8px;
    max-width: 560px;
    list-style: none;
  }
  .referral-steps li {
    display: grid;
    grid-template-columns: 40px 1fr;
    align-items: center;
    gap: 16px;
    padding: 14px 20px 14px 14px;
    border-radius: var(--r-lg);
    background: rgba(16, 42, 67, 0.04);
    font-size: var(--fs-body);
    line-height: 1.5;
    color: var(--ink);
  }
  .referral-steps .n {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--cream);
    font-size: 13px;
    font-weight: var(--fw-medium);
    letter-spacing: 0.02em;
  }
  .referral-form {
    padding: clamp(28px, 3vw, 44px);
    border-radius: var(--r-2xl);
    background: var(--white);
    border: 1px solid rgba(16, 42, 67, 0.06);
    box-shadow: var(--shadow-md);
  }
  .referral-form-title {
    margin-bottom: 28px;
    font-family: var(--serif);
    font-weight: var(--fw-medium);
    font-size: 26px;
    letter-spacing: -0.015em;
    line-height: 1.2;
    color: var(--ink);
  }

  /* ══ RESPONSIVE ═══════════════════════════════════════════════════════ */
  @media (max-width: 1200px) {
    .how {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    }
    .referral {
      grid-template-columns: minmax(0, 1fr) minmax(0, 460px);
    }
  }

  @media (max-width: 1000px) {
    .how {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .how-sticky {
      position: static;
    }
    .how-step {
      position: relative;
      top: auto;
      min-height: 0;
      gap: 40px;
      transform: none;
    }
    .how-step::after {
      display: none;
    }
    .how-steps {
      gap: 12px;
    }
  }

  @media (max-width: 900px) {
    .hero {
      display: flex;
      flex-direction: column;
      min-height: 0;
      padding: 0;
    }
    .hero-stage {
      order: -1;
      aspect-ratio: 4 / 5;
      max-height: 68svh;
      width: auto;
      margin: 0 var(--slab-x);
      border-radius: var(--r-xl);
    }
    .hero-copy {
      container-type: normal;
      padding: 36px var(--pad-x-mob) 8px;
    }
    .hero-main {
      padding-top: 28px;
    }
    .hero-title {
      font-size: clamp(
        40px,
        min(
          calc((100vw - 2 * var(--pad-x-mob)) / (var(--run) * 0.58)),
          calc((100vw - 2 * var(--pad-x-mob)) / (var(--line) * 0.54) * 1.8)
        ),
        88px
      );
    }
    .hero-intro {
      margin-top: 28px;
    }
    .hero-actions {
      margin-top: 28px;
    }
    .hero-panel {
      left: 12px;
      right: 12px;
      bottom: 12px;
      width: auto;
    }
    .hero-card {
      padding: 14px 12px 14px 18px;
      border-radius: var(--r-lg);
    }
    .hero-card-title {
      font-size: 19px;
    }
    .hero-card :global(.arrow-chip) {
      --chip: 40px !important;
    }

    .search-band {
      padding: 72px var(--pad-x-mob) 48px;
    }
    .search-count-n {
      font-size: 48px;
    }

    .featured {
      padding: 32px var(--pad-x-mob) var(--section-y-mob);
    }
    .featured :global(.section-head) {
      margin-bottom: 36px;
    }
    .featured :global(.head-link) {
      display: none;
    }
    .bento {
      grid-template-columns: 1fr;
      row-gap: 48px;
    }
    .bento > :global(.bento-item) {
      grid-column: 1 !important;
      grid-row: auto !important;
    }
    .bento > :global(.bento-0 .card-img-wrap) {
      flex: none;
      aspect-ratio: 4 / 3;
      min-height: 0;
    }
    .cards-more {
      display: flex;
    }

    .marquee {
      padding: 20px 0;
    }
    .statement-body {
      padding: 72px calc(var(--pad-x-mob) - var(--slab-x) + 4px) 56px;
    }

    .audiences {
      flex-direction: column;
      gap: 8px;
      min-height: 0;
      padding-top: 8px;
    }
    .aud {
      min-height: 76svh;
      border-radius: var(--r-xl);
    }
    .aud-copy {
      padding: 20px 20px 28px;
    }

    .how {
      padding: var(--section-y-mob) var(--pad-x-mob);
    }
    .how-step {
      padding: 28px 24px 32px;
