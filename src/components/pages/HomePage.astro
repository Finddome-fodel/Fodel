---
/**
 * Home.
 *
 * 2.0 composition, top to bottom — a stack of rounded surfaces on the cream
 * page, each set in from the viewport edge by the same margin:
 *
 *   hero        The split, as before: copy on the cream page in its own
 *               column, the photograph beside it — now a rounded stage that
 *               moves through the featured listings, the listing's card and
 *               a progress line for each.
 *   search      The working tool, straight after the promise, as one
 *               floating panel.
 *   featured    An editorial grid whose big photograph always ends level
 *               with the two beside it.
 *   statement   One dark slab: FODEL's signature line in its five languages
 *               running across the top, the verbatim line about Dutch buyers
 *               lit word by word, and the four figures the model rests on.
 *   audiences   The dual-audience split — still the strategic heart of the
 *               page — as two photographic cards that open towards the one
 *               being pointed at.
 *   how         The three-step model as cards that stack as they are read.
 *   referral, cta
 */
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import Eyebrow from '~/components/Eyebrow.astro';
import SectionHead from '~/components/SectionHead.astro';
import Button from '~/components/Button.astro';
import PropertyCard from '~/components/PropertyCard.astro';
import HomeSearch from '~/components/HomeSearch.astro';
import NewsletterForm from '~/components/NewsletterForm.astro';
import ParallaxCta from '~/components/ParallaxCta.astro';
import ArrowChip from '~/components/ArrowChip.astro';
import FormShell from '~/components/forms/FormShell.astro';
import Field from '~/components/forms/Field.astro';
import { UI, BRAND, path, localizer, type Locale } from '~/i18n/ui';
import { CHROME } from '~/i18n/chrome';
import { copy } from '~/data/copy';
import { fillShortHours } from '~/config/company';
import { homeAlternates } from '~/lib/page';
import { activeProperties, homepageFeatured, editorsPick, regionsOf, text, url } from '~/lib/properties';
import { getTaxonomy, listingCategories, getCompany } from '~/lib/runtime-config';
import PostCard from '~/components/PostCard.astro';
import YouTubeStrip from '~/components/YouTubeStrip.astro';
import { latestArticles } from '~/lib/blog';
import { websiteSchema } from '~/lib/seo';
import { valuationPackages, priceLabel } from '~/lib/valuation/packages';
import { eur } from '~/lib/format';
import { splitOpeningQuote } from '~/lib/typography';
import sellersImage from '~/assets/properties/vineyard.png';
import buyersImage from '~/assets/properties/vevoknek.jpg';
import heroImage from '~/assets/properties/hero.png';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const x = localizer(locale);
/** Hungarian is the one language whose second call to action is "sell" rather than "search". */
const hu = locale === 'hu';
const ui = UI[locale];
const c = copy(locale).home;
const steps = copy(locale).steps;

const all = await activeProperties(locale);
const featured = await homepageFeatured(3, locale);
const top = await editorsPick(10, locale);
const taxonomy = await getTaxonomy();
const company = await getCompany();
// Brief 2 (§1/A): the three newest articles in this language — never another
// language's, never a case study, and no section at all when there are none.
const latest = await latestArticles(locale, 3);
const latestTitle = x({ hu: 'Legfrissebb cikkeink', nl: 'Onze nieuwste artikelen', en: 'Our latest articles', de: 'Unsere neuesten Artikel', fr: 'Nos derniers articles', es: 'Nuestros últimos artículos', pl: 'Nasze najnowsze artykuły', ro: 'Cele mai recente articole', sk: 'Naše najnovšie články', it: 'I nostri ultimi articoli', pt: 'Os nossos artigos mais recentes', el: 'Τα πιο πρόσφατα άρθρα μας', cs: 'Naše nejnovější články', sl: 'Naši najnovejši članki', sv: 'Våra senaste artiklar', da: 'Vores seneste artikler', no: 'Våre nyeste artikler', fi: 'Uusimmat artikkelimme', et: 'Meie uusimad artiklid', lv: 'Mūsu jaunākie raksti', lt: 'Mūsų naujausi straipsniai', sr: 'Naši najnoviji članci', uk: 'Наші найновіші статті', tr: 'En yeni makalelerimiz', he: 'המאמרים האחרונים שלנו', ar: 'أحدث مقالاتنا', ru: 'Наши новые статьи', zh: '最新文章' });
// The valuation entry point appears only while an admin has confirmed the
// service is staffed (Beállítások → Szolgáltatások), and says "free" only once
// that is confirmed too.
const valuation = company.services.valuationEntry
  ? {
      href: path(locale, 'valuation'),
      label: company.services.valuationFreeConfirmed
        ? x({ hu: 'Ingyenes értékbecslés', nl: 'Gratis waardebepaling', en: 'Free valuation', de: 'Kostenlose Bewertung', fr: 'Estimation gratuite', es: 'Valoración gratuita', pl: 'Bezpłatna wycena', ro: 'Evaluare gratuită', sk: 'Bezplatný odhad ceny', it: 'Valutazione gratuita', pt: 'Avaliação gratuita', el: 'Δωρεάν εκτίμηση', cs: 'Odhad ceny zdarma', sl: 'Brezplačna ocena vrednosti', sv: 'Kostnadsfri värdering', da: 'Gratis vurdering', no: 'Gratis verdivurdering', fi: 'Maksuton arvio', et: 'Tasuta hindamine', lv: 'Bezmaksas novērtējums', lt: 'Nemokamas vertinimas', sr: 'Besplatna procena', uk: 'Безкоштовна оцінка', tr: 'Ücretsiz değerleme', he: 'הערכת שווי ללא תשלום', ar: 'تقييم مجاني', ru: 'Бесплатная оценка', zh: '免费估价' })
        : x({ hu: 'Mennyit ér az ingatlanom?', nl: 'Wat is mijn woning waard?', en: 'What is my property worth?', de: 'Was ist meine Immobilie wert?', fr: 'Que vaut mon bien\u202f?', es: '¿Cuánto vale mi inmueble?', pl: 'Ile jest warta moja nieruchomość?', ro: 'Cât valorează proprietatea mea?', sk: 'Koľko má moja nehnuteľnosť hodnotu?', it: 'Quanto vale il mio immobile?', pt: 'Quanto vale o meu imóvel?', el: 'Πόσο αξίζει το ακίνητό μου;', cs: 'Kolik má moje nemovitost hodnotu?', sl: 'Koliko je vredna moja nepremičnina?', sv: 'Vad är min fastighet värd?', da: 'Hvad er min ejendom værd?', no: 'Hva er eiendommen min verdt?', fi: 'Paljonko kiinteistöni on arvoltaan?', et: 'Kui palju on minu kinnisvara väärt?', lv: 'Cik vērts ir mans īpašums?', lt: 'Kiek vertas mano turtas?', sr: 'Koliko vredi moja nekretnina?', uk: 'Скільки коштує моя нерухомість?', tr: 'Mülküm ne kadar eder?', he: 'כמה שווה הנכס שלי?', ar: 'كم يساوي عقاري؟', ru: 'Сколько стоит моя недвижимость?', zh: '我的房产值多少钱？' }),
    }
  : null;
// The three valuation packages, named and priced in Beállítások → Szolgáltatások
// (listing packages live in the Csomagok menu). The free
// estimate's price is spoken only once the free launch is confirmed.
const valuationTiers = valuationPackages(company.services)
  .filter((pkg) => pkg.enabled)
  .map((pkg) => ({
    kind: pkg.kind,
    name: pkg.names[locale],
    price: pkg.kind === 'indicative' && !company.services.valuationFreeConfirmed ? '' : priceLabel(pkg, locale),
  }));
const referral = c.referral;

const HERO_WIDTHS = [700, 1000, 1400, 1800];
const HERO_SIZES = '(max-width: 900px) 100vw, 54vw';
/** The stage moves through the featured listings; the first is the LCP. */
const slides = featured.slice(0, 4);
const alternates = homeAlternates();
const schema = [websiteSchema(locale, path(locale, 'properties'))];

/** The headline is sized from its longest unbreakable run. Lines may wrap at
 *  spaces and after a hyphen ("Nyugat-" / "Európában", as the prototype set
 *  it), so that — not the longest line — is what has to fit the column. */
const longestRun = Math.max(
  ...c.hero.title.flatMap((line: string) => line.split(/[\s-]+/)).map((run: string) => run.length)
);
/** …and from its longest authored line, which may wrap once but no more. */
const longestLine = Math.max(...c.hero.title.map((line: string) => line.length));

/** FODEL's signature line in each of the five languages it advertises in —
 *  verbatim from BRAND, which holds their own published wording. */
const signatures = (['hu', 'nl', 'de', 'en', 'fr'] as const).map((code) => ({
  code,
  text: BRAND[code].signature,
}));

const audienceImage = (to: string) => (to === 'sellers' ? sellersImage : buyersImage);
const quote = splitOpeningQuote(c.quote);
---


<Base
  locale={locale}
  title={c.meta.title}
  description={c.meta.description}
  alternates={alternates}
  schema={schema}
  whatsapp={{}}
>
  {/* ── HERO ── */}
  <section class="hero">
    <div class="hero-copy">
      <p class="hero-eyebrow">
        <span class="hero-eyebrow-rule" aria-hidden="true"></span>
        <span>{c.hero.eyebrow}</span>
      </p>

      <div class="hero-main">
        <h1 class="hero-title" style={`--run:${longestRun};--line:${longestLine}`}>
          {
            c.hero.title.map((line: string, i: number) => (
              <span class="line" style={`--i:${i}`}>
                <span class:list={{ quiet: i === c.hero.emphasis }}>{line}</span>
              </span>
            ))
          }
        </h1>

        <div class="hero-intro">
          <p class="hero-body">{c.hero.body}</p>
          <div class="hero-actions">
            <Button variant="dark" href={path(locale, 'properties')}>{c.hero.primary}</Button>
            <Button variant="text" href={path(locale, hu ? 'sellers' : 'searchRequest')}>{c.hero.secondary}</Button>
          </div>
        </div>
      </div>
    </div>

        <div class="hero-stage" data-hero>
          {slides.length === 0 && (
            <div class="hero-slide" data-active data-hero-fallback>
              <Image
                src={heroImage}
                alt={x({ hu: 'Tóparti otthon naplementében', nl: 'Een huis aan het water bij zonsondergang', en: 'A lakeside home at sunset', de: 'Ein Haus am See bei Sonnenuntergang', fr: 'Une maison au bord du lac au coucher du soleil', es: 'Una casa junto al lago al atardecer', pl: 'Dom nad jeziorem o zachodzie słońca', ro: 'O casă pe malul lacului la apus', sk: 'Dom pri jazere pri západe slnka', it: 'Una casa sul lago al tramonto', pt: 'Uma casa à beira do lago ao pôr do sol', el: 'Ένα σπίτι δίπλα στη λίμνη στο ηλιοβασίλεμα', cs: 'Dům u jezera při západu slunce', sl: 'Hiša ob jezeru ob sončnem zahodu', sv: 'Ett hus vid sjön i solnedgången', da: 'Et hus ved søen i solnedgang', no: 'Et hus ved vannet i solnedgang', fi: 'Järvenrantatalo auringonlaskussa', et: 'Järveäärne maja päikeseloojangul', lv: 'Māja pie ezera saulrietā', lt: 'Namas prie ežero saulei leidžiantis', sr: 'Kuća uz jezero u sumrak', uk: 'Будинок біля озера на заході сонця', tr: 'Gün batımında göl kenarında bir ev', he: 'בית על שפת אגם בשקיעה', ar: 'منزل على ضفة بحيرة عند الغروب', ru: 'Дом у озера на закате', zh: '日落时分的湖畔住宅' })}
                widths={HERO_WIDTHS}
                sizes={HERO_SIZES}
                loading="eager"
                fetchpriority="high"
                class="hero-img"
              />
            </div>
          )}
          {slides.map((p, i) => (
            <div class="hero-slide" id={`hero-photo-${i}`} data-vt data-active={i === 0 ? '' : undefined}>
              {/* astro:assets' <Image> has separate local/remote overloads; a src that can be either doesn't match either cleanly — the `as any` is a type-checker limitation, not a runtime one. */}
              <Image
                src={p.data.media.hero as any}
                alt={i === 0 ? text(p.data.media.heroAlt, locale) : ''}
                widths={HERO_WIDTHS}
                sizes={HERO_SIZES}
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : 'low'}
                inferSize={typeof p.data.media.hero === 'string'}
                class="hero-img"
              />
            </div>
          ))}
          {slides.length > 0 && <div class="hero-scrim" aria-hidden="true" />}

          {slides.length > 0 && (
          <div class="hero-panel">
          {slides.length > 1 && (
            <div class="hero-dots" role="group" aria-label={c.featured.title}>
              {slides.map((p, i) => (
                <button
                  type="button"
                  class="hero-dot"
                  data-go={i}
                  aria-label={text(p.data.title, locale)}
                  aria-current={i === 0 ? 'true' : 'false'}
                  data-active={i === 0 ? '' : undefined}
                >
                  <span class="hero-dot-track"><span class="hero-dot-fill" /></span>
                </button>
              ))}
            </div>
          )}
          <div class="hero-cards">
            {slides.map((p, i) => (
              <a
                class="hero-card"
                href={url(p, locale)}
                data-bg="dark"
                data-vt-for={`hero-photo-${i}`}
                data-active={i === 0 ? '' : undefined}
                inert={i !== 0}
              >
                <span class="hero-card-text">
                  <span class="hero-card-top">
                    {(p.data.listing.homepageFeatured || p.data.listing.featured) ? <span class="hero-card-label">{c.hero.featuredLabel}</span> : <span class="hero-card-label" aria-hidden="true" />}
                    <span class="hero-card-ref num">{ui.property.reference} {p.data.ref}</span>
                  </span>
                  <span class="hero-card-title">{text(p.data.title, locale)}</span>
                  <span class="hero-card-meta">
                    <span>{p.data.location.settlement}</span>
                    <span class="hero-card-dot" aria-hidden="true" />
                    <span class="num">{eur(p.data.price.eur, locale)}</span>
                  </span>
                </span>
                <ArrowChip size={48} />
                <span class="sr-only">, {ui.cta.viewProperty}</span>
              </a>
            ))}
          </div>
          </div>
          )}
        </div>
  </section>

  {/* ── SEARCH ── */}
  <section class="search-band reveal">
    <HomeSearch locale={locale} regions={regionsOf(all)} categories={listingCategories(taxonomy)}>
      {all.length > 0 && <p class="search-count">
        <span class="search-count-n num" data-count={String(all.length)}>{all.length}</span>
        <span class="search-count-text">{x({ hu: 'aktív hirdetés, közvetlenül a tulajdonostól', nl: 'actieve advertenties, direct van de eigenaar', en: 'active listings, direct from the owner', de: 'aktive Inserate, direkt vom Eigentümer', fr: 'annonces actives, en direct du propriétaire', es: 'anuncios activos, directamente del propietario', pl: 'aktywnych ogłoszeń bezpośrednio od właścicieli', ro: 'anunțuri active, direct de la proprietar', sk: 'aktívnych inzerátov priamo od majiteľov', it: 'annunci attivi, direttamente dal proprietario', pt: 'anúncios ativos, diretamente do proprietário', el: 'ενεργές αγγελίες, απευθείας από τον ιδιοκτήτη', cs: 'aktivních inzerátů přímo od vlastníků', sl: 'aktivnih oglasov neposredno od lastnikov', sv: 'aktiva annonser, direkt från ägaren', da: 'aktive annoncer direkte fra ejeren', no: 'aktive annonser, direkte fra eieren', fi: 'aktiivista ilmoitusta suoraan omistajalta', et: 'aktiivset kuulutust otse omanikult', lv: 'aktīvi sludinājumi tieši no īpašnieka', lt: 'aktyvūs skelbimai tiesiogiai iš savininko', sr: 'aktivnih oglasa, direktno od vlasnika', uk: 'активних оголошень, напряму від власників', tr: 'aktif ilan, doğrudan mülk sahibinden', he: 'מודעות פעילות, ישירות מבעלי הנכסים', ar: 'إعلانًا نشطًا، مباشرة من المالكين', ru: 'активных объявлений, напрямую от владельцев', zh: '条在售房源，业主直接发布' })}</span>
      </p>}
    </HomeSearch>
  </section>

  {/* ── VALUATION ── only while an admin has the service switched on */}
  {valuation && (
    <section class="valuation-slab slab reveal" aria-labelledby="valuation-slab-title">
      <div class="vs-copy">
        <SectionHead eyebrow={x({ hu: 'Értékmeghatározás', nl: 'Waardebepaling', en: 'Valuation', de: 'Bewertung', fr: 'Estimation', es: 'Valoración', pl: 'Wycena', ro: 'Evaluare', sk: 'Odhad ceny', it: 'Valutazione', pt: 'Avaliação', el: 'Εκτίμηση', cs: 'Odhad ceny', sl: 'Ocena vrednosti', sv: 'Värdering', da: 'Vurdering', no: 'Verdivurdering', fi: 'Arvio', et: 'Hindamine', lv: 'Novērtējums', lt: 'Vertinimas', sr: 'Procena', uk: 'Оцінка', tr: 'Değerleme', he: 'הערכת שווי', ar: 'التقييم', ru: 'Оценка', zh: '估价' })} title={x({ hu: 'Mennyit ér\naz ingatlana?', nl: 'Wat is uw woning\nwaard?', en: 'What is your\nproperty worth?', de: 'Was ist Ihre\nImmobilie wert?', fr: 'Que vaut\nvotre bien\u202f?', es: '¿Cuánto vale\nsu inmueble?', pl: 'Ile jest warta\nPaństwa nieruchomość?', ro: 'Cât valorează\nproprietatea dumneavoastră?', sk: 'Akú hodnotu má\nvaša nehnuteľnosť?', it: 'Quanto vale il suo\nimmobile?', pt: 'Quanto vale o seu\nimóvel?', el: 'Πόσο αξίζει\nτο ακίνητό σας;', cs: 'Kolik má vaše\nnemovitost hodnotu?', sl: 'Koliko je vredna\nvaša nepremičnina?', sv: 'Vad är din\nfastighet värd?', da: 'Hvad er din\nejendom værd?', no: 'Hva er eiendommen\ndin verdt?', fi: 'Paljonko kiinteistösi\non arvoltaan?', et: 'Kui palju on teie\nkinnisvara väärt?', lv: 'Cik vērts ir\njūsu īpašums?', lt: 'Kiek vertas\njūsų turtas?', sr: 'Koliko vredi vaša\nnekretnina?', uk: 'Скільки коштує ваша\nнерухомість?', tr: 'Mülkünüz\nne kadar eder?', he: 'כמה שווה\nהנכס שלכם?', ar: 'كم يساوي\nعقارك؟', ru: 'Сколько стоит ваша\nнедвижимость?', zh: '您的房产\n值多少钱？' })} size="large" />
        <p class="vs-body">
          {x({
            hu: 'Adja meg, amit tud az ingatlanról: fotókat, alaprajzot, dokumentumokat is csatolhat. Munkatársunk ellenőrzi az eredményt, és e-mailben küldi. Tájékoztató becslés, nem hivatalos szakvélemény.',
            nl: 'Vul in wat u van de woning weet; foto’s, plattegronden en documenten kunt u bijvoegen. Onze medewerker controleert het resultaat en stuurt het per e-mail. Indicatief, geen officieel taxatierapport.',
            en: 'Tell us what you know about the property; you can attach photos, floor plans and documents. One of our team checks the result and sends it by email. Indicative only, not an official valuation report.',
            de: 'Geben Sie an, was Sie über die Immobilie wissen; Fotos, Grundrisse und Unterlagen können Sie beifügen. Ein Mitarbeiter prüft das Ergebnis und schickt es per E-Mail. Unverbindliche Einschätzung, kein amtliches Gutachten.',
            fr: 'Indiquez ce que vous savez du bien\u202f; vous pouvez joindre des photos, des plans et des documents. Un collaborateur vérifie le résultat et vous l’envoie par e-mail. Estimation indicative, et non une expertise officielle.',
            es: 'Indíquenos lo que sabe del inmueble; puede adjuntar fotos, planos y documentos. Un miembro de nuestro equipo revisa el resultado y se lo envía por correo electrónico. Valoración orientativa, no una tasación oficial.',
            pl: 'Prosimy podać, co Państwo wiedzą o nieruchomości; można dołączyć zdjęcia, rzuty i dokumenty. Nasz pracownik sprawdzi wynik i prześle go e-mailem. Wycena ma charakter orientacyjny i nie jest operatem szacunkowym.',
            ro: 'Spuneți-ne ce știți despre proprietate; puteți atașa fotografii, planuri și documente. Un coleg verifică rezultatul și vi-l trimite prin e-mail. Evaluare orientativă, nu o evaluare oficială.',
            sk: 'Napíšte nám, čo o nehnuteľnosti viete; môžete priložiť fotografie, pôdorysy a dokumenty. Náš kolega výsledok skontroluje a pošle vám ho e-mailom. Ide o orientačný odhad, nie o znalecký posudok.',
            it: 'Ci dica ciò che sa dell’immobile; può allegare foto, planimetrie e documenti. Un membro del nostro team controlla il risultato e lo invia per e-mail. Ha valore puramente indicativo e non è una perizia ufficiale.',
            pt: 'Diga-nos o que sabe sobre o imóvel; pode anexar fotografias, plantas e documentos. Um membro da nossa equipa verifica o resultado e envia-o por e-mail. É apenas indicativo, não é um relatório de avaliação oficial.',
            el: 'Πείτε μας ό,τι γνωρίζετε για το ακίνητο· μπορείτε να επισυνάψετε φωτογραφίες, κατόψεις και έγγραφα. Ένα μέλος της ομάδας μας ελέγχει το αποτέλεσμα και σας το στέλνει με email. Είναι μόνο ενδεικτικό και όχι επίσημη έκθεση εκτίμησης.',
            cs: 'Řekněte nám, co o nemovitosti víte; můžete přiložit fotografie, půdorysy a dokumenty. Někdo z našeho týmu výsledek zkontroluje a pošle vám ho e-mailem. Jde pouze o orientační odhad, nikoli o úřední znalecký posudek.',
            sl: 'Povejte nam, kar veste o nepremičnini; priložite lahko fotografije, tlorise in dokumente. Član naše ekipe preveri rezultat in vam ga pošlje po e-pošti. Ocena je le okvirna in ni uradno cenilno poročilo.',
            sv: 'Berätta vad du vet om fastigheten; du kan bifoga foton, planritningar och dokument. Någon i vårt team kontrollerar resultatet och skickar det via mejl. Endast vägledande, inte en officiell värderingsrapport.',
            da: 'Fortæl os, hvad du ved om ejendommen; du kan vedhæfte fotos, plantegninger og dokumenter. En fra vores team kontrollerer resultatet og sender det på e-mail. Kun vejledende – ikke en officiel vurderingsrapport.',
            no: 'Fortell oss det du vet om eiendommen; du kan legge ved bilder, plantegninger og dokumenter. En i teamet vårt kontrollerer resultatet og sender det på e-post. Kun veiledende, ikke en offisiell takstrapport.',
            fi: 'Kerro meille, mitä tiedät kiinteistöstä; voit liittää mukaan valokuvia, pohjapiirroksia ja asiakirjoja. Tiimimme jäsen tarkistaa tuloksen ja lähettää sen sähköpostitse. Arvio on suuntaa antava eikä virallinen arviolausunto.',
            et: 'Rääkige meile, mida te kinnisvara kohta teate; võite lisada fotosid, korruseplaane ja dokumente. Meie meeskonna liige kontrollib tulemuse ja saadab selle e-postiga. Hinnang on üksnes soovituslik, mitte ametlik hindamisaruanne.',
