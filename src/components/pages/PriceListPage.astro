---
/**
 * Price list — FODEL's published tariff, which the prototype omitted entirely
 * (its Sellers page ended at "Árlista kérése" → a generic contact form).
 *
 * Figures are exactly those on fodel.hu/arlista: €69 / €129 / €179, €25 per
 * language, €15 and €25 per month for highlighting, €36 video, €30 retro
 * photos, €25 renewal. All prices include 21% Dutch VAT.
 */
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/PageHeader.astro';
import Eyebrow from '~/components/Eyebrow.astro';
import Button from '~/components/Button.astro';
import PackageCard from '~/components/PackageCard.astro';
import { path, localizer, type L10n, type Locale } from '~/i18n/ui';
import { COMMISSION, CONTRACT_PRICES, ONSITE_SERVICES, LISTING_VAT_PERCENT } from '~/config/company';
import { listingCatalog, packageCard, priceFacts, extraPrice, eurText, type ExtraId } from '~/lib/listing-packages';
import { alternatesFor } from '~/lib/page';
import { approvedWording } from '~/lib/approved-text';
import { listingServiceSchema } from '~/lib/seo';
import { getCompany } from '~/lib/runtime-config';
import { nOf } from '~/i18n/plural';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const x = localizer(locale);
const company = await getCompany();
// The refund wording is approved per language by the admin; English, German
// and French readers see the Dutch text (if there is one), marked as Dutch.
const refund = approvedWording(company.services.refundPolicy, locale);
const refundPolicy = refund?.text;
const refundLang = refund?.lang ?? locale;
