      { name: 'Adăugarea ulterioară de fotografii', price: xp('retro-images'), unit: 'o singură dată' },
      { name: 'Prelungirea unui anunț standard, 6 luni', price: xp('renewal-6m'), unit: 'o singură dată' },
    ],
    services: ['Obținerea certificatului de performanță energetică'],
    onsiteUnit: 'o singură dată, la fața locului',
    servicesHead: 'Alte servicii',
    servicesNote: 'Pentru acestea întocmim o ofertă personalizată. Nu ezitați să ne întrebați.',
    contractNote: 'Traducerea contractului de vânzare-cumpărare pe combinație de limbi, prețuri „de la”.',
    commissionBody:
      'Percepem comision doar dacă FODEL a adus cumpărătorul, există un contract de vânzare-cumpărare scris și s-a achitat avansul. Dacă cumpărătorul vă contactează direct și nu aveți nevoie de ajutorul nostru, nu plătiți nimic în plus față de taxa de anunț.',
    refundHead: 'Politica de rambursare',
    commissionTitle: `${pct(COMMISSION.percent)} net, min. ${eurText(locale, COMMISSION.minimumEur)}`,
    contractFrom: (n: number) => `de la ${eurText(locale, n)}`,
  },
  sk: {
    metaTitle: `Cenník: inzeráty od ${eurText(locale, from)}`,
    metaDescription: `Cenník inzerátov FODEL: ${pkgSummary}. Preklad ${eurText(locale, translationPrice)} za jazyk, zvýraznenie ${hlRange} € mesačne. Všetky ceny zahŕňajú ${pct(vat)} holandskú DPH.`,
    eyebrow: 'Cenník',
    title: 'Jasné ceny,',
    titleEm: 'bez skrytých poplatkov',
    body: `Všetky ceny zahŕňajú ${pct(vat)} holandskú DPH. Poplatok za inzerát sa platí iba raz, po schválení; schválený inzerát je hneď online. Províziu si účtujeme, len ak kupujúceho privedieme my.`,
    packagesHead: 'Balíky inzerátov',
    extrasHead: 'Doplnkové služby',
    contractsHead: 'Dvojjazyčná kúpna zmluva',
    commissionHead: 'Provízia',
    vatNote: `Všetky ceny zahŕňajú ${pct(vat)} holandskú DPH.`,
    cta: 'Pridať inzerát',
    ctaNote: 'Po schválení inzerát hneď zverejníme a výzvu na platbu dostanete e-mailom.',
    extras: [
      { name: 'Preklad (holandčina, nemčina, angličtina, francúzština)', price: xp('translation'), unit: '/ jazyk' },
      { name: 'Zvýraznenie v kategórii (min. 3 mesiace)', price: xp('category-highlight'), unit: '/ mesiac' },
      { name: 'Zvýraznenie na úvodnej stránke (min. 3 mesiace)', price: xp('homepage-highlight'), unit: '/ mesiac' },
      { name: 'Zverejnenie videa (vlastného)', price: xp('video'), unit: 'jednorazovo' },
      { name: 'Dodatočné pridanie fotografií', price: xp('retro-images'), unit: 'jednorazovo' },
      { name: 'Predĺženie štandardného inzerátu, 6 mesiacov', price: xp('renewal-6m'), unit: 'jednorazovo' },
    ],
    services: ['Vystavenie energetického certifikátu'],
    onsiteUnit: 'jednorazovo, na mieste',
    servicesHead: 'Ďalšie služby',
    servicesNote: 'Na tieto služby pripravíme cenovú ponuku na mieru. Neváhajte sa opýtať.',
    contractNote: 'Preklad kúpnej zmluvy podľa jazykovej kombinácie, ceny „od“.',
    commissionBody:
      'Províziu si účtujeme, len ak kupujúceho priviedol FODEL, existuje písomná kúpna zmluva a bola zaplatená záloha. Ak vás kupujúci kontaktuje priamo a našu pomoc nepotrebujete, okrem poplatku za inzerát neplatíte nič.',
    refundHead: 'Pravidlá vrátenia platieb',
    commissionTitle: `${pct(COMMISSION.percent)} bez DPH, min. ${eurText(locale, COMMISSION.minimumEur)}`,
    contractFrom: (n: number) => `od ${eurText(locale, n)}`,
  },
};

type Copy = (typeof copies)['en'];
const huExtra = { refundHead: 'Visszatérítési szabály', commissionTitle: `${COMMISSION.percent}% nettó, min. ${COMMISSION.minimumEur} €`, contractFrom: (n: number) => `${n} €-tól` };
const nlExtra = { refundHead: 'Terugbetalingsbeleid', commissionTitle: `${COMMISSION.percent}% netto, min. € ${COMMISSION.minimumEur}`, contractFrom: (n: number) => `vanaf € ${n}` };
const t = { ...copies[locale], ...(locale === 'hu' ? huExtra : locale === 'nl' ? nlExtra : {}) } as Copy;

const contractLabels: Record<string, L10n> = {
  hu: { hu: 'Magyar', nl: 'Hongaars', en: 'Hungarian', de: 'Ungarisch', fr: 'Hongrois', es: 'Húngaro', pl: 'Węgierski', ro: 'Maghiară', sk: 'Maďarčina' },
  'de-hu': { hu: 'Német–magyar', nl: 'Duits–Hongaars', en: 'German–Hungarian', de: 'Deutsch–Ungarisch', fr: 'Allemand–hongrois', es: 'Alemán–húngaro', pl: 'Niemiecki–węgierski', ro: 'Germană–maghiară', sk: 'Nemčina–maďarčina' },
  'en-hu': { hu: 'Angol–magyar', nl: 'Engels–Hongaars', en: 'English–Hungarian', de: 'Englisch–Ungarisch', fr: 'Anglais–hongrois', es: 'Inglés–húngaro', pl: 'Angielski–węgierski', ro: 'Engleză–maghiară', sk: 'Angličtina–maďarčina' },
  'nl-hu': { hu: 'Holland–magyar', nl: 'Nederlands–Hongaars', en: 'Dutch–Hungarian', de: 'Niederländisch–Ungarisch', fr: 'Néerlandais–hongrois', es: 'Neerlandés–húngaro', pl: 'Niderlandzki–węgierski', ro: 'Neerlandeză–maghiară', sk: 'Holandčina–maďarčina' },
};
const packageCards = catalog.packages.map((pkg) => packageCard(pkg, catalog, locale, { withExtras: true }));

const packageSchema = listingServiceSchema(locale, {
  name: t.packagesHead,
  description: t.metaDescription,
  url: path(locale, 'priceList'),
  packages: catalog.packages.map((pkg) => ({
    name: pkg.names[locale],
    priceEur: pkg.priceEur,
  })),
});
---

<Base
  locale={locale}
  title={t.metaTitle}
  description={t.metaDescription}
  alternates={alternatesFor('priceList')}
  schema={[packageSchema]}
>
  <PageHeader
    eyebrow={t.eyebrow}
    title={t.title}
    titleEm={t.titleEm}
    body={t.body}
    compact
    primary={{ label: t.cta, href: path(locale, 'submitAd') }}
  />

  {/* ── Packages ── */}
  <section class="packages">
    <Eyebrow space="24px">{t.packagesHead}</Eyebrow>
    <div class="package-grid">
      {
        packageCards.map((pkg: any) => (
          <PackageCard pkg={pkg} mode="link" ctaLabel={t.cta} ctaHref={path(locale, 'submitAd')} />
        ))
      }
    </div>
    <p class="vat">{t.vatNote}</p>
  </section>

  {/* ── Extras ── */}
  <section class="extras slab">
    <Eyebrow space="24px">{t.extrasHead}</Eyebrow>
    <table>
      <tbody>
        {
          t.extras.map((extra: any) => (
            <tr>
              <th scope="row">{extra.name}</th>
              <td class="amount">{extra.price}</td>
              <td class="unit">{extra.unit}</td>
            </tr>
          ))
        }
        {
          ONSITE_SERVICES.map((service) => (
            <tr>
              <th scope="row">{service.names[locale]}</th>
              <td class="amount">{fmt(service.priceEur)}</td>
              <td class="unit">{t.onsiteUnit}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>

  {/* ── Contracts + services ── */}
  <div class="two-col duo">
    <section class="contracts duo-panel duo-paper">
      <Eyebrow space="24px">{t.contractsHead}</Eyebrow>
      <table>
        <tbody>
          {
            CONTRACT_PRICES.map((cp) => (
              <tr>
                <th scope="row">{contractLabels[cp.id][locale]}</th>
                <td class="amount">{t.contractFrom(cp.fromEur)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p class="note">{t.contractNote}</p>
    </section>

    <section class="services duo-panel duo-paper">
      <Eyebrow space="24px">{t.servicesHead}</Eyebrow>
      <ul>
        {
          t.services.map((s: string) => (
            <li>
              <span class="tick" aria-hidden="true">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2.5 6.25 5 8.75l4.5-5.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </span>
              <span>{s}</span>
            </li>
          ))
        }
      </ul>
      <p class="note">{t.servicesNote}</p>
    </section>
  </div>

  {/* ── Commission ── */}
  {refundPolicy && <section class="slab"><h2>{t.refundHead}</h2><p lang={refundLang}>{refundPolicy}</p></section>}
  <section class="commission slab surface-ink" data-bg="dark">
    <div class="commission-copy">
      <Eyebrow space="24px">{t.commissionHead}</Eyebrow>
      <h2>{t.commissionTitle}</h2>
      <p>{t.commissionBody}</p>
    </div>
    <div class="commission-cta">
      <Button variant="dark" light href={path(locale, 'submitAd')}>{t.cta}</Button>
      <p class="cta-note">{t.ctaNote}</p>
    </div>
  </section>
</Base>

<style>
  .packages {
    padding: 48px var(--pad-x) 72px;
  }
  .package-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .vat {
    font-size: var(--fs-small);
    color: var(--taupe);
    margin-top: 20px;
  }

  /* ── Extras: a tinted slab; each row lights as it is read ── */
  .extras {
    padding: 72px calc(var(--pad-x) - var(--slab-x)) 64px;
    background: var(--linen);
  }
  table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0 6px;
  }
  th,
  td {
    text-align: left;
    padding: 18px 0;
    font-weight: var(--fw-body);
    font-size: var(--fs-body);
    line-height: 1.5;
    color: var(--taupe);
    vertical-align: middle;
    background: rgba(255, 255, 255, 0.6);
    transition: background-color 0.3s var(--ease-out);
  }
  tr > :first-child {
    padding-left: 24px;
    border-radius: var(--r-md) 0 0 var(--r-md);
  }
  tr > :last-child {
    padding-right: 24px;
    border-radius: 0 var(--r-md) var(--r-md) 0;
  }
  tr:hover > * {
    background: var(--white);
  }
  th {
    color: var(--ink);
  }
  .amount {
    font-family: var(--serif);
    font-weight: var(--fw-medium);
    font-size: var(--fs-lead);
    color: var(--ink);
    text-align: right;
    white-space: nowrap;
    padding-left: 24px;
  }
  .unit {
    text-align: right;
    white-space: nowrap;
    font-size: var(--fs-small);
    padding-left: 12px;
    width: 1%;
  }

  /* ── Contracts + services ── */
  .two-col {
    margin-top: var(--slab-x);
  }
  .two-col .duo-panel {
    padding-block: 64px;
  }
  .contracts table {
    border-spacing: 0 6px;
  }
  .contracts th,
  .contracts td {
    background: rgba(16, 42, 67, 0.04);
  }
  /* "à partir de 300 €" is longer than the Hungarian "300 €-tól": let it wrap on a phone. */
  .contracts .amount {
    white-space: normal;
    padding-left: 12px;
    font-size: var(--fs-body);
  }
  .contracts tr:hover > * {
    background: rgba(16, 42, 67, 0.07);
  }
  .services ul {
    display: flex;
    flex-direction: column;
    gap: 14px;
    list-style: none;
  }
  .services li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    font-size: var(--fs-body);
    line-height: 1.55;
    color: var(--ink);
  }
  .tick {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    margin-top: 1px;
    border-radius: 50%;
    background: rgba(16, 42, 67, 0.08);
    color: var(--ink);
  }
  .note {
    font-size: var(--fs-small);
    line-height: var(--lh-body);
    color: var(--taupe);
    margin-top: 20px;
  }

  /* ── Commission ── */
  .commission {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 56px;
    margin-top: var(--slab-x);
    padding: 88px calc(var(--pad-x) - var(--slab-x));
  }
  .commission h2 {
    font-family: var(--serif);
    font-weight: var(--fw-hero);
    font-size: clamp(32px, 3.6vw, 56px);
    letter-spacing: var(--ls-display);
    line-height: 1.05;
    color: var(--cream);
    margin-bottom: 20px;
  }
  .commission-copy p {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--on-dark-body);
    max-width: 62ch;
  }
  .commission-cta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    flex-shrink: 0;
    text-align: right;
  }
  .cta-note {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--on-dark-muted);
    margin-top: 14px;
    max-width: 30ch;
  }

  @media (max-width: 900px) {
    .packages {
      padding: 32px var(--pad-x-mob) 48px;
    }
    .package-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .extras {
      padding: 48px calc(var(--pad-x-mob) - var(--slab-x) + 4px);
    }
    tr > :first-child {
      padding-left: 16px;
    }
    tr > :last-child {
      padding-right: 16px;
    }
    .two-col .duo-panel {
      padding-block: 44px;
    }
    .commission {
      flex-direction: column;
      align-items: stretch;
      gap: 32px;
      padding: 56px calc(var(--pad-x-mob) - var(--slab-x) + 4px);
    }
    .commission-cta {
      align-items: flex-start;
      text-align: left;
    }
    .unit {
      display: none;
    }
    /* With the unit hidden, the amount closes the row. */
    .extras .amount {
      padding-right: 16px;
      border-radius: 0 var(--r-md) var(--r-md) 0;
    }
  }
</style>
