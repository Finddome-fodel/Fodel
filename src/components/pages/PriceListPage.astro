import { listingCatalog, packageCard, priceFacts, extraPrice, eurText, type ExtraId } from '~/lib/listing-packages';
import { alternatesFor } from '~/lib/page';
import { approvedWording } from '~/lib/approved-text';
import { listingServiceSchema } from '~/lib/seo';
import { getCompany } from '~/lib/runtime-config';
import { nOf } from '~/i18n/plural';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const x = localizer(locale);
const company = await getCompany();
