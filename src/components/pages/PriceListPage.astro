// (Szolgáltatások → Hirdetési csomagok), so this page always matches checkout.
const catalog = listingCatalog(company.services);
const from = priceFacts(catalog).from;
const fmt = (n: number) => eurText(locale, n);
const xp = (id: ExtraId) => fmt(extraPrice(catalog, id));
const vat = LISTING_VAT_PERCENT;
const pct = (n: number) => (locale === 'de' || locale === 'fr' || locale === 'es' || locale === 'sk' ? `${n}\u00a0%` : `${n}%`);
const pkgSummary = catalog.packages
  .map((p) => {
    const price = p.priceEurAbove !== null ? `${fmt(p.priceEur)} ${x('vagy', 'of', 'or', 'oder', 'ou', 'o', 'lub', 'sau', 'alebo', 'o', 'ou', 'ή', 'nebo', 'ali', 'eller', 'eller', 'eller', 'tai', 'või', 'vai', 'arba')} ${fmt(p.priceEurAbove)}` : fmt(p.priceEur);
    return x(`${p.months} hónapos ${price}`, `${p.months} maanden ${price}`, `${p.months}-month listing ${price}`, `${p.months}-monatiges Inserat ${price}`, `annonce de ${p.months} mois à ${price}`, `anuncio de ${p.months} meses por ${price}`, `ogłoszenie na ${nOf('pl', p.months, 'miesiąc', 'miesiące', 'miesięcy')} za ${price}`, `anunț pe ${nOf('ro', p.months, 'lună', 'luni', 'de luni')} la ${price}`, `inzerát na ${nOf('sk', p.months, 'mesiac', 'mesiace', 'mesiacov')} za ${price}`, `annuncio di ${p.months} mesi a ${price}`, `anúncio de ${p.months} meses por ${price}`, `αγγελία ${p.months} μηνών στα ${price}`, `${p.months}měsíční inzerát za ${price}`, `${p.months}-mesečni oglas za ${price}`, `annons i ${p.months} månader för ${price}`, `annonce i ${p.months} måneder til ${price}`, `annonse i ${p.months} måneder for ${price}`, `${p.months} kuukauden ilmoitus hintaan ${price}`, `${p.months}-kuuline kuulutus hinnaga ${price}`, `${nOf('lv', p.months, 'mēneša', 'mēnešu')} sludinājums par ${price}`, `${nOf('lt', p.months, 'mėnesio', 'mėnesių', 'mėnesių')} skelbimas už ${price}`);
  })
  .join(', ');
const hl = [extraPrice(catalog, 'category-highlight'), extraPrice(catalog, 'homepage-highlight')].sort((a, b) => a - b);
const hlRange = hl[0] === hl[1] ? `${hl[0]}` : `${hl[0]}–${hl[1]}`;
const translationPrice = extraPrice(catalog, 'translation');

