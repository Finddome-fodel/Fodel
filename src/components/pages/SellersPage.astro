---
/**
 * Sellers. Ported from the prototype, with the commission band now pointing at
 * a real price list and a real order form instead of a generic contact link.
 *
 * The argument sequence (cash buyers → serious intent → €200–300 to view) is
 * FODEL's strongest sales asset and is kept exactly as the prototype ordered it.
 */
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/PageHeader.astro';
import SectionHead from '~/components/SectionHead.astro';
import Button from '~/components/Button.astro';
import PointsList from '~/components/PointsList.astro';
import NumberedColumns from '~/components/NumberedColumns.astro';
import FaqAccordion from '~/components/FaqAccordion.astro';
import { UI, path, localizer, type Locale } from '~/i18n/ui';
import { COMMISSION } from '~/config/company';
import { listingCatalog, priceFacts, extraPrice } from '~/lib/listing-packages';
import { eur } from '~/lib/format';
import { getCompany } from '~/lib/runtime-config';
import { copy } from '~/data/copy';
import { alternatesFor } from '~/lib/page';
import { serviceSchema, faqSchema } from '~/lib/seo';
import { faqFor, faqAnswerText } from '~/data/faq';
import vineyard from '~/assets/properties/vineyard.png';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = UI[locale];
const x = localizer(locale);
const c = copy(locale).sellers;
const steps = copy(locale).steps;

const catalog = listingCatalog((await getCompany()).services);
const cheapest = priceFacts(catalog).from;
const translationFee = extraPrice(catalog, 'translation');
const space = ['de', 'fr', 'es', 'sk', 'cs', 'sl', 'sv', 'da', 'no', 'fi', 'lt'].includes(locale) ? '\u00a0' : '';

// The seller FAQ doubles as FAQPage markup — this is the content answer
// engines quote when someone asks how selling to foreign buyers works.
const sellerFaq = faqFor(locale, 'seller').slice(0, 8);
---

<Base
  locale={locale}
  title={c.meta.title}
  description={c.meta.description}
  alternates={alternatesFor('sellers')}
  schema={[
    serviceSchema(locale, c.hero.title, c.meta.description),
    ...(sellerFaq.length > 0
      ? [faqSchema(sellerFaq.map((e) => ({ question: e.question, answer: faqAnswerText(e) })))]
      : []),
  ]}
>
  <PageHeader
    eyebrow={c.hero.eyebrow}
    title={c.hero.title}
    titleEm={c.hero.titleEm}
    body={c.hero.body}
    image={vineyard}
    imageAlt={x({ hu: 'Szőlőbirtok a Dunántúlon', nl: 'Wijngaard in Transdanubië', en: 'Vineyard in Transdanubia', de: 'Weingut in Transdanubien', fr: 'Vignoble en Transdanubie', es: 'Viñedo en Transdanubia', pl: 'Winnica w Zadunaju', ro: 'Podgorie în Transdanubia', sk: 'Vinica v Zadunajsku', it: 'Vigneto in Transdanubia', pt: 'Vinha na Transdanúbia', el: 'Αμπελώνας στην Υπερδουνάβια', cs: 'Vinice v Zadunají', sl: 'Vinograd v Prekdonavju', sv: 'Vingård i Transdanubien', da: 'Vingård i Transdanubien', no: 'Vingård i Transdanubia', fi: 'Viinitila Transdanubiassa', et: 'Viinamägi Transdanuubias', lv: 'Vīnogulāji Aizdonavā', lt: 'Vynuogynas Užduonojyje', sr: 'Vineyard in Transdanubia', uk: 'Vineyard in Transdanubia', tr: 'Vineyard in Transdanubia', he: 'Vineyard in Transdanubia', ar: 'Vineyard in Transdanubia', ru: 'Vineyard in Transdanubia', zh: 'Vineyard in Transdanubia' })}
    primary={{ label: c.hero.cta, href: path(locale, 'submitAd'), emphasis: true }}
    secondary={{ label: c.hero.secondary, href: path(locale, 'priceList') }}
  />

  {/* ── Benefits + buyer personas ── */}
  <div class="split duo">
    <section class="benefits duo-panel duo-paper reveal">
      <SectionHead eyebrow={c.benefits.eyebrow} title={c.benefits.title} rule={false} />
      <PointsList items={c.benefits.points} />
    </section>

    <section class="personas duo-panel duo-linen reveal">
      <SectionHead eyebrow={c.personas.eyebrow} title={c.personas.title} rule={false} />
      <dl class="persona-list">
        {
          c.personas.items.map((p: any, i: number) => (
            <div class="persona">
              <span class="persona-num num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <dt>{p.title}</dt>
              <dd>{p.body}</dd>
            </div>
          ))
        }
      </dl>
    </section>
  </div>

  {/* ── Three-step model ── */}
  <section class="how">
    <SectionHead eyebrow={c.how.eyebrow} title={c.how.title} size="large" class="how-head reveal" />
    <NumberedColumns items={steps} />
  </section>

  {/* ── Commission band ── */}
  <section class="commission slab surface-ink" data-bg="dark">
    <div class="commission-copy reveal">
      <SectionHead eyebrow={c.commission.eyebrow} title={c.commission.title} rule={false} />
      <p>{c.commission.body}</p>
    </div>
    <div class="commission-figure reveal">
      <span class="pct num">{COMMISSION.percent}<span class="pct-sign">%</span></span>
      <span class="pct-note">
        {x({
          hu: `min. ${COMMISSION.minimumEur} € + ${COMMISSION.vatPercent}% áfa`,
          nl: `min. € ${COMMISSION.minimumEur} + ${COMMISSION.vatPercent}% btw`,
          en: `min. ${eur(COMMISSION.minimumEur, locale)} + ${COMMISSION.vatPercent}% VAT`,
          de: `mind. ${eur(COMMISSION.minimumEur, locale)} + ${COMMISSION.vatPercent}${space}% USt.`,
          fr: `min. ${eur(COMMISSION.minimumEur, locale)} + ${COMMISSION.vatPercent}${space}% de TVA`,
          es: `mín. ${eur(COMMISSION.minimumEur, locale)} + ${COMMISSION.vatPercent}${space}% de IVA`,
          pl: `min. ${eur(COMMISSION.minimumEur, locale)} + ${COMMISSION.vatPercent}${space}% VAT`,
          ro: `min. ${eur(COMMISSION.minimumEur, locale)} + TVA ${COMMISSION.vatPercent}${space}%`,
          sk: `min. ${eur(COMMISSION.minimumEur, locale)} + ${COMMISSION.vatPercent}${space}% DPH`,
          it: `min. ${eur(COMMISSION.minimumEur, locale)} + IVA ${COMMISSION.vatPercent}${space}%`,
          pt: `mín. ${eur(COMMISSION.minimumEur, locale)} + IVA ${COMMISSION.vatPercent}${space}%`,
          el: `ελάχ. ${eur(COMMISSION.minimumEur, locale)} + ΦΠΑ ${COMMISSION.vatPercent}${space}%`,
          cs: `min. ${eur(COMMISSION.minimumEur, locale)} + ${COMMISSION.vatPercent}${space}% DPH`,
          sl: `najmanj ${eur(COMMISSION.minimumEur, locale)} + ${COMMISSION.vatPercent}${space}% DDV`,
          sv: `minst ${eur(COMMISSION.minimumEur, locale)} + ${COMMISSION.vatPercent}${space}% moms`,
          da: `min. ${eur(COMMISSION.minimumEur, locale)} + ${COMMISSION.vatPercent}${space}% moms`,
          no: `min. ${eur(COMMISSION.minimumEur, locale)} + ${COMMISSION.vatPercent}${space}% mva.`,
          fi: `väh. ${eur(COMMISSION.minimumEur, locale)} + alv ${COMMISSION.vatPercent}${space}%`,
          et: `vähemalt ${eur(COMMISSION.minimumEur, locale)} + käibemaks ${COMMISSION.vatPercent}${space}%`,
          lv: `vismaz ${eur(COMMISSION.minimumEur, locale)} + PVN ${COMMISSION.vatPercent}${space}%`,
          lt: `ne mažiau kaip ${eur(COMMISSION.minimumEur, locale)} + ${COMMISSION.vatPercent}${space}% PVM`,
          sr: `min. ${eur(COMMISSION.minimumEur, locale)} + ${COMMISSION.vatPercent}% VAT`,
          uk: `min. ${eur(COMMISSION.minimumEur, locale)} + ${COMMISSION.vatPercent}% VAT`,
          tr: `min. ${eur(COMMISSION.minimumEur, locale)} + ${COMMISSION.vatPercent}% VAT`,
          he: `min. ${eur(COMMISSION.minimumEur, locale)} + ${COMMISSION.vatPercent}% VAT`,
          ar: `min. ${eur(COMMISSION.minimumEur, locale)} + ${COMMISSION.vatPercent}% VAT`,
          ru: `min. ${eur(COMMISSION.minimumEur, locale)} + ${COMMISSION.vatPercent}% VAT`,
          zh: `min. ${eur(COMMISSION.minimumEur, locale)} + ${COMMISSION.vatPercent}% VAT`,
        })}
      </span>
    </div>
  </section>

  {/* ── Pricing summary ── */}
  <section class="pricing slab">
    <SectionHead
      eyebrow={x({ hu: 'Hirdetési csomagok', nl: 'Advertentiepakketten', en: 'Listing packages', de: 'Inseratspakete', fr: 'Forfaits d’annonce', es: 'Paquetes de anuncio', pl: 'Pakiety ogłoszeń', ro: 'Pachete de anunț', sk: 'Balíky inzerátov', it: 'Pacchetti di annunci', pt: 'Pacotes de anúncios', el: 'Πακέτα αγγελιών', cs: 'Balíčky inzerátů', sl: 'Paketi oglasov', sv: 'Annonspaket', da: 'Annoncepakker', no: 'Annonsepakker', fi: 'Ilmoituspaketit', et: 'Kuulutuspaketid', lv: 'Sludinājumu paketes', lt: 'Skelbimų paketai', sr: 'Listing packages', uk: 'Listing packages', tr: 'Listing packages', he: 'Listing packages', ar: 'Listing packages', ru: 'Listing packages', zh: 'Listing packages' })}
      title={x({ hu: `Hirdetés már ${cheapest} €-tól`, nl: `Adverteren vanaf € ${cheapest}`, en: `Listings from ${eur(cheapest, locale)}`, de: `Inserieren ab ${eur(cheapest, locale)}`, fr: `Annonces dès ${eur(cheapest, locale)}`, es: `Anuncios desde ${eur(cheapest, locale)}`, pl: `Ogłoszenia od ${eur(cheapest, locale)}`, ro: `Anunțuri de la ${eur(cheapest, locale)}`, sk: `Inzeráty od ${eur(cheapest, locale)}`, it: `Annunci da ${eur(cheapest, locale)}`, pt: `Anúncios a partir de ${eur(cheapest, locale)}`, el: `Αγγελίες από ${eur(cheapest, locale)}`, cs: `Inzeráty od ${eur(cheapest, locale)}`, sl: `Oglasi od ${eur(cheapest, locale)}`, sv: `Annonser från ${eur(cheapest, locale)}`, da: `Annoncer fra ${eur(cheapest, locale)}`, no: `Annonser fra ${eur(cheapest, locale)}`, fi: `Ilmoitukset alkaen ${eur(cheapest, locale)}`, et: `Kuulutused alates ${eur(cheapest, locale)}`, lv: `Sludinājumi no ${eur(cheapest, locale)}`, lt: `Skelbimai nuo ${eur(cheapest, locale)}`, sr: `Listings from ${eur(cheapest, locale)}`, uk: `Listings from ${eur(cheapest, locale)}`, tr: `Listings from ${eur(cheapest, locale)}`, he: `Listings from ${eur(cheapest, locale)}`, ar: `Listings from ${eur(cheapest, locale)}`, ru: `Listings from ${eur(cheapest, locale)}`, zh: `Listings from ${eur(cheapest, locale)}` })}
      size="large"
      class="reveal"
    />
    <div class="pricing-side reveal">
      <p>
        {x({
          hu: `A hirdetési díj tartalmazza a szöveg szerkesztését, a képfeldolgozást és a hirdetés összeállítását. Idegen nyelvű fordítás nyelvenként ${translationFee} €.`,
          nl: `De advertentieprijs omvat het redigeren van de tekst, de beeldbewerking en het opmaken van de advertentie. Vertaling kost € ${translationFee} per taal.`,
          en: `The listing fee covers editing the text, processing the photos and putting the listing together. A translation costs ${eur(translationFee, locale)} per language.`,
          de: `Die Inseratsgebühr umfasst das Redigieren des Textes, die Bildbearbeitung und das Zusammenstellen des Inserats. Eine Übersetzung kostet ${eur(translationFee, locale)} pro Sprache.`,
          fr: `Les frais d’annonce comprennent la relecture du texte, le traitement des photos et la mise en forme de l’annonce. Une traduction coûte ${eur(translationFee, locale)} par langue.`,
          es: `La tarifa del anuncio incluye la revisión del texto, el tratamiento de las fotos y la maquetación del anuncio. Una traducción cuesta ${eur(translationFee, locale)} por idioma.`,
          pl: `Opłata za ogłoszenie obejmuje redakcję tekstu, obróbkę zdjęć i przygotowanie ogłoszenia. Tłumaczenie kosztuje ${eur(translationFee, locale)} za język.`,
          ro: `Taxa de anunț include corectarea textului, prelucrarea fotografiilor și realizarea anunțului. O traducere costă ${eur(translationFee, locale)} per limbă.`,
          sk: `Poplatok za inzerát zahŕňa úpravu textu, spracovanie fotografií a zostavenie inzerátu. Preklad stojí ${eur(translationFee, locale)} za jazyk.`,
          it: `La tariffa dell’annuncio comprende la revisione del testo, l’elaborazione delle foto e la composizione dell’annuncio. Una traduzione costa ${eur(translationFee, locale)} per lingua.`,
          pt: `A taxa do anúncio inclui a revisão do texto, o tratamento das fotografias e a montagem do anúncio. Uma tradução custa ${eur(translationFee, locale)} por idioma.`,
          el: `Το τέλος της αγγελίας περιλαμβάνει την επιμέλεια του κειμένου, την επεξεργασία των φωτογραφιών και τη σύνταξη της αγγελίας. Μια μετάφραση κοστίζει ${eur(translationFee, locale)} ανά γλώσσα.`,
          cs: `Poplatek za inzerát zahrnuje úpravu textu, zpracování fotografií a sestavení inzerátu. Překlad stojí ${eur(translationFee, locale)} za jazyk.`,
          sl: `Pristojbina za oglas vključuje urejanje besedila, obdelavo fotografij in pripravo oglasa. Prevod stane ${eur(translationFee, locale)} na jezik.`,
          sv: `Annonsavgiften omfattar textredigering, bildbehandling och sammanställning av annonsen. En översättning kostar ${eur(translationFee, locale)} per språk.`,
          da: `Annoncegebyret dækker redigering af teksten, behandling af fotos og opsætning af annoncen. En oversættelse koster ${eur(translationFee, locale)} pr. sprog.`,
          no: `Annonseavgiften dekker redigering av teksten, behandling av bildene og oppsett av annonsen. En oversettelse koster ${eur(translationFee, locale)} per språk.`,
          fi: `Ilmoitusmaksu kattaa tekstin toimittamisen, kuvien käsittelyn ja ilmoituksen kokoamisen. Käännös maksaa ${eur(translationFee, locale)} kieltä kohden.`,
          et: `Kuulutuse tasu sisaldab teksti toimetamist, fotode töötlemist ja kuulutuse koostamist. Tõlge maksab ${eur(translationFee, locale)} keele kohta.`,
          lv: `Sludinājuma maksā ietilpst teksta rediģēšana, fotoattēlu apstrāde un sludinājuma sagatavošana. Tulkojums maksā ${eur(translationFee, locale)} par katru valodu.`,
          lt: `Skelbimo mokestis apima teksto redagavimą, nuotraukų apdorojimą ir skelbimo parengimą. Vertimas kainuoja ${eur(translationFee, locale)} už kalbą.`,
          sr: `The listing fee covers editing the text, processing the photos and putting the listing together. A translation costs ${eur(translationFee, locale)} per language.`,
          uk: `The listing fee covers editing the text, processing the photos and putting the listing together. A translation costs ${eur(translationFee, locale)} per language.`,
          tr: `The listing fee covers editing the text, processing the photos and putting the listing together. A translation costs ${eur(translationFee, locale)} per language.`,
          he: `The listing fee covers editing the text, processing the photos and putting the listing together. A translation costs ${eur(translationFee, locale)} per language.`,
          ar: `The listing fee covers editing the text, processing the photos and putting the listing together. A translation costs ${eur(translationFee, locale)} per language.`,
          ru: `The listing fee covers editing the text, processing the photos and putting the listing together. A translation costs ${eur(translationFee, locale)} per language.`,
          zh: `The listing fee covers editing the text, processing the photos and putting the listing together. A translation costs ${eur(translationFee, locale)} per language.`,
        })}
      </p>
      <div class="pricing-actions">
        <Button variant="dark" href={path(locale, 'priceList')}>{c.commission.cta}</Button>
        <Button variant="text" href={path(locale, 'submitAd')}>{ui.cta.submitAd}</Button>
      </div>
    </div>
  </section>

  {/* ── Seller FAQ ── */}
  <FaqAccordion
    eyebrow={x({ hu: 'Gyakori kérdések', nl: 'Veelgestelde vragen', en: 'Frequently asked questions', de: 'Häufige Fragen', fr: 'Questions fréquentes', es: 'Preguntas frecuentes', pl: 'Najczęściej zadawane pytania', ro: 'Întrebări frecvente', sk: 'Časté otázky', it: 'Domande frequenti', pt: 'Perguntas frequentes', el: 'Συχνές ερωτήσεις', cs: 'Časté dotazy', sl: 'Pogosta vprašanja', sv: 'Vanliga frågor', da: 'Ofte stillede spørgsmål', no: 'Ofte stilte spørsmål', fi: 'Usein kysytyt kysymykset', et: 'Korduma kippuvad küsimused', lv: 'Biežāk uzdotie jautājumi', lt: 'Dažnai užduodami klausimai', sr: 'Frequently asked questions', uk: 'Frequently asked questions', tr: 'Frequently asked questions', he: 'Frequently asked questions', ar: 'Frequently asked questions', ru: 'Frequently asked questions', zh: 'Frequently asked questions' })}
    title={x({ hu: 'Amit az eladók kérdezni szoktak', nl: 'Wat verkopers ons vragen', en: 'What sellers ask us', de: 'Was Verkäufer uns fragen', fr: 'Ce que nous demandent les vendeurs', es: 'Lo que nos preguntan los vendedores', pl: 'O co pytają nas sprzedający', ro: 'Ce ne întreabă vânzătorii', sk: 'Na čo sa nás pýtajú predávajúci', it: 'Cosa ci chiedono i venditori', pt: 'O que os vendedores nos perguntam', el: 'Τι μας ρωτούν οι πωλητές', cs: 'Na co se nás prodávající ptají', sl: 'Kaj nas sprašujejo prodajalci', sv: 'Vad säljare frågar oss', da: 'Det spørger sælgere os om', no: 'Dette spør selgere oss om', fi: 'Mitä myyjät kysyvät meiltä', et: 'Mida müüjad meilt küsivad', lv: 'Ko mums jautā pārdevēji', lt: 'Ko mūsų klausia pardavėjai', sr: 'What sellers ask us', uk: 'What sellers ask us', tr: 'What sellers ask us', he: 'What sellers ask us', ar: 'What sellers ask us', ru: 'What sellers ask us', zh: 'What sellers ask us' })}
    entries={sellerFaq}
    moreHref={path(locale, 'faq')}
    moreLabel={x({ hu: 'Összes kérdés és válasz', nl: 'Alle vragen en antwoorden', en: 'All questions and answers', de: 'Alle Fragen und Antworten', fr: 'Toutes les questions et réponses', es: 'Todas las preguntas y respuestas', pl: 'Wszystkie pytania i odpowiedzi', ro: 'Toate întrebările și răspunsurile', sk: 'Všetky otázky a odpovede', it: 'Tutte le domande e risposte', pt: 'Todas as perguntas e respostas', el: 'Όλες οι ερωτήσεις και απαντήσεις', cs: 'Všechny otázky a odpovědi', sl: 'Vsa vprašanja in odgovori', sv: 'Alla frågor och svar', da: 'Alle spørgsmål og svar', no: 'Alle spørsmål og svar', fi: 'Kaikki kysymykset ja vastaukset', et: 'Kõik küsimused ja vastused', lv: 'Visi jautājumi un atbildes', lt: 'Visi klausimai ir atsakymai', sr: 'All questions and answers', uk: 'All questions and answers', tr: 'All questions and answers', he: 'All questions and answers', ar: 'All questions and answers', ru: 'All questions and answers', zh: 'All questions and answers' })}
  />
</Base>

<style>
  /* ── Benefits + personas ──
     Subgrid, so both lists start on one line whatever the headings wrap to.
     No gold rule under these heads: the list's own hairline is the rule. */
  .split {
    grid-template-rows: auto 1fr;
    margin-top: var(--slab-x);
  }
  .benefits,
  .personas {
    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
    row-gap: 0;
    align-content: start;
  }
  .split :global(.section-head-standard) {
    align-self: start;
    margin-bottom: 26px;
  }
  .persona-list {
    border-top: 1px solid var(--border);
  }
  .persona {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    column-gap: 0;
    padding: 20px 0;
    border-bottom: 1px solid var(--border);
  }
  .persona-num {
    grid-row: span 2;
    padding-top: 4px;
    font-size: 13px;
    font-weight: var(--fw-medium);
    letter-spacing: 0.04em;
    color: var(--taupe);
  }
  .persona dt {
    font-family: var(--serif);
    font-weight: var(--fw-medium);
    font-size: 20px;
    letter-spacing: var(--ls-heading);
    line-height: 1.3;
    color: var(--ink);
    margin-bottom: 6px;
  }
  .persona dd {
    font-size: var(--fs-small);
    line-height: var(--lh-body);
    color: var(--taupe);
  }

  /* ── Three-step model ── */
  .how {
    padding: var(--section-y) var(--pad-x);
  }
  .how :global(.how-head) {
    margin-bottom: 72px;
  }

  /* ── Pricing ── */
  .pricing {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 64px;
    align-items: end;
    margin-top: var(--slab-x);
    padding: var(--section-y) calc(var(--pad-x) - var(--slab-x));
    background: var(--linen);
  }
  .pricing-side {
    padding-bottom: 12px;
  }
  .pricing-side p {
    max-width: 48ch;
    margin-bottom: 36px;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--taupe);
  }
  .pricing-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 36px;
  }

  /* ── Commission ── */
  .commission {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 80px;
    align-items: center;
    padding: var(--section-y) calc(var(--pad-x) - var(--slab-x));
  }
  .commission p {
    max-width: 56ch;
    font-size: var(--fs-body-lg);
    line-height: var(--lh-lead);
    /* ADJUSTED: was rgba(cream,.55) — this is a key sales paragraph. */
    color: var(--on-dark-body);
  }
  .commission-figure {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 16px;
  }
  .pct {
    display: block;
    font-family: var(--serif);
    font-weight: var(--fw-light);
    font-size: clamp(112px, 15vw, 240px);
    line-height: 0.8;
    letter-spacing: -0.04em;
    color: var(--cream);
  }
  .pct-sign {
    font-size: 0.5em;
    letter-spacing: 0;
    vertical-align: 0.72em;
    margin-inline-start: 0.04em;
  }
  .pct-note {
    font-size: var(--fs-small);
    letter-spacing: 0.06em;
    color: var(--on-dark-muted);
  }

  @media (max-width: 900px) {
    .split,
    .pricing,
    .commission {
      grid-template-columns: 1fr;
    }
    .split {
      grid-template-rows: none;
    }
    .benefits,
    .personas {
      display: block;
    }
    .how {
      padding: var(--section-y-mob) var(--pad-x-mob);
    }
    .pricing,
    .commission {
      padding: var(--section-y-mob) calc(var(--pad-x-mob) - var(--slab-x) + 4px);
    }
    .how :global(.how-head) {
      margin-bottom: 32px;
    }
    .pricing {
      gap: 8px;
    }
    .pricing-side {
      padding-bottom: 0;
    }
    .commission {
      gap: 40px;
    }
    .commission-figure {
      align-items: flex-start;
    }
  }
</style>
