const grouped = t.groups
  .map((g) => ({ ...g, items: entries.filter((e) => e.audience === g.id) }))
  .filter((g) => g.items.length > 0);
---

<Base
  locale={locale}
  title={t.metaTitle}
  description={t.metaDescription}
  alternates={alternatesFor('faq')}
  schema={[faqSchema(entries.map((e) => ({ question: e.question, answer: faqAnswerText(e) })))]}
>
  <PageHeader eyebrow={t.eyebrow} title={t.title} titleEm={t.titleEm} body={t.body} compact />

  <div class="faq-page">
    <nav class="toc no-print" aria-label={x('Kérdések', 'Vragen', 'Questions', 'Fragen', 'Questions', 'Preguntas', 'Pytania', 'Întrebări', 'Otázky', 'Domande', 'Perguntas', 'Ερωτήσεις', 'Otázky', 'Vprašanja', 'Frågor', 'Spørgsmål', 'Spørsmål', 'Kysymykset', 'Küsimused', 'Jautājumi', 'Klausimai')}>
      {
        grouped.map((group) => (
          <div class="toc-group">
            <Eyebrow space="10px" class="toc-label">{group.label}</Eyebrow>
            <ol>
              {group.items.map((e) => (
                <li><a href={`#${e.id}`} data-toc={e.id}>{e.question}</a></li>
              ))}
            </ol>
          </div>
        ))
      }
    </nav>

    <div class="faq-body">
      {
        grouped.map((group) => (
          <section class="group">
            <h2 class="group-head">
              {group.label}
              <span class="group-count num">{group.items.length}</span>
            </h2>
            {group.items.map((entry) => (
              <article class="entry" id={entry.id}>
                <h3>{entry.question}</h3>
                <div class="answer">
                  {entry.answer.map((para) =>
                    para.startsWith('- ') ? <p class="bullet">{para.slice(2)}</p> : <p>{para}</p>
                  )}
                </div>
              </article>
            ))}
          </section>
        ))
      }

      <aside class="still" data-bg="dark">
        <h2 class="still-head">{t.stillHead}</h2>
        <p>{fillHours(t.stillBody, hours, locale)}</p>
        <div class="still-actions">
          <Button variant="dark" light href={path(locale, 'contact')}>{ui.cta.callback}</Button>
          <Button variant="outline" light href={path(locale, hu ? 'submitAd' : 'searchRequest')}>
            {hu ? ui.cta.submitAd : ui.cta.searchRequest}
          </Button>
        </div>
      </aside>
    </div>
  </div>
</Base>

<script>
  /* Scroll-spy: the question being read is marked in the list beside it,
     and the list keeps it in view. */
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc]'));
  const toc = document.querySelector<HTMLElement>('.toc');
  if (links.length && 'IntersectionObserver' in window) {
    const byId = new Map(links.map((a) => [a.dataset.toc!, a]));
    let current: HTMLAnchorElement | null = null;
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const link = byId.get(entry.target.id);
          if (!link || link === current) continue;
          current?.removeAttribute('aria-current');
          link.setAttribute('aria-current', 'true');
          current = link;
          if (toc && getComputedStyle(toc).position === 'sticky') {
            const top = link.offsetTop - toc.clientHeight / 2;
            toc.scrollTo({ top, behavior: 'smooth' });
          }
        }
      },
      { rootMargin: '-30% 0px -60% 0px' }
    );
    document.querySelectorAll('.entry').forEach((el) => io.observe(el));
  }
</script>

