---
/**
 * Property detail. Ported from the prototype, plus the fields it was missing:
 * FODEL reference number, EPC class (legally required in EU property ads),
 * coordinates and a map link, features, video, and — most importantly — the
 * owner's own contact details where the seller has agreed to publish them.
 * That last block is FODEL's actual differentiator, expressed as data.
 */
import { Image, getImage } from 'astro:assets';
import { languageName, subtypeLabel } from '~/lib/listing-catalogue';
import Base from '~/layouts/Base.astro';
import Eyebrow from '~/components/Eyebrow.astro';
import PropertyCard from '~/components/PropertyCard.astro';
import Map from '~/components/Map.astro';
import VideoEmbed from '~/components/VideoEmbed.astro';
import FormShell from '~/components/forms/FormShell.astro';
import Field from '~/components/forms/Field.astro';
import { UI, path, localizer, type Locale } from '~/i18n/ui';
import { sourceNote } from '~/i18n/fallback';
import { COMPANY } from '~/config/company';
import { featureLabel } from '~/data/features';
import { activeProperties, similarTo, text, resolveText, url as propUrl, type Property } from '~/lib/properties';
import { propertyAlternates, crumbs } from '~/lib/page';
import { propertySchema, breadcrumbSchema, videoObjectSchema } from '~/lib/seo';
import { eur, huf, area, floorArea, epcLabel, formatDate } from '~/lib/format';
import { extractYouTubeId } from '~/lib/video';
import WhatsApp from '~/components/WhatsApp.astro';
import { getTaxonomy, termLabel, getCompany } from '~/lib/runtime-config';
import { abs } from '~/lib/seo';
import { listingRules, showSellerPhone } from '~/lib/listing-rules';
import { normalizePhone } from '~/lib/validation';
import { detailLabel, settingLabel, utilityLabel, parkingLabel } from '~/lib/listing-details';

interface Props {
  locale: Locale;
  property: Property;
}

const { locale, property } = Astro.props;
const d = property.data;
const vocabulary=await getTaxonomy();
const featureName=(key:string)=>termLabel(vocabulary.feature.find(t=>t.key===key),locale)||featureLabel(key,locale);
const ui = UI[locale];
const x = localizer(locale);
const colon = locale === 'fr' ? '\u00a0:' : ':';

const title = text(d.title, locale);
const subtitle = d.subtitle ? text(d.subtitle, locale) : '';
// English, German and French pages show the Dutch (or Hungarian) text the
// seller wrote, and say so; the facts around it are in the visitor's language.
const resolvedDescription = resolveText(d.description, locale);
const description = resolvedDescription.text;
const languageNote = sourceNote(locale, resolvedDescription.from, 'description');
const category = d.categoryLabels[locale] ?? d.categoryLabels.nl ?? d.categoryLabels.hu;
const tag = d.tag ? text(d.tag, locale) : null;

const gallery = [
  { src: d.media.hero, alt: text(d.media.heroAlt, locale), label: null as string | null },
  ...d.media.gallery.map((g) => ({
    src: g.src,
    alt: text(g.alt, locale),
    label: g.label ? text(g.label, locale) : null,
  })),
];

const HERO_WIDTHS = [900, 1400, 1920];
const HERO_SIZES = '100vw';

// Structured data and Open Graph get a right-sized variant, not the source
// file. Using `.src` of the original would point crawlers and social scrapers
// at a multi-megabyte PNG — and would force the originals to ship in dist.
const shareImage = await getImage({
  src: gallery[0].src,
  width: 1200,
  height: 630,
  fit: 'cover',
  // 'jpg', not 'jpeg' — the build accepts both, the dev image endpoint only
  // accepts 'jpg' and 500s otherwise.
  format: 'jpg',
  quality: 80,
  inferSize: typeof gallery[0].src === 'string',
});

const pageUrl = propUrl(property, locale);
const epc = epcLabel(d.building.epcClass, { epcMissing: ui.property.epcMissing });

const specs = [
  d.rooms && { label: ui.property.beds, value: String(d.rooms.bedrooms) },
  d.rooms && { label: ui.property.baths, value: String(d.rooms.bathrooms) },
  d.details.rooms !== undefined && { label: detailLabel('rooms', locale), value: String(d.details.rooms) },
  d.details.half_rooms && { label: detailLabel('half_rooms', locale), value: String(d.details.half_rooms) },
  d.details.floors !== undefined && { label: detailLabel('floors', locale), value: String(d.details.floors) },
  d.details.kitchens !== undefined && { label: detailLabel('kitchens', locale), value: String(d.details.kitchens) },
  d.details.toilets !== undefined && { label: detailLabel('toilets', locale), value: String(d.details.toilets) },
  d.areas.floorM2 && { label: ui.property.area, value: floorArea(d.areas.floorM2, locale) },
  d.areas.plotM2 && { label: ui.property.land, value: area(d.areas.plotM2, locale) },
  d.details.cellar_m2 && { label: detailLabel('cellar_m2', locale), value: floorArea(d.details.cellar_m2, locale) },
  d.areas.buildingM2 && {label:x('Teljes épületterület','Totale gebouwoppervlakte','Total building area','Gesamte Gebäudefläche','Surface totale du bâtiment', 'Superficie total construida', 'Całkowita powierzchnia budynku', 'Suprafața totală a clădirii', 'Celková plocha budovy', 'Superficie edificata totale', 'Área total de construção', 'Συνολική δομημένη επιφάνεια', 'Celková zastavěná plocha', 'Skupna površina stavbe', 'Total byggnadsyta', 'Samlet bebygget areal', 'Totalt bebygd areal', 'Kokonaisrakennusala', 'Hoone kogupind', 'Kopējā apbūves platība', 'Bendras pastato plotas'),value:floorArea(d.areas.buildingM2,locale)},
  d.propertySubtype && {label:x('Altípus','Subtype','Subtype','Untertyp','Sous-type', 'Subtipo', 'Podtyp', 'Subtip', 'Podtyp', 'Sottotipo', 'Subtipo', 'Υποκατηγορία', 'Podtyp', 'Podvrsta', 'Undertyp', 'Undertype', 'Undertype', 'Alatyyppi', 'Alamtüüp', 'Apakštips', 'Potipis'),value:subtypeLabel(d.propertyGroup||d.category,d.propertySubtype,locale)},
  { label: ui.property.epc, value: epc.value },
  d.building.condition && {label:x('Állapot','Staat','Condition','Zustand','État', 'Estado', 'Stan', 'Stare', 'Stav', 'Stato', 'Estado', 'Κατάσταση', 'Stav', 'Stanje', 'Skick', 'Stand', 'Tilstand', 'Kunto', 'Seisukord', 'Stāvoklis', 'Būklė'),value:text(d.building.condition,locale)},
  d.building.heating && {label:x('Fűtés','Verwarming','Heating','Heizung','Chauffage', 'Calefacción', 'Ogrzewanie', 'Încălzire', 'Vykurovanie', 'Riscaldamento', 'Aquecimento', 'Θέρμανση', 'Vytápění', 'Ogrevanje', 'Uppvärmning', 'Opvarmning', 'Oppvarming', 'Lämmitys', 'Küte', 'Apkure', 'Šildymas'),value:text(d.building.heating,locale)},
  d.building.yearBuilt && { label: ui.property.yearBuilt, value: String(d.building.yearBuilt) },
  d.building.wall && d.building.wall.key !== 'nem-tudom' && { label: x('Falazat', 'Muurwerk', 'Wall material', 'Wandmaterial', 'Matériau des murs', 'Material de los muros', 'Materiał ścian', 'Materialul pereților', 'Materiál múrov', 'Materiale delle pareti', 'Material das paredes', 'Υλικό τοιχοποιίας', 'Materiál zdí', 'Material sten', 'Väggmaterial', 'Vægmateriale', 'Veggmateriale', 'Seinämateriaali', 'Seinamaterjal', 'Sienu materiāls', 'Sienų medžiaga'), value: d.building.wall.labels[locale] ?? d.building.wall.labels.nl ?? d.building.wall.labels.hu },
].filter(Boolean) as { label: string; value: string }[];

// Text facts, utilities and parking: below the description, beside the features.
const factRows = [
  d.details.setting && { label: detailLabel('setting', locale), value: settingLabel(d.details.setting, locale) },
  d.address && { label: detailLabel('address', locale), value: [d.address.street, [d.address.postalCode, d.location.settlement].filter(Boolean).join(' ')].filter(Boolean).join(', ') },
  d.details.extra_buildings && { label: detailLabel('extra_buildings', locale), value: d.details.extra_buildings },
].filter(Boolean) as { label: string; value: string }[];
const hasFacts = factRows.length > 0 || d.details.utilities.length > 0 || d.details.parking.length > 0;

const all = await activeProperties();
const similar = similarTo(property, all, 3);

const trail = crumbs(locale, [
  { name: ui.nav.properties, url: path(locale, 'properties') },
  { name: d.location.region, url: path(locale, 'properties') },
  { name: title, url: pageUrl },
]);

const mapUrl = `https://www.openstreetmap.org/?mlat=${d.location.lat}&mlon=${d.location.lng}#map=13/${d.location.lat}/${d.location.lng}`;

// A stored E.164 number is shown the way it is dialled from abroad.
const dialled = d.seller.phone ? normalizePhone(d.seller.phone, 'HU') : { ok: false as const };

const metaDescription = `${title} · ${d.location.settlement}, ${d.location.county}. ${eur(d.price.eur, locale)}${d.areas.floorM2 ? `, ${floorArea(d.areas.floorM2, locale)}` : ''}${d.areas.plotM2 ? `, ${area(d.areas.plotM2,locale)}` : ''}. ${x('Azonosító', 'Referentie', 'Reference', 'Referenz', 'Référence', 'Referencia', 'Numer referencyjny', 'Referință', 'Referenčné číslo', 'Riferimento', 'Referência', 'Κωδικός', 'Číslo inzerátu', 'Referenca', 'Referens', 'Reference', 'Referanse', 'Viite', 'Viitenumber', 'Atsauce', 'Nuoroda')} ${d.ref}.`;

const videoId = d.media.videoUrl ? extractYouTubeId(d.media.videoUrl) : null;

// WhatsApp (brief §9): the chat opens with the listing named and linked, so
// FODEL knows which house is meant. The visitor edits and sends it.
const { whatsapp, services } = await getCompany();

// The seller's own block appears only when their package includes a public
// phone number (Beállítások → Szolgáltatások) and they agreed to publish it.
// Otherwise the enquiry / callback form beside it is the contact path.
const sellerPhone = showSellerPhone(
  { package: d.listing.package, contactVisible: d.seller.contactVisible, phone: d.seller.phone },
  listingRules(services)
);
const whatsappMessage = x(
  `Jó napot! Érdeklődöm a(z) „${title}” (#${d.ref}) hirdetés iránt: ${abs(pageUrl)}`,
  `Goedendag, ik heb interesse in „${title}” (#${d.ref}): ${abs(pageUrl)}`,
  `Hello, I am interested in “${title}” (#${d.ref}): ${abs(pageUrl)}`,
  `Guten Tag, ich interessiere mich für „${title}“ (#${d.ref}): ${abs(pageUrl)}`,
  `Bonjour, je m’intéresse à «\u00a0${title}\u00a0» (#${d.ref})\u00a0: ${abs(pageUrl)}`,
  `Hola, me interesa «${title}» (#${d.ref}): ${abs(pageUrl)}`,
  `Dzień dobry, interesuje mnie „${title}” (#${d.ref}): ${abs(pageUrl)}`,
  `Bună ziua, sunt interesat de „${title}” (#${d.ref}): ${abs(pageUrl)}`,
  `Dobrý deň, mám záujem o „${title}“ (#${d.ref}): ${abs(pageUrl)}`,
  `Buongiorno, vorrei informazioni su “${title}” (#${d.ref}): ${abs(pageUrl)}`,
  `Olá, tenho interesse em «${title}» (#${d.ref}): ${abs(pageUrl)}`,
  `Γεια σας, ενδιαφέρομαι για το «${title}» (#${d.ref}): ${abs(pageUrl)}`,
  `Dobrý den, mám zájem o „${title}“ (#${d.ref}): ${abs(pageUrl)}`,
  `Pozdravljeni, zanima me „${title}“ (#${d.ref}): ${abs(pageUrl)}`,
  `Hej! Jag är intresserad av ”${title}” (#${d.ref}): ${abs(pageUrl)}`,
  `Hej, jeg er interesseret i “${title}” (#${d.ref}): ${abs(pageUrl)}`,
  `Hei, jeg er interessert i «${title}» (#${d.ref}): ${abs(pageUrl)}`,
  `Hei, olen kiinnostunut kohteesta ”${title}” (#${d.ref}): ${abs(pageUrl)}`,
  `Tere! Mind huvitab „${title}“ (#${d.ref}): ${abs(pageUrl)}`,
  `Labdien! Mani interesē „${title}“ (#${d.ref}): ${abs(pageUrl)}`,
  `Laba diena, mane domina „${title}“ (#${d.ref}): ${abs(pageUrl)}`
);
---

<Base
  locale={locale}
  title={`${title}, ${d.location.settlement}`}
  description={metaDescription}
  alternates={propertyAlternates(d.categorySlugs, d.ref)}
  ogType="article"
  ogImage={shareImage.src}
  whatsapp={{ message: whatsappMessage }}
  schema={[
    propertySchema(property, locale, pageUrl, shareImage.src),
    breadcrumbSchema(trail),
    videoId &&
      videoObjectSchema({
        name: title,
        description,
        url: d.media.videoUrl!,
        videoId,
        uploadDate: d.listing.publishedAt,
      }),
  ]}
>
  <div class="detail-top">
  <nav class="crumbs no-print" aria-label={ui.a11y.breadcrumb}>
    <ol>
      {
        trail.map((c, i) => (
          <li>
            {i < trail.length - 1 ? <a href={c.url}>{c.name}</a> : <span aria-current="page">{c.name}</span>}
          </li>
        ))
      }
    </ol>
  </nav>

  {/* ── Gallery hero ── */}
  <div class="property-detail-hero" id="gallery" tabindex="-1" aria-roledescription="carousel" aria-label={title}>
    {
      gallery.map((image, i) => (
        <div
          class="property-detail-hero-media gallery-slide"
          data-slide={i}
          data-active={i === 0 ? '' : undefined}
          hidden={i !== 0}
        >
          {/* The first photograph shares its name with the card photograph a
              visitor clicked (PropertyCard, Base.astro), so the one morphs
              into the other across the page transition. */}
          <div class="slide-inner" style={i === 0 ? 'view-transition-name: prop-hero' : undefined}>
            {/* astro:assets' <Image> has separate local/remote overloads; a src that can be either doesn't match either cleanly — the `as any` is a type-checker limitation, not a runtime one. */}
            <Image
              src={image.src as any}
              alt={image.alt}
              widths={HERO_WIDTHS}
              sizes={HERO_SIZES}
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'auto'}
              inferSize={typeof image.src === 'string'}
            />
          </div>
        </div>
      ))
    }
    <div class="property-detail-hero-overlay"></div>

    <div class="hero-foot">
      <div class="hero-title">
        {tag && <span class="hero-tag">{tag}</span>}
        <span class="hero-kicker">{d.location.region} · {category}</span>
        <span class="hero-name">{title}</span>
      </div>

      {
        gallery.length > 1 && (
          <div class="hero-gallery no-print">
            <div class="property-detail-gallery-controls">
              <button class="property-detail-nav" type="button" id="gal-prev" aria-label={ui.property.prevImage} aria-controls="gallery">
                <svg width="16" height="12" viewBox="0 0 16 12" fill="none" aria-hidden="true">
                  <path d="M15 6H2M6.5 1.5 2 6l4.5 4.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
              <p class="property-detail-gallery-count num" id="gal-count" role="status">
                01 / {String(gallery.length).padStart(2, '0')}
              </p>
              <button class="property-detail-nav" type="button" id="gal-next" aria-label={ui.property.nextImage} aria-controls="gallery">
                <svg width="16" height="12" viewBox="0 0 16 12" fill="none" aria-hidden="true">
                  <path d="M1 6h13M9.5 1.5 14 6l-4.5 4.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
            </div>
            <div class="gal-bar" aria-hidden="true">
              {gallery.map((_, i) => <span data-seg={i} data-on={i === 0 ? '' : undefined} />)}
            </div>
          </div>
        )
      }
    </div>
  </div>
  </div>

  {/* ── Body ── */}
  <div class="body">
    <div class="main">
      <Eyebrow space="12px">{d.location.region} · {category}</Eyebrow>
      <h1>{title}</h1>
      {subtitle && <p class="subtitle">{subtitle}</p>}

      <p class="location">
        {d.location.settlement}, {d.location.county}
        <a class="map-link no-print" href={mapUrl} target="_blank" rel="noopener">
          <svg width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M10 18s6-5.2 6-10a6 6 0 1 0-12 0c0 4.8 6 10 6 10Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
            <circle cx="10" cy="8" r="2.2" stroke="currentColor" stroke-width="1.6" />
          </svg>
          {x('OpenStreetMap-en', 'Op OpenStreetMap', 'On OpenStreetMap', 'Auf OpenStreetMap', 'Sur OpenStreetMap', 'En OpenStreetMap', 'W OpenStreetMap', 'Pe OpenStreetMap', 'Na OpenStreetMap', 'Su OpenStreetMap', 'No OpenStreetMap', 'Στο OpenStreetMap', 'Na OpenStreetMap', 'Na OpenStreetMap', 'På OpenStreetMap', 'På OpenStreetMap', 'På OpenStreetMap', 'OpenStreetMapissa', 'OpenStreetMapis', 'OpenStreetMap kartē', '„OpenStreetMap“ žemėlapyje')}
        </a>
      </p>

      <div class="price-row">
        <span class="price">{eur(d.price.eur, locale)}</span>
        <span class="price-huf">{huf(d.price.huf, locale)}</span>
        <span class="price-asof">
          {x('Árfolyam', 'Koers', 'Exchange rate', 'Wechselkurs', 'Taux de change', 'Tipo de cambio', 'Kurs wymiany', 'Curs de schimb', 'Výmenný kurz', 'Tasso di cambio', 'Taxa de câmbio', 'Συναλλαγματική ισοτιμία', 'Směnný kurz', 'Menjalni tečaj', 'Växelkurs', 'Valutakurs', 'Valutakurs', 'Valuuttakurssi', 'Vahetuskurss', 'Valūtas kurss', 'Valiutos kursas')}{colon} {formatDate(d.price.asOf, locale)}
        </span>
      </div>

      <dl class="specs">
        {
          specs.map((s) => (
            <div class="spec">
              <dd>{s.value}</dd>
              <dt>{s.label}</dt>
            </div>
          ))
        }
      </dl>

      <div class="ref-row">
        <span>{ui.property.reference} <strong>{d.ref}</strong></span>
        <button type="button" class="print-btn no-print" id="print-btn">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M4 6V1.75h8V6M4 12H2.25A1.25 1.25 0 0 1 1 10.75v-3.5A1.25 1.25 0 0 1 2.25 6h11.5A1.25 1.25 0 0 1 15 7.25v3.5A1.25 1.25 0 0 1 13.75 12H12M4 9.5h8v4.75H4z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
          </svg>
          {x('Nyomtatás', 'Afdrukken', 'Print', 'Drucken', 'Imprimer', 'Imprimir', 'Drukuj', 'Imprimare', 'Vytlačiť', 'Stampa', 'Imprimir', 'Εκτύπωση', 'Tisk', 'Natisni', 'Skriv ut', 'Udskriv', 'Skriv ut', 'Tulosta', 'Prindi', 'Drukāt', 'Spausdinti')}
        </button>
      </div>

      <div class="prose">
        <h2 class="sr-heading">{ui.property.description}</h2>
        {languageNote && <p class="lang-note">{languageNote}</p>}
        <p class="lead">{description}</p>
        <slot />
      </div>

      {
        d.features.length > 0 && (
          <section class="features">
            <Eyebrow space="14px">{ui.property.features}</Eyebrow>
            <ul>
              {d.features.map((f) => <li>{featureName(f)}</li>)}
            </ul>
          </section>
        )
      }

      {
        hasFacts && (
          <section class="features facts">
            <Eyebrow space="14px">{x('Részletek', 'Details', 'Details', 'Details', 'Détails', 'Detalles', 'Szczegóły', 'Detalii', 'Podrobnosti', 'Dettagli', 'Detalhes', 'Λεπτομέρειες', 'Podrobnosti', 'Podrobnosti', 'Detaljer', 'Detaljer', 'Detaljer', 'Tiedot', 'Üksikasjad', 'Informācija', 'Informacija')}</Eyebrow>
            {factRows.length > 0 && (
              <dl class="fact-list">
                {factRows.map((row) => (
                  <div>
                    <dt>{row.label}</dt>
                    <dd>{row.value}</dd>
                  </div>
                ))}
              </dl>
            )}
            {d.details.utilities.length > 0 && (
              <>
                <h3 class="fact-head">{detailLabel('utilities', locale)}</h3>
                <ul>{d.details.utilities.map((k) => <li>{utilityLabel(k, locale)}</li>)}</ul>
              </>
            )}
            {d.details.parking.length > 0 && (
              <>
                <h3 class="fact-head">{detailLabel('parking', locale)}</h3>
                <ul>{d.details.parking.map((k) => <li>{parkingLabel(k, locale)}</li>)}</ul>
              </>
            )}
          </section>
        )
      }

      {
        d.media.videoUrl && (
          <section class="video no-print">
            <Eyebrow space="14px">{ui.property.video}</Eyebrow>
            <VideoEmbed url={d.media.videoUrl} title={title} locale={locale} />
          </section>
        )
      }

      <div class="detail-map no-print">
        <Map mode="pin" lat={d.location.lat} lng={d.location.lng} precision={d.location.precision} locale={locale} id={`map-${d.ref}`} />
      </div>

      {/* FODEL's actual USP, as a data-driven block rather than a slogan. */}
      {
        sellerPhone && (
          <aside class="owner">
            <Eyebrow space="10px">{ui.property.ownerContact}</Eyebrow>
            <p class="owner-note">{ui.property.ownerContactNote}</p>
            {d.seller.name && <p class="owner-name">{d.seller.name}</p>}
            {d.seller.phone && (
              <p class="owner-phone">
                <a href={`tel:${dialled.ok ? dialled.e164 : d.seller.phone.replace(/\s/g, '')}`}>
                  <span class="owner-phone-icon" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 20 20" fill="none">
                      <path d="M6.2 2.5 7.9 6.4 5.9 7.8a10.6 10.6 0 0 0 6.3 6.3l1.4-2 3.9 1.7-.6 3a1.8 1.8 0 0 1-1.9 1.4C8.7 17.8 2.2 11.3 1.8 5a1.8 1.8 0 0 1 1.4-1.9l3-.6Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
                    </svg>
                  </span>
                  <span class="num">{dialled.ok ? dialled.display : d.seller.phone}</span>
                </a>
              </p>
            )}
            {d.seller.speaks.length > 0 && (
              <p class="owner-speaks">
                {x('Beszélt nyelvek', 'Spreekt', 'Speaks', 'Spricht', 'Langues parlées', 'Idiomas', 'Języki', 'Limbi vorbite', 'Hovorí', 'Parla', 'Fala', 'Μιλά', 'Mluví', 'Govori', 'Talar', 'Taler', 'Snakker', 'Puhuu', 'Räägib', 'Runā', 'Kalba')}{colon}{' '}
                {d.seller.speaks.map((s) => languageName(s,locale)).join(' · ')}
              </p>
            )}
          </aside>
        )
      }

      <aside class="guarantee">
        <Eyebrow space="8px">
          {x('FODEL Garancia', 'De FODEL-garantie', 'The FODEL guarantee', 'Die FODEL-Garantie', 'La garantie FODEL', 'La garantía FODEL', 'Gwarancja FODEL', 'Garanția FODEL', 'Záruka FODEL', 'La garanzia FODEL', 'A garantia FODEL', 'Η εγγύηση FODEL', 'Záruka FODEL', 'Jamstvo FODEL', 'FODEL-garantin', 'FODEL-garantien', 'FODEL-garantien', 'FODEL-takuu', 'FODELi garantii', 'FODEL garantija', 'FODEL garantija')}
        </Eyebrow>
        <p>
          {x(
