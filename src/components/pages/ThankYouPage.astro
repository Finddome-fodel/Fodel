---
/**
 * Confirmation page for submissions made without JavaScript, one component for
 * all nine languages (the route files are one-liners).
 *
 * noindex: it is a transactional endpoint, not content.
 */
import Base from '~/layouts/Base.astro';
import Eyebrow from '~/components/Eyebrow.astro';
import Button from '~/components/Button.astro';
import { UI, path, localizer, type Locale } from '~/i18n/ui';
import { getCompany } from '~/lib/runtime-config';
import { fillHours } from '~/lib/hours';
import { COMPANY, formatHours } from '~/config/company';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = UI[locale];
const x = localizer(locale);
const { hours } = await getCompany();
---

<Base
  locale={locale}
  title={x({ hu: 'Köszönjük a megkeresését', nl: 'Bedankt voor uw bericht', en: 'Thank you for your message', de: 'Vielen Dank für Ihre Nachricht', fr: 'Merci pour votre message', es: 'Gracias por su mensaje', pl: 'Dziękujemy za wiadomość', ro: 'Vă mulțumim pentru mesaj', sk: 'Ďakujeme za vašu správu', it: 'Grazie per il suo messaggio', pt: 'Obrigado pela sua mensagem', el: 'Ευχαριστούμε για το μήνυμά σας', cs: 'Děkujeme za vaši zprávu', sl: 'Hvala za vaše sporočilo', sv: 'Tack för ditt meddelande', da: 'Tak for din besked', no: 'Takk for meldingen din', fi: 'Kiitos viestistäsi', et: 'Aitäh teie sõnumi eest', lv: 'Paldies par jūsu ziņu', lt: 'Ačiū už jūsų žinutę', sr: 'Hvala na poruci', uk: 'Дякуємо за повідомлення', tr: 'Mesajınız için teşekkürler', he: 'תודה על פנייתכם', ar: 'شكرًا على رسالتك', ru: 'Спасибо за сообщение', zh: '感谢您的留言' })}
  description={x({ hu: 'Megkaptuk az üzenetét.', nl: 'Wij hebben uw bericht ontvangen.', en: 'We have received your message.', de: 'Wir haben Ihre Nachricht erhalten.', fr: 'Nous avons bien reçu votre message.', es: 'Hemos recibido su mensaje.', pl: 'Otrzymaliśmy Państwa wiadomość.', ro: 'Am primit mesajul dumneavoastră.', sk: 'Vašu správu sme prijali.', it: 'Abbiamo ricevuto il suo messaggio.', pt: 'Recebemos a sua mensagem.', el: 'Λάβαμε το μήνυμά σας.', cs: 'Vaši zprávu jsme přijali.', sl: 'Vaše sporočilo smo prejeli.', sv: 'Vi har tagit emot ditt meddelande.', da: 'Vi har modtaget din besked.', no: 'Vi har mottatt meldingen din.', fi: 'Olemme vastaanottaneet viestisi.', et: 'Oleme teie sõnumi kätte saanud.', lv: 'Esam saņēmuši jūsu ziņu.', lt: 'Jūsų žinutę gavome.', sr: 'Primili smo vašu poruku.', uk: 'Ми отримали ваше повідомлення.', tr: 'Mesajınızı aldık.', he: 'קיבלנו את ההודעה שלכם.', ar: 'تلقينا رسالتك.', ru: 'Мы получили ваше сообщение.', zh: '我们已收到您的留言。' })}
  noindex
>
  <section class="thanks">
    <span class="mark" aria-hidden="true">
      <svg width="24" height="24" viewBox="0 0 22 22" fill="none">
        <path d="M5 11.5l4 4 8-9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
    <Eyebrow center space="18px">{x({ hu: 'Elküldve', nl: 'Verzonden', en: 'Sent', de: 'Gesendet', fr: 'Envoyé', es: 'Enviado', pl: 'Wysłano', ro: 'Trimis', sk: 'Odoslané', it: 'Inviato', pt: 'Enviado', el: 'Εστάλη', cs: 'Odesláno', sl: 'Poslano', sv: 'Skickat', da: 'Sendt', no: 'Sendt', fi: 'Lähetetty', et: 'Saadetud', lv: 'Nosūtīts', lt: 'Išsiųsta', sr: 'Poslato', uk: 'Надіслано', tr: 'Gönderildi', he: 'נשלח', ar: 'تم الإرسال', ru: 'Отправлено', zh: '已发送' })}</Eyebrow>
    <h1>{ui.form.successTitle}</h1>
    <p class="body">{fillHours(ui.form.successBody, hours, locale)}</p>

    <p class="hours">{formatHours(locale, hours)}</p>
    <p class="phones">
      {COMPANY.phones.slice(0, 2).map((p) => <a href={p.href}>{p.display}</a>)}
    </p>

    <div class="actions">
      <Button variant="dark" href={path(locale, 'properties')}>{ui.cta.allProperties}</Button>
      <Button variant="outline" href={`/${locale}/`}>{ui.nav.home}</Button>
    </div>
  </section>
</Base>

<style>
  .thanks { max-width: 720px; margin: 64px auto var(--section-y); padding: clamp(40px, 6vw, 72px) clamp(24px, 5vw, 64px); text-align: center; border-radius: var(--r-2xl); background: var(--white); border: 1px solid rgba(16, 42, 67, 0.06); box-shadow: var(--shadow-float); }
  .mark { display: inline-grid; place-items: center; width: 64px; height: 64px; margin-bottom: 28px; border-radius: 50%; background: var(--ink); color: var(--cream); animation: fx-fade-up 1s var(--ease-out) 0.2s both; }
  h1 { font-family: var(--serif); font-weight: var(--fw-hero); font-size: clamp(34px, 4.4vw, 58px); letter-spacing: var(--ls-display); line-height: 1.05; color: var(--ink); margin-bottom: 24px; }
  .body { font-size: var(--fs-body-lg); line-height: var(--lh-lead); color: var(--taupe); margin-bottom: 32px; }
  .hours { font-size: var(--fs-small); color: var(--taupe); }
  .phones { display: flex; gap: 20px; justify-content: center; flex-wrap: wrap; margin: 8px 0 40px; }
  .phones a { font-family: var(--serif); font-size: var(--fs-lead); color: var(--ink); text-decoration: underline; text-underline-offset: 4px; }
  .actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  @media (max-width: 768px) {
    .thanks { margin: 24px var(--slab-x) var(--section-y-mob); padding: 44px 20px; border-radius: var(--r-xl); }
    .actions { flex-direction: column; }
  }
</style>
