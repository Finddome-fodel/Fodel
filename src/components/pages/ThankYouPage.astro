---
/**
 * Confirmation page for submissions made without JavaScript, one component for
 * all nine languages (the route files are one-liners).
 *
 * noindex: it is a transactional endpoint, not content.
 */
import Base from '~/layouts/Base.astro';
import Eyebrow from '~/components/Eyebrow.astro';
import Button from '~/components/Button.astro';
import { UI, path, localizer, type Locale } from '~/i18n/ui';
import { getCompany } from '~/lib/runtime-config';
import { fillHours } from '~/lib/hours';
import { COMPANY, formatHours } from '~/config/company';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = UI[locale];
const x = localizer(locale);
const { hours } = await getCompany();
---

<Base
  locale={locale}
  title={x('Köszönjük a megkeresését', 'Bedankt voor uw bericht', 'Thank you for your message', 'Vielen Dank für Ihre Nachricht', 'Merci pour votre message', 'Gracias por su mensaje', 'Dziękujemy za wiadomość', 'Vă mulțumim pentru mesaj', 'Ďakujeme za vašu správu')}
  description={x('Megkaptuk az üzenetét.', 'Wij hebben uw bericht ontvangen.', 'We have received your message.', 'Wir haben Ihre Nachricht erhalten.', 'Nous avons bien reçu votre message.', 'Hemos recibido su mensaje.', 'Otrzymaliśmy Państwa wiadomość.', 'Am primit mesajul dumneavoastră.', 'Vašu správu sme prijali.')}
  noindex
>
  <section class="thanks">
    <span class="mark" aria-hidden="true">
      <svg width="24" height="24" viewBox="0 0 22 22" fill="none">
        <path d="M5 11.5l4 4 8-9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
    <Eyebrow center space="18px">{x('Elküldve', 'Verzonden', 'Sent', 'Gesendet', 'Envoyé', 'Enviado', 'Wysłano', 'Trimis', 'Odoslané')}</Eyebrow>
    <h1>{ui.form.successTitle}</h1>
    <p class="body">{fillHours(ui.form.successBody, hours, locale)}</p>

    <p class="hours">{formatHours(locale)}</p>
    <p class="phones">
      {COMPANY.phones.slice(0, 2).map((p) => <a href={p.href}>{p.display}</a>)}
    </p>

    <div class="actions">
      <Button variant="dark" href={path(locale, 'properties')}>{ui.cta.allProperties}</Button>
      <Button variant="outline" href={`/${locale}/`}>{ui.nav.home}</Button>
    </div>
  </section>
</Base>

<style>
  .thanks { max-width: 720px; margin: 64px auto var(--section-y); padding: clamp(40px, 6vw, 72px) clamp(24px, 5vw, 64px); text-align: center; border-radius: var(--r-2xl); background: var(--white); border: 1px solid rgba(16, 42, 67, 0.06); box-shadow: var(--shadow-float); }
  .mark { display: inline-grid; place-items: center; width: 64px; height: 64px; margin-bottom: 28px; border-radius: 50%; background: var(--ink); color: var(--cream); animation: fx-fade-up 1s var(--ease-out) 0.2s both; }
  h1 { font-family: var(--serif); font-weight: var(--fw-hero); font-size: clamp(34px, 4.4vw, 58px); letter-spacing: var(--ls-display); line-height: 1.05; color: var(--ink); margin-bottom: 24px; }
  .body { font-size: var(--fs-body-lg); line-height: var(--lh-lead); color: var(--taupe); margin-bottom: 32px; }
  .hours { font-size: var(--fs-small); color: var(--taupe); }
  .phones { display: flex; gap: 20px; justify-content: center; flex-wrap: wrap; margin: 8px 0 40px; }
  .phones a { font-family: var(--serif); font-size: var(--fs-lead); color: var(--ink); text-decoration: underline; text-underline-offset: 4px; }
  .actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  @media (max-width: 768px) {
    .thanks { margin: 24px var(--slab-x) var(--section-y-mob); padding: 44px 20px; border-radius: var(--r-xl); }
    .actions { flex-direction: column; }
  }
</style>
