---

<Base
  locale={locale}
  title={t.metaTitle}
  description={t.metaDescription}
  alternates={alternatesFor('blog')}
>
  <PageHeader eyebrow={t.eyebrow} title={t.title} titleEm={t.titleEm} body={t.intro} compact />

  <div class="blog">
    {cases.length > 0 && (
      <nav class="kinds" aria-label={t.kinds}>
        <a href={path(locale, 'blog')} aria-current={!showCases ? 'page' : undefined}>{t.articles}</a>
        <a href={`${path(locale, 'blog')}?type=case-study`} aria-current={showCases ? 'page' : undefined}>
          {t.cases}
        </a>
      </nav>
    )}
    {posts.length === 0 && <p class="empty">{t.empty}</p>}

    {
      lead && (
        <article class="lead reveal">
          <a href={postPathIn(locale, lead.slug)} data-bg="dark" class:list={[{ 'has-media': !!lead.cover_url }]}>
            {lead.cover_url && (
              <div class="lead-media">
                <img src={lead.cover_url} alt={lead.cover_alt ?? ''} loading="eager" width="900" height="600" />
              </div>
            )}
            <div class="lead-copy">
              <span class="pill pill-dark">{lead.category}</span>
              <h2>{lead.title}</h2>
              <p class="excerpt">{lead.excerpt}</p>
              {noteOf(-1) && <p class="note">{noteOf(-1)}</p>}
              <div class="lead-foot">
                <p class="meta">
                  {lead.published_at && (
                    <time datetime={lead.published_at.toISOString()}>
                      {formatDate(lead.published_at, locale)}
                    </time>
                  )}
                  <span aria-hidden="true">·</span>
                  <span>{minutes(lead.reading_minutes)}</span>
                </p>
                <span class="more">
                  <span>{ui.cta.readMore}</span>
                  <ArrowChip size={44} />
                </span>
              </div>
            </div>
          </a>
        </article>
      )
    }

    {
      rest.length > 0 && (
        <div class="grid">
          {rest.map((post, i) => (
            <article class="card reveal" style={`--reveal-delay:${(i % 3) * 0.08}s`}>
              <a href={postPathIn(locale, post.slug)}>
                {post.cover_url && (
                  <div class="card-media">
                    <img src={post.cover_url} alt={post.cover_alt ?? ''} loading="lazy" width="700" height="525" />
                  </div>
                )}
                <div class="card-copy">
                  <div class="card-top">
                    <span class="pill">{post.category}</span>
                    <ArrowChip size={40} class="card-chip" />
                  </div>
                  <h3>{post.title}</h3>
                  <p class="excerpt">{post.excerpt}</p>
                  {noteOf(i) && <p class="note">{noteOf(i)}</p>}
                  <p class="meta">
                    {post.published_at && (
                      <time datetime={post.published_at.toISOString()}>
                        {formatDate(post.published_at, locale)}
                      </time>
                    )}
                    <span aria-hidden="true">·</span>
