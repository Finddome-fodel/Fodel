---
/**
 * Editorial index. FODEL publish long-form pieces on why Dutch buyers move to
 * Hungary; that content is a genuine organic-search asset for the Dutch market.
 *
 * Supabase-backed since FODEL 1.2 (previously two Markdown files) — see
 * src/lib/blog.ts. `cover_url`/`og_image_url` are stored as plain public
 * Storage URLs, not astro:assets ImageMetadata, so this uses a plain <img>
 * rather than <Image> for post covers; the images already go through the
 * sharp pipeline at upload time (src/lib/media.ts), just not through Astro's
 * build-time optimiser.
 *
 * 2.0: every article is a rounded card that reads as finished with or
 * without a cover photograph — the newest one set large on ink, the rest on
 * white — and each ends in the arrow chip that says it opens.
 */
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/PageHeader.astro';
import Eyebrow from '~/components/Eyebrow.astro';
import ArrowChip from '~/components/ArrowChip.astro';
import { UI, path, localizer, type Locale } from '~/i18n/ui';
import { sourceNote } from '~/i18n/fallback';
import { alternatesFor } from '~/lib/page';
import { formatDate } from '~/lib/format';
import { localizedPosts, postPathIn } from '~/lib/blog';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = UI[locale];
const x = localizer(locale);

// Articles and case studies are listed separately (brief §5): the default view
// is articles, `?type=case-study` the case studies. The switch only appears
// once a case study exists in this language.
const showCases = Astro.url.searchParams.get('type') === 'case-study';
const [articles, cases] = await Promise.all([
  localizedPosts(locale, { kind: 'article' }),
  localizedPosts(locale, { kind: 'case_study' }),
]);
const posts = showCases ? cases : articles;

const [leadEntry, ...restEntries] = posts;
const lead = leadEntry?.post;
const rest = restEntries.map((entry) => entry.post);
const noteOf = (index: number) => {
  const entry = index < 0 ? leadEntry : restEntries[index];
  return entry ? sourceNote(locale, entry.from, 'article') : null;
};
const minutes = (n: number) => x({ hu: `${n} perc olvasás`, nl: `${n} min. lezen`, en: `${n} min read`, de: `${n} Min. Lesezeit`, fr: `${n} min de lecture`, es: `${n} min de lectura`, pl: `${n} min czytania`, ro: `${n} min de lectură`, sk: `${n} min čítania`, it: `${n} min di lettura`, pt: `${n} min de leitura`, el: `${n} λεπτά ανάγνωσης`, cs: `${n} min čtení`, sl: `${n} min branja`, sv: `${n} min läsning`, da: `${n} min. læsning`, no: `${n} min lesing`, fi: `Lukuaika ${n} min`, et: `Lugemisaeg ${n} min`, lv: `Lasīšanas laiks ${n} min`, lt: `Skaitymo laikas ${n} min.`, sr: `${n} min čitanja`, uk: `${n} хв читання`, tr: `${n} dk okuma`, he: `${n} דק׳ קריאה`, ar: `قراءة في ${n} د`, ru: `${n} мин чтения`, zh: `阅读约 ${n} 分钟` });

