    'Ką verta žinoti apie Vengrijos nekilnojamojo turto rinką ir pirkėjus iš Vakarų Europos.'
  ),
  empty: x(
    'Hamarosan új cikkekkel jelentkezünk.',
    'Binnenkort verschijnen hier nieuwe artikelen.',
    'New articles are coming soon.',
    'Bald erscheinen hier neue Artikel.',
    'De nouveaux articles arrivent bientôt.',
    'Pronto publicaremos nuevos artículos.',
    'Wkrótce pojawią się nowe artykuły.',
    'În curând vor apărea articole noi.',
    'Nové články čoskoro pribudnú.',
    'Presto nuovi articoli.',
    'Em breve, novos artigos.',
    'Νέα άρθρα έρχονται σύντομα.',
    'Nové články brzy přibudou.',
    'Novi članki bodo kmalu na voljo.',
    'Nya artiklar kommer snart.',
    'Nye artikler er på vej.',
    'Nye artikler kommer snart.',
    'Uusia artikkeleita on tulossa pian.',
    'Uued artiklid tulevad peagi.',
    'Drīzumā būs jauni raksti.',
    'Netrukus pasirodys naujų straipsnių.'
  ),
  kinds: x('Tartalomtípus', 'Soort inhoud', 'Content type', 'Art des Inhalts', 'Type de contenu', 'Tipo de contenido', 'Rodzaj treści', 'Tip de conținut', 'Typ obsahu', 'Tipo di contenuto', 'Tipo de conteúdo', 'Είδος περιεχομένου', 'Typ obsahu', 'Vrsta vsebine', 'Innehållstyp', 'Indholdstype', 'Innholdstype', 'Sisältötyyppi', 'Sisu tüüp', 'Satura veids', 'Turinio tipas'),
  articles: x('Cikkek', 'Artikelen', 'Articles', 'Artikel', 'Articles', 'Artículos', 'Artykuły', 'Articole', 'Články', 'Articoli', 'Artigos', 'Άρθρα', 'Články', 'Članki', 'Artiklar', 'Artikler', 'Artikler', 'Artikkelit', 'Artiklid', 'Raksti', 'Straipsniai'),
  cases: x('Esettanulmányok', 'Casestudies', 'Case studies', 'Fallstudien', 'Études de cas', 'Casos prácticos', 'Studia przypadków', 'Studii de caz', 'Prípadové štúdie', 'Casi di studio', 'Estudos de caso', 'Μελέτες περίπτωσης', 'Případové studie', 'Študije primerov', 'Fallstudier', 'Casestudier', 'Casestudier', 'Tapaustutkimukset', 'Juhtumiuuringud', 'Gadījumu izpētes', 'Atvejų analizės'),
};
---

<Base
  locale={locale}
  title={t.metaTitle}
  description={t.metaDescription}
  alternates={alternatesFor('blog')}
>
  <PageHeader eyebrow={t.eyebrow} title={t.title} titleEm={t.titleEm} body={t.intro} compact />

  <div class="blog">
    {cases.length > 0 && (
      <nav class="kinds" aria-label={t.kinds}>
        <a href={path(locale, 'blog')} aria-current={!showCases ? 'page' : undefined}>{t.articles}</a>
        <a href={`${path(locale, 'blog')}?type=case-study`} aria-current={showCases ? 'page' : undefined}>
          {t.cases}
        </a>
      </nav>
    )}
    {posts.length === 0 && <p class="empty">{t.empty}</p>}

    {
      lead && (
        <article class="lead reveal">
          <a href={postPathIn(locale, lead.slug)} data-bg="dark" class:list={[{ 'has-media': !!lead.cover_url }]}>
            {lead.cover_url && (
              <div class="lead-media">
                <img src={lead.cover_url} alt={lead.cover_alt ?? ''} loading="eager" width="900" height="600" />
              </div>
            )}
            <div class="lead-copy">
              <span class="pill pill-dark">{lead.category}</span>
              <h2>{lead.title}</h2>
              <p class="excerpt">{lead.excerpt}</p>
              {noteOf(-1) && <p class="note">{noteOf(-1)}</p>}
              <div class="lead-foot">
                <p class="meta">
                  {lead.published_at && (
                    <time datetime={lead.published_at.toISOString()}>
                      {formatDate(lead.published_at, locale)}
                    </time>
                  )}
                  <span aria-hidden="true">·</span>
                  <span>{minutes(lead.reading_minutes)}</span>
                </p>
                <span class="more">
                  <span>{ui.cta.readMore}</span>
                  <ArrowChip size={44} />
                </span>
              </div>
            </div>
          </a>
        </article>
      )
    }

    {
      rest.length > 0 && (
        <div class="grid">
          {rest.map((post, i) => (
            <article class="card reveal" style={`--reveal-delay:${(i % 3) * 0.08}s`}>
              <a href={postPathIn(locale, post.slug)}>
                {post.cover_url && (
                  <div class="card-media">
                    <img src={post.cover_url} alt={post.cover_alt ?? ''} loading="lazy" width="700" height="525" />
                  </div>
                )}
                <div class="card-copy">
                  <div class="card-top">
                    <span class="pill">{post.category}</span>
                    <ArrowChip size={40} class="card-chip" />
                  </div>
                  <h3>{post.title}</h3>
                  <p class="excerpt">{post.excerpt}</p>
                  {noteOf(i) && <p class="note">{noteOf(i)}</p>}
                  <p class="meta">
                    {post.published_at && (
                      <time datetime={post.published_at.toISOString()}>
                        {formatDate(post.published_at, locale)}
                      </time>
                    )}
                    <span aria-hidden="true">·</span>
                    <span>{post.reading_minutes} {x('perc', 'min.', 'min', 'Min.', 'min', 'min', 'min', 'min', 'min', 'min', 'min', 'λεπτά', 'min', 'min', 'min', 'min', 'min', 'min', 'min', 'min', 'min')}</span>
                  </p>
                </div>
              </a>
            </article>
          ))}
        </div>
      )
    }
  </div>
</Base>

<style>
  .blog {
    padding: 48px var(--pad-x) var(--section-y);
  }
  .kinds {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 32px;
  }
  .kinds a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 20px;
    border-radius: var(--r-pill);
    border: 1px solid rgba(16, 42, 67, 0.16);
    font-size: 15px;
    font-weight: var(--fw-medium);
    color: var(--ink);
    transition: background-color 0.3s var(--ease-out), color 0.3s var(--ease-out);
  }
  .kinds a:hover {
    border-color: var(--ink);
  }
  .kinds a[aria-current='page'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--cream);
  }
  /* "Article in Dutch": quiet, one line, never louder than the excerpt. */
  .note {
    font-size: 13px;
    font-weight: var(--fw-medium);
    opacity: 0.72;
  }
  .empty {
    font-size: var(--fs-body);
    color: var(--taupe);
    padding: 40px 0;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    height: 30px;
    padding: 0 13px;
    border-radius: var(--r-pill);
    background: rgba(16, 42, 67, 0.07);
    font-size: 13px;
    font-weight: var(--fw-medium);
    color: var(--ink);
  }
  .pill-dark {
    background: rgba(244, 244, 242, 0.12);
    color: var(--cream);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 13.5px;
    color: var(--taupe);
  }

  /* ── The newest article, on ink ── */
  .lead {
    margin-bottom: 16px;
  }
  .lead a {
    display: grid;
    grid-template-columns: 1fr;
    overflow: hidden;
    border-radius: var(--r-2xl);
    background:
      radial-gradient(110% 90% at 100% 0%, var(--ink-soft) 0%, transparent 60%),
      var(--ink);
    color: var(--cream);
    --chip-bg: var(--cream);
    --chip-fg: var(--ink);
    transition: box-shadow 0.6s var(--ease-out);
  }
  .lead a.has-media {
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
  }
  .lead a:hover {
    box-shadow: var(--shadow-float);
  }
  .lead-media {
    position: relative;
    min-height: 420px;
    overflow: hidden;
  }
  .lead-media :global(img),
  .card-media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 1.4s var(--ease-out);
  }
  .lead a:hover .lead-media :global(img),
  .card a:hover .card-media :global(img) {
    transform: scale(1.04);
  }
  .lead-copy {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: clamp(36px, 5vw, 72px);
  }
  .lead h2 {
    max-width: 18ch;
    font-family: var(--serif);
    font-weight: var(--fw-hero);
    font-size: clamp(32px, 4vw, 60px);
    letter-spacing: var(--ls-display);
    line-height: 1.04;
    color: var(--cream);
  }
  .lead .excerpt {
    max-width: 52ch;
    font-size: var(--fs-body-lg);
    line-height: 1.6;
    color: var(--on-dark-body);
  }
  .lead-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px 32px;
    margin-top: 20px;
    padding-top: 24px;
    border-top: 1px solid var(--on-dark-rule);
  }
  .lead .meta {
    color: var(--on-dark-muted);
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    font-size: 1rem;
    font-weight: var(--fw-medium);
    color: var(--cream);
  }

  /* ── The rest, on white ── */
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .card a {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: var(--r-xl);
    background: var(--white);
    border: 1px solid rgba(16, 42, 67, 0.07);
    --chip-bg: rgba(16, 42, 67, 0.07);
    --chip-fg: var(--ink);
    transition:
      transform 0.6s var(--ease-out),
      box-shadow 0.6s var(--ease-out);
  }
  .card a:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    --chip-bg: var(--ink);
    --chip-fg: var(--cream);
  }
  .card-media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--mist);
  }
  .card-copy {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 12px;
    padding: 24px 26px 26px;
  }
  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }
  .card h3 {
    font-family: var(--serif);
    font-weight: var(--fw-medium);
    font-size: clamp(21px, 1.7vw, 25px);
    letter-spacing: -0.015em;
    line-height: 1.2;
    color: var(--ink);
  }
  .card .excerpt {
    font-size: var(--fs-small);
    line-height: 1.6;
    color: var(--taupe);
  }
  .card .meta {
    margin-top: auto;
    padding-top: 12px;
  }

  @media (max-width: 1100px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 900px) {
    .blog {
      padding: 36px var(--pad-x-mob) var(--section-y-mob);
