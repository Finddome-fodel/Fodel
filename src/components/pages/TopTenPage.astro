---
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/PageHeader.astro';
import PropertyCard from '~/components/PropertyCard.astro';
import { localizer, type Locale } from '~/i18n/ui';
import { alternatesFor } from '~/lib/page';
import { editorsPick } from '~/lib/properties';

interface Props { locale: Locale }
const { locale } = Astro.props;
const x = localizer(locale);
const properties = await editorsPick(10);
// The heading stays the brand term "FODEL Top 10" in both locales; the
// <title>/meta title need their own locale-distinct text, or the two pages
// render an identical <title> (verify-ssg's duplicate-title check catches
// this — Base.astro leaves a title containing "FODEL" untouched, so a bare
// "FODEL Top 10" on both locales never gets a distinguishing suffix).
const heading = 'FODEL Top 10';
const metaTitle = x('FODEL Top 10: szerkesztőségi ajánlás', 'FODEL Top 10: aanbevolen door de redactie', 'FODEL Top 10: the editors’ picks', 'FODEL Top 10: die Empfehlungen der Redaktion', 'FODEL Top 10\u00a0: la sélection de la rédaction', 'FODEL Top 10: la selección de la redacción', 'FODEL Top 10: wybór redakcji', 'FODEL Top 10: alegerea redacției', 'FODEL Top 10: výber redakcie', 'FODEL Top 10: la selezione della redazione', 'FODEL Top 10: a seleção da redação', 'FODEL Top 10: οι επιλογές της συντακτικής ομάδας', 'FODEL Top 10: výběr redakce', 'FODEL Top 10: izbor uredništva', 'FODEL Top 10: redaktionens val', 'FODEL Top 10: redaktionens udvalg', 'FODEL Top 10: redaksjonens utvalg', 'FODEL Top 10: toimituksen valinnat', 'FODEL Top 10: toimetuse valik', 'FODEL Top 10: redakcijas izvēle', 'FODEL Top 10: redakcijos pasirinkimas');
const description = x(
  'A FODEL szerkesztői által ajánlott tíz ingatlan, függetlenül a fizetős kiemelésektől.',
  'Tien woningen aanbevolen door de redactie van FODEL, los van betaalde uitlichting.',
  'Ten properties recommended by FODEL’s editors, independent of paid highlighting.',
  'Zehn Immobilien, die die Redaktion von FODEL empfiehlt, unabhängig von bezahlter Hervorhebung.',
  'Dix biens recommandés par la rédaction de FODEL, indépendamment des mises en avant payantes.', 'Diez inmuebles recomendados por la redacción de FODEL, al margen de los destacados de pago.', 'Dziesięć nieruchomości polecanych przez redakcję FODEL, niezależnie od płatnych wyróżnień.', 'Zece proprietăți recomandate de redacția FODEL, independent de promovările plătite.', 'Desať nehnuteľností, ktoré odporúča redakcia FODEL, nezávisle od platených zvýraznení.', 'Dieci immobili consigliati dalla redazione di FODEL, indipendentemente dalle evidenze a pagamento.', 'Dez imóveis recomendados pela redação da FODEL, independentemente dos destaques pagos.', 'Δέκα ακίνητα που προτείνει η συντακτική ομάδα της FODEL, ανεξάρτητα από τις επί πληρωμή προβολές.', 'Deset nemovitostí doporučených redakcí FODEL, nezávisle na placených zvýrazněních.', 'Deset nepremičnin, ki jih priporoča uredništvo FODEL, ne glede na plačljive izpostavitve.', 'Tio objekt som FODELs redaktion rekommenderar, oberoende av betald exponering.', 'Ti ejendomme anbefalet af FODELs redaktion, uafhængigt af betalte fremhævelser.', 'Ti eiendommer anbefalt av FODELs redaksjon, uavhengig av betalt fremheving.', 'Kymmenen kohdetta, joita FODELin toimitus suosittelee, riippumatta maksullisista nostoista.', 'Kümme kinnisvaraobjekti, mida FODELi toimetus soovitab, sõltumata tasulistest esiletõstmistest.', 'Desmit īpašumi, ko iesaka FODEL redakcija, neatkarīgi no maksas izcēlumiem.', 'Dešimt objektų, kuriuos rekomenduoja FODEL redakcija, nepriklausomai nuo mokamo išskyrimo.'
);
---
<Base locale={locale} title={metaTitle} description={description} alternates={alternatesFor('top10')}>
  <PageHeader eyebrow="FODEL" title={heading} body={description} compact />
  <section class="grid">
    {properties.map((property, index) => <PropertyCard property={property} locale={locale} rank={index + 1} ratio="4 / 5" />)}
    {properties.length === 0 && <p class="empty">{x('A válogatás hamarosan érkezik.', 'De selectie volgt binnenkort.', 'The selection is coming soon.', 'Die Auswahl folgt in Kürze.', 'La sélection arrive bientôt.', 'La selección llegará pronto.', 'Wybór pojawi się wkrótce.', 'Selecția va fi disponibilă în curând.', 'Výber bude čoskoro k dispozícii.', 'La selezione arriverà presto.', 'A seleção chegará em breve.', 'Η επιλογή έρχεται σύντομα.', 'Výběr bude brzy k dispozici.', 'Izbor bo kmalu na voljo.', 'Urvalet kommer snart.', 'Udvalget kommer snart.', 'Utvalget kommer snart.', 'Valikoima julkaistaan pian.', 'Valik ilmub peagi.', 'Izlase drīzumā būs pieejama.', 'Atranka netrukus bus paskelbta.')}</p>}
  </section>
</Base>
<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 56px 28px;
    padding: 56px var(--pad-x) var(--section-y);
  }
  .empty {
    font-size: var(--fs-body);
    color: var(--taupe);
  }
  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 700px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 48px;
      padding: 32px var(--pad-x-mob) var(--section-y-mob);
    }
  }
</style>
