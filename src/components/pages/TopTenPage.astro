---
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/PageHeader.astro';
import PropertyCard from '~/components/PropertyCard.astro';
import { localizer, type Locale } from '~/i18n/ui';
import { alternatesFor } from '~/lib/page';
import { editorsPick } from '~/lib/properties';

interface Props { locale: Locale }
const { locale } = Astro.props;
const x = localizer(locale);
const properties = await editorsPick(10);
// The heading stays the brand term "FODEL Top 10" in both locales; the
// <title>/meta title need their own locale-distinct text, or the two pages
// render an identical <title> (verify-ssg's duplicate-title check catches
// this — Base.astro leaves a title containing "FODEL" untouched, so a bare
// "FODEL Top 10" on both locales never gets a distinguishing suffix).
const heading = 'FODEL Top 10';
const metaTitle = x({ hu: 'FODEL Top 10: szerkesztőségi ajánlás', nl: 'FODEL Top 10: aanbevolen door de redactie', en: 'FODEL Top 10: the editors’ picks', de: 'FODEL Top 10: die Empfehlungen der Redaktion', fr: 'FODEL Top 10\u00a0: la sélection de la rédaction', es: 'FODEL Top 10: la selección de la redacción', pl: 'FODEL Top 10: wybór redakcji', ro: 'FODEL Top 10: alegerea redacției', sk: 'FODEL Top 10: výber redakcie', it: 'FODEL Top 10: la selezione della redazione', pt: 'FODEL Top 10: a seleção da redação', el: 'FODEL Top 10: οι επιλογές της συντακτικής ομάδας', cs: 'FODEL Top 10: výběr redakce', sl: 'FODEL Top 10: izbor uredništva', sv: 'FODEL Top 10: redaktionens val', da: 'FODEL Top 10: redaktionens udvalg', no: 'FODEL Top 10: redaksjonens utvalg', fi: 'FODEL Top 10: toimituksen valinnat', et: 'FODEL Top 10: toimetuse valik', lv: 'FODEL Top 10: redakcijas izvēle', lt: 'FODEL Top 10: redakcijos pasirinkimas', sr: 'FODEL Top 10: izbor urednika', uk: 'FODEL Top 10: вибір редакції', tr: 'FODEL Top 10: editörlerin seçimi', he: 'FODEL Top 10: בחירת העורכים', ar: 'FODEL Top 10: اختيارات المحررين', ru: 'FODEL Top 10: выбор редакции', zh: 'FODEL Top 10：编辑精选' });
const description = x({
  hu: 'A FODEL szerkesztői által ajánlott tíz ingatlan, függetlenül a fizetős kiemelésektől.',
  nl: 'Tien woningen aanbevolen door de redactie van FODEL, los van betaalde uitlichting.',
  en: 'Ten properties recommended by FODEL’s editors, independent of paid highlighting.',
  de: 'Zehn Immobilien, die die Redaktion von FODEL empfiehlt, unabhängig von bezahlter Hervorhebung.',
  fr: 'Dix biens recommandés par la rédaction de FODEL, indépendamment des mises en avant payantes.',
  es: 'Diez inmuebles recomendados por la redacción de FODEL, al margen de los destacados de pago.',
  pl: 'Dziesięć nieruchomości polecanych przez redakcję FODEL, niezależnie od płatnych wyróżnień.',
  ro: 'Zece proprietăți recomandate de redacția FODEL, independent de promovările plătite.',
  sk: 'Desať nehnuteľností, ktoré odporúča redakcia FODEL, nezávisle od platených zvýraznení.',
  it: 'Dieci immobili consigliati dalla redazione di FODEL, indipendentemente dalle evidenze a pagamento.',
  pt: 'Dez imóveis recomendados pela redação da FODEL, independentemente dos destaques pagos.',
  el: 'Δέκα ακίνητα που προτείνει η συντακτική ομάδα της FODEL, ανεξάρτητα από τις επί πληρωμή προβολές.',
  cs: 'Deset nemovitostí doporučených redakcí FODEL, nezávisle na placených zvýrazněních.',
  sl: 'Deset nepremičnin, ki jih priporoča uredništvo FODEL, ne glede na plačljive izpostavitve.',
  sv: 'Tio objekt som FODELs redaktion rekommenderar, oberoende av betald exponering.',
  da: 'Ti ejendomme anbefalet af FODELs redaktion, uafhængigt af betalte fremhævelser.',
  no: 'Ti eiendommer anbefalt av FODELs redaksjon, uavhengig av betalt fremheving.',
  fi: 'Kymmenen kohdetta, joita FODELin toimitus suosittelee, riippumatta maksullisista nostoista.',
  et: 'Kümme kinnisvaraobjekti, mida FODELi toimetus soovitab, sõltumata tasulistest esiletõstmistest.',
  lv: 'Desmit īpašumi, ko iesaka FODEL redakcija, neatkarīgi no maksas izcēlumiem.',
  lt: 'Dešimt objektų, kuriuos rekomenduoja FODEL redakcija, nepriklausomai nuo mokamo išskyrimo.',
  sr: 'Deset nekretnina koje preporučuju urednici FODEL-a, nezavisno od plaćenog isticanja.',
  uk: 'Десять об’єктів нерухомості, які рекомендує редакція FODEL, незалежно від платного виділення.',
  tr: 'FODEL editörlerinin, ücretli öne çıkarmadan bağımsız olarak önerdiği on mülk.',
  he: 'עשרה נכסים שעורכי FODEL ממליצים עליהם, ללא קשר להבלטה בתשלום.',
  ar: 'عشرة عقارات يوصي بها محررو FODEL، بصرف النظر عن الإبراز المدفوع.',
  ru: 'Десять объектов недвижимости, которые рекомендует редакция FODEL, независимо от платного выделения.',
  zh: '由 FODEL 编辑推荐的十套房产，与付费推广无关。',
});
---
<Base locale={locale} title={metaTitle} description={description} alternates={alternatesFor('top10')}>
  <PageHeader eyebrow="FODEL" title={heading} body={description} compact />
  <section class="grid">
    {properties.map((property, index) => <PropertyCard property={property} locale={locale} rank={index + 1} ratio="4 / 5" />)}
    {properties.length === 0 && <p class="empty">{x({ hu: 'A válogatás hamarosan érkezik.', nl: 'De selectie volgt binnenkort.', en: 'The selection is coming soon.', de: 'Die Auswahl folgt in Kürze.', fr: 'La sélection arrive bientôt.', es: 'La selección llegará pronto.', pl: 'Wybór pojawi się wkrótce.', ro: 'Selecția va fi disponibilă în curând.', sk: 'Výber bude čoskoro k dispozícii.', it: 'La selezione arriverà presto.', pt: 'A seleção chegará em breve.', el: 'Η επιλογή έρχεται σύντομα.', cs: 'Výběr bude brzy k dispozici.', sl: 'Izbor bo kmalu na voljo.', sv: 'Urvalet kommer snart.', da: 'Udvalget kommer snart.', no: 'Utvalget kommer snart.', fi: 'Valikoima julkaistaan pian.', et: 'Valik ilmub peagi.', lv: 'Izlase drīzumā būs pieejama.', lt: 'Atranka netrukus bus paskelbta.', sr: 'Izbor uskoro stiže.', uk: 'Добірка незабаром з’явиться.', tr: 'Seçki yakında burada.', he: 'המבחר יעלה בקרוב.', ar: 'المختارات قريبًا.', ru: 'Подборка скоро появится.', zh: '精选内容即将推出。' })}</p>}
  </section>
</Base>
<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 56px 28px;
    padding: 56px var(--pad-x) var(--section-y);
  }
  .empty {
    font-size: var(--fs-body);
    color: var(--taupe);
  }
  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 700px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 48px;
      padding: 32px var(--pad-x-mob) var(--section-y-mob);
    }
  }
</style>
