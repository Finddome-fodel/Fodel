const t = copies[locale];
---

<Base
  locale={locale}
  title={t.metaTitle}
  description={t.metaDescription}
  alternates={alternatesFor('sold')}
  noindex={sold.length === 0}
>
  <PageHeader eyebrow={t.eyebrow} title={t.title} titleEm={t.titleEm} body={t.intro} compact />

  <div class="sold">
    {
      sold.length > 0 ? (
        <div class="grid">
          {sold.map((p) => <PropertyCard property={p} locale={locale} />)}
        </div>
      ) : (
        <div class="empty">
          <span class="empty-dot" aria-hidden="true"></span>
          <p class="empty-title">{t.empty}</p>
          <p class="empty-hint">{t.emptyHint}</p>
          <Button variant="dark" href={path(locale, 'properties')}>{ui.cta.allProperties}</Button>
        </div>
      )
    }
  </div>
</Base>

<style>
  .sold {
    padding: 56px var(--pad-x) var(--section-y);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 56px 28px;
  }
  .empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 72px 24px 88px;
    border-radius: var(--r-2xl);
    background: var(--white);
    border: 1px solid rgba(16, 42, 67, 0.06);
  }
  .empty-dot {
    width: 10px;
    height: 10px;
    margin-bottom: 28px;
    border-radius: 50%;
    background: var(--ink);
  }
  .empty-title {
    font-family: var(--serif);
    font-weight: var(--fw-medium);
    font-size: clamp(22px, 2.2vw, 30px);
    letter-spacing: -0.015em;
    color: var(--ink);
    margin-bottom: 10px;
  }
  .empty-hint {
    max-width: 48ch;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--taupe);
    margin-bottom: 32px;
  }
  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 700px) {
    .sold {
      padding: 32px var(--pad-x-mob) var(--section-y-mob);
    }
    .grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
</style>
