      formHead: 'Registreren',
      formNote: 'Drie gegevens en u kunt beginnen. Loopt u ergens op vast? Bel ons gerust, wij helpen u graag.',
      already: 'Adverteert u al bij ons?',
      alreadyLink: 'Log in op het adverteerdersportaal',
      alreadyTail: '; daar start u ook een nieuwe advertentie.',
      bankHead: 'Onze bankrekeningen',
      bankNote: 'Bij goedkeuring gaat uw advertentie direct online; daarna maakt u het bedrag over naar een van deze rekeningen of betaalt u met creditcard.',
    },
  en: {
    metaTitle: 'Place a listing: advertise your property in Western Europe',
    metaDescription: `Place your property listing from ${eur(fromEur, locale)}. Once approved it appears at once in ${R.languages} languages in ${R.countries} countries, with no upfront payment and no exclusivity.`,
    eyebrow: 'Place a listing',
    title: 'Advertise your property',
    titleEm: 'in Western Europe',
    body: 'Register with a few details. You receive an email with a link to set your password, and then put your listing together step by step in your own area, photos included. You pay nothing upfront: we review the listing and publish it as soon as it is approved.',
