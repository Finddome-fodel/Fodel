const refundPolicy = refund?.text;
const refundLang = refund?.lang ?? locale;
const catalog = listingCatalog(COMPANY.services);
const fromEur = priceFacts(catalog).from;
const live = catalog.pricingLive;
// The cheapest cell of the matrix with its cents when the three packages are on sale; whole euros before.
