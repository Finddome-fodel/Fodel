    ],
    packagesHead: 'Packages and prices',
    packagesNote: 'You choose the package and extras after registering, when you put your listing together.',
    recommended: 'Recommended',
    extrasHead: 'Extras',
    extraTranslation: 'Translation',
    extraTranslationUnit: 'per language',
    extraCategoryHighlight: 'Highlighting in the category',
    extraHomepageHighlight: 'Highlighting on the homepage',
    extraVideo: 'Video placement',
    perMonth: '/ month',
    minMonths: (n: number) => `min. ${n} months`,
    once: 'one-off',
    formHead: 'Register',
    formNote: 'Three details and you can begin. If you get stuck, call us; we are glad to help.',
    already: 'Already advertising with us?',
    alreadyLink: 'Sign in to the advertiser portal',
    alreadyTail: ', where you can also start a new listing.',
    bankHead: 'Our bank accounts',
    bankNote: 'Once approved, your listing goes live at once; you then transfer the amount to one of these accounts or pay by card in your own area.',
  },
  de: {
    metaTitle: 'Inserat aufgeben: Ihre Immobilie in Westeuropa',
    metaDescription: `Geben Sie Ihr Immobilieninserat ab ${eur(fromEur, locale)} auf. Nach der Freigabe erscheint es sofort in ${R.languages} Sprachen in ${R.countries} Ländern, ohne Vorauszahlung und ohne Exklusivität.`,
    eyebrow: 'Inserat aufgeben',
    title: 'Inserieren Sie Ihre Immobilie',
    titleEm: 'in Westeuropa',
    body: 'Registrieren Sie sich mit wenigen Angaben. Sie erhalten per E-Mail einen Link zum Festlegen Ihres Passworts und stellen danach in Ihrem eigenen Bereich Schritt für Schritt Ihr Inserat zusammen, einschließlich der Fotos. Sie zahlen nichts im Voraus: Wir prüfen das Inserat und veröffentlichen es, sobald es freigegeben ist.',
    processHead: 'Der Ablauf',
    steps: [
      { n: '01', t: 'Registrieren', b: 'Sie geben Name, E-Mail-Adresse und Telefonnummer an. Mehr brauchen Sie zum Start nicht.' },
      { n: '02', t: 'E-Mail und Passwort', b: 'Wir senden Ihnen einen Link per E-Mail. Darüber legen Sie Ihr Passwort fest.' },
      { n: '03', t: 'Inserat zusammenstellen', b: 'Schritt für Schritt: Paket, Angaben zur Immobilie, Beschreibung, Fotos. Sie können jederzeit aufhören und später weitermachen.' },
      { n: '04', t: 'Prüfung', b: 'Ein Mitarbeiter prüft das Inserat und bittet bei Bedarf um eine Korrektur.' },
      { n: '05', t: 'Veröffentlichung', b: `Ein freigegebenes Inserat geht sofort online, in ${R.languages} Sprachen und ${R.countries} Ländern. Für ein abgelehntes Inserat zahlen Sie nie.` },
      { n: '06', t: 'Zahlung', b: 'Anschließend zahlen Sie per Karte oder Überweisung; die Zahlung hält die Veröffentlichung nicht auf.' },
    ],
    packagesHead: 'Pakete und Preise',
    packagesNote: 'Paket und Zusatzoptionen wählen Sie nach der Registrierung, wenn Sie Ihr Inserat zusammenstellen.',
    recommended: 'Empfohlen',
    extrasHead: 'Zusatzoptionen',
    extraTranslation: 'Übersetzung',
    extraTranslationUnit: 'pro Sprache',
    extraCategoryHighlight: 'Hervorhebung in der Kategorie',
    extraHomepageHighlight: 'Hervorhebung auf der Startseite',
    extraVideo: 'Video einbinden',
    perMonth: '/ Monat',
    minMonths: (n: number) => `mind. ${n} Monate`,
    once: 'einmalig',
    formHead: 'Registrieren',
    formNote: 'Drei Angaben, und Sie können loslegen. Wenn Sie irgendwo nicht weiterkommen, rufen Sie uns an; wir helfen gern.',
    already: 'Inserieren Sie bereits bei uns?',
    alreadyLink: 'Im Inserentenportal anmelden',
    alreadyTail: ', dort können Sie auch ein neues Inserat starten.',
    bankHead: 'Unsere Bankverbindungen',
    bankNote: 'Nach der Freigabe geht Ihr Inserat sofort online; den Betrag überweisen Sie danach auf eines dieser Konten oder zahlen in Ihrem Bereich per Karte.',
  },
  fr: {
    metaTitle: 'Déposer une annonce\u00a0: votre bien en Europe de l’Ouest',
    metaDescription: `Déposez votre annonce dès ${eur(fromEur, locale)}. Une fois validée, elle paraît aussitôt en ${R.languages} langues dans ${R.countries} pays, sans paiement d’avance ni exclusivité.`,
    eyebrow: 'Déposer une annonce',
    title: 'Annoncez votre bien',
    titleEm: 'en Europe de l’Ouest',
    body: 'Inscrivez-vous avec quelques informations. Vous recevez par e-mail un lien pour définir votre mot de passe, puis vous composez votre annonce étape par étape dans votre espace, photos comprises. Vous ne payez rien d’avance\u00a0: nous examinons l’annonce et la publions dès sa validation.',
    processHead: 'Le déroulement',
    steps: [
      { n: '01', t: 'Inscription', b: 'Vous indiquez votre nom, votre adresse e-mail et votre numéro de téléphone. C’est tout ce qu’il faut pour commencer.' },
      { n: '02', t: 'E-mail et mot de passe', b: 'Nous vous envoyons un lien par e-mail. Il vous permet de définir votre mot de passe.' },
      { n: '03', t: 'Composer l’annonce', b: 'Étape par étape\u00a0: forfait, données du bien, description, photos. Vous pouvez vous arrêter à tout moment et reprendre plus tard.' },
      { n: '04', t: 'Vérification', b: 'Un collaborateur examine l’annonce et demande une correction si nécessaire.' },
      { n: '05', t: 'Publication', b: `Une annonce validée est mise en ligne aussitôt, en ${R.languages} langues dans ${R.countries} pays. Vous ne payez jamais pour une annonce refusée.` },
      { n: '06', t: 'Paiement', b: 'Vous réglez ensuite par carte bancaire ou par virement\u00a0; le paiement ne retarde pas la publication.' },
    ],
    packagesHead: 'Forfaits et tarifs',
    packagesNote: 'Vous choisissez le forfait et les options après l’inscription, au moment de composer votre annonce.',
    recommended: 'Recommandé',
    extrasHead: 'Options complémentaires',
    extraTranslation: 'Traduction',
    extraTranslationUnit: 'par langue',
    extraCategoryHighlight: 'Mise en avant dans la catégorie',
    extraHomepageHighlight: 'Mise en avant sur la page d’accueil',
    extraVideo: 'Mise en ligne d’une vidéo',
    perMonth: '/ mois',
    minMonths: (n: number) => `min. ${n} mois`,
    once: 'unique',
    formHead: 'Inscription',
    formNote: 'Trois informations, et vous pouvez commencer. Si vous êtes bloqué, appelez-nous\u00a0; nous vous aidons volontiers.',
    already: 'Vous annoncez déjà chez nous\u00a0?',
    alreadyLink: 'Connectez-vous à l’espace annonceur',
    alreadyTail: ', vous pouvez aussi y lancer une nouvelle annonce.',
    bankHead: 'Nos comptes bancaires',
    bankNote: 'Dès la validation, votre annonce est mise en ligne\u00a0; vous virez ensuite le montant sur l’un de ces comptes ou réglez par carte dans votre espace.',
  },
};
const t = copies[locale];
const misc = {
  refund: x('Visszatérítési szabály', 'Terugbetalingsbeleid', 'Refund policy', 'Erstattungsregel', 'Politique de remboursement'),
  help: x('Segítségre van szüksége?', 'Hulp nodig?', 'Need help?', 'Brauchen Sie Hilfe?', 'Besoin d’aide\u00a0?'),
  faq: x('Gyakori kérdések', 'Veelgestelde vragen', 'Frequently asked questions', 'Häufige Fragen', 'Questions fréquentes'),
  bankNl: x('Hollandia', 'Nederland', 'Netherlands', 'Niederlande', 'Pays-Bas'),
  bankHu: x('Magyarország', 'Hongarije', 'Hungary', 'Ungarn', 'Hongrie'),
};
// Money here is shown the way the page's own language writes it.
const money = (cents: number) => eurCents(cents, locale === 'hu' ? 'nl' : locale);

/**
 * Package cards, ids straight off the catalogue — this zip is what makes the
 * old id bug impossible: the value posted by the radio input can only ever
 * be a real package id (src/lib/listing-packages.ts), never a hand-typed string.
 */
const packageCards = catalog.packages.map((pkg) => packageCard(pkg, catalog, locale));

const extra = (id: string) => catalog.extras.find((e) => e.id === id)!;
const categoryHighlight = extra('category-highlight');
const homepageHighlight = extra('homepage-highlight');
const videoExtra = extra('video');
const translationExtra = extra('translation');
// Video is listed only when some package sells it as an extra.
const videoSold = catalog.packages.some((pkg) => pkg.video === 'extra');
// Read-only list of what can be added later, in the setup's first step.
const extrasInfo = [
  {
    name: t.extraTranslation,
    detail: TRANSLATION_LANGUAGES.map((lang) => LOCALE_META[lang].label).join(', '),
    price: `${money(translationExtra.priceEur * 100)} ${t.extraTranslationUnit}`,
  },
  {
    name: t.extraCategoryHighlight,
    price: `${money(categoryHighlight.priceEur * 100)} ${t.perMonth} · ${t.minMonths(categoryHighlight.minMonths!)}`,
  },
  {
    name: t.extraHomepageHighlight,
    price: `${money(homepageHighlight.priceEur * 100)} ${t.perMonth} · ${t.minMonths(homepageHighlight.minMonths!)}`,
  },
  ...(videoSold ? [{ name: t.extraVideo, price: `${money(videoExtra.priceEur * 100)} ${t.once}` }] : []),
];

const packageSchema = listingServiceSchema(locale, {
  name: t.packagesHead,
  description: t.metaDescription,
  url: path(locale, 'submitAd'),
  packages: packageCards.map((p) => ({ name: p.name, priceEur: p.priceCents / 100 })),
});
---

<Base
  locale={locale}
  title={t.metaTitle}
  description={t.metaDescription}
  alternates={alternatesFor('submitAd')}
  schema={[packageSchema]}
>
  <div class="layout">
    <div class="marketing">
      <header class="intro">
        <p class="s-eyebrow">
          <span class="s-eyebrow-rule" aria-hidden="true"></span>
          <span>{t.eyebrow}</span>
        </p>
        <h1>
          <span class="line"><span>{t.title}</span></span>
          <span class="line" style="--i:1"><span><em>{t.titleEm}</em></span></span>
        </h1>
        <p class="intro-body">{t.body}</p>
      </header>

      {/* ── Process ── */}
      <section class="process">
        <Eyebrow space="20px">{t.processHead}</Eyebrow>
        <ol>
          {
            t.steps.map((s) => (
              <li>
                <span class="n">{s.n}</span>
                <h2>{s.t}</h2>
                <p>{s.b}</p>
              </li>
            ))
          }
        </ol>
      </section>

      {/* ── Packages: information only; chosen after registration ── */}
      <section class="packages">
        <Eyebrow space="20px">{t.packagesHead}</Eyebrow>
        <p class="packages-note">{t.packagesNote}</p>
        <div class="package-grid">
          {packageCards.map((card) => <PackageCard pkg={card} mode="info" recommendedLabel={t.recommended} />)}
        </div>
      </section>

      <section class="extras">
        <Eyebrow space="20px">{t.extrasHead}</Eyebrow>
        <ul class="extras-list">
          {extrasInfo.map((item) => (
            <li>
              <span class="extra-name">
                {item.name}
                {item.detail && <span class="extra-detail">{item.detail}</span>}
              </span>
              <span class="extra-price num">{item.price}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="photos">
        <PhotoTips locale={locale} />
      </section>

      {refundPolicy && (
        <section class="refund-policy">
          <h3>{misc.refund}</h3>
          <p lang={refundLang}>{refundPolicy}</p>
        </section>
      )}
    </div>

    <div class="form-col">
      <div class="form-card" data-bg="dark">
        <Eyebrow space="20px">{t.formHead}</Eyebrow>
        <p class="form-note">{t.formNote}</p>
        <p class="form-note">
          {t.already} <a href={`/portal/login?lang=${locale}`} rel="nofollow">{t.alreadyLink}</a>{t.alreadyTail}
        </p>

        <RegisterForm locale={locale} onDark />
      </div>

      <aside class="bank">
        <Eyebrow space="20px">{t.bankHead}</Eyebrow>
        <p class="bank-note">{t.bankNote}</p>
        <dl>
          <div>
            <dt>{misc.bankNl}</dt>
            <dd>{COMPANY.banks.nl.iban}</dd>
            <dd class="bic">{COMPANY.banks.nl.bic}</dd>
          </div>
          <div>
            <dt>{misc.bankHu}</dt>
            <dd>{COMPANY.banks.hu.account}</dd>
          </div>
        </dl>

        <div class="help">
          <p>{misc.help}</p>
          {COMPANY.phones.filter((p) => p.public).map((p) => <a href={p.href}>{p.display}</a>)}
          <Button variant="text" href={path(locale, 'faq')}>
            {misc.faq}
          </Button>
        </div>
      </aside>
    </div>
  </div>
</Base>


<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 460px;
    gap: clamp(48px, 5vw, 80px);
    align-items: start;
    padding: 64px var(--pad-x) var(--section-y);
  }

  .intro {
    max-width: 62ch;
    margin-bottom: 64px;
  }
  .s-eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 28px;
    font-size: 0.75rem;
    font-weight: var(--fw-medium);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink);
    animation: fx-fade-up 1.2s var(--ease-out) 0.3s both;
  }
  .s-eyebrow-rule {
    width: 32px;
    height: 1px;
    background: var(--ink);
    transform-origin: left;
    animation: fx-draw 1.2s var(--ease-out) 0.4s both;
  }
  .intro h1 {
    font-family: var(--serif);
    font-weight: var(--fw-hero);
    font-size: clamp(38px, 4.6vw, 72px);
    letter-spacing: var(--ls-display);
    line-height: 1.02;
    color: var(--ink);
    margin-bottom: 28px;
  }
  .intro h1 .line > span {
    animation: fx-rise 1.4s var(--ease-out) both;
    animation-delay: calc(0.35s + var(--i, 0) * 0.11s);
  }
  .intro-body {
    font-size: var(--fs-body-lg);
