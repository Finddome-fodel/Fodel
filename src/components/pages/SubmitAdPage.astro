---
/**
 * Ad submission — the page that makes FODEL money.
 *
 * Launch round: registration first, the listing after. This page used to ask
 * for everything at once — package, extras, a live total, the property, the
 * description and the billing details — and then created only an invite, so
 * nothing reached the admin until the emailed link was accepted. Now it asks
 * for a name, an email address and a phone number (RegisterForm.astro); the
 * package, the property and the photos are chosen step by step in the
 * portal's guided setup (src/pages/portal/properties/[id]/setup.astro), and
 * the registration shows up in the admin inbox the moment it is made.
 *
 * The packages stay on the page as information — real catalogue prices from
 * listingCatalog()/packageCard(), the recommended one badged — so nobody has
 * to register to find out what it costs. The €179 tier is still decided
 * server-side from the listing's own forint price (isAboveThreshold()).
 */
import Base from '~/layouts/Base.astro';
import Eyebrow from '~/components/Eyebrow.astro';
import Button from '~/components/Button.astro';
import PackageCard from '~/components/PackageCard.astro';
import PhotoTips from '~/components/PhotoTips.astro';
import RegisterForm from '~/components/forms/RegisterForm.astro';
import { LOCALE_META, path, type Locale } from '~/i18n/ui';
import { getCompany } from '~/lib/runtime-config';
import { TRANSLATION_LANGUAGES } from '~/config/company';
import { listingCatalog, packageCard, priceFacts } from '~/lib/listing-packages';
import { alternatesFor } from '~/lib/page';
import { formatCents } from '~/lib/orders';
import { listingServiceSchema } from '~/lib/seo';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const hu = locale === 'hu';
const COMPANY = await getCompany();
const refundPolicy = COMPANY.services.refundPolicy?.[locale]?.trim();
const catalog = listingCatalog(COMPANY.services);
const fromEur = priceFacts(catalog).from;

const t = hu
  ? {
      metaTitle: 'Hirdetés feladása: hirdesse ingatlanát Nyugat-Európában',
      metaDescription:
        `Adja fel ingatlanhirdetését ${fromEur} €-tól. Jóváhagyás után azonnal megjelenik ${COMPANY.reach.languages} nyelven, ${COMPANY.reach.countries} országban, előrefizetés és kizárólagosság nélkül.`,
      eyebrow: 'Hirdetésfeladás',
      title: 'Hirdesse ingatlanát',
      titleEm: 'Nyugat-Európában',
      body: 'Regisztráljon néhány adattal. E-mailben kap egy linket a jelszó beállításához, utána a saját felületén, lépésről lépésre állítja össze a hirdetést, a fotókkal együtt. Nincs előrefizetés: munkatársunk átnézi, és jóváhagyáskor azonnal közzéteszi.',
      processHead: 'A folyamat',
      steps: [
        { n: '01', t: 'Regisztráció', b: 'Megadja a nevét, az e-mail-címét és a telefonszámát. Ennyi kell a kezdéshez.' },
        { n: '02', t: 'E-mail és jelszó', b: 'E-mailben küldünk egy linket. Erre kattintva beállítja a jelszavát.' },
        { n: '03', t: 'Hirdetés összeállítása', b: 'Lépésről lépésre: csomag, az ingatlan adatai, leírás, fotók. Bármikor abbahagyhatja, és később folytathatja.' },
        { n: '04', t: 'Ellenőrzés', b: 'Munkatársunk átnézi a hirdetést, és ha szükséges, javítást kér.' },
        { n: '05', t: 'Megjelenés', b: `A jóváhagyott hirdetés azonnal élesedik, ${COMPANY.reach.languages} nyelven, ${COMPANY.reach.countries} országban. Elutasított hirdetésért soha nem kell fizetni.` },
        { n: '06', t: 'Díjrendezés', b: 'A hirdetési díjat ezután bankkártyával vagy átutalással rendezheti; a fizetés nem késlelteti a megjelenést.' },
      ],
      packagesHead: 'Csomagok és árak',
      packagesNote: 'A csomagot és a kiegészítőket a regisztráció után, a hirdetés összeállításakor választja ki.',
      recommended: 'Ajánlott',
      extrasHead: 'Kiegészítők',
      extraTranslation: 'Fordítás',
      extraTranslationUnit: 'nyelvenként',
      extraCategoryHighlight: 'Kiemelés a kategóriában',
      extraHomepageHighlight: 'Kiemelés a főoldalon',
      extraVideo: 'Videós bemutató',
      perMonth: '/ hó',
      minMonths: (n: number) => `min. ${n} hó`,
      once: 'egyszeri',
      formHead: 'Regisztráció',
      formNote: 'Három adat, és már kezdheti is. Ha bármiben elakad, hívjon minket, szívesen segítünk.',
      already: 'Már hirdet nálunk?',
      alreadyLink: 'Lépjen be a hirdetői felületre',
      alreadyTail: ', onnan új hirdetést is indíthat.',
      bankHead: 'Bankszámlaszámaink',
      bankNote: 'A jóváhagyáskor a hirdetés azonnal megjelenik; a díjat ezután ezekre a számlákra utalhatja, vagy bankkártyával rendezheti a saját felületén.',
    }
  : {
      metaTitle: 'Advertentie plaatsen: uw woning in West-Europa',
      metaDescription:
        `Plaats uw advertentie vanaf € ${fromEur}. Na goedkeuring verschijnt deze direct in ${COMPANY.reach.languages} talen en ${COMPANY.reach.countries} landen, zonder vooruitbetaling of exclusiviteit.`,
      eyebrow: 'Adverteren',
      title: 'Plaats uw woning',
      titleEm: 'in West-Europa',
      body: 'Registreer u met een paar gegevens. U krijgt per e-mail een link om een wachtwoord in te stellen en stelt daarna in uw eigen omgeving stap voor stap uw advertentie samen, met de foto’s. U betaalt niet vooraf: wij beoordelen de advertentie en publiceren hem direct na goedkeuring.',
      processHead: 'Het proces',
      steps: [
        { n: '01', t: 'Registreren', b: 'U vult uw naam, e-mailadres en telefoonnummer in. Meer is er niet nodig om te beginnen.' },
        { n: '02', t: 'E-mail en wachtwoord', b: 'Wij sturen u een link per e-mail. Daarmee stelt u uw wachtwoord in.' },
        { n: '03', t: 'Advertentie samenstellen', b: 'Stap voor stap: pakket, gegevens van de woning, omschrijving, foto’s. U kunt altijd stoppen en later verdergaan.' },
        { n: '04', t: 'Beoordeling', b: 'Onze medewerker beoordeelt de advertentie en vraagt zo nodig om een aanpassing.' },
        { n: '05', t: 'Publicatie', b: `Een goedgekeurde advertentie staat direct online, in ${COMPANY.reach.languages} talen en ${COMPANY.reach.countries} landen. Voor een afgewezen advertentie betaalt u nooit.` },
        { n: '06', t: 'Betaling', b: 'Daarna betaalt u met creditcard of per overschrijving; de betaling houdt de publicatie niet tegen.' },
      ],
      packagesHead: 'Pakketten en tarieven',
      packagesNote: 'Het pakket en de opties kiest u na de registratie, wanneer u uw advertentie samenstelt.',
      recommended: 'Aanbevolen',
      extrasHead: 'Aanvullende opties',
      extraTranslation: 'Vertaling',
      extraTranslationUnit: 'per taal',
      extraCategoryHighlight: 'Uitlichten in de categorie',
      extraHomepageHighlight: 'Uitlichten op de homepage',
      extraVideo: 'Video plaatsen',
      perMonth: '/ mnd',
      minMonths: (n: number) => `min. ${n} mnd`,
      once: 'eenmalig',
      formHead: 'Registreren',
      formNote: 'Drie gegevens en u kunt beginnen. Loopt u ergens op vast? Bel ons gerust, wij helpen u graag.',
      already: 'Adverteert u al bij ons?',
      alreadyLink: 'Log in op het adverteerdersportaal',
      alreadyTail: '; daar start u ook een nieuwe advertentie.',
      bankHead: 'Onze bankrekeningen',
      bankNote: 'Bij goedkeuring gaat uw advertentie direct online; daarna maakt u het bedrag over naar een van deze rekeningen of betaalt u met creditcard.',
    };

/**
 * Package cards, ids straight off the catalogue — this zip is what makes the
 * old id bug impossible: the value posted by the radio input can only ever
 * be a real package id (src/lib/listing-packages.ts), never a hand-typed string.
 */
const packageCards = catalog.packages.map((pkg) => packageCard(pkg, catalog, locale));

const extra = (id: string) => catalog.extras.find((e) => e.id === id)!;
const categoryHighlight = extra('category-highlight');
const homepageHighlight = extra('homepage-highlight');
const videoExtra = extra('video');
const translationExtra = extra('translation');
// Video is listed only when some package sells it as an extra.
const videoSold = catalog.packages.some((pkg) => pkg.video === 'extra');
// Read-only list of what can be added later, in the setup's first step.
const extrasInfo = [
  {
    name: t.extraTranslation,
    detail: TRANSLATION_LANGUAGES.map((lang) => LOCALE_META[lang].label).join(', '),
    price: `${formatCents(translationExtra.priceEur * 100)} ${t.extraTranslationUnit}`,
  },
  {
    name: t.extraCategoryHighlight,
    price: `${formatCents(categoryHighlight.priceEur * 100)} ${t.perMonth} · ${t.minMonths(categoryHighlight.minMonths!)}`,
  },
  {
    name: t.extraHomepageHighlight,
    price: `${formatCents(homepageHighlight.priceEur * 100)} ${t.perMonth} · ${t.minMonths(homepageHighlight.minMonths!)}`,
  },
  ...(videoSold ? [{ name: t.extraVideo, price: `${formatCents(videoExtra.priceEur * 100)} ${t.once}` }] : []),
];

const packageSchema = listingServiceSchema(locale, {
  name: t.packagesHead,
  description: t.metaDescription,
  url: path(locale, 'submitAd'),
  packages: packageCards.map((p) => ({ name: p.name, priceEur: p.priceCents / 100 })),
});
---

<Base
  locale={locale}
  title={t.metaTitle}
  description={t.metaDescription}
  alternates={alternatesFor('submitAd')}
  schema={[packageSchema]}
>
  <div class="layout">
    <div class="marketing">
      <header class="intro">
        <p class="s-eyebrow">
          <span class="s-eyebrow-rule" aria-hidden="true"></span>
          <span>{t.eyebrow}</span>
        </p>
        <h1>
          <span class="line"><span>{t.title}</span></span>
          <span class="line" style="--i:1"><span><em>{t.titleEm}</em></span></span>
        </h1>
        <p class="intro-body">{t.body}</p>
      </header>

      {/* ── Process ── */}
      <section class="process">
        <Eyebrow space="20px">{t.processHead}</Eyebrow>
        <ol>
          {
            t.steps.map((s) => (
              <li>
                <span class="n">{s.n}</span>
                <h2>{s.t}</h2>
                <p>{s.b}</p>
              </li>
            ))
          }
        </ol>
      </section>

      {/* ── Packages: information only; chosen after registration ── */}
      <section class="packages">
        <Eyebrow space="20px">{t.packagesHead}</Eyebrow>
        <p class="packages-note">{t.packagesNote}</p>
        <div class="package-grid">
          {packageCards.map((card) => <PackageCard pkg={card} mode="info" recommendedLabel={t.recommended} />)}
        </div>
      </section>

      <section class="extras">
        <Eyebrow space="20px">{t.extrasHead}</Eyebrow>
        <ul class="extras-list">
          {extrasInfo.map((item) => (
            <li>
              <span class="extra-name">
                {item.name}
                {item.detail && <span class="extra-detail">{item.detail}</span>}
              </span>
              <span class="extra-price num">{item.price}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="photos">
        <PhotoTips locale={locale} />
      </section>

      {refundPolicy && (
        <section class="refund-policy">
          <h3>{hu ? 'Visszatérítési szabály' : 'Terugbetalingsbeleid'}</h3>
          <p>{refundPolicy}</p>
        </section>
      )}
    </div>

    <div class="form-col">
      <div class="form-card" data-bg="dark">
        <Eyebrow space="20px">{t.formHead}</Eyebrow>
        <p class="form-note">{t.formNote}</p>
        <p class="form-note">
          {t.already} <a href={`/portal/login?lang=${locale}`} rel="nofollow">{t.alreadyLink}</a>{t.alreadyTail}
        </p>

        <RegisterForm locale={locale} onDark />
      </div>

      <aside class="bank">
        <Eyebrow space="20px">{t.bankHead}</Eyebrow>
        <p class="bank-note">{t.bankNote}</p>
        <dl>
          <div>
            <dt>Nederland</dt>
            <dd>{COMPANY.banks.nl.iban}</dd>
            <dd class="bic">{COMPANY.banks.nl.bic}</dd>
          </div>
          <div>
            <dt>Magyarország</dt>
            <dd>{COMPANY.banks.hu.account}</dd>
          </div>
        </dl>

        <div class="help">
          <p>{hu ? 'Segítségre van szüksége?' : 'Hulp nodig?'}</p>
          {COMPANY.phones.filter((p) => p.public).map((p) => <a href={p.href}>{p.display}</a>)}
          <Button variant="text" href={path(locale, 'faq')}>
            {hu ? 'Gyakori kérdések' : 'Veelgestelde vragen'}
          </Button>
        </div>
      </aside>
    </div>
  </div>
</Base>


<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 460px;
    gap: clamp(48px, 5vw, 80px);
    align-items: start;
    padding: 64px var(--pad-x) var(--section-y);
  }

  .intro {
    max-width: 62ch;
    margin-bottom: 64px;
  }
  .s-eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 28px;
    font-size: 0.75rem;
    font-weight: var(--fw-medium);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink);
    animation: fx-fade-up 1.2s var(--ease-out) 0.3s both;
  }
  .s-eyebrow-rule {
    width: 32px;
    height: 1px;
    background: var(--ink);
    transform-origin: left;
    animation: fx-draw 1.2s var(--ease-out) 0.4s both;
  }
  .intro h1 {
    font-family: var(--serif);
    font-weight: var(--fw-hero);
    font-size: clamp(38px, 4.6vw, 72px);
    letter-spacing: var(--ls-display);
    line-height: 1.02;
    color: var(--ink);
    margin-bottom: 28px;
  }
  .intro h1 .line > span {
    animation: fx-rise 1.4s var(--ease-out) both;
    animation-delay: calc(0.35s + var(--i, 0) * 0.11s);
  }
  .intro-body {
    font-size: var(--fs-body-lg);
    line-height: 1.65;
    color: var(--taupe);
    max-width: 52ch;
    animation: fx-fade-up 1.3s var(--ease-out) 0.7s both;
  }

  .process,
  .packages,
  .extras,
  .photos {
    margin-bottom: 56px;
  }
  .process ol {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    list-style: none;
  }
  .process li {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    column-gap: 16px;
    padding: 22px 24px 24px 20px;
    border-radius: var(--r-lg);
    background: var(--white);
    border: 1px solid rgba(16, 42, 67, 0.07);
  }
  .n {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(16, 42, 67, 0.07);
    font-family: var(--sans);
    font-size: 13.5px;
    font-weight: var(--fw-medium);
    line-height: 1;
    color: var(--ink);
  }
  .process h2 {
    margin-top: 2px;
    font-family: var(--serif);
    font-weight: var(--fw-medium);
    font-size: 19px;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin-bottom: 6px;
  }
  .process p {
    font-size: var(--fs-small);
    line-height: 1.6;
    color: var(--taupe);
  }

  .package-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .packages-note {
    max-width: 60ch;
    margin: -6px 0 20px;
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--taupe);
  }

  /* Extras: a quiet price list, not choices — they are picked in the setup. */
  .extras-list {
    list-style: none;
    border-radius: var(--r-xl);
    background: var(--white);
    border: 1px solid rgba(16, 42, 67, 0.07);
    overflow: hidden;
  }
  .extras-list li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px 24px;
    flex-wrap: wrap;
    padding: 16px 24px;
  }
  .extras-list li + li {
    border-top: 1px solid rgba(16, 42, 67, 0.07);
  }
  .extra-name {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: var(--fs-body);
    font-weight: var(--fw-medium);
    color: var(--ink);
  }
  .extra-detail {
    font-size: 13.5px;
    font-weight: var(--fw-regular);
    color: var(--taupe);
  }
  .extra-price {
    font-size: var(--fs-small);
    color: var(--taupe);
    white-space: nowrap;
  }

  .refund-policy {
    margin-bottom: 56px;
    padding: 24px 28px;
    border-radius: var(--r-xl);
    background: rgba(16, 42, 67, 0.04);
  }
  .refund-policy h3 {
    font-family: var(--serif);
    font-weight: var(--fw-medium);
    font-size: 19px;
    color: var(--ink);
    margin-bottom: 8px;
  }
  .refund-policy p {
    font-size: var(--fs-small);
    line-height: 1.65;
    color: var(--taupe);
  }

  .form-col {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .form-card {
    padding: 40px 36px 36px;
    border-radius: var(--r-2xl);
    background:
      radial-gradient(90% 60% at 100% 0%, var(--ink-soft) 0%, transparent 65%),
      var(--ink);
    box-shadow: var(--shadow-float);
  }
  .form-card :global(.eyebrow) {
    color: var(--on-dark-strong);
  }
  .form-note {
    font-size: var(--fs-small);
    line-height: var(--lh-body);
    color: var(--on-dark-body);
  }
  .form-note + .form-note {
    margin-top: 10px;
  }
  .form-note a {
    color: var(--cream);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .form-card :global(.fields) {
    margin-top: 28px;
  }

  .bank {
    padding: 28px 30px;
    border-radius: var(--r-xl);
    background: var(--white);
    border: 1px solid rgba(16, 42, 67, 0.07);
  }
  .bank-note {
    font-size: var(--fs-small);
    line-height: var(--lh-body);
    color: var(--taupe);
    margin-bottom: 20px;
  }
  .bank dl {
    display: grid;
    gap: 8px;
    margin-bottom: 24px;
  }
  .bank dl > div {
    padding: 14px 18px;
    border-radius: var(--r-md);
    background: rgba(16, 42, 67, 0.04);
  }
  .bank dt {
    font-size: 13px;
    font-weight: var(--fw-medium);
    color: var(--taupe);
    margin-bottom: 4px;
  }
  .bank dd {
    font-family: var(--serif);
    font-size: var(--fs-body-lg);
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }
  .bic {
    font-size: var(--fs-small);
    color: var(--taupe);
    margin-top: 2px;
  }
  .help {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }
  .help p {
    font-size: 13px;
    font-weight: var(--fw-medium);
    color: var(--taupe);
    margin-bottom: 4px;
  }
  .help a:not(:global(.btn)) {
    font-family: var(--serif);
    font-size: var(--fs-lead);
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .help a:not(:global(.btn)):hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (max-width: 1100px) {
    .layout {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
  @media (max-width: 700px) {
    .intro {
      margin-bottom: 40px;
    }
    .layout {
      padding: 40px var(--pad-x-mob) var(--section-y-mob);
    }
    .process ol {
      grid-template-columns: 1fr;
    }
    .package-grid {
      grid-template-columns: 1fr;
    }
    .form-card {
      padding: 28px 20px;
      border-radius: var(--r-xl);
    }
    .extras-list li {
      padding: 14px 18px;
    }
  }
</style>
