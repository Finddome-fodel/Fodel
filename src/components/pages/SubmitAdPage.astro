      { n: '01', t: 'Înregistrare', b: 'Ne dați numele, adresa de e-mail și numărul de telefon. Este tot ce vă trebuie pentru a începe.' },
      { n: '02', t: 'E-mail și parolă', b: 'Vă trimitem un link prin e-mail. Cu ajutorul lui vă setați parola.' },
      { n: '03', t: 'Realizarea anunțului', b: 'Pas cu pas: pachet, datele proprietății, descriere, fotografii. Vă puteți opri oricând și puteți continua mai târziu.' },
      { n: '04', t: 'Verificare', b: 'Un coleg verifică anunțul și, dacă este nevoie, solicită o corectură.' },
      { n: '05', t: 'Publicare', b: `Un anunț aprobat apare imediat online, în ${nOf('ro', R.languages, 'limbă', 'limbi', 'de limbi')} din ${nOf('ro', R.countries, 'țară', 'țări', 'de țări')}. Nu plătiți niciodată pentru un anunț respins.` },
      { n: '06', t: 'Plată', b: 'Apoi plătiți cu cardul sau prin transfer bancar; plata nu întârzie publicarea.' },
    ],
    packagesHead: 'Pachete și tarife',
    packagesNote: 'Alegeți pachetul și opțiunile după înregistrare, când vă realizați anunțul.',
    recommended: 'Recomandat',
    extrasHead: 'Servicii suplimentare',
    extraTranslation: 'Traducere',
    extraTranslationUnit: 'per limbă',
    extraCategoryHighlight: 'Evidențiere în categorie',
    extraHomepageHighlight: 'Evidențiere pe prima pagină',
    extraVideo: 'Publicarea unui videoclip',
    perMonth: '/ lună',
    minMonths: (n: number) => `min. ${nOf('ro', n, 'lună', 'luni', 'de luni')}`,
    once: 'o singură dată',
    formHead: 'Înregistrare',
    formNote: 'Trei informații și puteți începe. Dacă vă împotmoliți, sunați-ne; vă ajutăm cu plăcere.',
    already: 'Aveți deja anunțuri la noi?',
    alreadyLink: 'Conectați-vă în contul de ofertant',
    alreadyTail: '; acolo puteți crea și un anunț nou.',
    bankHead: 'Conturile noastre bancare',
    bankNote: 'După aprobare, anunțul apare imediat online; apoi transferați suma în unul dintre aceste conturi sau plătiți cu cardul în contul dumneavoastră.',
  },
  sk: {
    metaTitle: 'Pridať inzerát: vaša nehnuteľnosť v západnej Európe',
    metaDescription: `Inzerát pridáte už od ${eur(fromEur, locale)}. Po schválení sa hneď zobrazí v ${nOf('sk', R.languages, 'jazyku', 'jazykoch')} v ${nOf('sk', R.countries, 'krajine', 'krajinách')}, bez platby vopred a bez exkluzivity.`,
    eyebrow: 'Pridať inzerát',
    title: 'Inzerujte svoju nehnuteľnosť',
    titleEm: 'v západnej Európe',
    body: 'Zaregistrujte sa pomocou niekoľkých údajov. E-mailom dostanete odkaz na nastavenie hesla a potom si vo svojom účte krok za krokom zostavíte inzerát vrátane fotografií. Nič neplatíte vopred: inzerát skontrolujeme a po schválení ho hneď zverejníme.',
    processHead: 'Postup',
    steps: [
      { n: '01', t: 'Registrácia', b: 'Zadáte meno, e-mailovú adresu a telefónne číslo. To je všetko, čo na začiatok potrebujete.' },
      { n: '02', t: 'E-mail a heslo', b: 'Pošleme vám e-mailom odkaz, pomocou ktorého si nastavíte heslo.' },
      { n: '03', t: 'Zostavenie inzerátu', b: 'Krok za krokom: balík, údaje o nehnuteľnosti, popis, fotografie. Kedykoľvek môžete prestať a pokračovať neskôr.' },
      { n: '04', t: 'Kontrola', b: 'Náš kolega inzerát skontroluje a v prípade potreby požiada o opravu.' },
      { n: '05', t: 'Zverejnenie', b: `Schválený inzerát je hneď online, v ${nOf('sk', R.languages, 'jazyku', 'jazykoch')} v ${nOf('sk', R.countries, 'krajine', 'krajinách')}. Za zamietnutý inzerát nikdy neplatíte.` },
      { n: '06', t: 'Platba', b: 'Potom zaplatíte kartou alebo prevodom; platba zverejnenie nezdrží.' },
    ],
    packagesHead: 'Balíky a ceny',
    packagesNote: 'Balík a doplnkové služby si vyberiete po registrácii, keď budete zostavovať inzerát.',
    recommended: 'Odporúčaný',
    extrasHead: 'Doplnkové služby',
    extraTranslation: 'Preklad',
    extraTranslationUnit: 'za jazyk',
    extraCategoryHighlight: 'Zvýraznenie v kategórii',
    extraHomepageHighlight: 'Zvýraznenie na úvodnej stránke',
    extraVideo: 'Zverejnenie videa',
    perMonth: '/ mesiac',
    minMonths: (n: number) => `min. ${nOf('sk', n, 'mesiac', 'mesiace', 'mesiacov')}`,
    once: 'jednorazovo',
    formHead: 'Registrácia',
    formNote: 'Stačia tri údaje a môžete začať. Ak si neviete rady, zavolajte nám; radi vám pomôžeme.',
    already: 'Už u nás inzerujete?',
    alreadyLink: 'Prihláste sa do účtu inzerenta',
    alreadyTail: '– tam môžete pridať aj nový inzerát.',
    bankHead: 'Naše bankové účty',
    bankNote: 'Po schválení je váš inzerát hneď online; sumu potom prevediete na jeden z týchto účtov alebo zaplatíte kartou vo svojom účte.',
  },
};
const t = copies[locale];
const misc = {
  refund: x('Visszatérítési szabály', 'Terugbetalingsbeleid', 'Refund policy', 'Erstattungsregel', 'Politique de remboursement', 'Política de reembolso', 'Zasady zwrotów', 'Politica de rambursare', 'Pravidlá vrátenia platieb'),
  help: x('Segítségre van szüksége?', 'Hulp nodig?', 'Need help?', 'Brauchen Sie Hilfe?', 'Besoin d’aide\u00a0?', '¿Necesita ayuda?', 'Potrzebują Państwo pomocy?', 'Aveți nevoie de ajutor?', 'Potrebujete pomoc?'),
  faq: x('Gyakori kérdések', 'Veelgestelde vragen', 'Frequently asked questions', 'Häufige Fragen', 'Questions fréquentes', 'Preguntas frecuentes', 'Najczęściej zadawane pytania', 'Întrebări frecvente', 'Časté otázky'),
  bankNl: x('Hollandia', 'Nederland', 'Netherlands', 'Niederlande', 'Pays-Bas', 'Países Bajos', 'Holandia', 'Țările de Jos', 'Holandsko'),
  bankHu: x('Magyarország', 'Hongarije', 'Hungary', 'Ungarn', 'Hongrie', 'Hungría', 'Węgry', 'Ungaria', 'Maďarsko'),
};
// Money here is shown the way the page's own language writes it.
const money = (cents: number) => eurCents(cents, locale === 'hu' ? 'nl' : locale);

/**
 * Package cards, ids straight off the catalogue — this zip is what makes the
 * old id bug impossible: the value posted by the radio input can only ever
 * be a real package id (src/lib/listing-packages.ts), never a hand-typed string.
 */
const packageCards = catalog.packages.map((pkg) => packageCard(pkg, catalog, locale));

const extra = (id: string) => catalog.extras.find((e) => e.id === id)!;
const categoryHighlight = extra('category-highlight');
const homepageHighlight = extra('homepage-highlight');
const videoExtra = extra('video');
const translationExtra = extra('translation');
// Video is listed only when some package sells it as an extra.
const videoSold = catalog.packages.some((pkg) => pkg.video === 'extra');
// Read-only list of what can be added later, in the setup's first step.
const extrasInfo = [
  {
    name: t.extraTranslation,
    detail: TRANSLATION_LANGUAGES.map((lang) => LOCALE_META[lang].label).join(', '),
    price: `${money(translationExtra.priceEur * 100)} ${t.extraTranslationUnit}`,
  },
  {
    name: t.extraCategoryHighlight,
    price: `${money(categoryHighlight.priceEur * 100)} ${t.perMonth} · ${t.minMonths(categoryHighlight.minMonths!)}`,
  },
  {
    name: t.extraHomepageHighlight,
    price: `${money(homepageHighlight.priceEur * 100)} ${t.perMonth} · ${t.minMonths(homepageHighlight.minMonths!)}`,
  },
  ...(videoSold ? [{ name: t.extraVideo, price: `${money(videoExtra.priceEur * 100)} ${t.once}` }] : []),
];

const packageSchema = listingServiceSchema(locale, {
  name: t.packagesHead,
  description: t.metaDescription,
  url: path(locale, 'submitAd'),
  packages: packageCards.map((p) => ({ name: p.name, priceEur: p.priceCents / 100 })),
});
---

<Base
  locale={locale}
  title={t.metaTitle}
  description={t.metaDescription}
  alternates={alternatesFor('submitAd')}
  schema={[packageSchema]}
>
  <div class="layout">
    <div class="marketing">
      <header class="intro">
        <p class="s-eyebrow">
          <span class="s-eyebrow-rule" aria-hidden="true"></span>
          <span>{t.eyebrow}</span>
        </p>
        <h1>
          <span class="line"><span>{t.title}</span></span>
          <span class="line" style="--i:1"><span><em>{t.titleEm}</em></span></span>
        </h1>
        <p class="intro-body">{t.body}</p>
      </header>

      {/* ── Process ── */}
      <section class="process">
        <Eyebrow space="20px">{t.processHead}</Eyebrow>
        <ol>
          {
            t.steps.map((s) => (
              <li>
                <span class="n">{s.n}</span>
                <h2>{s.t}</h2>
                <p>{s.b}</p>
              </li>
            ))
          }
        </ol>
      </section>

      {/* ── Packages: information only; chosen after registration ── */}
      <section class="packages">
        <Eyebrow space="20px">{t.packagesHead}</Eyebrow>
        <p class="packages-note">{t.packagesNote}</p>
        <div class="package-grid">
          {packageCards.map((card) => <PackageCard pkg={card} mode="info" recommendedLabel={t.recommended} />)}
        </div>
      </section>

      <section class="extras">
        <Eyebrow space="20px">{t.extrasHead}</Eyebrow>
        <ul class="extras-list">
          {extrasInfo.map((item) => (
            <li>
              <span class="extra-name">
                {item.name}
                {item.detail && <span class="extra-detail">{item.detail}</span>}
              </span>
              <span class="extra-price num">{item.price}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="photos">
        <PhotoTips locale={locale} />
      </section>

      {refundPolicy && (
        <section class="refund-policy">
          <h3>{misc.refund}</h3>
          <p lang={refundLang}>{refundPolicy}</p>
        </section>
      )}
    </div>

    <div class="form-col">
      <div class="form-card" data-bg="dark">
        <Eyebrow space="20px">{t.formHead}</Eyebrow>
        <p class="form-note">{t.formNote}</p>
        <p class="form-note">
          {t.already} <a href={`/portal/login?lang=${locale}`} rel="nofollow">{t.alreadyLink}</a>{t.alreadyTail}
        </p>

        <RegisterForm locale={locale} onDark />
      </div>

      <aside class="bank">
        <Eyebrow space="20px">{t.bankHead}</Eyebrow>
        <p class="bank-note">{t.bankNote}</p>
        <dl>
          <div>
            <dt>{misc.bankNl}</dt>
            <dd>{COMPANY.banks.nl.iban}</dd>
            <dd class="bic">{COMPANY.banks.nl.bic}</dd>
          </div>
          <div>
            <dt>{misc.bankHu}</dt>
            <dd>{COMPANY.banks.hu.account}</dd>
          </div>
        </dl>

        <div class="help">
          <p>{misc.help}</p>
          {COMPANY.phones.filter((p) => p.public).map((p) => <a href={p.href}>{p.display}</a>)}
          <Button variant="text" href={path(locale, 'faq')}>
            {misc.faq}
          </Button>
        </div>
      </aside>
    </div>
  </div>
</Base>


<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 460px;
    gap: clamp(48px, 5vw, 80px);
    align-items: start;
    padding: 64px var(--pad-x) var(--section-y);
  }

  .intro {
    max-width: 62ch;
    margin-bottom: 64px;
  }
  .s-eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 28px;
    font-size: 0.75rem;
    font-weight: var(--fw-medium);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink);
    animation: fx-fade-up 1.2s var(--ease-out) 0.3s both;
  }
  .s-eyebrow-rule {
    width: 32px;
    height: 1px;
    background: var(--ink);
    transform-origin: left;
    animation: fx-draw 1.2s var(--ease-out) 0.4s both;
  }
  .intro h1 {
    font-family: var(--serif);
    font-weight: var(--fw-hero);
    font-size: clamp(38px, 4.6vw, 72px);
    letter-spacing: var(--ls-display);
    line-height: 1.02;
    color: var(--ink);
    margin-bottom: 28px;
  }
  .intro h1 .line > span {
    animation: fx-rise 1.4s var(--ease-out) both;
    animation-delay: calc(0.35s + var(--i, 0) * 0.11s);
  }
  .intro-body {
    font-size: var(--fs-body-lg);
    line-height: 1.65;
    color: var(--taupe);
    max-width: 52ch;
    animation: fx-fade-up 1.3s var(--ease-out) 0.7s both;
  }

  .process,
  .packages,
  .extras,
  .photos {
    margin-bottom: 56px;
  }
  .process ol {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    list-style: none;
  }
  .process li {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    column-gap: 16px;
    padding: 22px 24px 24px 20px;
    border-radius: var(--r-lg);
    background: var(--white);
    border: 1px solid rgba(16, 42, 67, 0.07);
  }
  .n {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(16, 42, 67, 0.07);
    font-family: var(--sans);
    font-size: 13.5px;
    font-weight: var(--fw-medium);
    line-height: 1;
    color: var(--ink);
  }
  .process h2 {
    margin-top: 2px;
    font-family: var(--serif);
    font-weight: var(--fw-medium);
    font-size: 19px;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin-bottom: 6px;
  }
  .process p {
    font-size: var(--fs-small);
    line-height: 1.6;
    color: var(--taupe);
  }

  .package-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .packages-note {
    max-width: 60ch;
    margin: -6px 0 20px;
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--taupe);
  }

  /* Extras: a quiet price list, not choices — they are picked in the setup. */
  .extras-list {
    list-style: none;
    border-radius: var(--r-xl);
    background: var(--white);
    border: 1px solid rgba(16, 42, 67, 0.07);
    overflow: hidden;
  }
  .extras-list li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px 24px;
    flex-wrap: wrap;
    padding: 16px 24px;
  }
  .extras-list li + li {
    border-top: 1px solid rgba(16, 42, 67, 0.07);
  }
  .extra-name {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: var(--fs-body);
    font-weight: var(--fw-medium);
    color: var(--ink);
  }
  .extra-detail {
    font-size: 13.5px;
    font-weight: var(--fw-regular);
    color: var(--taupe);
  }
  .extra-price {
    font-size: var(--fs-small);
    color: var(--taupe);
    white-space: nowrap;
  }

  .refund-policy {
    margin-bottom: 56px;
    padding: 24px 28px;
    border-radius: var(--r-xl);
    background: rgba(16, 42, 67, 0.04);
  }
  .refund-policy h3 {
    font-family: var(--serif);
    font-weight: var(--fw-medium);
    font-size: 19px;
    color: var(--ink);
    margin-bottom: 8px;
  }
  .refund-policy p {
    font-size: var(--fs-small);
    line-height: 1.65;
    color: var(--taupe);
  }

  .form-col {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .form-card {
    padding: 40px 36px 36px;
    border-radius: var(--r-2xl);
    background:
      radial-gradient(90% 60% at 100% 0%, var(--ink-soft) 0%, transparent 65%),
      var(--ink);
    box-shadow: var(--shadow-float);
  }
  .form-card :global(.eyebrow) {
    color: var(--on-dark-strong);
  }
  .form-note {
    font-size: var(--fs-small);
    line-height: var(--lh-body);
    color: var(--on-dark-body);
  }
  .form-note + .form-note {
    margin-top: 10px;
  }
  .form-note a {
    color: var(--cream);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .form-card :global(.fields) {
    margin-top: 28px;
  }

  .bank {
    padding: 28px 30px;
    border-radius: var(--r-xl);
    background: var(--white);
    border: 1px solid rgba(16, 42, 67, 0.07);
  }
  .bank-note {
    font-size: var(--fs-small);
    line-height: var(--lh-body);
    color: var(--taupe);
    margin-bottom: 20px;
  }
  .bank dl {
    display: grid;
    gap: 8px;
    margin-bottom: 24px;
  }
  .bank dl > div {
    padding: 14px 18px;
    border-radius: var(--r-md);
    background: rgba(16, 42, 67, 0.04);
  }
  .bank dt {
    font-size: 13px;
    font-weight: var(--fw-medium);
    color: var(--taupe);
    margin-bottom: 4px;
  }
  .bank dd {
    font-family: var(--serif);
    font-size: var(--fs-body-lg);
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }
  .bic {
    font-size: var(--fs-small);
    color: var(--taupe);
    margin-top: 2px;
  }
  .help {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }
  .help p {
    font-size: 13px;
    font-weight: var(--fw-medium);
    color: var(--taupe);
    margin-bottom: 4px;
  }
  .help a:not(:global(.btn)) {
    font-family: var(--serif);
    font-size: var(--fs-lead);
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .help a:not(:global(.btn)):hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (max-width: 1100px) {
    .layout {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
  @media (max-width: 700px) {
    .intro {
      margin-bottom: 40px;
    }
    .layout {
      padding: 40px var(--pad-x-mob) var(--section-y-mob);
    }
    .process ol {
      grid-template-columns: 1fr;
    }
    .package-grid {
      grid-template-columns: 1fr;
    }
    .form-card {
      padding: 28px 20px;
      border-radius: var(--r-xl);
    }
    .extras-list li {
      padding: 14px 18px;
    }
  }
</style>
