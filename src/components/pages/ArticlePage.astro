---
/**
 * Article detail — one shared component for both locales' [slug] routes,
 * which were byte-identical apart from a locale literal. Supabase-backed
 * since FODEL 1.2; see src/lib/blog.ts.
 *
 * The route file looks the post up and answers 404 itself: a Response
 * returned from inside a component is dropped, so a missing slug used to
 * render an empty page with status 200 (and a five-minute CDN cache).
 */
export const prerender = false;

import { getImage } from 'astro:assets';
import Button from '~/components/Button.astro';
import Base from '~/layouts/Base.astro';
import { UI, path, localizer, type Locale } from '~/i18n/ui';
import { sourceNote } from '~/i18n/fallback';
import { crumbs } from '~/lib/page';
import { articleSchema, breadcrumbSchema } from '~/lib/seo';
import { formatDate } from '~/lib/format';
import { siblingPosts, postPath, postPathIn, type BlogPost } from '~/lib/blog';
import { renderMarkdown } from '~/lib/markdown';

interface Props {
  locale: Locale;
  post: BlogPost;
  /** The language the text is in, when it is not the page's (Dutch standing in for English, German, French). */
  from?: Locale;
}

const { locale, post, from = locale } = Astro.props;

const ui = UI[locale];
const x = localizer(locale);
const standIn = from !== locale;
const note = sourceNote(locale, from, 'article');
const url = postPathIn(locale, post.slug);
const html = renderMarkdown(post.body_md);

// hreflang only where a version really exists in that language — most posts
// have few, and asserting otherwise is exactly the bug the plan's architecture
// review flagged (Piacelemzés and Kopersgids are not translations of each
// other). The language menu is more generous: every language can open the
// article, so each row links to its page, with the stand-in note where the
// text is not in that language.
const siblings = await siblingPosts(post);
const versions: Partial<Record<Locale, string>> = Object.fromEntries(
  Object.entries(siblings).map(([code, version]) => [code, postPathIn(code as Locale, version!.slug)])
);
const hreflang = standIn ? {} : versions;
const switcher: Partial<Record<Locale, string>> = Object.fromEntries(
  (['hu', 'nl', 'en', 'de', 'fr', 'es', 'pl', 'ro', 'sk'] as const).map((code) => [code, versions[code] ?? postPathIn(code, post.slug)])
);

// The article's own share picture, cut to the 1200×630 the page's og:image
// tags declare — the same treatment property pages get. Without one the site
// default is used, never a guessed size.
const shareSource = post.og_image_url ?? post.cover_url;
let ogImage: string | undefined;
if (shareSource) {
  try {
    ogImage = (await getImage({ src: shareSource, width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src;
  } catch (error) {
    console.error('[article] share image could not be prepared', error);
  }
}

const isCase = post.kind === 'case_study';
const caseSections = isCase
  ? [
      { title: x('Módszertan', 'Methode', 'Method', 'Methode', 'Méthode', 'Método', 'Metoda', 'Metodă', 'Metóda', 'Metodo', 'Método', 'Μέθοδος', 'Metoda', 'Metoda', 'Metod', 'Metode', 'Metode', 'Menetelmä', 'Meetod', 'Metode', 'Metodas'), md: post.case_method },
      { title: x('Eredmények', 'Resultaten', 'Results', 'Ergebnisse', 'Résultats', 'Resultados', 'Wyniki', 'Rezultate', 'Výsledky', 'Risultati', 'Resultados', 'Αποτελέσματα', 'Výsledky', 'Rezultati', 'Resultat', 'Resultater', 'Resultater', 'Tulokset', 'Tulemused', 'Rezultāti', 'Rezultatai'), md: post.case_results },
      { title: x('Források', 'Bronnen', 'Sources', 'Quellen', 'Sources', 'Fuentes', 'Źródła', 'Surse', 'Zdroje', 'Fonti', 'Fontes', 'Πηγές', 'Zdroje', 'Viri', 'Källor', 'Kilder', 'Kilder', 'Lähteet', 'Allikad', 'Avoti', 'Šaltiniai'), md: post.case_sources },
    ].filter((section) => section.md?.trim())
  : [];

const trail = crumbs(locale, [
  { name: ui.nav.blog, url: path(locale, 'blog') },
  { name: post.title, url },
]);
---

<Base
  locale={locale}
  title={post.seo_title || post.title}
  description={post.seo_description || post.excerpt}
  alternates={hreflang}
  switcher={switcher}
  canonicalPath={standIn ? postPath(post) : undefined}
  ogType="article"
  ogImage={ogImage}
  schema={[
    articleSchema({
      title: post.title,
      description: post.excerpt,
      url,
      image: post.og_image_url ?? post.cover_url ?? undefined,
      published: post.published_at ?? post.updated_at,
      updated: post.updated_at,
      locale,
      author: post.author,
    }),
    breadcrumbSchema(trail),
  ]}
>
  <nav class="crumbs" aria-label={ui.a11y.breadcrumb}>
    <ol>
      {trail.map((c, i) => (
        <li>{i < trail.length - 1 ? <a href={c.url}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>
      ))}
    </ol>
  </nav>

  <article class="article">
    <header>
      <span class="pill">{isCase ? x('Esettanulmány', 'Casestudy', 'Case study', 'Fallstudie', 'Étude de cas', 'Caso práctico', 'Studium przypadku', 'Studiu de caz', 'Prípadová štúdia', 'Caso di studio', 'Estudo de caso', 'Μελέτη περίπτωσης', 'Případová studie', 'Študija primera', 'Fallstudie', 'Casestudie', 'Casestudie', 'Tapaustutkimus', 'Juhtumiuuring', 'Gadījuma izpēte', 'Atvejo analizė') : post.category}</span>
      <h1>{post.title}</h1>
      <p class="meta">
        {post.published_at && (
          <time datetime={post.published_at.toISOString()}>{formatDate(post.published_at, locale)}</time>
        )}
        <span aria-hidden="true">·</span>
        <span>{x(`${post.reading_minutes} perc olvasás`, `${post.reading_minutes} min. lezen`, `${post.reading_minutes} min read`, `${post.reading_minutes} Min. Lesezeit`, `${post.reading_minutes} min de lecture`, `${post.reading_minutes} min de lectura`, `${post.reading_minutes} min czytania`, `${post.reading_minutes} min de lectură`, `${post.reading_minutes} min čítania`, `${post.reading_minutes} min di lettura`, `${post.reading_minutes} min de leitura`, `${post.reading_minutes} λεπτά ανάγνωσης`, `${post.reading_minutes} min čtení`, `${post.reading_minutes} min branja`, `${post.reading_minutes} min läsning`, `${post.reading_minutes} min. læsning`, `${post.reading_minutes} min lesing`, `Lukuaika ${post.reading_minutes} min`, `Lugemisaeg ${post.reading_minutes} min`, `Lasīšanas laiks ${post.reading_minutes} min`, `Skaitymo laikas ${post.reading_minutes} min.`)}</span>
        <span aria-hidden="true">·</span>
        <span>{post.author}</span>
      </p>
      <p class="excerpt">{post.excerpt}</p>
      {note && <p class="stand-in">{note}</p>}
    </header>

    <div class="prose" set:html={html} />

    {caseSections.map((section) => (
      <section class="case-section">
        <h2>{section.title}</h2>
        <div class="prose" set:html={renderMarkdown(section.md!)} />
      </section>
    ))}

    <footer class="foot">
      <Button variant="text" href={path(locale, 'blog')}>{ui.nav.blog}</Button>
      <Button variant="dark" href={path(locale, 'properties')}>{ui.cta.browseProperties}</Button>
    </footer>
  </article>
</Base>

<style>
  /* "Article in Dutch": a quiet one-liner under the standfirst. */
  .stand-in {
    margin-top: 14px;
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    color: var(--taupe);
  }
  .case-section {
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }
  .case-section h2 {
    font-family: var(--serif);
    font-weight: var(--fw-medium);
    font-size: clamp(22px, 2vw, 28px);
    letter-spacing: -0.015em;
    color: var(--ink);
    margin-bottom: 16px;
  }
  .crumbs {
    padding: 28px var(--pad-x) 0;
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    list-style: none;
    font-size: 13.5px;
    color: var(--taupe);
  }
  .crumbs li {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .crumbs li + li::before {
    content: '';
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--taupe);
    opacity: 0.5;
  }
  .crumbs a:hover,
  .crumbs [aria-current] {
    color: var(--ink);
  }

  .article {
    max-width: calc(72ch + 2 * var(--pad-x));
    margin-inline: auto;
    padding: 56px var(--pad-x) var(--section-y);
  }
  .pill {
    display: inline-flex;
    align-items: center;
    height: 30px;
    padding: 0 13px;
    margin-bottom: 24px;
    border-radius: var(--r-pill);
    background: rgba(16, 42, 67, 0.07);
    font-size: 13px;
    font-weight: var(--fw-medium);
    color: var(--ink);
  }
  h1 {
    font-family: var(--serif);
    font-weight: var(--fw-hero);
    font-size: clamp(34px, 4.4vw, 64px);
    letter-spacing: var(--ls-display);
    line-height: 1.05;
    color: var(--ink);
    margin-bottom: 24px;
    animation: fx-fade-up 1.2s var(--ease-out) 0.2s both;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 13.5px;
    color: var(--taupe);
    margin-bottom: 28px;
  }
  .excerpt {
    font-size: var(--fs-lead);
    line-height: 1.65;
    color: var(--ink);
    padding: 26px 30px;
    border-radius: var(--r-xl);
    background: rgba(16, 42, 67, 0.04);
    margin-bottom: 48px;
  }

  .prose :global(h2) {
    font-family: var(--serif);
    font-weight: var(--fw-medium);
    font-size: clamp(24px, 2.4vw, 32px);
    letter-spacing: -0.015em;
    line-height: 1.2;
    color: var(--ink);
    margin: 48px 0 16px;
  }
  .prose :global(h3) {
    font-family: var(--serif);
    font-weight: var(--fw-medium);
    font-size: var(--fs-lead);
    color: var(--ink);
    margin: 32px 0 10px;
  }
  .prose :global(p) {
    font-size: var(--fs-body-lg);
    line-height: 1.75;
    color: var(--taupe);
    margin-bottom: 20px;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 20px 22px;
  }
  .prose :global(li) {
    font-size: var(--fs-body-lg);
    line-height: 1.7;
    color: var(--taupe);
    margin-bottom: 8px;
  }
  .prose :global(li::marker) {
    color: var(--ink);
  }
  .prose :global(a) {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .prose :global(hr) {
    border: none;
    height: 1px;
    background: var(--border);
    margin: 48px 0;
  }
  .prose :global(blockquote) {
    margin: 32px 0;
    padding: 24px 28px;
    border-radius: var(--r-lg);
    background: var(--white);
    border: 1px solid rgba(16, 42, 67, 0.07);
    font-family: var(--serif);
    font-size: var(--fs-lead);
    line-height: 1.55;
    color: var(--ink);
  }
  .prose :global(blockquote p) {
    margin: 0;
    color: inherit;
    font-size: inherit;
  }
  .prose :global(strong) {
    font-weight: var(--fw-medium);
    color: var(--ink);
  }
  .prose :global(img) {
    border-radius: var(--r-lg);
  }
  /* Markdown tables (e.g. a tax-rate schedule): readable, and scrollable on a phone. */
  .prose :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    margin: 0 0 28px;
    font-size: var(--fs-body);
    line-height: 1.55;
  }
  .prose :global(th),
  .prose :global(td) {
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
    color: var(--taupe);
  }
  .prose :global(th) {
    font-weight: var(--fw-medium);
    color: var(--ink);
    background: rgba(16, 42, 67, 0.04);
  }

  .foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 64px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }

  @media (max-width: 768px) {
    .crumbs {
      padding: 20px var(--pad-x-mob) 0;
    }
    .article {
      padding: 32px var(--pad-x-mob) var(--section-y-mob);
    }
    .excerpt {
      padding: 20px 22px;
    }
  }
</style>
