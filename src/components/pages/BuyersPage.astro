<style>
  /* ── Direct from the owner ── */
  .direct {
    padding: clamp(96px, 9vw, 144px) calc(var(--pad-x) - var(--slab-x)) clamp(72px, 7vw, 112px);
  }
  .direct-source {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 40px;
    font-size: 0.75rem;
    font-weight: var(--fw-medium);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--on-dark-body);
  }
  .direct-rule {
    width: 32px;
    height: 1px;
    background: var(--cream);
  }
  .direct-statement {
    max-width: 1180px;
    font-family: var(--serif);
    font-weight: var(--fw-light);
    font-size: clamp(34px, 4.6vw, 74px);
    line-height: 1.1;
    letter-spacing: var(--ls-display);
    color: var(--cream);
    text-wrap: balance;
  }
  .direct-foot {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 80px;
    align-items: end;
    margin-top: 128px;
    padding-top: 48px;
    border-top: 1px solid var(--on-dark-rule);
  }
  .direct-body {
    max-width: 56ch;
    font-size: var(--fs-body-lg);
    line-height: var(--lh-lead);
    color: var(--on-dark-body);
  }
  .direct-figure {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 16px;
  }
  .pct {
    display: block;
    font-family: var(--serif);
    font-weight: var(--fw-light);
    font-size: clamp(112px, 13vw, 208px);
    line-height: 0.8;
    letter-spacing: -0.04em;
    color: var(--cream);
  }
  .pct-sign {
    font-size: 0.5em;
    letter-spacing: 0;
    vertical-align: 0.72em;
    margin-inline-start: 0.04em;
  }
  .pct-note {
    font-size: var(--fs-small);
    letter-spacing: 0.06em;
    color: var(--on-dark-muted);
  }

  /* ── Services + wants ──
     Subgrid, so both lists start on one line whatever the headings wrap to.
     No gold rule under these heads: the list's own hairline is the rule. */
  .split {
    grid-template-rows: auto 1fr;
    margin-top: var(--slab-x);
  }
  .services,
  .wants {
    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
    row-gap: 0;
    align-content: start;
  }
  .split :global(.section-head-standard) {
    align-self: start;
    margin-bottom: 26px;
  }
  .services-more {
    margin-top: 36px;
  }

  /* ── Agricultural land ── */
  .agri {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 80px;
    align-items: center;
    padding: var(--section-y) var(--pad-x);
  }
  .agri-figure {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  /* The negative margin takes out the numeral's side bearing (~0.05em), so
     the ink of the 3 lines up with the label under it. */
  .ha {
    display: block;
    margin-inline-start: -0.05em;
    font-family: var(--serif);
    font-weight: var(--fw-light);
    font-size: clamp(120px, 16vw, 256px);
    line-height: 0.8;
    letter-spacing: -0.045em;
    color: var(--ink);
  }
  .ha-unit {
    font-size: 0.75rem;
    font-weight: var(--fw-medium);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--taupe);
  }
  .agri-copy p {
    max-width: 56ch;
    margin-bottom: 36px;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--taupe);
  }

  /* ── Featured ── */
  .featured {
    padding: var(--section-y) calc(var(--pad-x) - var(--slab-x));
    background: var(--linen);
  }
  .featured :global(.feat-head) {
    margin-bottom: 64px;
  }
  .feat-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
  }
  .feat-more {
    display: none;
    margin-top: 32px;
  }

  @media (max-width: 1080px) {
    .agri {
      gap: 48px;
    }
  }

  @media (max-width: 900px) {
    .direct {
      padding: 80px calc(var(--pad-x-mob) - var(--slab-x) + 4px) 56px;
    }
    .direct-source {
      margin-bottom: 32px;
    }
    .direct-foot {
      grid-template-columns: 1fr;
      gap: 40px;
      margin-top: 72px;
      padding-top: 36px;
    }
    .direct-figure {
      align-items: flex-start;
    }

    .split {
      grid-template-columns: 1fr;
      grid-template-rows: none;
    }
    .services,
    .wants {
      display: block;
    }

    .agri {
      grid-template-columns: 1fr;
      gap: 32px;
      padding: var(--section-y-mob) var(--pad-x-mob);
    }

    .featured {
      padding: var(--section-y-mob) calc(var(--pad-x-mob) - var(--slab-x) + 4px);
    }
    .featured :global(.feat-head) {
      margin-bottom: 36px;
    }
    .featured :global(.feat-link) {
      display: none;
    }
    .feat-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .feat-more {
      display: block;
    }
  }
</style>
