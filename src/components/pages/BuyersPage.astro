---
/**
 * Buyers. Ported from the prototype, with two additions: the "direct from the
 * owner" mechanic stated concretely (it is FODEL's differentiator and the
 * prototype only gestured at it), and the free search service, which is the
 * strongest call to action on this page.
 *
 * 1.4: the owner mechanic is set as the page's statement, lit word by word,
 * with the figure it earns the buyer (0% commission on a direct deal) as the
 * counterpart of the 4% on the sellers page. Lists, FAQ and the featured row
 * use the shared components, so every audience page reads the same way.
 */
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/PageHeader.astro';
import SectionHead from '~/components/SectionHead.astro';
import Button from '~/components/Button.astro';
import PropertyCard from '~/components/PropertyCard.astro';
import PointsList from '~/components/PointsList.astro';
import FaqAccordion from '~/components/FaqAccordion.astro';
import ParallaxCta from '~/components/ParallaxCta.astro';
import { UI, path, localizer, type Locale } from '~/i18n/ui';
import { AGRI_HECTARE_LIMIT } from '~/config/company';
import { copy } from '~/data/copy';
import { faqFor, faqAnswerText } from '~/data/faq';
import { alternatesFor } from '~/lib/page';
import { faqSchema } from '~/lib/seo';
import { homepageFeatured } from '~/lib/properties';
import vevoknek from '~/assets/properties/vevoknek.jpg';
import { nOf } from '~/i18n/plural';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = UI[locale];
const c = copy(locale).buyers;
const x = localizer(locale);

const buyerFaq = faqFor(locale, 'buyer').slice(0, 8);
const featured = await homepageFeatured(3);

// FAQ Q19 / Q21 — what FODEL say Dutch and Belgian buyers actually look for.
const wantsByLocale = {
  hu: [
    'Vidéki, reális árú ingatlanok',
    'Hegyvidéki ingatlanok kilátással',
    'Erdőszéli, erdőközeli ingatlanok',
    'Kiadható nyaralók, vízparti ingatlanok',
    'Állattartásra, lótartásra alkalmas tanyák',
    'Nagy földterületek, agráringatlanok',
    'Ferihegyhez jó közlekedéssel rendelkező ingatlanok',
    'A Dunántúlon fekvő ingatlanok',
  ],
  nl: [
    'Landelijk gelegen woningen met een reële prijs',
    'Woningen op een heuvel, met uitzicht',
    'Panden aan de bosrand',
    'Verhuurbare vakantiehuizen en waterkant',
    'Boerderijen geschikt voor vee en paarden',
    'Grote percelen en agrarisch vastgoed',
    'Goede verbinding met de luchthaven van Boedapest',
    'Vastgoed in Transdanubië',
  ],
  en: [
    'Rural properties at a realistic price',
    'Hilltop properties with a view',
    'Properties at the edge of a forest',
    'Holiday homes to let, and waterside properties',
    'Farms suitable for livestock and horses',
    'Large plots and agricultural property',
    'Good links to Budapest airport',
    'Property in Transdanubia',
  ],
  de: [
    'Ländliche Immobilien zu einem realistischen Preis',
    'Immobilien auf einem Hügel, mit Aussicht',
    'Objekte am Waldrand',
    'Vermietbare Ferienhäuser und Immobilien am Wasser',
    'Höfe, geeignet für Vieh und Pferde',
    'Große Grundstücke und Agrarimmobilien',
    'Gute Anbindung an den Flughafen Budapest',
    'Immobilien in Transdanubien',
  ],
  fr: [
    'Des biens à la campagne, à un prix réaliste',
    'Des biens sur les collines, avec vue',
    'Des biens en lisière de forêt',
    'Des maisons de vacances à louer et des biens au bord de l’eau',
    'Des fermes adaptées au bétail et aux chevaux',
    'De grands terrains et des biens agricoles',
    'Une bonne liaison avec l’aéroport de Budapest',
    'Des biens en Transdanubie',
  ],
  es: [
    'Inmuebles en el campo, a un precio realista',
    'Inmuebles en colinas, con vistas',
    'Inmuebles en el linde del bosque',
    'Casas vacacionales en alquiler e inmuebles junto al agua',
    'Fincas aptas para ganado y caballos',
    'Grandes parcelas e inmuebles rústicos',
    'Buena conexión con el aeropuerto de Budapest',
    'Inmuebles en Transdanubia',
  ],
  pl: [
    'Nieruchomości na wsi w realnej cenie',
    'Nieruchomości na wzgórzach, z widokiem',
    'Nieruchomości na skraju lasu',
    'Domy wakacyjne na wynajem i nieruchomości nad wodą',
    'Gospodarstwa odpowiednie do hodowli bydła i koni',
    'Duże działki i nieruchomości rolne',
    'Dobry dojazd do lotniska w Budapeszcie',
    'Nieruchomości w Zadunaju',
  ],
  ro: [
    'Proprietăți la țară, la un preț realist',
    'Proprietăți pe dealuri, cu priveliște',
    'Proprietăți la marginea pădurii',
    'Case de vacanță de închiriat și proprietăți lângă apă',
    'Ferme potrivite pentru animale și cai',
    'Terenuri mari și proprietăți agricole',
    'Legătură bună cu aeroportul din Budapesta',
    'Proprietăți în Transdanubia',
  ],
  sk: [
    'Nehnuteľnosti na vidieku za reálnu cenu',
    'Nehnuteľnosti na kopcoch s výhľadom',
    'Nehnuteľnosti na okraji lesa',
    'Rekreačné domy na prenájom a nehnuteľnosti pri vode',
    'Farmy vhodné na chov dobytka a koní',
    'Veľké pozemky a poľnohospodárske nehnuteľnosti',
    'Dobré spojenie s letiskom v Budapešti',
    'Nehnuteľnosti v Zadunajsku',
  ],
};
const wants = wantsByLocale[locale];
---

<Base
  locale={locale}
  title={c.meta.title}
  description={c.meta.description}
  alternates={alternatesFor('buyers')}
  schema={
    buyerFaq.length > 0
      ? [faqSchema(buyerFaq.map((e) => ({ question: e.question, answer: faqAnswerText(e) })))]
      : []
  }
>
  <PageHeader
    eyebrow={c.hero.eyebrow}
    title={c.hero.title}
    titleEm={c.hero.titleEm}
    body={c.hero.body}
    image={vevoknek}
    imageAlt={x('Felújított magyar parasztház belső tere', 'Interieur van een gerenoveerde Hongaarse woning', 'Interior of a renovated Hungarian farmhouse', 'Innenraum eines renovierten ungarischen Bauernhauses', 'Intérieur d’une maison hongroise rénovée', 'Interior de una casa de campo húngara reformada', 'Wnętrze wyremontowanego węgierskiego domu wiejskiego', 'Interiorul unei case de țară maghiare renovate', 'Interiér zrekonštruovaného maďarského vidieckeho domu')}
    primary={{ label: c.hero.cta, href: path(locale, 'properties') }}
    secondary={{ label: c.hero.secondary, href: path(locale, 'searchRequest') }}
  />

  {/* ── Direct from the owner ── */}
  <section class="direct slab surface-ink" data-bg="dark">
    <p class="direct-source reveal">
      <span class="direct-rule draw" aria-hidden="true"></span>
      {x('A FODEL-modell', 'Het FODEL-model', 'The FODEL model', 'Das FODEL-Modell', 'Le modèle FODEL', 'El modelo FODEL', 'Model FODEL', 'Modelul FODEL', 'Model FODEL')}
    </p>
    <h2 class="direct-statement" data-words>
      {x(
        'A hirdetésben a tulajdonos neve és telefonszáma is szerepel.',
        'Bij de advertentie staan ook de naam en het nummer van de eigenaar.',
        'The owner’s name and number are in the listing too.',
        'Beim Inserat stehen auch Name und Nummer des Eigentümers.',
        'L’annonce indique aussi le nom et le numéro du propriétaire.',
        'El anuncio también indica el nombre y el teléfono del propietario.',
        'W ogłoszeniu podane są również imię i nazwisko oraz numer telefonu właściciela.',
        'Anunțul conține și numele și numărul de telefon al proprietarului.',
        'V inzeráte nájdete aj meno a telefónne číslo majiteľa.'
      )}
    </h2>

    <div class="direct-foot">
      <p class="direct-body reveal">
        {x(
          'Ez nem szlogen, hanem a modellünk lényege. Ahol a tulajdonos hozzájárult, ott közvetlenül felveheti vele a kapcsolatot. Ha így köti meg az üzletet, sem Önnek, sem az eladónak nem kell jutalékot fizetnie. Mi a hirdetésért kaptunk díjat.',
          'Dat is geen slogan maar de kern van ons model. Waar de eigenaar daarmee heeft ingestemd, kunt u rechtstreeks contact opnemen. Regelt u de koop zo, dan betaalt niemand courtage. Wij zijn al betaald voor de advertentie.',
          'This is not a slogan but the heart of our model. Where the owner has agreed to it, you can contact them directly. If you arrange the purchase that way, nobody pays commission. We have already been paid for the listing.',
          'Das ist kein Slogan, sondern der Kern unseres Modells. Wo der Eigentümer zugestimmt hat, können Sie ihn direkt kontaktieren. Regeln Sie den Kauf auf diesem Weg, fällt für niemanden Provision an. Wir sind für das Inserat bereits bezahlt.',
          'Ce n’est pas un slogan, c’est le cœur de notre modèle. Lorsque le propriétaire y a consenti, vous pouvez le contacter directement. Si vous réglez l’achat ainsi, personne ne paie de commission. Nous avons déjà été rémunérés pour l’annonce.',
          'No es un eslogan, sino la esencia de nuestro modelo. Si el propietario lo ha autorizado, puede contactar con él directamente. Si cierra la compra de este modo, nadie paga comisión. Ya hemos cobrado por el anuncio.',
          'To nie slogan, lecz istota naszego modelu. Jeśli właściciel wyraził na to zgodę, mogą Państwo skontaktować się z nim bezpośrednio. Przy takim zakupie nikt nie płaci prowizji – za ogłoszenie otrzymaliśmy już wynagrodzenie.',
          'Nu este un slogan, ci esența modelului nostru. Dacă proprietarul a fost de acord, îl puteți contacta direct. Dacă încheiați achiziția astfel, nimeni nu plătește comision. Am fost deja plătiți pentru anunț.',
          'Nie je to slogan, ale podstata nášho modelu. Ak s tým majiteľ súhlasil, môžete ho kontaktovať priamo. Ak kúpu dohodnete takto, nikto neplatí províziu. Za inzerát sme už dostali zaplatené.'
        )}
      </p>
      <div class="direct-figure reveal">
        <span class="pct num">0<span class="pct-sign">%</span></span>
        <span class="pct-note">
          {x('jutalék közvetlen üzletkötésnél', 'courtage bij een directe koop', 'commission on a direct purchase', 'Provision bei direktem Kauf', 'de commission en cas d’achat direct', 'de comisión en una compra directa', 'prowizji przy zakupie bezpośrednim', 'comision la achiziția directă', 'provízia pri priamej kúpe')}
        </span>
      </div>
    </div>
  </section>

  {/* ── What we handle + what buyers look for ── */}
  <div class="split duo">
    <section class="services duo-panel duo-paper reveal">
      <SectionHead eyebrow={c.services.eyebrow} title={c.services.title} rule={false} />
      <div>
        <PointsList items={c.services.points} />
        <div class="services-more">
          <Button variant="text" href={path(locale, 'services')}>
            {x('Szolgáltatások és díjak', 'Diensten en tarieven', 'Services and prices', 'Leistungen und Preise', 'Services et tarifs', 'Servicios y tarifas', 'Usługi i ceny', 'Servicii și tarife', 'Služby a ceny')}
          </Button>
        </div>
      </div>
    </section>

    <section class="wants duo-panel duo-linen reveal">
      <SectionHead eyebrow={c.reasons.eyebrow} title={c.reasons.title} rule={false} />
      <PointsList items={wants} />
    </section>
  </div>

  {/* ── Agricultural land ── */}
  <section class="agri">
    <div class="agri-figure reveal" aria-hidden="true">
      <span class="ha num">{AGRI_HECTARE_LIMIT}</span>
      <span class="ha-unit">{x('hektár', 'hectare', 'hectares', 'Hektar', 'hectares', 'hectáreas', 'hektarów', 'de hectare', 'hektárov')}</span>
    </div>
    <div class="agri-copy reveal">
      <SectionHead
        eyebrow={x('Agráringatlan', 'Agrarisch vastgoed', 'Agricultural property', 'Agrarimmobilien', 'Immobilier agricole', 'Inmuebles rústicos', 'Nieruchomości rolne', 'Proprietăți agricole', 'Poľnohospodárske nehnuteľnosti')}
        title={x(
          `Agrárvégzettséggel ${AGRI_HECTARE_LIMIT} hektárig vásárolhat`,
          `Met een agrarische kwalificatie tot ${AGRI_HECTARE_LIMIT} hectare`,
          `Buy up to ${AGRI_HECTARE_LIMIT} hectares with an agricultural qualification`,
          `Mit landwirtschaftlicher Qualifikation bis zu ${AGRI_HECTARE_LIMIT} Hektar kaufen`,
          `Jusqu’à ${AGRI_HECTARE_LIMIT} hectares avec une qualification agricole`,
          `Hasta ${AGRI_HECTARE_LIMIT} hectáreas con cualificación agraria`,
          `Do ${nOf('pl', AGRI_HECTARE_LIMIT, 'hektara', 'hektarów')} z kwalifikacjami rolniczymi`,
          `Până la ${nOf('ro', AGRI_HECTARE_LIMIT, 'hectar', 'hectare', 'de hectare')} cu calificare agricolă`,
          `Až ${nOf('sk', AGRI_HECTARE_LIMIT, 'hektár', 'hektáre', 'hektárov')} s poľnohospodárskou kvalifikáciou`
        )}
      />
      <p>
        {x(
          `Uniós állampolgár agrárvégzettséggel Magyarországon összesen ${AGRI_HECTARE_LIMIT} hektár földterület megvásárlására jogosult. Ennek a procedúrának a teljes körű leszervezését a FODEL vállalja.`,
          `Een EU-burger met een agrarische kwalificatie mag in Hongarije in totaal ${AGRI_HECTARE_LIMIT} hectare grond verwerven. Die hele procedure regelen wij voor u.`,
          `An EU citizen with an agricultural qualification may acquire a total of ${AGRI_HECTARE_LIMIT} hectares of land in Hungary. We handle that whole procedure for you.`,
          `Ein EU-Bürger mit landwirtschaftlicher Qualifikation darf in Ungarn insgesamt ${AGRI_HECTARE_LIMIT} Hektar Land erwerben. Das gesamte Verfahren übernehmen wir für Sie.`,
          `Un citoyen de l’UE titulaire d’une qualification agricole peut acquérir au total ${AGRI_HECTARE_LIMIT} hectares de terres en Hongrie. Nous nous chargeons de toute la procédure.`,
          `Un ciudadano de la UE con cualificación agraria puede adquirir en total ${AGRI_HECTARE_LIMIT} hectáreas de tierra en Hungría. Nos encargamos de todo el procedimiento.`,
          `Obywatel UE posiadający kwalifikacje rolnicze może nabyć na Węgrzech łącznie ${nOf('pl', AGRI_HECTARE_LIMIT, 'hektar', 'hektary', 'hektarów')} gruntów. Całą procedurę przeprowadzamy za Państwa.`,
          `Un cetățean UE cu calificare agricolă poate dobândi în Ungaria, în total, ${nOf('ro', AGRI_HECTARE_LIMIT, 'hectar', 'hectare', 'de hectare')} de teren. Ne ocupăm de întreaga procedură.`,
          `Občan EÚ s poľnohospodárskou kvalifikáciou môže v Maďarsku nadobudnúť spolu ${nOf('sk', AGRI_HECTARE_LIMIT, 'hektár', 'hektáre', 'hektárov')} pôdy. Celý postup vybavíme za vás.`
        )}
      </p>
      <Button variant="outline" href={path(locale, 'agricultural')}>
        {x('Részletek', 'Meer hierover', 'More on this', 'Mehr dazu', 'En savoir plus', 'Más información', 'Dowiedz się więcej', 'Aflați mai multe', 'Viac informácií')}
      </Button>
    </div>
  </section>

  {/* ── Featured ── */}
  {
    featured.length > 0 && (
      <section class="featured slab">
        <SectionHead
          eyebrow={x('Válogatás', 'Selectie', 'Selection', 'Auswahl', 'Sélection', 'Selección', 'Wybór', 'Selecție', 'Výber')}
          title={x('Kiemelt ingatlanok', 'Uitgelicht aanbod', 'Featured properties', 'Empfohlene Immobilien', 'Biens à la une', 'Inmuebles destacados', 'Wyróżnione nieruchomości', 'Proprietăți recomandate', 'Vybrané nehnuteľnosti')}
          size="large"
          class="feat-head reveal"
        >
          <Button variant="text" href={path(locale, 'properties')} class="feat-link">
            {ui.cta.allProperties}
          </Button>
        </SectionHead>
        <div class="feat-grid">
          {featured.map((p) => (
            <PropertyCard
              property={p}
              locale={locale}
              ratio="4 / 5"
              sizes="(max-width: 900px) 100vw, 30vw"
            />
          ))}
        </div>
        <div class="feat-more">
          <Button variant="outline" href={path(locale, 'properties')} block arrow>
            {ui.cta.allProperties}
          </Button>
        </div>
      </section>
    )
  }

  {/* ── Buyer FAQ ── */}
  <FaqAccordion
    eyebrow={x('Gyakori kérdések', 'Veelgestelde vragen', 'Frequently asked questions', 'Häufige Fragen', 'Questions fréquentes', 'Preguntas frecuentes', 'Najczęściej zadawane pytania', 'Întrebări frecvente', 'Časté otázky')}
    title={x('Amit a vevők kérdezni szoktak', 'Wat kopers ons vragen', 'What buyers ask us', 'Was Käufer uns fragen', 'Ce que nous demandent les acheteurs', 'Lo que nos preguntan los compradores', 'O co pytają nas kupujący', 'Ce ne întreabă cumpărătorii', 'Na čo sa nás pýtajú kupujúci')}
    entries={buyerFaq}
    moreHref={path(locale, 'faq')}
    moreLabel={x('Összes kérdés és válasz', 'Alle vragen en antwoorden', 'All questions and answers', 'Alle Fragen und Antworten', 'Toutes les questions et réponses', 'Todas las preguntas y respuestas', 'Wszystkie pytania i odpowiedzi', 'Toate întrebările și răspunsurile', 'Všetky otázky a odpovede')}
  />

  <ParallaxCta
    eyebrow={x('Nem találta meg?', 'Niet gevonden?', 'Cannot find it?', 'Nichts Passendes gefunden?', 'Pas trouvé\u202f?', '¿No lo encuentra?', 'Nie znaleźli Państwo?', 'Nu găsiți ce căutați?', 'Nenašli ste?')}
    title={x('Kerestesse velünk', 'Laat ons zoeken', 'Let us search', 'Wir suchen', 'Laissez-nous chercher', 'Déjenos buscar', 'Poszukamy za Państwa', 'Lăsați-ne pe noi să căutăm', 'Nechajte hľadanie na nás')}
    titleEm={x('díjmentesen', 'zonder kosten', 'free of charge', 'kostenlos für Sie', 'gratuitement', 'gratis', 'bezpłatnie', 'gratuit', 'bezplatne')}
    body={x(
      'Adja meg, mit keres. A nem hirdetett kínálatból is keresünk Önnek.',
      'Geef door wat u zoekt. Wij zoeken ook buiten het geadverteerde aanbod.',
      'Tell us what you are looking for. We also search beyond the properties we advertise.',
      'Sagen Sie uns, was Sie suchen. Wir suchen auch außerhalb des inserierten Angebots.',
      'Dites-nous ce que vous cherchez. Nous cherchons aussi au-delà des biens annoncés.',
      'Díganos qué busca. También buscamos más allá de los inmuebles que anunciamos.',
      'Prosimy napisać, czego Państwo szukają. Szukamy także poza ogłoszeniami w naszym serwisie.',
      'Spuneți-ne ce căutați. Căutăm și dincolo de proprietățile pe care le avem în anunțuri.',
      'Povedzte nám, čo hľadáte. Hľadáme aj mimo nehnuteľností, ktoré inzerujeme.'
    )}
    primary={{ label: ui.cta.searchRequest, href: path(locale, 'searchRequest') }}
    secondary={{ label: ui.cta.contact, href: path(locale, 'contact') }}
  />
</Base>

<style>
  /* ── Direct from the owner ── */
  .direct {
    padding: clamp(96px, 9vw, 144px) calc(var(--pad-x) - var(--slab-x)) clamp(72px, 7vw, 112px);
  }
  .direct-source {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 40px;
    font-size: 0.75rem;
    font-weight: var(--fw-medium);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--on-dark-body);
  }
  .direct-rule {
    width: 32px;
    height: 1px;
    background: var(--cream);
  }
  .direct-statement {
    max-width: 1180px;
    font-family: var(--serif);
    font-weight: var(--fw-light);
    font-size: clamp(34px, 4.6vw, 74px);
    line-height: 1.1;
    letter-spacing: var(--ls-display);
    color: var(--cream);
    text-wrap: balance;
  }
  .direct-foot {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 80px;
    align-items: end;
    margin-top: 128px;
    padding-top: 48px;
    border-top: 1px solid var(--on-dark-rule);
  }
  .direct-body {
    max-width: 56ch;
    font-size: var(--fs-body-lg);
    line-height: var(--lh-lead);
    color: var(--on-dark-body);
  }
  .direct-figure {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 16px;
  }
  .pct {
    display: block;
    font-family: var(--serif);
    font-weight: var(--fw-light);
    font-size: clamp(112px, 13vw, 208px);
    line-height: 0.8;
    letter-spacing: -0.04em;
    color: var(--cream);
  }
  .pct-sign {
    font-size: 0.5em;
    letter-spacing: 0;
    vertical-align: 0.72em;
    margin-left: 0.04em;
  }
  .pct-note {
    font-size: var(--fs-small);
    letter-spacing: 0.06em;
    color: var(--on-dark-muted);
  }

  /* ── Services + wants ──
     Subgrid, so both lists start on one line whatever the headings wrap to.
     No gold rule under these heads: the list's own hairline is the rule. */
  .split {
    grid-template-rows: auto 1fr;
    margin-top: var(--slab-x);
  }
  .services,
  .wants {
    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
    row-gap: 0;
    align-content: start;
  }
  .split :global(.section-head-standard) {
    align-self: start;
    margin-bottom: 26px;
  }
  .services-more {
    margin-top: 36px;
  }

  /* ── Agricultural land ── */
  .agri {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 80px;
    align-items: center;
    padding: var(--section-y) var(--pad-x);
  }
  .agri-figure {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  /* The negative margin takes out the numeral's side bearing (~0.05em), so
     the ink of the 3 lines up with the label under it. */
  .ha {
    display: block;
    margin-left: -0.05em;
    font-family: var(--serif);
    font-weight: var(--fw-light);
    font-size: clamp(120px, 16vw, 256px);
    line-height: 0.8;
    letter-spacing: -0.045em;
