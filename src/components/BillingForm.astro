---
/**
 * The customer's billing details, entered once and reused: on every order, on
 * every invoice. Used in Settings, in the guided listing setup and, with an
 * order id, right inside the payment panel so nobody has to leave the page
 * they are paying on.
 *
 * The tax number is read the way people write it (12345678-1-23), shown in
 * its EU form (HU12345678) and decides whether VAT is charged: a business
 * with a valid EU VAT id is invoiced without Dutch VAT (reverse charge).
 *
 * Launch round: speaks the seller's language (hu/nl/en), takes the phone number
 * through the international PhoneField, and checks the postcode against the
 * chosen country's format (HU 4 digits, NL "1234 AB", DE 5 digits…) on blur
 * — the server checks both again (api/portal/settings/billing.ts).
 */
import { COUNTRIES, type Party } from '~/lib/invoicing/model';
import { postcodeExample } from '~/lib/validation';
import PhoneField from '~/components/forms/PhoneField.astro';
import type { PortalLang } from '~/lib/portal/auth-copy';

interface Props {
  billing?: Partial<Party> | null;
  fallbackName?: string;
  fallbackPhone?: string;
  paymentId?: string;
  compact?: boolean;
  locale?: PortalLang;
  /** Hide the form's own save button (the guided setup saves it with "Continue"). */
  embedded?: boolean;
}
const { billing, fallbackName = '', fallbackPhone = '', paymentId, compact = false, locale = 'hu', embedded = false } = Astro.props;
const b = { type: 'person', countryCode: { hu: 'HU', nl: 'NL', en: 'GB' }[locale], ...(billing ?? {}) } as Partial<Party>;
const uid = `bf-${Math.random().toString(36).slice(2, 8)}`;
const countryNames = new Intl.DisplayNames([locale], { type: 'region' });
const countryLabel = (c: (typeof COUNTRIES)[number]) => (locale === 'en' ? (countryNames.of(c.code) ?? c.nl) : c[locale]);
const t = {
  hu: {
      kind: 'Számlázás típusa', person: 'Magánszemély', company: 'Vállalkozás',
      nameCompany: 'Cégnév', namePerson: 'Név a számlán', country: 'Ország', postcode: 'Irányítószám', city: 'Város', street: 'Utca, házszám',
      tax: 'Adószám', optional: '(nem kötelező)', required: '(kötelező)',
      taxPlaceholder: 'pl. 12345678-1-23',
      taxHint: 'Ha vállalkozásként vásárol, az adószámával áfa nélküli (fordított adózású) számlát kaphat.',
      taxInvalid: 'Nem tűnik érvényes adószámnak. Magyar adószám: 12345678-1-23; uniós: országkóddal, pl. NL123456789B01.',
      example: 'pl.',
      save: 'Számlázási adatok mentése', saving: 'Mentés…', saved: 'Számlázási adatok mentve.', failed: 'A mentés nem sikerült.',
    },
  nl: {
      kind: 'Soort factuur', person: 'Particulier', company: 'Bedrijf',
      nameCompany: 'Bedrijfsnaam', namePerson: 'Naam op de factuur', country: 'Land', postcode: 'Postcode', city: 'Plaats', street: 'Straat en huisnummer',
      tax: 'Btw-nummer', optional: '(optioneel)', required: '(verplicht)',
      taxPlaceholder: 'bijv. NL123456789B01',
      taxHint: 'Koopt u zakelijk, dan ontvangt u met uw btw-nummer een factuur zonder btw (verlegd).',
      taxInvalid: 'Dit lijkt geen geldig btw-nummer. Vermeld de landcode, bijv. NL123456789B01.',
      example: 'bijv.',
      save: 'Factuurgegevens opslaan', saving: 'Opslaan…', saved: 'Factuurgegevens opgeslagen.', failed: 'Opslaan is niet gelukt.',
    },
  en: {
      kind: 'Billing type', person: 'Individual', company: 'Business',
      nameCompany: 'Company name', namePerson: 'Name on the invoice', country: 'Country', postcode: 'Postcode', city: 'Town or city', street: 'Street and house number',
      tax: 'VAT number', optional: '(optional)', required: '(required)',
      taxPlaceholder: 'for example NL123456789B01',
      taxHint: 'If you are buying as a business, your VAT number gets you an invoice without VAT (reverse charge).',
      taxInvalid: 'This does not look like a valid VAT number. Include the country code, for example NL123456789B01.',
      example: 'for example',
      save: 'Save billing details', saving: 'Saving…', saved: 'Billing details saved.', failed: 'Saving failed.',
    },
}[locale];
const postcodeHint = (code: string) => {
  const example = postcodeExample(code);
  return example ? `${t.example} ${example}` : '';
};
---

<form
  class:list={['billing-form', { compact }]}
  data-billing
  data-payment={paymentId}
  data-locale={locale}
  data-embedded={embedded ? '' : undefined}
  data-strings={JSON.stringify({ saving: t.saving, saved: t.saved, failed: t.failed, taxHint: t.taxHint, taxInvalid: t.taxInvalid, namePerson: t.namePerson, nameCompany: t.nameCompany, example: t.example })}
  id={uid}
  novalidate
>
  <div class="bf-type" role="group" aria-label={t.kind}>
    <label><input type="radio" name="type" value="person" checked={b.type !== 'company'} /><span>{t.person}</span></label>
    <label><input type="radio" name="type" value="company" checked={b.type === 'company'} /><span>{t.company}</span></label>
  </div>
  <div class="bf-grid">
    <label class="wide"><span><span data-name-label>{b.type === 'company' ? t.nameCompany : t.namePerson}</span> <em>{t.required}</em></span><input name="name" value={b.name ?? fallbackName} autocomplete="name" enterkeyhint="next" required /><small class="bf-error" hidden></small></label>
    <label><span>{t.country} <em>{t.required}</em></span>
      <select name="countryCode" autocomplete="country">
        {COUNTRIES.map((c) => <option value={c.code} selected={c.code === b.countryCode}>{countryLabel(c)}</option>)}
      </select>
    </label>
    <label><span>{t.postcode} <em>{t.optional}</em></span><input name="postalCode" value={b.postalCode ?? ''} autocomplete="postal-code" autocapitalize="characters" enterkeyhint="next" data-postcode /><small data-postcode-hint>{postcodeHint(b.countryCode ?? 'HU')}</small><small class="bf-error" hidden></small></label>
    <label><span>{t.city} <em>{t.required}</em></span><input name="city" value={b.city ?? ''} autocomplete="address-level2" enterkeyhint="next" required /><small class="bf-error" hidden></small></label>
    <label><span>{t.street} <em>{t.required}</em></span><input name="street" value={b.street ?? ''} autocomplete="street-address" enterkeyhint="next" required /><small class="bf-error" hidden></small></label>
    <div class="wide bf-phone"><PhoneField locale={locale} name="phone" id={`${uid}-phone`} value={b.phone ?? fallbackPhone} /></div>
    <label class="wide"><span>{t.tax} <em>{t.optional}</em></span>
      <input name="taxNumber" value={b.taxNumber ?? ''} placeholder={t.taxPlaceholder} autocomplete="off" autocapitalize="characters" enterkeyhint="done" />
      <small data-tax-hint>{t.taxHint}</small>
    </label>
  </div>
  {!embedded && (
    <div class="bf-actions">
      <button type="submit" class="btn">{t.save}</button>
      <span class="bf-status" role="status"></span>
    </div>
  )}
</form>

<script>
  import { checkTaxId } from '~/lib/invoicing/model';
  import { validateField, normalizePostcode } from '~/lib/validation';
  import { loadValidationCopy } from '~/lib/validation-client';
  import { errorMessageIn } from '~/lib/validation-messages';

  type Strings = { saving: string; saved: string; failed: string; taxHint: string; taxInvalid: string; namePerson: string; nameCompany: string; example: string };

  /** Validates every field; returns the first invalid control (or null). Used by the setup too. */
  async function validateBilling(form: HTMLFormElement): Promise<HTMLElement | null> {
    const copy = await loadValidationCopy(form.dataset.locale ?? 'hu');
    const errorMessage = (e: Parameters<typeof errorMessageIn>[1], _locale?: string) => errorMessageIn(copy, e);
    const locale = form.dataset.locale ?? 'hu';
    const cc = (form.elements.namedItem('countryCode') as HTMLSelectElement).value;
    let first: HTMLElement | null = null;
    const mark = (control: HTMLInputElement, message: string | null) => {
      const error = control.closest('label, .field')?.querySelector<HTMLElement>('.bf-error, .error');
      control.toggleAttribute('aria-invalid', Boolean(message));
      if (message) control.setAttribute('aria-invalid', 'true');
      if (error) {
        error.textContent = message ?? '';
        error.hidden = !message;
      }
      if (message) first ??= control;
    };
    for (const name of ['name', 'city', 'street']) {
      const control = form.elements.namedItem(name) as HTMLInputElement;
      const e = validateField({ required: true, maxLength: 160 }, control.value);
      mark(control, e ? errorMessage(e, locale) : null);
    }
    const postcode = form.elements.namedItem('postalCode') as HTMLInputElement;
    const pe = validateField({ rule: 'postcode' }, postcode.value, cc);
    mark(postcode, pe ? errorMessage(pe, locale) : null);
    if (!pe && postcode.value) postcode.value = normalizePostcode(postcode.value, cc);
    const phone = form.querySelector<HTMLInputElement>('input[type="tel"]');
    const country = form.querySelector<HTMLSelectElement>('.pf-select')?.value;
    if (phone) {
      const e = validateField({ rule: 'phone' }, phone.value, country);
      mark(phone, e ? errorMessage(e, locale) : null);
    }
    return first;
  }
  (window as any).fodelValidateBilling = validateBilling;

  document.querySelectorAll<HTMLFormElement>('form[data-billing]').forEach((form) => {
    if (form.dataset.bound) return;
    form.dataset.bound = '1';
    const s = JSON.parse(form.dataset.strings ?? '{}') as Strings;
    const cc = form.elements.namedItem('countryCode') as HTMLSelectElement;
    const tax = form.elements.namedItem('taxNumber') as HTMLInputElement;
    const hint = form.querySelector<HTMLElement>('[data-tax-hint]')!;
    const postHint = form.querySelector<HTMLElement>('[data-postcode-hint]');
    const status = form.querySelector<HTMLElement>('.bf-status');
    const label = form.querySelector<HTMLElement>('[data-name-label]')!;

    const check = () => {
      const r = checkTaxId(cc.value, tax.value);
      hint.dataset.state = r.state;
      // The checker's own detail line is Hungarian; the other forms use their own words.
      hint.textContent =
        r.state === 'valid' ? `✓ ${r.value}` : r.state === 'invalid' ? (form.dataset.locale === 'hu' ? r.hint : s.taxInvalid) : s.taxHint;
      return r;
    };
    tax.addEventListener('blur', () => {
      const r = check();
      if (r.state === 'valid') tax.value = r.value;
    });
    tax.addEventListener('input', () => {
      if (hint.dataset.state === 'invalid') check();
    });
    cc.addEventListener('change', async () => {
      check();
      const { postcodeExample } = await import('~/lib/validation');
      const example = postcodeExample(cc.value);
      if (postHint) postHint.textContent = example ? `${s.example} ${example}` : '';
    });
    // Inline, on leaving a field — never while it is still being typed.
    form.addEventListener('focusout', (e) => {
      const target = e.target as HTMLElement;
      if (target.matches('input[name="postalCode"], input[type="tel"]') && (target as HTMLInputElement).value) void validateBilling(form);
    });
    const syncLabel = () => {
      const company = form.querySelector<HTMLInputElement>('input[name="type"]:checked')?.value === 'company';
      label.textContent = company ? s.nameCompany : s.namePerson;
    };
    form.querySelectorAll('input[name="type"]').forEach((r) => r.addEventListener('change', syncLabel));
    check();

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const invalid = await validateBilling(form);
      if (invalid) {
        invalid.focus();
        return;
      }
      const data = Object.fromEntries(new FormData(form).entries());
      if (status) status.textContent = s.saving;
      try {
        const res = await fetch('/api/portal/settings/billing', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ billing: data, paymentId: form.dataset.payment }),
        });
        const json = await res.json().catch(() => ({}));
        if (status) status.textContent = '';
        if (json.ok) {
          window.pf?.toast(s.saved, 'ok');
          if (json.billing?.taxNumber) tax.value = json.billing.taxNumber;
          form.dispatchEvent(new CustomEvent('billing:saved', { bubbles: true }));
        } else {
          form.dispatchEvent(new CustomEvent('billing:failed', { bubbles: true }));
          window.pf?.toast(json.message ?? s.failed, 'error');
        }
      } catch {
        if (status) status.textContent = '';
        form.dispatchEvent(new CustomEvent('billing:failed', { bubbles: true }));
        window.pf?.toast(s.failed, 'error');
      }
    });
  });
</script>

<style>
  .billing-form { display: grid; gap: 18px; }
  .bf-type { display: inline-flex; padding: 4px; gap: 2px; border-radius: var(--r-pill); background: var(--linen); box-shadow: inset 0 0 0 1px var(--pt-hair); justify-self: start; }
  .bf-type label { position: relative; cursor: pointer; }
  .bf-type input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  .bf-type span { display: block; padding: 9px 18px; border-radius: var(--r-pill); font-size: 14px; font-weight: var(--fw-medium); color: var(--ink-quiet); transition: background 0.25s var(--ease-out), color 0.25s, box-shadow 0.25s; }
  .bf-type input:checked + span { background: #fff; color: var(--ink); box-shadow: 0 1px 2px rgba(16, 42, 67, 0.12), 0 4px 12px -4px rgba(16, 42, 67, 0.18); }
  .bf-type input:focus-visible + span { outline: var(--focus-ring); outline-offset: 2px; }
  .bf-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 18px; }
  .bf-grid .wide { grid-column: 1 / -1; }
  .bf-grid label { display: grid; gap: 8px; font-size: var(--fs-small); font-weight: var(--fw-medium); color: var(--ink); align-content: start; }
  .bf-grid label em { font-style: normal; font-weight: var(--fw-regular); color: var(--ink-quiet); }
  .bf-grid input, .bf-grid select { width: 100%; min-height: 50px; padding: 12px 16px; font: inherit; font-weight: var(--fw-body); font-size: var(--fs-body); color: var(--ink); }
  .bf-grid small { font-weight: var(--fw-regular); font-size: 13px; line-height: 1.5; color: var(--ink-quiet); }
  .bf-grid small:empty { display: none; }
  .bf-grid small[data-state='valid'] { color: var(--pt-green); }
  .bf-grid small[data-state='invalid'] { color: var(--pt-red); }
  .bf-grid .bf-error { color: #b3261e; }
  .bf-grid .bf-error[hidden] { display: none; }
  .bf-grid [aria-invalid='true'] { border-color: #b3261e; }
  .bf-phone :global(.fld) { margin-bottom: 0; }
  .bf-actions { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .bf-status { font-size: 14px; color: var(--ink-quiet); }
  .compact .bf-grid { gap: 12px 14px; }
  .compact .bf-grid input, .compact .bf-grid select { min-height: 46px; padding: 10px 14px; }
  @media (max-width: 620px) { .bf-grid { grid-template-columns: 1fr; } }
</style>
