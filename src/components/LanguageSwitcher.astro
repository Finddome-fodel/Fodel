---
/**
 * The language menu: a flag + code toggle that lists all five languages, each
 * as a complete site. Every row links to the equivalent page when the template
 * passes `alternates`, and to that language's home page otherwise.
 *
 * Used twice per page (desktop nav + mobile drawer), so ids are randomised
 * per render rather than hardcoded, and the toggle script below is written
 * to set up every `[data-switcher]` instance it finds.
 *
 * Every row is a real `<a href>`: switching works with JavaScript off, and the
 * script only adds the open/close behaviour and remembers the choice in the
 * `fodel_lang` cookie the root page reads.
 */
import Flag from './Flag.astro';
import { LOCALE_META, SWITCHER_LOCALES, UI, type Locale } from '~/i18n/ui';

interface Props {
  locale: Locale;
  /** The same page in another language, where one exists. Falls back to that language's home. */
  alternates?: Partial<Record<Locale, string>>;
  align?: 'left' | 'right';
}

const { locale, alternates = {}, align = 'right' } = Astro.props;
const current = LOCALE_META[locale];
const uid = Math.random().toString(36).slice(2, 8);
const menuId = `lang-menu-${uid}`;
/** The toggle's accessible name, in the page's own language. */
const switchLabel = UI[locale].a11y.langSwitch;
---

<div class="switcher" data-switcher data-align={align}>
  <button
    type="button"
    class="switcher-toggle"
    aria-expanded="false"
    aria-controls={menuId}
  >
    <Flag code={current.flag} />
    <span aria-hidden="true">{current.short}</span>
    <span class="sr-only">{switchLabel}</span>
    <svg class="switcher-caret" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
      <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
  <ul class="switcher-menu" id={menuId}>
    {
      SWITCHER_LOCALES.map(({ code }) => {
        const meta = LOCALE_META[code];
        const active = code === locale;
        return (
          <li>
            <a
              href={alternates[code] ?? `/${code}/`}
              hreflang={meta.hreflang}
              lang={meta.htmlLang}
              class:list={['switcher-row', { active }]}
              aria-current={active ? 'true' : undefined}
              data-lang={code}
            >
              <Flag code={meta.flag} />
              <span class="switcher-name">{meta.label}</span>
              <span class="switcher-code" aria-hidden="true">
                {meta.short}
              </span>
            </a>
          </li>
        );
      })
    }
  </ul>
</div>

<script>
  /**
   * Remembered for a year so the root page (src/pages/index.astro) sends a
   * returning visitor to the language they chose, not the one their browser
   * happens to prefer — a Hungarian living in Utrecht who picked NL stays NL.
   */
  const rememberLanguage = (code: string) => {
    const secure = location.protocol === 'https:' ? '; Secure' : '';
    document.cookie = `fodel_lang=${code}; Max-Age=31536000; Path=/; SameSite=Lax${secure}`;
  };

  function setupSwitcher(root: HTMLElement) {
    const toggle = root.querySelector<HTMLButtonElement>('.switcher-toggle');
    const menu = root.querySelector<HTMLElement>('.switcher-menu');
    if (!toggle || !menu) return;
    const rows = () => Array.from(menu.querySelectorAll<HTMLAnchorElement>('a.switcher-row'));
    // Closed and out of the tab order from here on; without this script the
    // menu instead opens on hover and keyboard focus (see the CSS below).
    root.setAttribute('data-ready', '');
    menu.inert = true;

    const isOpen = () => root.hasAttribute('data-open');
    const setOpen = (open: boolean, focusFirst = false) => {
      root.toggleAttribute('data-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      menu.inert = !open;
      if (open && focusFirst) (rows().find((a) => a.classList.contains('active')) ?? rows()[0])?.focus();
    };

    toggle.addEventListener('click', () => setOpen(!isOpen(), true));

    // Closing rules, written for Safari. Safari does not focus a link or a
    // button on mouse click, so pressing a menu row moves focus to <body> and
    // fires `focusout` with no relatedTarget *between mousedown and click*.
    // Closing on that (as this used to) made the menu inert before the click
    // landed, so in Safari no language could be chosen at all. Now the menu
    // only closes on a press outside it, on Escape, or when focus genuinely
    // moves to another element on the page — never because focus went nowhere.
    document.addEventListener('pointerdown', (e) => {
      if (isOpen() && !root.contains(e.target as Node)) setOpen(false);
    });
    root.addEventListener('focusout', (e: FocusEvent) => {
      const next = e.relatedTarget;
      if (isOpen() && next instanceof Element && !root.contains(next)) setOpen(false);
    });
    root.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape' && isOpen()) {
        e.preventDefault();
        setOpen(false);
        toggle.focus();
        return;
      }
      // Arrow keys move through the rows, as in any menu-like list.
      if ((e.key === 'ArrowDown' || e.key === 'ArrowUp') && isOpen()) {
        e.preventDefault();
        const list = rows();
        const at = list.indexOf(document.activeElement as HTMLAnchorElement);
        const step = e.key === 'ArrowDown' ? 1 : -1;
        list[(at + step + list.length) % list.length]?.focus();
      }
    });

    menu.addEventListener('click', (e) => {
      const row = (e.target as Element).closest<HTMLAnchorElement>('a[data-lang]');
      if (row?.dataset.lang) rememberLanguage(row.dataset.lang);
    });

    // Coming back with the browser's Back button restores the page from the
    // back/forward cache exactly as it was left — menu open. Close it.
    window.addEventListener('pageshow', (e) => {
      if (e.persisted) setOpen(false);
    });
  }

  document.querySelectorAll<HTMLElement>('[data-switcher]').forEach(setupSwitcher);
</script>

<style>
  .switcher {
    position: relative;
  }
  .switcher-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    padding: 0 14px;
    border-radius: var(--r-pill);
    font-family: var(--sans);
    font-size: 0.9375rem;
    font-weight: var(--fw-medium);
    letter-spacing: 0.04em;
    color: var(--ink);
    background: none;
    border: none;
    cursor: pointer;
    transition: background-color var(--dur-fast) ease;
  }
  .switcher[data-open] .switcher-toggle {
    background: rgba(16, 42, 67, 0.065);
  }
  @media (hover: hover) {
    .switcher-toggle:hover {
      background: rgba(16, 42, 67, 0.065);
    }
  }
  .switcher-caret {
    color: var(--taupe);
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .switcher[data-open] .switcher-caret {
    transform: rotate(180deg);
  }

  .switcher-menu {
    position: absolute;
    top: calc(100% + 10px);
    min-width: 232px;
    background: var(--paper);
    border: 1px solid rgba(16, 42, 67, 0.08);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-float);
    list-style: none;
    padding: 6px;
    z-index: 1100;
    opacity: 0;
    transform: translateY(-6px) scale(0.97);
    transform-origin: top right;
    pointer-events: none;
    /* Hidden from tab order and touch once closed even where `inert` is not
       supported; the delay lets the closing fade finish first. */
    visibility: hidden;
    transition:
      opacity 0.3s var(--ease-out),
      transform 0.45s var(--ease-out),
      visibility 0s linear 0.45s;
  }
  .switcher[data-align='right'] .switcher-menu {
    right: 0;
  }
  .switcher[data-align='left'] .switcher-menu {
    left: 0;
    transform-origin: top left;
  }
  .switcher[data-open] .switcher-menu,
  .switcher:not([data-ready]):is(:hover, :focus-within) .switcher-menu {
    opacity: 1;
    transform: none;
    pointer-events: auto;
    visibility: visible;
    transition-delay: 0s;
  }

  .switcher-row {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding: 8px 12px;
    border-radius: var(--r-sm);
    font-family: var(--sans);
    font-size: var(--fs-small);
    color: var(--ink);
  }
  a.switcher-row {
    transition: background-color 0.25s ease;
  }
  @media (hover: hover) {
    a.switcher-row:hover {
      background: rgba(16, 42, 67, 0.06);
    }
  }
  a.switcher-row:focus-visible {
    background: rgba(16, 42, 67, 0.06);
    outline-offset: -2px;
  }
  a.switcher-row.active {
    background: rgba(16, 42, 67, 0.08);
    font-weight: var(--fw-medium);
  }
  .switcher-name {
    flex: 1;
  }
  .switcher-code {
    color: var(--taupe);
    font-size: 12px;
    letter-spacing: 0.08em;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .switcher-caret,
    .switcher-menu {
      transition: none;
    }
    .switcher[data-open] .switcher-menu {
      transform: none;
    }
  }
</style>
