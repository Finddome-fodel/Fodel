---
/**
 * A listing's photos: the package's photo meter, the rules, the tips, the
 * grid (cover photo, captions, delete) and the drop zone.
 *
 * Extracted from the property editor in the launch round so the guided setup
 * (properties/[id]/setup.astro) uses exactly the same uploader and rules —
 * the package photo limit (the server answers `photo-limit` past it, admins
 * excepted), in-browser downscaling of large phone photos before upload, and
 * the portrait / low-resolution flags. Hungarian in the editor; in the
 * setup it speaks the seller's language.
 *
 * Safari: the drop zone is a <label> around the file input, so a click opens
 * the picker natively. (A second, scripted click on top of that made Safari
 * open nothing at all.) Drag and drop reads `dataTransfer.files`, which Safari
 * supports.
 */
import PhotoTips from '~/components/PhotoTips.astro';
import type { PortalLang } from '~/lib/portal/auth-copy';
import { isPortrait, isLowResolution, photoHints } from '~/config/review-checklist';
import { resolveImage } from '~/lib/property-images';
import { MAX_UPLOAD_MB, MAX_EDGE, LOW_RESOLUTION_EDGE } from '~/lib/media';
import type { PortalMedia } from '~/lib/portal/properties';
import { PENDING_PHOTOS_MAX } from '~/lib/portal/photo-moderation';

/** A "these photos were not published" notice (migration 0053, property_media_rejections). */
export type PhotoNotice = { id: string; photo_count: number; reason_code: string | null; reason: string; note: string | null; created_at: string };

interface Props {
  propertyId: string;
  media: PortalMedia[];
  /** null = unlimited. */
  photoLimit: number | null;
  packageName: string;
  editable: boolean;
  isAdmin: boolean;
  locale?: PortalLang;
  /** Show the card heading (the editor); the setup has its own step heading. */
  withHeading?: boolean;
  /**
   * The owner of a live listing (§4c part 2): adding photos is free, every new
   * one waits for an admin; approved ones can be reordered, made the cover or
   * removed, but not swapped or recaptioned unseen.
   */
  live?: boolean;
  /** Rejections the owner has not closed yet. */
  notices?: PhotoNotice[];
}

const { propertyId, media, photoLimit: packageLimit, packageName, editable, isAdmin, locale = 'hu', withHeading = true, live = false, notices = [] } = Astro.props;

const photoLimit=packageLimit;
const moveLabel={hu:"Kép áthelyezése",nl:"Foto verplaatsen",en:"Move photo"}[locale];
const replaceLabel={hu:"Csere",nl:"Vervangen",en:"Replace"}[locale];

/** A demo photo (bare filename) needs Astro's asset pipeline to become a real URL; a real upload already is one. */
function mediaSrc(storagePath: string): string {
  if (storagePath.startsWith('http')) return storagePath;
  return resolveImage(storagePath).src;
}
const captionOf = (m: PortalMedia) => (m.alt as Record<string, string> | null)?.[locale] ?? (m.alt as Record<string, string> | null)?.hu ?? '';

const isPending = (m: PortalMedia) => m.pending === true;
// The cover is what the public sees: never a photo still waiting for review.
const hero = media.find((m) => m.is_hero && !isPending(m)) ?? media.find((m) => !isPending(m)) ?? media[0];
const ordered = media;
const photoCount = media.length;
const pendingCount = media.filter(isPending).length;
const approvedCount = photoCount - pendingCount;
const pendingFull = live && pendingCount >= PENDING_PHOTOS_MAX;
const photosFull = (photoLimit !== null && photoCount >= photoLimit) || pendingFull;
const hints = photoHints(media);
/** On a live listing the last approved photo stays: the listing would have no picture. */
const canRemove = (m: PortalMedia) => editable && (!live || isPending(m) || approvedCount > 1);
const canReplace = (m: PortalMedia) => editable && (!live || isPending(m));
const canCaption = (m: PortalMedia) => editable && (!live || isPending(m));

const t = {
