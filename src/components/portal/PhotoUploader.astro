---

<section
  id="media"
  class="photo-uploader"
  data-photo-uploader
  data-property-id={propertyId}
  data-locale={locale}
  data-strings={JSON.stringify(scriptStrings)}
>
  <header class="pu-head">
    {withHeading && (
      <div>
        <h2>{t.heading}</h2>
        <p>{t.sub}</p>
      </div>
    )}
    <p class:list={['photo-meter', { full: photosFull }]} title={packageName} data-photo-count={photoCount}>
      <b>{photoCount}{photoLimit !== null && <span> / {photoLimit}</span>}</b>
      <span>{photoLimit === null ? t.meterUnlimited : t.meterOf}</span>
    </p>
  </header>
  {!withHeading && <p class="pu-hint">{t.sub}</p>}

  {notices.length > 0 && (
    <ul class="pu-notices" data-photo-notices>
      {notices.map((n) => (
        <li class="pu-notice" data-notice={n.id}>
          <span class="pu-notice-ic" aria-hidden="true">!</span>
          <div>
            <p class="pu-notice-t">{t.noticeTitle(n.photo_count)}</p>
            <p class="pu-notice-r">{(n.reason_code && t.reasons[n.reason_code]) || n.note || n.reason}{n.reason_code && t.reasons[n.reason_code] && n.note ? <>: <q>{n.note}</q></> : null}</p>
            <p class="pu-notice-s">{t.noticeAgain}</p>
          </div>
          <button type="button" class="pu-notice-ok" data-dismiss-notice={n.id}>{t.noticeOk}</button>
        </li>
      ))}
    </ul>
  )}

  {live && editable && (
    <aside class="pu-live" aria-label={t.liveTitle}>
      <span class="pu-live-ic" aria-hidden="true">✦</span>
      <div>
        <p class="pu-live-t">{t.liveTitle}</p>
        <p>{t.liveBody}</p>
        <p class="pu-live-s">{t.liveLocked}</p>
        {pendingCount > 0 && <p class="pu-live-w"><span class="dot" aria-hidden="true"></span>{t.liveWaiting(pendingCount)}</p>}
      </div>
    </aside>
  )}
  {isAdmin && pendingCount > 0 && (
    <aside class="pu-live admin">
      <span class="pu-live-ic" aria-hidden="true">◷</span>
      <div>
        <p class="pu-live-t">{t.adminWaiting(pendingCount)}</p>
        <p><a class="pu-live-a" href={`/portal/photos#listing-${propertyId}`}>{t.adminModerate} →</a></p>
      </div>
    </aside>
  )}

  <p class="pu-hint">{t.rules}</p>

  <details class="photo-advice"><summary>{t.tipsHeading}</summary><PhotoTips locale={locale} variant="portal" heading={t.tipsHeading} why={false}/></details>

  {(hints.portrait > 0 || hints.lowResolution > 0) && <p class="pu-warn">{t.flags(hints.portrait, hints.lowResolution)}</p>}

  {media.length > 0 && <p class="pu-hint">{t.captions}</p>}

  <div class="media-grid" data-media-grid>
    {ordered.map((m) => (
      <figure class:list={['media-item', { 'is-pending': isPending(m) }]} data-media-id={m.id} data-hero={m === hero ? 'true' : undefined} data-pending={isPending(m) ? 'true' : undefined}>
        <div class="media-thumb">
          <img src={mediaSrc(m.storage_path)} alt={captionOf(m)} loading="lazy" decoding="async" />
          {m === hero && <span class="hero-badge">{t.cover}</span>}
          {isPending(m) && <span class="pending-badge" title={t.pendingTitle}><span class="dot" aria-hidden="true"></span>{t.pending}</span>}
          {(isPortrait(m) || isLowResolution(m)) && (
            <span class="photo-flags">
              {isPortrait(m) && <span title={t.portraitTitle}>{t.portrait}</span>}
              {isLowResolution(m) && <span title={t.lowTitle}>{t.low}</span>}
            </span>
          )}
          {m !== hero && editable && !isPending(m) && <button type="button" class="set-hero" data-set-hero={m.id}>{t.makeCover}</button>}
          {canRemove(m) && <button type="button" class="remove" data-remove-media={m.id} aria-label={t.remove}>×</button>}
        </div>
        <figcaption>
          {editable && <div class="photo-controls"><button type="button" data-photo-move="-1" aria-label={`${moveLabel}: ←`}>←</button><button type="button" data-photo-move="1" aria-label={`${moveLabel}: →`}>→</button>{canReplace(m) && <label class="photo-replace">{replaceLabel}<input type="file" accept="image/jpeg,image/png,image/webp" data-replace-photo={m.id}/></label>}<span class="photo-grip" draggable="true" data-photo-drag aria-label={moveLabel} title={moveLabel}>⠿</span></div>}

          <label class="sr-only" for={`caption-${m.id}`}>{t.captionLabel}</label>
          <input
            id={`caption-${m.id}`}
            class="caption"
            type="text"
            maxlength="160"
            placeholder={t.captionPlaceholder}
            value={captionOf(m)}
            data-caption-for={m.id}
            enterkeyhint="done"
            disabled={!canCaption(m)}
          />
        </figcaption>
      </figure>
    ))}
  </div>

  {photosFull && <p class="pu-warn" data-photo-full>{pendingFull ? t.pendingFull : t.full}</p>}
  {editable && (
    <label class="dropzone" data-dropzone hidden={photosFull}>
      <input type="file" accept="image/jpeg,image/png,image/webp" multiple class="dz-input" data-file-input />
      <span class="dz-ic" aria-hidden="true">+</span><span class="dz-t">{t.add}</span><span class="dz-s">{t.addSub}</span>
    </label>
  )}
  <p class="upload-status" role="status" data-upload-status></p>
</section>

<script>
  import { exposeShrinkImage } from '~/scripts/shrink-image';
  exposeShrinkImage();

  type Strings = {
    uploading: string;
    failed: string;
    tooBig: string;
    done: string;
    lowRes: string;
    captionFailed: string;
    confirmTitle: string;
    confirmBody: string;
    confirmLabel: string;
    donePending: string;
    actionFailed: string;
    noticeFailed: string;
    errors: Record<string, string>;
  };

  document.querySelectorAll<HTMLElement>('[data-photo-uploader]').forEach((root) => {
    const propertyId = root.dataset.propertyId!;
    const s = JSON.parse(root.dataset.strings ?? '{}') as Strings;
    const grid = root.querySelector<HTMLElement>('[data-media-grid]');
    const dropzone = root.querySelector<HTMLElement>('[data-dropzone]');
    const fileInput = root.querySelector<HTMLInputElement>('[data-file-input]');
    const status = root.querySelector<HTMLElement>('[data-upload-status]')!;
    const fill = (text: string, values: Record<string, string>) => text.replace(/\{(\w+)\}/g, (_, k) => values[k] ?? '');

    /** "The change failed: <why>", from the API's error code when it has one. */
    async function failure(response: Response): Promise<string> {
      const code = (await response.json().catch(() => ({})))?.error;
      const reason = typeof code === 'string' ? s.errors[code] : undefined;
      return reason ? `${s.actionFailed}: ${reason}.` : `${s.actionFailed}.`;
    }

    root.querySelectorAll<HTMLButtonElement>('[data-dismiss-notice]').forEach((button) =>
      button.addEventListener('click', async () => {
        const id = button.dataset.dismissNotice!;
        const item = button.closest<HTMLElement>('[data-notice]');
        button.disabled = true;
        const response = await fetch(`/api/portal/properties/${propertyId}/photo-notices`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ ids: [id] }),
        }).catch(() => null);
        if (response?.ok) {
          item?.classList.add('leaving');
          setTimeout(() => {
            const list = item?.parentElement;
            item?.remove();
            if (list && !list.children.length) list.remove();
          }, 260);
        } else {
          button.disabled = false;
          status.textContent = s.noticeFailed;
        }
      })
    );

    let uploading=false;
    async function uploadFiles(files: File[],replaceId?:string) {
      if(uploading)return;uploading=true;
      try{
      const soft: string[] = [];
      let queued = false;
      for (const file of files) {
        status.textContent = fill(s.uploading, { name: file.name });
        // Large phone photos are scaled down in the browser first — the server
        // accepts at most ~4.5 MB per request (src/scripts/shrink-image.ts).
        const prepared = window.fodelShrinkImage ? await window.fodelShrinkImage(file) : file;
        if (prepared.size > 4.4 * 1024 * 1024) {
          status.textContent = fill(s.tooBig, { name: file.name });
          return;
        }
        const body = new FormData();
        body.append('file', prepared);
        if(replaceId)body.append('replace',replaceId);
        try {
          const res = await fetch(`/api/portal/properties/${propertyId}/media`, { method: 'POST', body });
          const json = await res.json().catch(() => ({}));
          if (!res.ok || !json.ok) throw new Error(json.error ?? 'upload-failed');
          if (json.warning === 'low-resolution') soft.push(file.name);
          if (json.pending) queued = true;
        } catch (error) {
          const reason = s.errors[(error as Error).message];
          status.textContent = `${fill(s.failed, { name: file.name })}${reason ? `: ${reason}` : ''}`;
          root.dispatchEvent(new CustomEvent('photos:error', { bubbles: true, detail: (error as Error).message }));
          if (['photo-limit', 'pending-limit'].includes((error as Error).message)) setTimeout(() => location.reload(), 2500);
          return;
        }
      }
      status.textContent = soft.length ? fill(s.lowRes, { names: soft.join(', ') }) : queued ? s.donePending : s.done;
      setTimeout(() => location.reload(), soft.length ? 4000 : queued ? 2200 : 0);
      }catch{status.textContent=s.failed.replace('{name}',files[0]?.name||'');}finally{uploading=false;}
    }

    root.querySelectorAll<HTMLInputElement>('[data-replace-photo]').forEach(input=>input.addEventListener('change',()=>{if(input.files?.[0])void uploadFiles([input.files[0]],input.dataset.replacePhoto);}));

    fileInput?.addEventListener('change', () => {
      if (fileInput.files?.length) void uploadFiles([...fileInput.files]);
      fileInput.value = '';
    });
    (['dragover', 'dragenter'] as const).forEach((evt) =>
      dropzone?.addEventListener(evt, (e) => {
        e.preventDefault();
        dropzone.classList.add('drag');
      })
    );
    (['dragleave', 'drop'] as const).forEach((evt) =>
      dropzone?.addEventListener(evt, (e) => {
        e.preventDefault();
        dropzone.classList.remove('drag');
      })
    );
    dropzone?.addEventListener('drop', (e) => {
      const files = (e as DragEvent).dataTransfer?.files;
      if (files?.length) void uploadFiles([...files]);
    });

    // Captions save on blur rather than behind a button: they are a dozen small
    // independent edits, and a "save all photos" button would be one more thing
    // to forget before submitting.
    grid?.addEventListener('change', async (e) => {
      const input = e.target;
      if (!(input instanceof HTMLInputElement)) return;
      const mediaId = input.getAttribute('data-caption-for');
      if (!mediaId) return;
      input.classList.remove('saved', 'failed');
      try {
        const res = await fetch(`/api/portal/properties/${propertyId}/media/${mediaId}`, {
          method: 'PATCH',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ alt: input.value, locale: root.dataset.locale }),
        });
        if (!res.ok) throw new Error('save-failed');
        input.classList.add('saved');
      } catch {
        input.classList.add('failed');
        status.textContent = s.captionFailed;
      }
    });

    let reordering=false;
    async function reorder(items:HTMLElement[]){
      if(!grid||reordering)return;reordering=true;
      const before=[...grid.children];items.forEach(item=>grid.append(item));
      try{
        const response=await fetch(`/api/portal/properties/${propertyId}/media`,{method:'PATCH',headers:{'content-type':'application/json'},body:JSON.stringify({ids:items.map(item=>item.dataset.mediaId)})});
        if(!response.ok)throw new Error('save-failed');
      }catch{before.forEach(item=>grid.append(item));status.textContent=`${s.actionFailed}.`;}
      finally{reordering=false;}
    }
    grid?.addEventListener('click',e=>{
      const button=(e.target as HTMLElement).closest<HTMLElement>('[data-photo-move]');if(!button)return;
      const item=button.closest<HTMLElement>('[data-media-id]')!,items=[...grid.querySelectorAll<HTMLElement>('[data-media-id]')];
      const at=items.indexOf(item),to=at+Number(button.dataset.photoMove);
      if(to<0||to>=items.length)return;[items[at],items[to]]=[items[to],items[at]];void reorder(items);
    });
    let dragged:HTMLElement|null=null;
    grid?.addEventListener('dragstart',e=>{const target=e.target as HTMLElement;if(!target.matches('[data-photo-drag]')){e.preventDefault();return;}dragged=target.closest<HTMLElement>('[data-media-id]');e.dataTransfer?.setData('text/plain',dragged?.dataset.mediaId||'');});
    grid?.addEventListener('dragover',e=>{if(dragged)e.preventDefault();});
    grid?.addEventListener('drop',e=>{if(!dragged)return;e.preventDefault();const target=(e.target as HTMLElement).closest<HTMLElement>('[data-media-id]');if(!target||target===dragged)return;const items=[...grid.querySelectorAll<HTMLElement>('[data-media-id]')].filter(item=>item!==dragged);items.splice(items.indexOf(target),0,dragged);dragged=null;void reorder(items);});
    grid?.addEventListener('dragend',()=>{dragged=null;});

    grid?.addEventListener('click', async (e) => {
      const target = e.target;
      if (!(target instanceof HTMLElement)) return;

      const removeId = target.getAttribute('data-remove-media');
      if (removeId) {
        const ok = window.pf
          ? await window.pf.confirm({ title: s.confirmTitle, body: s.confirmBody, confirmLabel: s.confirmLabel, danger: true })
          : window.confirm(s.confirmTitle);
        if (!ok) return;
        const response=await fetch(`/api/portal/properties/${propertyId}/media/${removeId}`, { method: 'DELETE' });
        if(response.ok)location.reload();else status.textContent=await failure(response);
        return;
      }

      const heroId = target.getAttribute('data-set-hero');
      if (heroId) {
        const response=await fetch(`/api/portal/properties/${propertyId}/media/${heroId}`, {
          method: 'PATCH',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ isHero: true }),
        });
        if(response.ok)location.reload();else status.textContent=await failure(response);
      }
    });
  });
</script>

<style>
  .photo-advice{margin:16px 0;border:1px solid var(--pt-hair);border-radius:12px;padding:12px 16px}.photo-advice summary{cursor:pointer;font-size:14px;color:var(--ink)}.photo-advice :global(.tips){margin-top:16px}
  .photo-controls{display:flex;flex-wrap:wrap;min-width:0;align-items:center;gap:6px;margin-bottom:7px}.photo-controls button,.photo-replace{display:grid;place-items:center;min-width:36px;min-height:36px;border:1px solid var(--pt-hair);border-radius:8px;font-size:13px;color:var(--ink);background:var(--white);cursor:pointer}.photo-replace{padding:5px 10px;position:relative;overflow:hidden}.photo-replace input{position:absolute;inset:0;opacity:0;width:100%;min-width:0;max-width:100%;height:100%;font-size:0;padding:0;border:0;cursor:pointer}.photo-replace:focus-within{outline:2px solid var(--ink);outline-offset:2px}.photo-grip{margin-left:auto;padding:5px 8px;cursor:grab;font-size:22px;color:var(--ink-quiet)}

  .pu-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px 24px; flex-wrap: wrap; margin-bottom: 20px; }
  .pu-head h2 { font-family: var(--serif); font-weight: var(--fw-display); font-size: 22px; letter-spacing: var(--ls-heading); color: var(--ink); }
  .pu-head p { margin-top: 6px; font-size: 14.5px; line-height: 1.6; color: var(--ink-quiet); max-width: 62ch; }
  .photo-meter { display: grid; justify-items: end; gap: 2px; margin: 0 0 0 auto; padding: 10px 18px; border-radius: var(--r-md); background: var(--paper); text-align: right; }
  .photo-meter b { font-size: 24px; line-height: 1.1; font-weight: var(--fw-medium); color: var(--ink); font-variant-numeric: tabular-nums; }
  .photo-meter b span { color: var(--ink-quiet); font-weight: var(--fw-body); }
  .photo-meter > span { margin: 0; font-size: 13px; color: var(--ink-quiet); }
  .photo-meter.full { background: var(--linen); }
  @media (max-width: 560px) { .photo-meter { justify-items: start; text-align: left; margin-left: 0; } }
  .pu-hint { font-size: 14px; line-height: 1.65; color: var(--ink-quiet); margin-bottom: 14px; max-width: 70ch; }
  .pu-warn { max-width: 68ch; margin-top: 16px; padding: 12px 16px; border-radius: var(--r-md); background: var(--pt-amber-bg); font-size: 14px; line-height: 1.65; color: var(--pt-amber); }

  .media-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 20px 16px; margin: 22px 0; }
  .media-grid:empty { display: none; }
  .media-item { display: flex; flex-direction: column; gap: 10px; margin: 0; }
  .media-thumb { position: relative; aspect-ratio: 4 / 3; overflow: hidden; border-radius: var(--r-lg); background: var(--linen); box-shadow: 0 0 0 1px var(--pt-hair); }
  .media-item img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.7s var(--ease-out); }
  @media (hover: hover) { .media-item:hover img { transform: scale(1.04); } }
  .media-item[data-hero='true'] .media-thumb { box-shadow: 0 0 0 2px var(--ink); }
  .hero-badge { position: absolute; top: 10px; left: 10px; padding: 4px 11px; border-radius: var(--r-pill); background: var(--ink); color: var(--cream); font-size: 12px; letter-spacing: 0.04em; }
  .set-hero { position: absolute; left: 10px; bottom: 10px; padding: 6px 12px; border-radius: var(--r-pill); background: rgba(250, 250, 248, 0.94); color: var(--ink); font-size: 12.5px; box-shadow: var(--shadow-sm); opacity: 0; transform: translateY(4px); transition: opacity 0.25s var(--ease-out), transform 0.25s var(--ease-out); }
  .media-thumb:hover .set-hero, .set-hero:focus-visible { opacity: 1; transform: none; }
  @media (hover: none) { .set-hero { opacity: 1; transform: none; } }
  .remove { position: absolute; top: 8px; right: 8px; display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: rgba(16, 42, 67, 0.82); color: var(--cream); font-size: 17px; line-height: 1; backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); transition: background-color 0.2s var(--ease-out), transform 0.2s var(--ease-out); }
  @media (hover: hover) { .remove:hover { background: var(--pt-red); transform: scale(1.08); } }
  .photo-flags { position: absolute; right: 10px; bottom: 10px; display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 4px; pointer-events: none; }
  .photo-flags span { padding: 3px 9px; border-radius: var(--r-pill); background: rgba(255, 247, 224, 0.96); color: var(--pt-amber); font-size: 11.5px; }
  .caption { width: 100%; min-height: 42px; padding: 9px 14px; border: 1px solid transparent; border-radius: var(--r-sm); background: var(--paper); font-size: 14px; color: var(--ink); transition: border-color 0.25s var(--ease-out), background-color 0.25s var(--ease-out), box-shadow 0.25s var(--ease-out); }
  @media (hover: hover) { .caption:hover { background: var(--linen); } }
  .caption:focus { outline: none; background: var(--white); border-color: var(--ink); box-shadow: 0 0 0 4px rgba(16, 42, 67, 0.08); }
  .caption:disabled { background: var(--paper); color: var(--ink-quiet); }
  /* A brief confirmation on the field itself — a photo grid full of toasts is unreadable. */
  .caption.saved { border-color: var(--pt-green); }
  .caption.failed { border-color: var(--pt-red); }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

  .dropzone { position: relative; display: grid; justify-items: center; gap: 4px; padding: 36px 24px; border: 1.5px dashed rgba(16, 42, 67, 0.22); border-radius: var(--r-lg); background: var(--paper); cursor: pointer; text-align: center; transition: border-color 0.3s var(--ease-out), background-color 0.3s var(--ease-out), transform 0.3s var(--ease-out); }
  .dropzone[hidden] { display: none; }
  /* Visually hidden but focusable, so the picker is reachable by keyboard. */
  .dz-input { position: absolute; width: 1px; height: 1px; opacity: 0; overflow: hidden; }
  .dropzone:has(.dz-input:focus-visible) { outline: var(--focus-ring); outline-offset: 3px; }
  @media (hover: hover) { .dropzone:hover { border-color: var(--ink); background: var(--linen); } .dropzone:hover .dz-ic { transform: rotate(90deg) scale(1.06); } }
  .dropzone.drag { border-color: var(--ink); background: rgba(16, 42, 67, 0.08); transform: scale(1.01); }
  .dz-ic { display: grid; place-items: center; width: 44px; height: 44px; margin-bottom: 8px; border-radius: 50%; background: var(--ink); color: var(--cream); font-size: 24px; line-height: 1; transition: transform 0.4s var(--ease-out); }
  .dz-t { font-size: var(--fs-body); font-weight: var(--fw-medium); color: var(--ink); }
  .dz-s { font-size: 14px; color: var(--ink-quiet); }
  /* Live listing (§4c): a photo waiting for review, the banner, and rejection notices. */
  .media-item.is-pending .media-thumb { box-shadow: 0 0 0 1.5px var(--pt-amber); }
  .media-item.is-pending img { filter: saturate(0.82); }
  .pending-badge { position: absolute; top: 10px; left: 10px; display: inline-flex; align-items: center; gap: 6px; padding: 4px 11px 4px 9px; border-radius: var(--r-pill); background: rgba(255, 247, 224, 0.97); color: var(--pt-amber); font-size: 12px; letter-spacing: 0.02em; box-shadow: var(--shadow-sm); }
  .hero-badge + .pending-badge { top: 42px; }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: currentColor; flex: none; animation: pu-pulse 2.4s var(--ease-out) infinite; }
  @keyframes pu-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }
  .pu-live { display: flex; gap: 14px; align-items: flex-start; max-width: 76ch; margin: 0 0 18px; padding: 16px 18px; border-radius: var(--r-lg); background: var(--paper); box-shadow: inset 0 0 0 1px var(--pt-hair); }
  .pu-live-ic { display: grid; place-items: center; flex: none; width: 34px; height: 34px; border-radius: 50%; background: var(--ink); color: var(--cream); font-size: 15px; }
  .pu-live p { font-size: 14px; line-height: 1.65; color: var(--ink-quiet); }
  .pu-live .pu-live-t { margin-bottom: 4px; font-size: 15px; font-weight: var(--fw-medium); color: var(--ink); }
  .pu-live .pu-live-s { margin-top: 6px; font-size: 13px; }
  .pu-live .pu-live-w { display: inline-flex; align-items: center; gap: 8px; margin-top: 10px; padding: 4px 12px; border-radius: var(--r-pill); background: var(--pt-amber-bg); color: var(--pt-amber); font-size: 13px; }
  .pu-live.admin { background: var(--pt-amber-bg); box-shadow: none; }
  .pu-live.admin .pu-live-ic { background: var(--pt-amber); color: var(--white); }
  .pu-live-a { color: var(--ink); font-weight: var(--fw-medium); text-decoration: underline; text-underline-offset: 3px; }
  .pu-notices { display: grid; gap: 10px; max-width: 76ch; margin: 0 0 18px; padding: 0; list-style: none; }
  .pu-notice { display: flex; gap: 14px; align-items: flex-start; padding: 14px 16px; border-radius: var(--r-lg); background: var(--white); box-shadow: inset 0 0 0 1px var(--pt-hair), var(--shadow-sm); transition: opacity 0.25s var(--ease-out), transform 0.25s var(--ease-out); }
  .pu-notice.leaving { opacity: 0; transform: translateY(-4px); }
  .pu-notice-ic { display: grid; place-items: center; flex: none; width: 28px; height: 28px; border-radius: 50%; background: var(--pt-red); color: var(--white); font-size: 14px; font-weight: var(--fw-medium); }
  .pu-notice > div { flex: 1; min-width: 0; }
  .pu-notice-t { font-size: 14.5px; font-weight: var(--fw-medium); color: var(--ink); }
  .pu-notice-r { margin-top: 2px; font-size: 14px; line-height: 1.6; color: var(--ink); overflow-wrap: anywhere; }
  .pu-notice-s { margin-top: 4px; font-size: 13px; color: var(--ink-quiet); }
  .pu-notice-ok { flex: none; min-height: 36px; padding: 6px 14px; border: 1px solid var(--pt-hair); border-radius: var(--r-pill); background: var(--white); color: var(--ink); font-size: 13px; cursor: pointer; }
  @media (hover: hover) { .pu-notice-ok:hover { border-color: var(--ink); } }
  @media (max-width: 560px) { .pu-notice { flex-wrap: wrap; } .pu-notice-ok { margin-inline-start: 42px; } }
  .upload-status { min-height: 1.5em; margin-top: 12px; font-size: 14px; color: var(--ink-quiet); }
  @media (max-width: 720px) { .media-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 12px; } }
  @media (prefers-reduced-motion: reduce) { .media-item img, .dz-ic, .pu-notice { transition: none; } .dot { animation: none; } }
</style>
