---
import Field from '~/components/forms/Field.astro';
import { PROPERTY_GROUPS, groupOf, subtypeOf, labelIn, FEATURE_ALIASES, DETAIL_OPTIONS, FEATURE_DEFINITIONS, RETIRED_FEATURES, currentFeatures, readEnergy, energyScale } from '~/lib/listing-catalogue';
import { COUNTRIES, regionsFor, regionLabel } from '~/config/countries';
import { PRICE_CURRENCIES } from '~/lib/exchange-rates';
import { readDetails, SETTINGS, UTILITIES, PARKING, detailLabel, fieldRules, parkingFits, HEATING_EXCLUSIVE, WALL_EXCLUSIVE, HEATING_RETIRED, WALL_RETIRED, type ListingField } from '~/lib/listing-details';
import { UI } from '~/i18n/ui';
import { termLabel, type Taxonomy } from '~/lib/runtime-config';
import type { PortalProperty } from '~/lib/portal/properties';
import type { PortalLang } from '~/lib/portal/auth-copy';
// Static on purpose: build.inlineStylesheets is 'always', so a dynamic import of this
// stylesheet from the client script has no .css file to fetch and fails with a 404.
import 'maplibre-gl/dist/maplibre-gl.css';
interface Props { property: PortalProperty; taxonomy: Taxonomy; locale?: PortalLang; section?: 'classification'|'location'|'details'|'features'|'all' }
const {property:p,taxonomy,locale='hu',section='all'}=Astro.props;
const x=(hu:string,nl:string,en:string)=>locale==='hu'?hu:locale==='nl'?nl:en;
// A new draft is stored with the country's middle as a stand-in point (the columns cannot be empty). Until
// somebody places the pin, show the coordinate fields empty rather than as if they had been filled in.
const placed=Boolean(p.location_confirmed)||(Boolean(p.settlement)&&!(p.lat===47.1625&&p.lng===19.5033));
const group=p.property_group||groupOf(p.category), subtype=subtypeOf(p.category,p.property_subtype);
const on=(s:string)=>section==='all'||section===s;
const number=(v:number|null|undefined)=>v!=null&&v>0?String(v):'';
// Drafts made before the editor stopped seeding 1 m² still carry it; show those as empty.
const area=(v:number|null|undefined)=>v!=null&&v>1?String(v):'';
const options=(g:'condition',blank=x('Nem adom meg','Niet opgeven','Not specified'))=>[{value:'',label:blank},...taxonomy[g].filter(t=>t.enabled || t.key===p[`${g}_key`]).map(t=>({value:t.key,label:labelIn(DETAIL_OPTIONS[g].find(v=>v.key===t.key)?.labels||t.labels,locale)}))];
const d=readDetails(p.details,p);
// Which facts this kind of property has, and which of them are required (src/lib/listing-details.ts).
// The client script applies the same rules again when the type changes in the form.
const rules=fieldRules(group,subtype);
const hide=(k:ListingField)=>rules[k]==='hidden';
const req=(k:ListingField)=>rules[k]==='required';
const words={required:`(${UI[locale].form.required})`,optional:`(${UI[locale].form.optional})`};
const tag=(k:ListingField)=>req(k)?words.required:words.optional;
// Multi-select choices: enabled terms, with "none" / "not known" last; a retired choice ("Vegyes") only while it is still ticked.
const choices=(g:'heating'|'wall',ticked:string[])=>{
  const exclusive=g==='heating'?HEATING_EXCLUSIVE:WALL_EXCLUSIVE,retired=g==='heating'?HEATING_RETIRED:WALL_RETIRED;
  return taxonomy[g].filter(t=>ticked.includes(t.key)||(t.enabled&&!retired.includes(t.key)))
    .sort((a,b)=>Number(exclusive.includes(a.key))-Number(exclusive.includes(b.key)))
    .map(t=>({key:t.key,label:labelIn(DETAIL_OPTIONS[g].find(v=>v.key===t.key)?.labels||t.labels,locale)}));
};
const energy=readEnergy(p.epc_class),scale=energyScale(p.country);
const count=(v:number|null|undefined)=>v!=null?String(v):'';
const selected=new Set(currentFeatures(p.features,group).features);
const featureTerms=taxonomy.feature.filter(t=>(t.enabled||selected.has(t.key))&&!FEATURE_ALIASES[t.key]&&!RETIRED_FEATURES.includes(t.key)&&(selected.has(t.key)||Boolean(t.propertyGroups?.length)||FEATURE_DEFINITIONS.some(f=>f.key===t.key)));
const featureSections=[...new Set(featureTerms.map(t=>t.sectionKey||'other'))];
const sectionNames:Record<string,string>={outdoor:x('Kert és környezet','Tuin en omgeving','Garden and surroundings'),water:x('Vízparti adottságok','Voorzieningen aan het water','Waterfront features'),terrain:group==='agricultural'?x('A terület jellege','Kenmerken van het terrein','Land characteristics'):x('A telek jellege','Kenmerken van het perceel','Plot characteristics'),facilities:x('Épületek és létesítmények','Gebouwen en voorzieningen','Buildings and facilities'),technical:x('Műszaki adottságok','Technische voorzieningen','Technical features'),heritage:x('Történelmi értékek','Historisch karakter','Historic features'),access:x('Megközelítés és közművek','Bereikbaarheid en nutsvoorzieningen','Access and utilities'),investment:x('Befektetési jellemzők','Beleggingskenmerken','Investment features'),other:x('További jellemzők','Overige kenmerken','Other features')};
---
<div class="listing-fields" data-listing-fields data-section={section} data-lang={locale} data-group={group} data-subtype={subtype} data-initial-price-huf={p.price_huf} data-word-required={words.required} data-word-optional={words.optional}>
{on('classification') && <section class="lf-section" id="basics">
  <header class="lf-heading"><span class="lf-number">01</span><div><h2>{x('Az ingatlan típusa','Het type vastgoed','Property type')}</h2><p>{x('Először fő kategóriát, majd azon belül altípust válasszon.','Kies eerst een hoofdcategorie en daarna het bijbehorende subtype.','Choose a category, then the subtype that describes your property.')}</p></div></header>
  <div class="lf-grid">
    <Field span="half" locale={locale} name="property_group" label={x('Fő kategória','Hoofdcategorie','Category')} type="select" required value={group} options={PROPERTY_GROUPS.map(g=>({value:g.key,label:labelIn(g.labels,locale)}))}/>
    <Field span="half" locale={locale} name="property_subtype" label={x('Altípus','Subtype','Subtype')} type="select" required value={subtype} options={[{value:'',label:x('Válasszon altípust','Kies een subtype','Choose a subtype')},...(PROPERTY_GROUPS.find(g=>g.key===group)?.subtypes||[]).map(s=>({value:s.key,label:labelIn(s.labels,locale)}))]}/>
  </div>
</section>}
{on('location') && <section class="lf-section" id="location">
  <header class="lf-heading"><span class="lf-number">02</span><div><h2>{x('Elhelyezkedés','Locatie','Location')}</h2><p>{x('Cím nélküli ingatlant is megadhat: keressen helyet, kattintson a térképre, vagy írja be a koordinátákat.','Ook zonder adres: zoek een plaats, klik op de kaart of voer de coördinaten in.','No street address needed: search for a place, drop a pin, or enter coordinates.')}</p></div></header>
  <div class="lf-grid">
    <Field span="half" locale={locale} name="country" label={x('Ország','Land','Country')} type="select" required value={p.country} options={Object.keys(COUNTRIES).sort((a,b)=>COUNTRIES[a].labels[locale].localeCompare(COUNTRIES[b].labels[locale],locale)).map(c=>({value:c,label:COUNTRIES[c].labels[locale]}))}/>
    <div class="field fld"><label for="f-county" data-region-label>{regionLabel(p.country,locale)}</label><input id="f-county" name="county" list="listing-regions" value={p.county} autocomplete="address-level1"/><datalist id="listing-regions">{regionsFor(p.country).map(r=><option value={r.name}/>)}</datalist><p class="hint">{x('Kereshető lista; ha szükséges, saját értéket is megadhat.','Doorzoekbare lijst; een eigen waarde is ook mogelijk.','Search the list, or enter the appropriate administrative area.')}</p></div>
    <div class="field fld"><label for="f-settlement">{x('Település / hely megnevezése','Plaats / locatie','Town / locality')}</label><input id="f-settlement" name="settlement" list="listing-settlements" value={p.settlement} autocomplete="address-level2" maxlength="120"/><datalist id="listing-settlements"/><p class="hint">{x('Külterületnél a birtok vagy a közeli település neve is megadható.','Buiten de bebouwde kom kunt u de naam van het landgoed of een nabijgelegen plaats gebruiken.','For rural land, use the estate name or a nearby settlement.')}</p></div>
    <Field span="half" locale={locale} name="region" label={x('További területi egység','Aanvullende regio','Additional administrative area')} value={p.region} hint={x('Csak ha a helyszínhez értelmezhető.','Alleen indien van toepassing.','Only where applicable.')}/>
  </div>
  <div class="lf-address">
    <div class="lf-grid">
      <Field span="half" locale={locale} name="street" label={x('Az ingatlan címe','Adres van het vastgoed','Street address')} value={p.street||''} softRequired={req('street')} maxlength={200} autocomplete="address-line1" placeholder={x('Pl. Kossuth u. 12.','Bijv. Kerkstraat 12','e.g. 12 High Street')}/>
      <Field span="half" locale={locale} type="postcode" countryField="country" name="postal_code" label={x('Irányítószám','Postcode','Postal code')} value={p.postal_code||''} maxlength={20}/>
    </div>
    <label class="lf-check"><input type="checkbox" name="address_public" value="yes" checked={Boolean(p.public_address)}/>{x('Szeretném, hogy az ingatlan címe megjelenjen a hirdetésben','Het adres van het vastgoed mag in de advertentie worden getoond','Show the property address in the listing')}</label>
    <p class="lf-note" data-address-note>{x('Alapértelmezés szerint a cím nem nyilvános: csak Ön és a FINDDOME munkatársai látják. Ha bejelöli, a hirdetés a címet és a pontos helyet mutatja a térképen.','Standaard is het adres niet openbaar: alleen u en FINDDOME zien het. Vinkt u dit aan, dan toont de advertentie het adres en de exacte plek op de kaart.','By default the address is private: only you and FINDDOME see it. If you tick this, the listing shows the address and the exact spot on the map.')}</p>
  </div>
  <input type="hidden" name="location_confirmed" value={placed ? 'yes' : ''}/><div class="lf-search"><label class="sr-only" for="listing-place-query">{x('Hely keresése','Plaats zoeken','Find a place')}</label><input id="listing-place-query" type="search" placeholder={x('Település, cím vagy ismert hely…','Plaats, adres of herkenningspunt…','Town, address or landmark…')} data-place-query/><button type="button" data-place-search>{x('Keresés a térképen','Zoeken op de kaart','Find on map')} <span aria-hidden="true">↗</span></button></div>
  <div data-place-results class="lf-results"></div>
  <div class="lf-map" data-location-map role="region" aria-label={x('Az ingatlan helyének megjelölése','Locatie van het vastgoed kiezen','Choose the property location')}><span data-map-loading>{x('Térkép betöltése…','Kaart laden…','Loading map…')}</span></div>
  <p class="lf-status" role="status" data-location-status></p>
  <div class="lf-grid lf-coordinates">
    <Field span="half" locale={locale} name="lat" required label={x('Szélesség','Breedtegraad','Latitude')} type="coordinate" value={placed ? String(p.lat) : ''} min={-90} max={90}/>
    <Field span="half" locale={locale} name="lng" required label={x('Hosszúság','Lengtegraad','Longitude')} type="coordinate" value={placed ? String(p.lng) : ''} min={-180} max={180}/>
  </div>
  <Field span="half" locale={locale} name="precision" label={x('Nyilvánosan megjelenített hely','Openbaar getoonde locatie','Public location')} type="select" value={p.precision} options={[{value:'approximate',label:x('Hozzávetőleges hely','Geschatte locatie','Approximate location')},{value:'exact',label:x('Pontos hely','Exacte locatie','Exact location')}]} hint={x('A pontos koordinátákat bizalmasan tároljuk. Közelítő megjelenítésnél csak az eltolással képzett környék nyilvános.','De exacte coördinaten worden afgeschermd bewaard. Bij een geschatte locatie is alleen de verschoven omgeving openbaar.','Exact coordinates are stored privately. Approximate listings publish only a displaced area.')}/>
  <p class="lf-credit"><a href="https://www.geonames.org/" target="_blank" rel="noopener">GeoNames · CC BY 4.0</a> · <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">© OpenStreetMap contributors</a></p>
</section>}
{on('details') && <section class="lf-section" id="details">
  <header class="lf-heading"><span class="lf-number">03</span><div><h2>{x('Ár és részletek','Prijs en gegevens','Price and details')}</h2><p>{x('Csak az ingatlan típusához illő adatokat kérdezzük. A kötelező mezőket a beküldés előtt kell kitölteni; a többit nyugodtan hagyja üresen, ha nem tudja.','We vragen alleen wat bij dit type vastgoed past. Verplichte velden vult u in vóór het indienen; de rest mag leeg blijven als u het niet weet.','We only ask what fits this kind of property. Required fields must be filled in before you submit; leave the rest blank if you do not know.')}</p></div></header>
  <div class="lf-price">
    <div class="lf-grid"><Field span="half" locale={locale} name="original_price" label={x('Irányár','Vraagprijs','Asking price')} type="number" required min={0.01} value={number(p.original_price ?? (p.price_huf>1?p.price_huf:null))}/><Field span="half" locale={locale} name="original_currency" required label={x('Pénznem','Valuta','Currency')} type="select" value={p.original_currency||'HUF'} options={PRICE_CURRENCIES.map(c=>({value:c,label:c}))}/></div>
    <output class="lf-conversion" data-price-conversion aria-live="polite">{p.price_eur>1 ? `≈ € ${p.price_eur.toLocaleString(locale)}` : x('Az euróban megjelenő árat automatikusan kiszámítjuk.','De prijs in euro wordt automatisch berekend.','The euro display price is calculated automatically.')}</output>
    <p class="hint" data-rate-note>{p.exchange_source && p.exchange_rate ? `${p.exchange_source} · ${p.price_asof} · 1 EUR = ${p.exchange_rate} ${p.original_currency}` : x('Az árfolyam forrását és dátumát automatikusan rögzítjük.','Bron en datum van de wisselkoers worden automatisch vastgelegd.','The exchange-rate source and date are recorded automatically.')}</p>
  </div>
  <input type="hidden" name="details_present" value="yes"/>

  <div class="lf-block" data-field-block hidden={(['floor_m2','building_m2','plot_m2'] as ListingField[]).every(hide)}>
    <h3 class="lf-sub">{x('Területek','Oppervlakten','Areas')}</h3>
    <div class="lf-grid">
      <div class="lf-area" data-field="floor_m2" hidden={hide('floor_m2')}><Field span="half" locale={locale} name="floor_m2" softRequired={req('floor_m2')} label={x('Lakóegység területe (m²)','Woonoppervlakte (m²)','Living area (m²)')} type="number" value={area(p.floor_m2)} min={0.000001} hint={x('A lakótér hasznos alapterülete.','De bruikbare woonoppervlakte.','The usable floor area of the home.')}/><input type="hidden" name="floor_m2_unit" value="m2"/></div>
      <div class="lf-area" data-field="building_m2" hidden={hide('building_m2')}><Field span="half" locale={locale} name="building_m2" softRequired={req('building_m2')} label={x('Teljes épületterület (m²)','Totale gebouwoppervlakte (m²)','Total building area (m²)')} type="number" value={area(p.building_m2)} min={0.000001} hint={x('Az összes épület együtt, a melléképületekkel, gazdasági épületekkel, istállókkal, műhelyekkel és raktárakkal.','Alle gebouwen samen, inclusief bijgebouwen, agrarische gebouwen, stallen, werkplaatsen en opslagruimten.','All buildings together, including outbuildings, farm buildings, stables, workshops and warehouses.')}/><input type="hidden" name="building_m2_unit" value="m2"/></div>
      <div class="lf-area lf-area-unit" data-field="plot_m2" hidden={hide('plot_m2')}><Field span="half" locale={locale} name="plot_m2" softRequired={req('plot_m2')} label={x('Telekterület','Perceeloppervlakte','Plot area')} type="number" value={area(p.plot_m2)} min={0.000001} /><label class="lf-unit"><span class="sr-only">{x('Mértékegység','Eenheid','Unit')}</span><select name="plot_m2_unit" aria-label={x('A telekterület mértékegysége','Eenheid van de perceeloppervlakte','Plot area unit')} data-area-unit="plot_m2"><option value="m2">m²</option><option value="ha">ha</option></select></label><small data-area-equivalent></small><p class="lf-hint">{x('Négyzetméterben vagy hektárban; a másikat automatikusan kiszámítjuk.','In vierkante meters of hectare; de andere eenheid rekenen we uit.','In square metres or hectares; we work out the other unit.')}</p></div>
    </div>
  </div>

  <div class="lf-block" data-field-block hidden={(['year_built','renovated_in','condition','cellar_m2','walls','heating','energy'] as ListingField[]).every(hide)}>
    <h3 class="lf-sub">{x('Az épület','Het gebouw','The building')}</h3>
    <div class="lf-grid">
      <div data-field="year_built" hidden={hide('year_built')}><Field span="half" locale={locale} name="year_built" softRequired={req('year_built')} label={x('Építés éve','Bouwjaar','Year built')} type="number" value={number(p.year_built)} min={1} max={new Date().getFullYear()+5}/><label class="lf-check lf-check-tight"><input type="checkbox" name="year_built_unknown" value="yes" checked={p.year_built_unknown}/>{x('Nem ismert','Onbekend','Not known')}</label></div>
      <div data-field="renovated_in" hidden={hide('renovated_in')}><Field span="half" locale={locale} name="renovated_in" label={x('Felújítás éve','Renovatiejaar','Year renovated')} type="number" value={number(p.renovated_in)} min={1} max={new Date().getFullYear()+5}/></div>
    </div>
    <div class="lf-grid">
      <div data-field="condition" hidden={hide('condition')}><Field span="half" locale={locale} name="condition_key" label={x('Állapot','Staat','Condition')} type="select" value={p.condition_key||''} options={options('condition')}/></div>
      <div data-field="cellar_m2" hidden={hide('cellar_m2')}><Field span="half" locale={locale} name="cellar_m2" label={x('Pince (m²)','Kelder (m²)','Cellar (m²)')} type="number" value={d.cellar_m2?String(d.cellar_m2):''} min={0} hint={x('Ha nincs pince, hagyja üresen.','Geen kelder? Laat dit leeg.','No cellar? Leave this blank.')}/></div>
    </div>
    <fieldset class="fld lf-choice" data-field="walls" hidden={hide('walls')}>
      <legend class="fld-label">{detailLabel('walls',locale)} <span class="req">{tag('walls')}</span></legend>
      <p class="hint">{x('Több is megjelölhető, ha az épületek falazata eltér.','Meerdere keuzes mogelijk als de gebouwen verschillen.','Tick more than one if the buildings differ.')}</p>
      <div class="lf-feature-grid" data-exclusive={WALL_EXCLUSIVE.join(',')}>{choices('wall',d.walls).map(t=><label class="lf-feature"><input type="checkbox" name="walls" value={t.key} checked={d.walls.includes(t.key)}/><span>{t.label}</span></label>)}</div>
    </fieldset>
    <fieldset class="fld lf-choice" data-field="heating" hidden={hide('heating')}>
      <legend class="fld-label">{detailLabel('heating',locale)} <span class="req">{tag('heating')}</span></legend>
      <p class="hint">{x('Több is megjelölhető. A „Nincs fűtés” és a „Nem ismert” a többi helyett választható.','Meerdere keuzes mogelijk. „Geen verwarming” en „Onbekend” sluiten de andere uit.','Tick all that apply. “No heating” and “Not known” replace the other choices.')}</p>
      <div class="lf-feature-grid" data-exclusive={HEATING_EXCLUSIVE.join(',')}>{choices('heating',d.heating).map(t=><label class="lf-feature"><input type="checkbox" name="heating" value={t.key} checked={d.heating.includes(t.key)}/><span>{t.label}</span></label>)}</div>
    </fieldset>
    <fieldset class="fld lf-choice" data-field="energy" hidden={hide('energy')}>
      <input type="hidden" name="energy_present" value="yes"/>
      <legend class="fld-label">{detailLabel('energy',locale)} <span class="req">{tag('energy')}</span></legend>
      <div class="lf-segment" role="radiogroup">
        <label class="lf-feature"><input type="radio" name="epc_has" value="yes" checked={energy.has==='yes'}/><span>{x('Van','Ja, aanwezig','Yes, there is one')}</span></label>
        <label class="lf-feature"><input type="radio" name="epc_has" value="no" checked={energy.has==='no'}/><span>{x('Nincs','Nee','No')}</span></label>
      </div>
      <div class="lf-energy-rating" data-energy-rating hidden={energy.has!=='yes'}>
        <label for="f-epc_class" class="fld-label">{x('Energetikai besorolás','Energielabel','Energy rating')} <span class="req">({UI[locale].form.optional})</span></label>
        <select id="f-epc_class" name="epc_class" data-energy-select hidden={!scale} disabled={!scale}><option value="">{x('Nem adom meg','Niet opgeven','Not stated')}</option>{(scale??[]).concat(energy.rating&&scale&&!scale.includes(energy.rating)?[energy.rating]:[]).map(v=><option value={v} selected={v===energy.rating}>{v}</option>)}</select>
        <input id="f-epc_class-text" name="epc_class" data-energy-text value={energy.rating} maxlength="40" hidden={Boolean(scale)} disabled={Boolean(scale)} aria-label={x('Energetikai besorolás','Energielabel','Energy rating')}/>
        <p class="hint" data-energy-hint>{scale ? `${x('A tanúsítványon szereplő osztály','De klasse op het certificaat','The class shown on the certificate')} (${COUNTRIES[p.country]?.labels[locale] ?? p.country}: ${scale[0]}–${scale[scale.length-1]}).` : x('Írja be úgy, ahogy a tanúsítványon szerepel.','Neem de waarde over zoals die op het certificaat staat.','Enter it exactly as it appears on the certificate.')}</p>
      </div>
    </fieldset>
  </div>

  <div class="lf-block" data-field-block hidden={(['rooms','half_rooms','floors','bathrooms','kitchens','toilets'] as ListingField[]).every(hide)}>
    <h3 class="lf-sub">{x('Helyiségek','Indeling','Rooms')}</h3>
    <div class="lf-grid">
      <div data-field="rooms" hidden={hide('rooms')}><Field span="half" locale={locale} name="rooms" softRequired={req('rooms')} label={x('Szobák száma (félszobák nélkül)','Aantal kamers (zonder halve kamers)','Rooms (not counting half rooms)')} type="number" value={count(d.rooms)} min={0}/></div>
      <div data-field="half_rooms" hidden={hide('half_rooms')}><Field span="half" locale={locale} name="half_rooms" softRequired={req('half_rooms')} label={x('Félszobák száma','Aantal halve kamers','Half rooms')} type="number" value={count(d.half_rooms)} min={0} hint={x('12 m²-nél kisebb szoba. Ha nincs, írjon 0-t.','Kamer kleiner dan 12 m². Geen? Vul 0 in.','A room under 12 m². None? Enter 0.')}/></div>
      <div data-field="floors" hidden={hide('floors')}><Field span="half" locale={locale} name="floors" softRequired={req('floors')} label={x('Szintek száma','Aantal woonlagen','Number of levels')} type="number" value={count(d.floors)} min={0} hint={x('Lakásnál a lakás saját szintjei: egyszintes lakásnál 1.','Bij een appartement de eigen woonlagen: 1 als alles gelijkvloers is.','For a flat, its own levels: 1 if it is all on one floor.')}/></div>
      <div data-field="bathrooms" hidden={hide('bathrooms')}><Field span="half" locale={locale} name="bathrooms" softRequired={req('bathrooms')} label={x('Fürdőszobák száma','Aantal badkamers','Bathrooms')} type="number" value={p.bathrooms!=null?String(p.bathrooms):''} min={0}/></div>
      <div data-field="kitchens" hidden={hide('kitchens')}><Field span="half" locale={locale} name="kitchens" softRequired={req('kitchens')} label={x('Konyhák száma','Aantal keukens','Kitchens')} type="number" value={count(d.kitchens)} min={0}/></div>
      <div data-field="toilets" hidden={hide('toilets')}><Field span="half" locale={locale} name="toilets" softRequired={req('toilets')} label={x('Különálló WC-k száma','Aantal aparte toiletten','Separate toilets')} type="number" value={count(d.toilets)} min={0} hint={x('A fürdőszobában lévő WC-t ne számolja. Ha nincs, írjon 0-t.','Tel een toilet in de badkamer niet mee. Geen? Vul 0 in.','Do not count a toilet inside a bathroom. None? Enter 0.')}/></div>
    </div>
  </div>

  <div class="lf-block" data-field-block>
    <h3 class="lf-sub">{x('Környezet és parkolás','Omgeving en parkeren','Surroundings and parking')}</h3>
    <fieldset class="fld lf-choice" data-field="settings">
      <legend class="fld-label">{detailLabel('setting',locale)} <span class="req">{tag('settings')}</span></legend>
      <p class="hint">{x('Több is megjelölhető.','Meerdere keuzes mogelijk.','Tick all that apply.')}</p>
      <div class="lf-feature-grid">{SETTINGS.map(o=><label class="lf-feature"><input type="checkbox" name="settings" value={o.key} checked={d.settings.includes(o.key)}/><span>{labelIn(o.labels,locale)}</span></label>)}</div>
    </fieldset>
    <fieldset class="fld lf-choice" data-field="parking" hidden={hide('parking')}>
      <legend class="fld-label">{detailLabel('parking',locale)} <span class="req">{tag('parking')}</span></legend>
      <p class="hint">{x('Több is megjelölhető.','Meerdere keuzes mogelijk.','Tick all that apply.')}</p>
      <div class="lf-feature-grid">{PARKING.map(o=><label class="lf-feature" data-parking-option={o.key} hidden={!parkingFits(o.key,group,subtype)&&!d.parking.includes(o.key)}><input type="checkbox" name="parking" value={o.key} checked={d.parking.includes(o.key)}/><span>{labelIn(o.labels,locale)}</span></label>)}</div>
    </fieldset>
    <fieldset class="fld lf-choice" data-field="utilities" hidden={hide('utilities')}>
      <legend class="fld-label">{detailLabel('utilities',locale)} <span class="req">{tag('utilities')}</span></legend>
      <div class="lf-feature-grid">{UTILITIES.map(o=><label class="lf-feature"><input type="checkbox" name="utilities" value={o.key} checked={d.utilities.includes(o.key)}/><span>{labelIn(o.labels,locale)}</span></label>)}</div>
    </fieldset>
    <div class="lf-set" data-field="extra_buildings" hidden={hide('extra_buildings')}><Field locale={locale} name="extra_buildings" type="textarea" rows={3} maxlength={500} label={x('Kiegészítő építmények','Bijgebouwen en bouwwerken','Additional structures')} value={d.extra_buildings||''} hint={x('Szabadon leírhatja, méretekkel együtt is, pl. „nyárikonyha 20 m², pajta kb. 60 m², fedett kocsibeálló”.','Vrij in te vullen, ook met afmetingen, bijv. „zomerkeuken 20 m², schuur ca. 60 m², carport”.','Describe them freely, sizes included, e.g. “summer kitchen 20 m², barn approx. 60 m², carport”.')}/></div>
  </div>

  <div class="lf-block">
    <h3 class="lf-sub">{x('Videó','Video','Video')}</h3>
    <Field locale={locale} name="video_url" label={x('YouTube-link','YouTube-link','YouTube link')} type="url" value={p.video_url||''} placeholder="https://www.youtube.com/watch?v=…" hint={x('Töltse fel a videót YouTube-ra (akár „nem nyilvános” beállítással), és másolja ide a linkjét. A hirdetésben lejátszható videóként jelenik meg.','Zet de video op YouTube (ook „niet vermeld” kan) en plak hier de link. In de advertentie verschijnt hij als afspeelbare video.','Upload the video to YouTube (“unlisted” works too) and paste its link here. It plays right inside the listing.')}/>
  </div>

  <label class="lf-check"><input type="checkbox" name="price_negotiable" value="yes" checked={p.price_negotiable}/>{x('Az ár alkuképes','Prijs is bespreekbaar','Price negotiable')}</label>
  {p.status==='published' && <label class="lf-check"><input type="checkbox" name="reserved" value="yes" checked={p.reserved}/>{x('Foglalt','Gereserveerd','Reserved')}</label>}
</section>}
{on('features') && <section class="lf-section" id="features">
  <header class="lf-heading"><span class="lf-number">04</span><div><h2>{x('Jellemzők','Kenmerken','Features')}</h2><p>{x('Csak a választott típushoz illő lehetőségek. Mindegyik szabadon választható.','Alleen kenmerken die bij dit type passen. Alles is optioneel.','Features relevant to your property type. Every choice is optional.')}</p></div></header>
  {featureSections.map(section=><fieldset class="lf-feature-section" data-feature-section><legend>{sectionNames[section]||sectionNames.other}</legend><div class="lf-feature-grid">{featureTerms.filter(t=>(t.sectionKey||'other')===section).map(term=><label class="lf-feature" data-feature-groups={(term.propertyGroups||[]).join(',')} data-feature-subtypes={(term.subtypeKeys||[]).join(',')}><input type="checkbox" name="features" value={term.key} checked={selected.has(term.key)}/><span>{termLabel(term,locale)}</span></label>)}</div></fieldset>)}
</section>}
</div>
<script>
  import '~/scripts/listing-fields';
</script>
<style>
  .listing-fields { min-width:0; }
  .lf-section { padding:28px 0; border-top:1px solid var(--pt-hair,var(--border)); scroll-margin-top:30px; }
  .lf-section:first-child { border-top:0;padding-top:0; }
  .lf-heading { display:flex;gap:14px;align-items:flex-start;margin-bottom:24px; }
  .lf-number { display:grid;place-items:center;flex-shrink:0;width:34px;height:34px;border:1px solid var(--pt-hair,var(--border));border-radius:50%;font-size:12px;font-variant-numeric:tabular-nums;color:var(--ink-quiet); }
  .lf-heading h2 { font-family:var(--serif);font-size:24px;font-weight:var(--fw-medium);letter-spacing:-.025em;line-height:1.2;color:var(--ink); }
  .lf-heading p { margin:7px 0 0;font-size:14px;line-height:1.65;color:var(--ink-quiet);max-width:66ch; }
  .lf-grid { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px 20px; }
  .lf-grid>* { min-width:0; }
  /* Paired fields line up even when only one of them has a hint: the hint takes up the slack, so both inputs sit on the same line. */
  .lf-grid:not(:has(.lf-check))>[data-field]:not([hidden]) { display:flex;flex-direction:column; }
  .lf-block .lf-grid+.lf-grid { margin-top:22px; }
  .lf-grid>[data-field]>:global(.fld) { flex:1;display:flex;flex-direction:column; }
  .lf-grid>[data-field]>:global(.fld>.hint) { margin-bottom:auto; }
  .lf-grid>[data-field]>:global(.fld>label:not(:has(+ .hint))) { margin-bottom:auto; }
  .lf-price { padding:22px;border:1px solid var(--pt-hair,var(--border));border-radius:18px;background:var(--paper);margin-bottom:26px; }
  .lf-conversion { display:block;font-family:var(--serif);font-size:24px;margin-top:16px;letter-spacing:-.02em; }
  .lf-check { display:flex;align-items:center;gap:10px;font-size:14px;line-height:1.5;margin-top:16px; }
  .lf-check input,.lf-feature input { width:18px;height:18px;flex-shrink:0;accent-color:var(--ink); }
  .lf-area { position:relative; }
  .lf-area-unit :global(.field input) { padding-right:85px; }
  .lf-unit { position:absolute;right:8px;top:31px; }
  .lf-unit select { min-height:36px;padding:5px 8px;border:0;background:var(--paper);border-radius:8px;color:var(--ink);font-size:14px; }
  .lf-area small { display:block;font-size:12px;color:var(--ink-quiet);min-height:16px;margin-top:5px; }
  .lf-search { display:flex;gap:10px;margin:24px 0 12px; }
  .lf-search input { min-width:0;flex:1;min-height:48px; }
  .lf-search button { flex-shrink:0;display:flex;gap:14px;align-items:center;padding:12px 18px;border-radius:12px;background:var(--ink);color:var(--cream);font-size:14px; }
  .lf-results { display:grid;gap:5px;margin-bottom:12px; }
  .lf-results:empty { display:none; }
  .lf-results :global(button) { padding:12px 14px;text-align:left;border-radius:10px;background:var(--paper);color:var(--ink);font-size:14px; }
  .lf-map { height:300px;border-radius:18px;overflow:hidden;background:var(--paper);border:1px solid var(--pt-hair,var(--border));position:relative; }
  .lf-map>span { display:block;padding:24px;font-size:14px; }
  .lf-status { min-height:1.5em;margin:9px 0;font-size:13px;color:var(--ink-quiet); }
  .lf-credit { margin-top:14px;font-size:11px;color:var(--ink-quiet); }
  .lf-credit a { color:inherit; }
  .lf-feature-section { border:0;padding:0;margin:22px 0 0;min-width:0; }.lf-feature-section legend { font-size:13px;font-weight:500;color:var(--ink-quiet);margin-bottom:10px; }
  .lf-feature-grid { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px; }
  .lf-feature { display:flex;align-items:center;gap:10px;padding:12px 14px;border:1px solid var(--pt-hair,var(--border));border-radius:12px;font-size:14px;line-height:1.45;cursor:pointer;min-height:48px; }
  .lf-feature:has(:checked) { background:var(--paper);border-color:var(--ink); }
  .lf-feature:has(:focus-visible) { outline:2px solid var(--ink);outline-offset:2px; }
  .lf-block { margin-top:30px; }
  .lf-sub { font-family:var(--serif);font-size:19px;font-weight:var(--fw-medium);letter-spacing:-.015em;color:var(--ink);margin:0 0 16px;padding-bottom:10px;border-bottom:1px solid var(--pt-hair,var(--border)); }
  .lf-choice { border:0;padding:0;margin:24px 0 0;min-width:0; }
  .lf-choice legend { padding:0; }
  .lf-segment { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;max-width:420px;clear:both; }
  .lf-energy-rating { margin-top:16px;max-width:420px; }
  .lf-energy-rating .fld-label { display:flex;gap:8px;align-items:baseline; }
  .lf-hint { margin:2px 0 0;font-size:13px;line-height:1.55;color:var(--ink-quiet); }
  .lf-check-tight { margin-top:10px; }
  .lf-address { margin-top:22px; }
  .lf-note { margin:8px 0 0;font-size:13px;line-height:1.6;color:var(--ink-quiet);max-width:66ch; }
  .lf-set { margin-top:26px; }
  .lf-set + .lf-check { margin-top:22px; }
  [hidden] { display:none!important; }
  .sr-only { position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0; }
  @media(max-width:600px){.lf-grid,.lf-feature-grid,.lf-segment{grid-template-columns:1fr}.lf-search{flex-direction:column}.lf-search button{justify-content:space-between}.lf-section{padding:24px 0}.lf-heading{gap:10px}.lf-heading h2{font-size:22px}.lf-map{height:260px}.lf-price{padding:16px}.lf-grid :global(input),.lf-grid :global(select),.lf-search input{font-size:16px}}
</style>
