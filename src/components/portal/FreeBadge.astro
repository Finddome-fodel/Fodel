---
/**
 * "Ingyenes" — shown wherever a listing's payment state is shown, when the
 * listing costs its owner nothing. The tooltip says which kind of free
 * (src/lib/portal/fee-source.ts): the free upload link, an admin's
 * "Jóváhagyás ingyen", or an admin's own listing.
 */
import { feeSource, feeSourceTitle, type FreeFacts } from '~/lib/portal/fee-source';

type Props = { property: FreeFacts; adminOwned?: boolean; approverName?: string | null };
const { property, adminOwned = false, approverName = null } = Astro.props;
const source = feeSource(property, { adminOwned });
const title = source ? feeSourceTitle(source, property, approverName) : '';
---
{source && (
  <span class="free-badge" data-source={source} title={title} aria-label={`Ingyenes. ${title}`}>
    <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3.5 8.5l3 3 6-7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>Ingyenes
  </span>
)}
<style>
  .free-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 2px 10px 2px 8px;
    border-radius: 999px;
    background: var(--pt-green-bg);
    color: var(--pt-green);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--pt-green) 28%, transparent);
    font-size: 12px;
    font-weight: var(--fw-medium);
    line-height: 1.5;
    white-space: nowrap;
  }
</style>
