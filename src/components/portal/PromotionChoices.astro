---
import type { PortalProperty } from '~/lib/portal/properties';
import { readRequestedExtras } from '~/lib/portal/requested-extras';
interface Props {property:PortalProperty;isAdmin:boolean}
const {property:p,isAdmin}=Astro.props;
const requested=readRequestedExtras(p.requested_extras);
const choices=[
 {key:'homepage_featured',request:'request_homepage',title:'Főoldali kiemelés',body:'Kiemelt megjelenés a FINDDOME főoldalán.',active:p.homepage_featured,asked:requested.homepageHighlight},
 {key:'featured',request:'request_category',title:'Kategórián belüli kiemelés',body:'Kiemelt hely a kiválasztott ingatlankategória találatai között.',active:p.featured,asked:requested.categoryHighlight},
 {key:'topic_featured',request:'topic_highlight_requested',title:'Témakörön belüli kiemelés',body:'Kiemelt megjelenés a választott altípus találatai között. Az árat munkatársunkkal egyeztetheti.',active:p.topic_featured,asked:p.topic_highlight_requested||requested.topicHighlight},
];
---
<section id="curation" class="promotions">
 <header><h2>Kiemelések</h2><p>Választható megjelenések. Igénylésük nem indít fizetést; a díjat jóváhagyáskor egyeztetjük.</p></header>
 <div class="promotion-grid">{choices.map(c=><div class="promotion"><label><input type="checkbox" name={c.request} value="yes" checked={c.asked}/><span><strong>{c.title}</strong><small>{c.body}</small></span></label>{isAdmin&&<label class="activation"><input type="checkbox" name={c.key} value="yes" checked={c.active}/>Aktív megjelenés</label>}</div>)}</div>
</section>
 <div class="dutch-ask"><label><input type="checkbox" name="dutch_agent_requested" value="yes" checked={p.dutch_agent_requested||requested.dutchAgent}/><span><strong>Holland nyelvű ingatlanos</strong><small>Személyes segítség holland nyelven beszélő ingatlanostól. Egyedi ár, munkatársunk felveszi Önnel a kapcsolatot.</small></span></label></div>
<style>
 .promotions header{margin-bottom:20px}.promotions h2{font-family:var(--serif);font-size:24px;font-weight:var(--fw-medium);letter-spacing:-.025em}.promotions header p{font-size:14px;color:var(--ink-quiet);line-height:1.65;margin-top:7px;max-width:65ch}.promotion-grid{display:grid;gap:10px}.dutch-ask{margin-top:16px}:is(.promotion,.dutch-ask){border:1px solid var(--pt-hair);border-radius:14px;padding:18px}:is(.promotion,.dutch-ask):has(:checked){background:var(--paper)}:is(.promotion,.dutch-ask) label{display:flex;align-items:flex-start;gap:12px;cursor:pointer}:is(.promotion,.dutch-ask) input{width:18px;height:18px;accent-color:var(--ink);flex-shrink:0;margin-top:2px}:is(.promotion,.dutch-ask) strong{display:block;font-size:15px;font-weight:500}:is(.promotion,.dutch-ask) small{display:block;margin-top:5px;line-height:1.6;color:var(--ink-quiet);font-size:13px}.activation{padding-top:14px;margin-top:14px;border-top:1px solid var(--pt-hair);font-size:13px}
</style>
