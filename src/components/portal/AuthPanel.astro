---
/**
 * The signed-out portal chrome: login, invite acceptance, forgot password,
 * reset password.
 *
 * Extracted in 1.1 because those four screens had carried four independent
 * copies of the same 60 lines of CSS since 1.0, and the fourth and fifth
 * (forgot/reset) would have made six. Astro scopes styles per component, so
 * the duplication was not merely untidy — it was the only way the pages could
 * look alike, and it guaranteed they would drift apart the first time one was
 * touched.
 */
import Portal from '~/layouts/Portal.astro';
import Logo from '~/components/Logo.astro';

interface Props {
  /** Browser title. */
  title: string;
  /** Heading shown on the panel. */
  heading: string;
  /** Page language — the invite screen follows the invitee's language. */
  lang?: 'hu' | 'nl' | 'en' | 'de';
}

const { title, heading, lang = 'hu' } = Astro.props;
const brandLocale = lang === 'nl' || lang === 'hu' ? lang : 'nl';
const backLabel = { hu: 'Vissza a főoldalra', nl: 'Terug naar de homepage', en: 'Back to the homepage', de: 'Zurück zur Startseite' }[lang];
---

<Portal title={title} bare lang={lang}>
  <a class="auth-back" href={`/${lang}/`}>
    <span class="auth-back-chip" aria-hidden="true">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7" /></svg>
    </span>
    {backLabel}
  </a>
  <div class="panel">
    <div class="brand"><Logo locale={brandLocale} href={`/${lang}/`} /></div>
    <slot name="top" />
    <h1>{heading}</h1>
    <slot />
  </div>
</Portal>

<style is:global>
  /* Global rather than scoped: the form fields these rules style are supplied
     by each page through <slot>, so they carry the *page's* scope id, not this
     component's. Scoped styles here would match nothing — the same Astro
     scoping trap documented in the README's "corrections" section. Confined to
     .panel so nothing outside the signed-out screens is affected. */
  .auth-back {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    align-self: flex-start;
    margin-bottom: 16px;
    padding: 6px 18px 6px 6px;
    border-radius: var(--r-pill);
    background: var(--white, #fff);
    box-shadow: var(--shadow-xs), 0 0 0 1px var(--pt-hair, var(--border));
    font-size: 14.5px;
    font-weight: var(--fw-medium);
    color: var(--ink);
    text-decoration: none;
    transition: transform 0.4s var(--ease-out), box-shadow 0.4s var(--ease-out);
  }
  @media (hover: hover) {
    .auth-back:hover {
      transform: translateY(-1px);
      box-shadow: var(--shadow-md);
    }
  }
  .auth-back:focus-visible {
    outline: var(--focus-ring);
    outline-offset: 3px;
  }
  .auth-back-chip {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--cream);
  }
  .panel {
    width: 100%;
    padding: 48px 40px 40px;
    border-radius: var(--r-xl);
    border: 1px solid var(--pt-hair, var(--border));
    background: var(--white, #fff);
    box-shadow: var(--shadow-float);
  }
  .panel .brand {
    margin-bottom: 32px;
  }
  .panel h1 {
    font-family: var(--serif);
    font-weight: var(--fw-display);
    font-size: 24px;
    color: var(--ink);
    margin-bottom: 20px;
  }
  .panel .body {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--taupe);
    margin-bottom: 24px;
  }
  .panel .notice {
    font-size: var(--fs-small);
    line-height: 1.7;
    padding: 12px 16px;
    margin-bottom: 20px;
    border-radius: var(--r-md);
  }
  .panel .notice.error {
    color: #b3261e;
    background: rgba(179, 38, 30, 0.07);
  }
  .panel .notice.ok {
    color: #164f35;
    background: rgba(31, 111, 74, 0.1);
  }
  .panel .field {
    display: flex;
    flex-direction: column;
    margin-bottom: 18px;
  }
  .panel label {
    font-size: 13.5px;
    color: var(--ink-quiet);
    margin-bottom: 8px;
  }
  .panel input {
    border: 1.5px solid var(--border);
    border-radius: var(--r-sm);
    background: var(--paper);
    padding: 13px 16px;
    font-size: var(--fs-body);
    color: var(--ink);
  }
  .panel input:focus-visible {
    outline: var(--focus-ring);
    outline-offset: 2px;
  }
  .panel .submit {
    width: 100%;
    margin-top: 8px;
    padding: 15px;
    border-radius: var(--r-pill);
    background: var(--ink);
    color: var(--cream);
    font-size: 15.5px;
    font-weight: var(--fw-medium);
    transition:
      transform 0.4s var(--ease-out),
      box-shadow 0.4s var(--ease-out);
  }
  @media (hover: hover) {
    .panel .submit:hover {
      transform: translateY(-1px);
      box-shadow: var(--shadow-md);
    }
  }
  .panel .hint {
    margin-top: 24px;
    font-size: var(--fs-micro);
    line-height: 1.7;
    color: var(--taupe);
  }
  .panel .hint a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
