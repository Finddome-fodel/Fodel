{
  "name": "fodel-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "FODEL Ingatlan / FODEL Vastgoed \u2014 Hungarian property advertised across Western Europe",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && node scripts/prune-assets.mjs",
    "preview": "node scripts/preview.mjs",
    "check": "astro check",
    "verify:ssg": "node scripts/verify-ssg.mjs",
    "verify:contrast": "node scripts/verify-contrast.mjs",
    "verify": "npm run build && npm run verify:ssg && npm run verify:contrast",
    "verify:dev": "npm run build && node scripts/verify-ssg.mjs --allow-missing-kvk && npm run verify:contrast",
    "og": "node scripts/build-og.mjs",
    "build:pmtiles": "node scripts/build-pmtiles.mjs",
    "seed:500": "node scripts/seed-500.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "verify:rls": "node scripts/verify-rls.mjs",
    "verify:workflow": "node scripts/verify-workflow.mjs",
    "test:rules": "node scripts/test-rules.mjs",
    "test:stripe": "node --no-warnings scripts/test-stripe-flow.mjs",
    "test:translation": "node --no-warnings scripts/test-translation-flow.mjs",
    "test:own-listing": "node --no-warnings scripts/test-admin-own-listing.mjs",
    "test:upload": "node --no-warnings scripts/test-upload-link.mjs",
    "check:i18n": "node scripts/check-i18n-keys.mjs",
    "test:e2e": "playwright test",
    "test:e2e:webkit": "playwright test --project=webkit --project=mobile-safari",
    "test:listing:migration": "node scripts/test-listing-migration.mjs",
    "test:listing": "node scripts/test-listing-input.mjs",
    "local:prepare": "python3 scripts/local-workspace.py"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.6.0",
    "@astrojs/vercel": "^8.2.11",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/jost": "^5.3.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.45.4",
    "astro": "^5.16.2",
    "libphonenumber-js": "^1.13.15",
    "maplibre-gl": "^6.5.0",
    "marked": "^18.0.12",
    "pdfmake": "^0.2.20",
    "pmtiles": "^4.5.0",
    "resend": "^6.1.2",
    "sharp": "^0.34.4",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@electric-sql/pglite": "^0.5.11",
    "@playwright/test": "^1.64.1",
    "typescript": "^5.9.3"
  }
}
